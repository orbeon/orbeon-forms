<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:OpenSelectSupport="java:org.orbeon.xbl.OpenSelectSupportJava">

    <xbl:binding
        id="fr-open-select"
        element="
            fr|open-select,
            fr|open-select[appearance ~= full],
            xf|select[selection = open],
            xf|select[selection = open][appearance ~= full]"
        xxbl:container="span"
        xxbl:mode="lhha binding value selection"
        xxbl:label-for="fr-open-select-elem">

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Checkboxes with "Other"</display-name>
            <display-name lang="fr">Cases à cocher avec "Autre"</display-name>
            <display-name lang="no">Avkrysningsbokser med "Annet"</display-name>
            <display-name lang="ru">Флажки с вариантом "Другое"</display-name>
            <display-name lang="it">Caselle di controllo con "Altro"</display-name>
            <display-name lang="de">Kontrollkästchen mit "Andere"</display-name>
            <display-name lang="fi">Valintaruudut "Muu"-vaihtoehdolla</display-name>
            <display-name lang="es">Casillas de verificación con "Otros"</display-name>
            <display-name lang="nl">Selectievakjes met "Andere"</display-name>
            <display-name lang="pt">Caixas de seleção com "Outro"</display-name>
            <display-name lang="sv">Kryssrutor med "Annat"</display-name>
            <display-name lang="ar">مربعات اختيار مع "آخر"</display-name>
            <display-name lang="pl">Pola wyboru z "Inne"</display-name>
            <display-name lang="ja">「その他」付きチェックボックス</display-name>
            <icon>
                <icon-class>fa fa-fw fa-check-square-o</icon-class>
            </icon>
            <editors static-itemset="true" item-hint="true"/>
            <templates>
                <view>
                    <fr:open-select id="" ref="" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                        <xf:itemset ref="">
                            <xf:label ref="label"/>
                            <xf:value ref="value"/>
                            <xf:hint  ref="hint"/>
                        </xf:itemset>
                    </fr:open-select>
                </view>
            </templates>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/open-select/open-select.css"/>
        </xbl:resources>

        <xbl:handlers>
            <xbl:handler event="xforms-select xforms-deselect" observer="select">
                <xxf:setvisited control="fr-open-select"/>
            </xbl:handler>
            <xbl:handler event="xforms-enabled xforms-readonly xforms-readwrite" phase="target">
                <xf:setvalue
                    ref="instance('i')/readonly"
                    value="xxf:is-control-readonly('fr-open-select')"/>
            </xbl:handler>
        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="open-select-model">
                <xf:instance id="i" xxf:exclude-result-prefixes="#all">
                    <_>
                        <selected-items/>
                        <open-tokens/>
                        <readonly>false</readonly>
                    </_>
                </xf:instance>
                <xf:bind ref="selected-items" readonly="../readonly = 'true'"/>
                <xf:bind ref="open-tokens"    readonly="../readonly = 'true'"/>
            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:group appearance="xxf:internal">

                <xf:var name="binding" value="xxf:binding('fr-open-select')"/>

                <xf:select id="hidden-select" ref="$binding" appearance="xxf:internal">
                    <xbl:content includes=":root > xf|itemset, :root > xf|item, :root > xf|choices"/>
                </xf:select>

                <xf:var name="items"              value="xxf:itemset('hidden-select', 'xml')//item"/>
                <xf:var name="item-values-joined" value="string-join($items/value/string(), ' ')"/>

                <!-- Sync external bound value & itemset changes into local instance -->
                <xf:var
                    name="bound-and-items"
                    value="concat(string($binding), '|', $item-values-joined)">
                    <xf:action event="xforms-enabled xforms-value-changed">
                        <xf:var name="bound-str"  value="string($binding)"/>
                        <xf:var name="closed-str" value="OpenSelectSupport:closedTokensJoined($bound-str, $item-values-joined)"/>
                        <xf:var name="open-str"   value="OpenSelectSupport:openTokensJoined($bound-str, $item-values-joined)"/>
                        <xf:setvalue
                            ref="instance('i')/open-tokens"
                            value="$open-str"/>
                        <xf:setvalue
                            ref="instance('i')/selected-items"
                            value="$closed-str"/>
                    </xf:action>
                </xf:var>

                <xh:div id="fr-open-select-elem" class="fr-component-group" xxf:control="true">
                    <xf:select
                        id="select"
                        ref="instance('i')/selected-items"
                        appearance="full"
                        xbl:attr="xxf:encrypt-item-values"
                        class="xxforms-events-mode-default">

                        <xf:itemset ref="$items">
                            <xf:label ref="label"/>
                            <xf:hint  ref="hint"/>
                            <xf:value ref="value"/>
                        </xf:itemset>

                        <xf:action event="xforms-value-changed">
                            <xf:var
                                name="closed-selected"
                                value="OpenSelectSupport:closedTokensJoined(instance('i')/selected-items, $item-values-joined)"/>
                            <xf:var
                                name="new-bound"
                                value="OpenSelectSupport:combineTokens($closed-selected, instance('i')/open-tokens)"/>
                            <xf:setvalue
                                if="string($binding) != $new-bound"
                                ref="$binding"
                                value="$new-bound"/>
                        </xf:action>
                    </xf:select>

                    <fr:tags-input
                        id="open-tokens-input"
                        ref="instance('i')/open-tokens"
                        collapsible="true">
                        <xf:action event="xforms-value-changed">
                            <xxf:setvisited control="fr-open-select"/>
                            <xf:var
                                name="closed-selected"
                                value="OpenSelectSupport:closedTokensJoined(instance('i')/selected-items, $item-values-joined)"/>
                            <xf:var
                                name="new-bound"
                                value="OpenSelectSupport:combineTokens($closed-selected, instance('i')/open-tokens)"/>
                            <xf:setvalue
                                if="string($binding) != $new-bound"
                                ref="$binding"
                                value="$new-bound"/>
                        </xf:action>
                    </fr:tags-input>
                </xh:div>
            </xf:group>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
