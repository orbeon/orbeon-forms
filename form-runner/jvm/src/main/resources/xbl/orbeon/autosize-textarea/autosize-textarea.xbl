<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner">

    <xbl:binding
        id="fr-autosize-textarea"
        element="
            fr|autosize-textarea,
            xf|textarea[appearance ~= 'xxf:autosize']"
        xxbl:mode="binding lhha value allow-minimal-label-hint"
        xxbl:label-for="field"
        xxbl:container="span">

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Plain Text Area with Resizing</display-name>
            <display-name lang="fr">Zone de texte avec redimensionnement</display-name>
            <display-name lang="no">Tekstområde med størrelsesjustering</display-name>
            <display-name lang="ru">Многострочное поле с изменением размера</display-name>
            <display-name lang="it">Area di testo con ridimensionamento</display-name>
            <display-name lang="de">Textbereich mit Größenänderung</display-name>
            <display-name lang="fi">Tekstialue koonmuutoksella</display-name>
            <display-name lang="es">Texto extendido con redimensionamiento</display-name>
            <display-name lang="nl">Tekstveld met formaat wijzigen</display-name>
            <display-name lang="pt">Área de texto com redimensionamento</display-name>
            <display-name lang="sv">Textyta med storleksändring</display-name>
            <display-name lang="ar">منطقة نص عادي مع تغيير الحجم</display-name>
            <display-name lang="pl">Obszar zwykłego tekstu ze zmianą rozmiaru</display-name>
            <display-name lang="ja">リサイズ対応テキストエリア</display-name>
            <appearance-display-name lang="en">With Resizing</appearance-display-name>
            <appearance-display-name lang="fr">Avec redimensionnement</appearance-display-name>
            <appearance-display-name lang="no">Med størrelsesjustering</appearance-display-name>
            <appearance-display-name lang="ru">С изменением размера</appearance-display-name>
            <appearance-display-name lang="it">Con ridimensionamento</appearance-display-name>
            <appearance-display-name lang="de">Mit Größenänderung</appearance-display-name>
            <appearance-display-name lang="fi">Koonmuutoksen kanssa</appearance-display-name>
            <appearance-display-name lang="es">Con Redimensionamiento</appearance-display-name>
            <appearance-display-name lang="nl">Met formaat wijzigen</appearance-display-name>
            <appearance-display-name lang="pt">Com redimensionamento</appearance-display-name>
            <appearance-display-name lang="sv">Med storleksändring</appearance-display-name>
            <appearance-display-name lang="ar">مع تغيير الحجم</appearance-display-name>
            <appearance-display-name lang="pl">Ze zmianą rozmiaru</appearance-display-name>
            <appearance-display-name lang="ja">リサイズ対応</appearance-display-name>
            <toolbox show="false"/>
            <icon>
                <icon-class>fa fa-fw fa-arrow-down</icon-class>
            </icon>
            <templates>
                <view>
                    <xf:textarea id="" ref="" appearance="xxf:autosize" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </xf:textarea>
                </view>
            </templates>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/autosize-textarea/autosize-textarea.css"/>
        </xbl:resources>

        <xbl:template
            xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
            xmlns:oxf="http://www.orbeon.com/oxf/processors"
            xxbl:transform="oxf:xslt">

            <xh:span xsl:version="2.0">
                <xsl:element name="{name(/*)}">
                    <xsl:attribute name="id">field</xsl:attribute>
                    <xsl:attribute name="ref">xxf:binding('fr-autosize-textarea')</xsl:attribute>
                    <xsl:attribute name="appearance"  select="tokenize(/*/@appearance, '\s+')[. != 'xxf:autosize']"/>
                    <xsl:copy-of select="/*/@xxf:maxlength"/>
                    <xsl:if test="/*/@autocomplete">
                        <xsl:attribute name="autocomplete">
                            <xsl:value-of select="/*/@autocomplete"/>
                        </xsl:attribute>
                    </xsl:if>
                    <xsl:if test="/*/xf:label/@appearance = 'minimal'">
                        <xf:label appearance="minimal" value="xxf:label('fr-autosize-textarea')">
                            <xsl:copy-of select="/*/xf:label/@mediatype"/>
                        </xf:label>
                    </xsl:if>
                </xsl:element>
            </xh:span>
        </xbl:template>

    </xbl:binding>
</xbl:xbl>
