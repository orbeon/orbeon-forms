<eh:config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:eh="http://www.ehcache.org/v3"
    xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
    xsi:schemaLocation="
        http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.3.xsd
        http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext-3.3.xsd">

    <!-- Where the disk store will go -->
    <eh:persistence directory="${java.io.tmpdir}/orbeon/cache"/>

    <!--
        From Ehcache 2 to Ehcache 3, we appear to have lost the following settings:

        - `memoryStoreEvictionPolicy`
        - `diskSpoolBufferSizeMB`
        - `diskExpiryThreadIntervalSeconds`
     -->

    <!-- XForms dynamic state store configuration. Only modify if you know what you are doing! -->
    <eh:cache alias="xforms.store.dynamic-states">
        <eh:key-type>java.lang.String</eh:key-type>
        <eh:value-type>java.io.Serializable</eh:value-type>
        <eh:expiry>
            <eh:tti unit="hours">5</eh:tti>
        </eh:expiry>
        <eh:resources>
            <eh:heap unit="entries">200</eh:heap>
            <eh:disk persistent="false" unit="GB">2</eh:disk>
        </eh:resources>
    </eh:cache>

    <!-- XForms serialized static state store -->
    <eh:cache alias="xforms.store.static-states">
        <eh:key-type>java.lang.String</eh:key-type>
        <eh:value-type>java.io.Serializable</eh:value-type>
        <eh:expiry>
            <eh:tti unit="hours">4</eh:tti>
        </eh:expiry>
        <eh:resources>
            <eh:heap unit="entries">100</eh:heap>
            <eh:disk persistent="false" unit="MB">500</eh:disk>
        </eh:resources>
    </eh:cache>

    <!-- XForms aggregated JS/CSS asset bundles store. Only modify if you know what you are doing! -->
    <eh:cache alias="xforms.store.asset-bundles">
        <eh:key-type>java.lang.String</eh:key-type>
        <eh:value-type>[Ljava.lang.String;</eh:value-type>
        <eh:expiry>
            <eh:tti unit="hours">24</eh:tti>
        </eh:expiry>
        <eh:resources>
            <eh:heap unit="entries">200</eh:heap>
            <eh:disk persistent="false" unit="MB">10</eh:disk>
        </eh:resources>
    </eh:cache>

    <!-- Form Runner external modes store -->
    <eh:cache alias="fr.store.external-modes">
        <eh:key-type>java.io.Serializable</eh:key-type>
        <eh:value-type>java.io.Serializable</eh:value-type>
        <eh:expiry>
            <eh:ttl unit="minutes">16</eh:ttl>
        </eh:expiry>
        <eh:resources>
            <eh:heap unit="entries">200</eh:heap>
        </eh:resources>
    </eh:cache>

    <!-- Form Runner persistence form metadata cache. Only modify if you know what you are doing! -->
    <eh:cache alias="fr.cache.form-metadata">
        <eh:key-type>java.io.Serializable</eh:key-type>
        <eh:value-type>java.io.Serializable</eh:value-type>
        <eh:expiry>
            <eh:ttl unit="minutes">5</eh:ttl>
        </eh:expiry>
        <eh:resources>
            <eh:heap unit="entries">100</eh:heap>
        </eh:resources>
    </eh:cache>

    <!-- Configuration properties cache -->
    <eh:cache alias="core.cache.properties">
        <eh:key-type>java.io.Serializable</eh:key-type>
        <eh:value-type>java.io.Serializable</eh:value-type>
        <eh:expiry>
            <eh:none/>
        </eh:expiry>
        <eh:resources>
            <eh:heap unit="entries">50</eh:heap>
        </eh:resources>
    </eh:cache>

</eh:config>
