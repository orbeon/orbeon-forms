                            <drag-to-reorder>Перетащите для изменения порядка</drag-to-reorder>
                            <move-up>Переместить сервер вверх</move-up>
                            <move-down>Переместить сервер вниз</move-down>
                            <remove-server>Удалить сервер</remove-server>
                            <moved-announcement>Сервер перемещён на позицию {0} из {1}</moved-announcement>
