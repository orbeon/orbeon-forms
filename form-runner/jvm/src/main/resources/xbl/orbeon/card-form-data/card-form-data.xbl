<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:frf="java:org.orbeon.oxf.fr.FormRunner"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:OpenSelectSupport="java:org.orbeon.xbl.OpenSelectSupportJava">

    <xbl:binding
        id="fr-card-form-data"
        element="fr|card-form-data"
        xxbl:mode="lhha custom-lhha binding"
        class="h-100"
    >
        <xbl:handlers>
            <xbl:handler event="fr-sync-aria-sort" phase="target">
                <xf:action type="javascript">
                    <xf:param name="col" value="event('col')"/>
                    <xf:param name="dir" value="event('dir')"/>
                    <xf:body>
                        const root = this;
                        if (root &amp;&amp; root.querySelectorAll) {
                            const sync = () =&gt; {
                                const ariaVal = dir === 'asc' ? 'ascending' : (dir === 'desc' ? 'descending' : '');
                                for (const h of root.querySelectorAll('.fr-card-heading')) {
                                    if (col &amp;&amp; h.getAttribute('data-col-path') === col &amp;&amp; ariaVal)
                                        h.setAttribute('aria-sort', ariaVal);
                                    else
                                        h.removeAttribute('aria-sort');
                                }
                            };
                            sync();
                            window.requestAnimationFrame(sync);
                        }
                    </xf:body>
                </xf:action>
            </xbl:handler>
        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="model">

                <xf:var
                    name="page-size"
                    value="xs:integer(xxf:property('oxf.fr.landing.page-size'))"/>

                <xf:var
                    name="max-rows"
                    value="$page-size + 6"/>

                <xf:var
                    name="tz"
                    value="
                        for $offset in frf:defaultTimezoneToOffsetString()
                        return xs:dayTimeDuration($offset)"/>

                <!-- `xxf:lang()` isn't available inside `xf:model`, so read `fr-fr-language-instance` directly -->
                <xf:var
                    name="datelang"
                    value="(xxf:instance('fr-fr-language-instance')[frf:hasXPathNumberer(.)], 'en')[1]"/>

                <xf:var name="app"     value="fr:component-param-value('app')"/>
                <xf:var name="form"    value="fr:component-param-value('form')"/>
                <xf:var name="version" value="xs:integer((fr:component-param-value('version')[. castable as xs:integer], 1)[1])"/>

                <xf:instance id="fr-state-instance" xxf:exclude-result-prefixes="#all">
                    <_ state="initial" has-loaded="false" operations="" latest-modified="" sort-announcement=""/>
                </xf:instance>

                <xf:instance id="fr-source-form-instance" xxf:readonly="false" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="fr-form-resources" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <!-- Used for obtaining item labels -->
                <xf:var
                    name="form-resources"
                    value="instance('fr-form-resources')/(*[@xml:lang = xxf:instance('fr-fr-language-instance')], *)[1]"/>

                <xf:instance id="fr-search-instance">
                    <search>
                        <query/>
                        <query metadata="created"          match="gte"/>
                        <query metadata="created"          match="lt"/>
                        <query metadata="created-by"       match="exact"/>
                        <query metadata="last-modified"    match="gte" sort="desc"/>
                        <query metadata="last-modified"    match="lt"/>
                        <query metadata="last-modified-by" match="exact"/>
                        <query metadata="workflow-stage"   match="exact"/>
                        <drafts>exclude</drafts>
                        <page-size>5</page-size>
                        <page-number>1</page-number>
                        <lang/>
                    </search>
                </xf:instance>

                <!-- Contains search labels -->
                <xf:instance id="fr-search-labels-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="fr-order-by" xxf:exclude-result-prefixes="#all">
                    <order-by>
                        <column>last-modified</column>
                        <direction>desc</direction>
                    </order-by>
                </xf:instance>

                <xf:submission
                    id="fr-get-source-form-submission"
                    method="get"
                    serialization="none"
                    resource="/fr/service/persistence/crud/{$app}/{$form}/form/form.xhtml"

                    replace="instance"
                    instance="fr-source-form-instance"

                    xxf:readonly="true"
                    xxf:cache="false"
                    xxf:xinclude="true"

                    mode="asynchronous"
                    xxf:response-must-await="200ms"
                    xxf:show-progress="false"
                >

                    <xf:header>
                        <xf:name>Orbeon-Form-Definition-Version</xf:name>
                        <xf:value value="$version"/>
                    </xf:header>

                    <xf:setvalue
                        event="xforms-submit"
                        ref="instance('fr-state-instance')/@state"
                        value="'loading'"/>

                    <xf:action event="xforms-submit-done">
                        <xf:delete ref="instance('fr-form-metadata-instance')/*"/>
                        <xf:insert
                            ref="instance('fr-form-metadata-instance')"
                            origin="frf:metadataInstanceRootOpt(instance('fr-source-form-instance'))"/>
                        <xf:var
                            name="property-profile-opt"
                            value="frf:getModelElem(instance('fr-source-form-instance'))/@xxf:property-profile[xxf:non-blank()]/xxf:trim()"/>
                        <xf:var
                            name="operations-from-role"
                            value="frf:authorizedOperationsBasedOnRolesXPath(instance('fr-form-metadata-instance')/permissions, $app, $form, $property-profile-opt)"/>
                        <xf:setvalue
                            ref="instance('fr-state-instance')/@operations"
                            value="string-join($operations-from-role, ' ')"/>
                    </xf:action>

                    <xf:setvalue
                        event="xforms-submit-error"
                        ref="instance('fr-state-instance')/@state"
                        value="'error'"/>

                </xf:submission>

                <xf:instance id="fr-search-results-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="fr-form-metadata-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:submission
                    id="fr-search-submission"
                    ref="instance('fr-search-instance')"
                    validate="false"
                    method="post"
                    resource="/fr/service/persistence/search/{$app}/{$form}"

                    replace="instance"
                    targetref="instance('fr-search-results-instance')"

                    mode="asynchronous"
                    xxf:response-must-await="200ms"
                    xxf:show-progress="false"
                >

                    <xf:header>
                        <xf:name>Orbeon-Form-Definition-Version</xf:name>
                        <xf:value value="$version"/>
                    </xf:header>

                    <xf:action event="xforms-submit">
                        <xf:setvalue ref="instance('fr-state-instance')/@state" value="'loading'"/>
                        <xf:setvalue ref="page-size" value="$max-rows"/>
                        <xf:setvalue ref="lang" value="(xxf:instance('fr-fr-language-instance')[xxf:non-blank()], 'en')[1]"/>
                    </xf:action>

                    <xf:action event="xforms-submit-done">
                        <xf:setvalue ref="instance('fr-state-instance')/@state"      value="'done'"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@has-loaded" value="'true'"/>

                        <xf:var name="returned-docs" value="instance('fr-search-results-instance')/document"/>
                        <xf:var name="search-total"  value="xs:integer((instance('fr-search-results-instance')/@search-total[. castable as xs:integer], 0)[1])"/>
                        <xf:setvalue
                            ref="instance('fr-state-instance')/@latest-modified"
                            value="
                                if ($search-total le 0 or empty($returned-docs)) then
                                    ''
                                else if (instance('fr-order-by')/column = 'last-modified' and instance('fr-order-by')/direction = 'desc') then
                                    string($returned-docs[1]/@last-modified)
                                else
                                    string(
                                        max((
                                            instance('fr-state-instance')/@latest-modified[. castable as xs:dateTime]/xs:dateTime(.),
                                            $returned-docs/@last-modified[. castable as xs:dateTime]/xs:dateTime(.)
                                        ))
                                    )"/>
                    </xf:action>

                    <xf:setvalue
                        event="xforms-submit-error"
                        ref="instance('fr-state-instance')/@state"
                        value="'error'"/>

                </xf:submission>

                <xf:action
                    event="xforms-model-construct-done"
                    if="not(fr:component-param-value('active') = 'false') and xxf:non-blank($app) and xxf:non-blank($form)">
                    <xf:send submission="fr-get-source-form-submission"/>
                </xf:action>

                <!-- Out of the box, this submission is used only for the Form Builder Summary page, as it is the only one with
                     an external resources instance (using the `src` attribute). -->
                <xf:submission
                    id="fr-load-form-resources-submission"
                    method="get"
                    resource="{event('fr-resources-uri')}"
                    serialization="none"
                    replace="instance"
                    instance="fr-form-resources"
                    xxf:readonly="true"
                    xxf:cache="true"
                    xxf:xinclude="true"/>

                <xf:action event="xforms-submit-done" observer="fr-get-source-form-submission">

                    <!-- Load resources -->
                    <xf:var
                        name="resources-instance"
                        value="instance('fr-source-form-instance')/xh:head/xf:model/xf:instance[@id = 'fr-form-resources']"/>
                    <xf:action if="exists($resources-instance/@src)">
                        <xf:send submission="fr-load-form-resources-submission">
                            <xf:property name="fr-resources-uri" value="$resources-instance/@src"/>
                        </xf:send>
                    </xf:action>
                    <xf:action if="empty($resources-instance/@src)">
                        <xf:insert
                            ref="instance('fr-form-resources')"
                            origin="$resources-instance/*"/>
                    </xf:action>

                    <xf:setvalue
                        ref="instance('fr-search-instance')/page-size"
                        value="$max-rows"/>

                    <!-- Create elements holding structured search data -->
                    <xf:delete
                        ref="
                            instance('fr-search-labels-instance')/* |
                            instance('fr-search-instance')/query[exists(@name)]"/>

                    <xf:insert
                        context="instance('fr-search-labels-instance')"
                        origin="frf:searchableValues(instance('fr-source-form-instance')/root(), $app, $form, $version, instance('fr-form-resources'))/*"/>

                    <xf:insert
                        context="instance('fr-search-instance')"
                        ref="query"
                        origin="instance('fr-search-labels-instance')/query[exists(@path)]"/>

                    <xf:delete
                        ref="instance('fr-search-labels-instance')/query/*[name() != 'resources']"/>

                    <xf:delete
                        ref="instance('fr-search-instance')/query/*"/>

                    <!-- Query initial list of documents -->
                    <xf:send submission="fr-search-submission"/>

                </xf:action>
            </xf:model>
        </xbl:implementation>
        <xbl:template>

            <xf:var
                name="non-card-controls"
                value="('attachment', 'image-attachment', 'video-attachment', 'audio-attachment', 'handwritten-signature', 'wpaint')"/>

            <xf:var
                name="card-query-paths"
                value="instance('fr-search-instance')/query[@name and @summary-show = 'true' and not(@control = $non-card-controls)]/@path"/>

            <xf:var
                name="summary-queries"
                value="instance('fr-search-labels-instance')/query[@name and @summary-show = 'true' and @path = $card-query-paths]"/>

            <xf:var
                name="detail-positions"
                value="instance('fr-search-instance')/query[@name and @summary-show = 'true' and not(@control = $non-card-controls)]/(count(preceding-sibling::query[@name]) + 1)"/>

            <xf:var
                name="documents"
                value="instance('fr-search-results-instance')/document"/>

            <xf:var
                name="search-total"
                value="xs:integer((instance('fr-search-results-instance')/@search-total[. castable as xs:integer], count($documents))[1])"/>

            <xf:var
                name="document-count-to-render"
                value="min((count($documents), $max-rows))"/>

            <xf:var
                name="show-more"
                value="$search-total gt $page-size"/>

            <xf:var
                name="ops"
                value="xxf:split(instance('fr-state-instance')/@operations)"/>

            <xf:var
                name="is-singleton"
                value="instance('fr-form-metadata-instance')/singleton = 'true'"/>

            <xf:var
                name="can-create"
                value="$ops = ('*', 'create') and not($is-singleton and $search-total gt 0)"/>

            <xf:var
                name="can-list"
                value="$ops = ('*', 'list')"/>

            <xf:var
                name="new-href"
                value="concat('/fr/', $app, '/', $form, '/new')"/>

            <xf:var
                name="summary-href"
                value="
                    concat(
                        '/fr/',
                        $app,
                        '/',
                        $form,
                        '/summary',
                        if (
                            $version != 1 and
                            xxf:property(string-join(('oxf.fr.summary.show-version-selector', $app, $form), '.'))
                        ) then
                            concat('?form-version=', $version)
                        else
                            ''
                    )"/>

            <xf:var
                name="param-thumbnail"
                value="fr:component-param-value('thumbnail')[xxf:non-blank()]"/>

            <xf:var
                name="metadata-thumbnail"
                value="instance('fr-form-metadata-instance')/thumbnail[xxf:non-blank()]"/>

            <xf:var
                name="svg-thumbnail"
                value="($param-thumbnail, if (empty($metadata-thumbnail) and $app = 'orbeon' and $form = 'builder') then '/apps/fr/style/images/orbeon/library.svg' else ())[1]"/>

            <xf:var
                name="latest-modified-dt"
                value="instance('fr-state-instance')/@latest-modified[. castable as xs:dateTime]/xs:dateTime(.)"/>

            <xf:var name="new-label"     value="xxf:r('landing.buttons.new', '|fr-fr-resources|')"/>
            <xf:var name="summary-label" value="xxf:r('landing.buttons.summary', '|fr-fr-resources|')"/>
            <xf:var name="refresh-label" value="xxf:r('landing.buttons.refresh', '|fr-fr-resources|')"/>

            <xf:var
                name="refresh-watch"
                value="concat(fr:component-param-value('refresh-token'), '|', xxf:instance('fr-fr-language-instance'))">
                <xf:send
                    event="xforms-value-changed"
                    if="instance('fr-state-instance')/@has-loaded = 'true'"
                    submission="fr-search-submission"/>
            </xf:var>

            <fr:card
                status="{instance('fr-state-instance')/@state}"
                has-loaded="{instance('fr-state-instance')/@has-loaded}"
                count="{$search-total}"
                columns="{max((count($detail-positions), 1))}"
                is-empty="{empty($documents)}"
                empty-message="{xxf:r('landing.messages.no-data', '|fr-fr-resources|')}"
            >
                <xf:label
                    value="(
                        xxf:label('fr-card-form-data')[xxf:non-blank()],
                        instance('fr-form-metadata-instance')/(title[@xml:lang = xxf:lang()], title)[xxf:non-blank()],
                        $form
                    )[1]"/>

                <fr:card-status>
                    <xf:output value="instance('fr-state-instance')/@sort-announcement"/>
                </fr:card-status>

                <fr:card-actions>
                    <xh:a
                        href="{$new-href}"
                        title="{$new-label}"
                        aria-label="{$new-label}"
                        class="fr-card-action-btn {'xforms-hidden'[not($can-create)]}">
                        <xh:i class="fa fa-plus" aria-hidden="true"/>
                    </xh:a>
                    <xh:a
                        href="{$summary-href}"
                        title="{$summary-label}"
                        aria-label="{$summary-label}"
                        class="fr-card-action-btn {'xforms-hidden'[not($can-list)]}">
                        <xh:i class="fa fa-list" aria-hidden="true"/>
                    </xh:a>
                    <xf:trigger
                        appearance="minimal"
                        class="fr-card-action-btn fr-card-refresh-btn {'is-spinning'[instance('fr-state-instance')/@state = 'loading' and instance('fr-state-instance')/@has-loaded = 'true']}">
                        <xf:label>
                            <xh:i class="fa fa-rotate-right" aria-hidden="true"/>
                            <xh:span class="xforms-hidden"><xf:output value="$refresh-label"/></xh:span>
                        </xf:label>
                        <xf:hint value="$refresh-label"/>
                        <xf:send event="DOMActivate" submission="fr-search-submission"/>
                    </xf:trigger>
                </fr:card-actions>

                <fr:headings>
                    <xf:repeat ref="$summary-queries">
                        <xf:var name="path"      value="string(@path)"/>
                        <xf:var name="label"     value="string((resources[@lang = xxf:lang()]/label, resources/label, @name)[1])"/>
                        <xf:var name="is-sorted" value="instance('fr-order-by')/column = $path"/>
                        <xf:var name="caret-value" value="
                            if (not($is-sorted) or instance('fr-order-by')/direction = 'asc') then
                                '&#x25B2;'
                            else
                                '&#x25BC;'
                        "/>
                        <xh:span class="fr-card-col fr-card-heading" role="columnheader" data-col-path="{$path}">
                            <xf:trigger appearance="minimal" class="fr-card-sort-trigger">
                                <xf:label>
                                    <xh:span class="fr-card-col-text text-truncate">
                                        <xf:output value="$label"/>
                                    </xh:span>
                                    <xh:span
                                        class="{
                                            'fr-card-sort-caret',
                                            'active-caret'[$is-sorted],
                                            'hover-caret'[not($is-sorted)]
                                        }"
                                        aria-hidden="true">
                                        <xf:output value="$caret-value"/>
                                    </xh:span>
                                </xf:label>
                                <xf:action event="DOMActivate">
                                    <xf:var name="target-col"  value="$path"/>
                                    <xf:var name="current-col" value="string(instance('fr-order-by')/column)"/>
                                    <xf:var name="current-dir" value="string(instance('fr-order-by')/direction)"/>
                                    <xf:var name="next-col" value="
                                        if ($current-col = $target-col and $current-dir = 'desc') then
                                            'last-modified'
                                        else
                                            $target-col
                                    "/>
                                    <xf:var name="next-dir" value="
                                        if ($current-col = $target-col) then
                                            'desc'
                                        else
                                            'asc'
                                    "/>
                                    <xf:var name="announce-col-label" value="
                                        if ($next-col = 'last-modified') then
                                            xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')
                                        else
                                            $label
                                    "/>

                                    <xf:setvalue ref="instance('fr-order-by')/column"    value="$next-col"/>
                                    <xf:setvalue ref="instance('fr-order-by')/direction" value="$next-dir"/>
                                    <xf:setvalue
                                        ref="instance('fr-state-instance')/@sort-announcement"
                                        value="
                                            if ($next-dir = 'asc') then
                                                xxf:format-message(
                                                    xxf:r('landing.messages.sorted-by-ascending', '|fr-fr-resources|'),
                                                    $announce-col-label
                                                )
                                            else
                                                xxf:format-message(
                                                    xxf:r('landing.messages.sorted-by-descending', '|fr-fr-resources|'),
                                                    $announce-col-label
                                                )"/>

                                    <xf:dispatch name="fr-sync-aria-sort" targetid="fr-card-form-data">
                                        <xf:property name="col" value="if ($next-col = 'last-modified') then '' else $next-col"/>
                                        <xf:property name="dir" value="$next-dir"/>
                                    </xf:dispatch>

                                    <!-- Delete sort attribute from all queries -->
                                    <xf:delete ref="instance('fr-search-instance')/query/@sort"/>

                                    <!-- Insert sort attribute on the appropriate query -->
                                    <xf:insert
                                        context="
                                            if ($next-col = 'last-modified') then
                                                instance('fr-search-instance')/query[@metadata = 'last-modified'][1]
                                            else
                                                instance('fr-search-instance')/query[@path = $next-col]"
                                        origin="xf:attribute('sort', $next-dir)"/>

                                    <!-- Query documents with updated sort order -->
                                    <xf:send submission="fr-search-submission"/>
                                </xf:action>
                            </xf:trigger>
                        </xh:span>
                    </xf:repeat>
                </fr:headings>

                <fr:card-body>
                    <xh:p class="card-text">
                        <xf:output
                            value="(
                                xxf:help('fr-card-form-data')[xxf:non-blank()],
                                instance('fr-form-metadata-instance')/(description[@xml:lang = xxf:lang()], description)[xxf:non-blank()]
                            )[1]"/>
                    </xh:p>
                </fr:card-body>

                <fr:card-thumbnail>
                    <!-- https://github.com/orbeon/orbeon-forms/issues/6696 -->
                    <xf:output
                        mediatype="image/*"
                        ref="$metadata-thumbnail[empty($param-thumbnail)]"
                        class="img-thumbnail fr-card-metadata-thumbnail"/>
                    <xf:group ref=".[exists($svg-thumbnail)]">
                        <xh:img
                            src="{($svg-thumbnail, 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7')[1]}"
                            alt=""
                            class="img-thumbnail img-invertible"/>
                    </xf:group>
                </fr:card-thumbnail>

                <fr:rows>
                    <xf:var
                        name="column-labels"
                        value="for $q in $summary-queries return string(($q/resources[@lang = xxf:lang()]/label, $q/resources/label, $q/@name)[1])"/>

                    <xf:repeat ref="$documents[position() le $document-count-to-render]">
                        <xf:var name="is-extra-row" value="position() gt $page-size"/>
                        <xf:var name="document" value="."/>
                        <xf:var
                            name="cell-values"
                            value="
                                if (empty($detail-positions)) then
                                    string($document/@name)
                                else
                                    for $detail-position in $detail-positions
                                    return
                                        let $raw     := $document/details/detail[$detail-position],
                                            $query   := instance('fr-search-instance')/query[exists(@name)][$detail-position],
                                            $control := $query/@control,
                                            $value   :=
                                                if (frf:isMultipleSelectionControl($control)) then
                                                    string-join(
                                                        for $code in xxf:split($raw) return
                                                            (
                                                                $form-resources/*[local-name() = $query/@name]/item[value = $code]/label,
                                                                if ($control = 'open-select') then OpenSelectSupport:decodeToken($code) else $code
                                                            )[1],
                                                        ', '
                                                    )
                                                else if ($control = 'tags-input') then
                                                    string-join(
                                                        for $code in xxf:split($raw) return
                                                            OpenSelectSupport:decodeToken($code),
                                                        ', '
                                                    )
                                                else if ($control = 'date-range') then
                                                    let $parts := tokenize($raw, '/') return
                                                    if (count($parts) = 2 and $parts[1] castable as xs:date and $parts[2] castable as xs:date) then
                                                        concat(
                                                            format-date(xs:date($parts[1]), xxf:r('summary.formats.date', '|fr-fr-resources|'), $datelang, (), ()),
                                                            ' – ',
                                                            format-date(xs:date($parts[2]), xxf:r('summary.formats.date', '|fr-fr-resources|'), $datelang, (), ())
                                                        )
                                                    else
                                                        $raw
                                                else if (frf:isSingleSelectionControl($control)) then
                                                    for $code in $raw return
                                                        ($form-resources/*[local-name() = $query/@name]/item[value = $code]/label, $code)[1]
                                                else if ($control = 'secret') then
                                                    if (normalize-space($raw) = '') then
                                                        ''
                                                    else
                                                        '••••••••'
                                                else
                                                    for $type in substring-after($query/@type, ':') return
                                                        if ($type = 'date') then
                                                            if ($raw castable as xs:date) then
                                                                format-date(
                                                                    xs:date($raw),
                                                                    xxf:r('summary.formats.date', '|fr-fr-resources|'),
                                                                    $datelang,
                                                                    (),
                                                                    ()
                                                                )
                                                            else
                                                                $raw
                                                        else if ($type = 'time') then
                                                            if ($raw castable as xs:time) then
                                                                format-time(
                                                                    xs:time($raw),
                                                                    xxf:r('summary.formats.time', '|fr-fr-resources|'),
                                                                    $datelang,
                                                                    (),
                                                                    ()
                                                                )
                                                            else
                                                                $raw
                                                        else if ($type = 'dateTime') then
                                                            if ($raw castable as xs:dateTime) then
                                                                format-dateTime(
                                                                    xs:dateTime($raw),
                                                                    xxf:r('summary.formats.dateTime', '|fr-fr-resources|'),
                                                                    $datelang,
                                                                    (),
                                                                    ()
                                                                )
                                                            else
                                                                $raw
                                                        else if ($type = 'dayTimeDuration') then
                                                            if ($raw castable as xs:dayTimeDuration) then
                                                                let $dur   := xs:dayTimeDuration($raw),
                                                                    $parts := (
                                                                        if (days-from-duration($dur) = 0) then
                                                                            ()
                                                                        else
                                                                            concat(days-from-duration($dur), ' d'),
                                                                        if (hours-from-duration($dur) = 0) then
                                                                            ()
                                                                        else
                                                                            concat(hours-from-duration($dur), ' h'),
                                                                        if (minutes-from-duration($dur) = 0) then
                                                                            ()
                                                                        else
                                                                            concat(minutes-from-duration($dur), ' min'),
                                                                        if (seconds-from-duration($dur) = 0) then
                                                                            ()
                                                                        else
                                                                            concat(seconds-from-duration($dur), ' sec')
                                                                    )
                                                                return
                                                                    if (empty($parts)) then
                                                                        '0 min'
                                                                    else
                                                                        string-join($parts, ' ')
                                                            else
                                                                $raw
                                                        else
                                                            $raw
                                        return
                                            if (xxf:is-blank($value)) then
                                                '–'
                                            else
                                                string($value)"/>

                        <xf:var
                            name="row-href"
                            value="
                                let
                                    $current-document-name       := string($document/@name),
                                    $current-document-operations := xxf:split($document/@operations),
                                    $edit-view-opt               :=
                                        if ($current-document-operations = ('*', 'update')) then
                                            'edit'
                                        else if ($current-document-operations = 'read') then
                                            'view'
                                        else
                                            ()
                                return
                                    if (exists($edit-view-opt)) then
                                        string-join(('/fr', $app, $form, $edit-view-opt, $current-document-name), '/')
                                    else
                                        ''"/>

                        <xf:var
                            name="row-tooltip"
                            value="
                                if (empty($column-labels)) then
                                    string-join($cell-values, ' · ')
                                else
                                    string-join(
                                        for $idx in 1 to count($cell-values)
                                        return concat($column-labels[$idx], ': ', $cell-values[$idx]),
                                        ' · '
                                    )"/>

                        <xf:var name="is-single-cell" value="count($cell-values) le 1"/>

                        <xh:li
                            class="list-group-item fr-card-data-row {'fr-card-data-row-clickable'[xxf:non-blank($row-href)]} {'fr-card-extra-row fr-card-extra-row-hidden'[$is-extra-row]}"
                            role="row"
                            title="{$row-tooltip}">
                            <xf:repeat ref="1 to count($cell-values)">
                                <xf:var name="col-idx"   value="."/>
                                <xf:var name="cell-text" value="$cell-values[$col-idx]"/>
                                <xf:var name="is-link"   value="$col-idx = 1 and xxf:non-blank($row-href)"/>
                                <xh:span
                                    class="fr-card-col {if ($is-single-cell) then 'fr-card-col-single' else ''} {if ($col-idx = 1) then 'fr-card-col-primary' else 'fr-card-col-secondary'}"
                                    role="cell">
                                    <xh:a
                                        href="{if ($is-link) then $row-href else '#'}"
                                        class="fr-card-stretched-link {'xforms-hidden'[not($is-link)]}">
                                        <xh:span class="fr-card-col-text text-truncate">
                                            <xf:output value="$cell-text"/>
                                        </xh:span>
                                    </xh:a>
                                    <xh:span class="fr-card-col-text text-truncate {'xforms-hidden'[$is-link]}">
                                        <xf:output value="$cell-text"/>
                                    </xh:span>
                                </xh:span>
                            </xf:repeat>
                        </xh:li>
                    </xf:repeat>
                </fr:rows>

                <fr:card-footer>
                    <xh:span class="fr-card-footer-meta {'xforms-hidden'[empty($latest-modified-dt)]}">
                        <xf:output value="
                            if (empty($latest-modified-dt)) then
                                ''
                            else
                                let $v :=
                                    if (exists($tz)) then
                                        adjust-dateTime-to-timezone($latest-modified-dt, $tz)
                                    else
                                        adjust-dateTime-to-timezone($latest-modified-dt)
                                return
                                    if (current-dateTime() - $v lt xs:dayTimeDuration('P1D'))
                                    then format-dateTime($v, xxf:r('common.formats.within-day', '|fr-fr-resources|'), xxf:lang(), (), ())
                                    else if (year-from-dateTime(current-dateTime()) = year-from-dateTime($v))
                                    then format-dateTime($v, xxf:r('common.formats.day-this-year', '|fr-fr-resources|'), xxf:lang(), (), ())
                                    else format-dateTime($v, xxf:r('common.formats.short-date', '|fr-fr-resources|'), xxf:lang(), (), ())">
                            <xf:label ref="xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')"/>
                        </xf:output>
                    </xh:span>
                    <xh:a href="{$summary-href}" class="fr-card-show-more {'xforms-hidden'[not($show-more)]}">
                        <xh:span><xf:output value="xxf:r('landing.show-more', '|fr-fr-resources|')"/></xh:span>
                        <xh:i class="fa fa-arrow-right" aria-hidden="true"/>
                    </xh:a>
                </fr:card-footer>

            </fr:card>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
