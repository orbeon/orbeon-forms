<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <xbl:binding
        id="xf-range"
        element="xf|range"
        xxbl:mode="lhha binding value external-value focus javascript-lifecycle"
        xxbl:label-for="fr-range-elem"
    >

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Slider</display-name>
            <display-name lang="fr">Curseur</display-name>
            <display-name lang="no">Glidebryter</display-name>
            <display-name lang="ru">Ползунок</display-name>
            <display-name lang="it">Cursore</display-name>
            <display-name lang="de">Schieberegler</display-name>
            <display-name lang="fi">Liukusäädin</display-name>
            <display-name lang="es">Control deslizante</display-name>
            <display-name lang="nl">Schuifregelaar</display-name>
            <display-name lang="pt">Controlo deslizante</display-name>
            <display-name lang="sv">Skjutreglage</display-name>
            <display-name lang="ar">شريط التمرير</display-name>
            <display-name lang="pl">Suwak</display-name>
            <display-name lang="ja">スライダー</display-name>
            <icon>
                <icon-class>fa fa-fw fa-sliders</icon-class>
            </icon>
            <templates>
                <bind type="xf:decimal"/>
                <view>
                    <xf:range id="" ref="" xmlns="">
                        <xf:label  ref=""/>
                        <xf:hint   ref=""/>
                        <xf:help   ref=""/>
                        <xf:alert  ref=""/>
                    </xf:range>
                </view>
            </templates>
        </metadata>

        <xbl:template>
            <xh:input
                id="fr-range-elem"
                xh:type="range"
                xxf:control="true"
                xbl:attr="min=start max=end step=step tabindex tabindex=navindex"/>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
