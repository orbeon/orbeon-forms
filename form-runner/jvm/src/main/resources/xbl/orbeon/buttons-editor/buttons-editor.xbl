                            <visible-always>Always visible</visible-always>
                            <visible-hidden>Hidden</visible-hidden>
                            <visible-xpath>Formula (XPath)</visible-xpath>
                            <enabled-label>Enabled</enabled-label>
                            <enabled-default>Default</enabled-default>
                            <enabled-disabled>Disabled</enabled-disabled>
                            <enabled-xpath>Formula (XPath)</enabled-xpath>
                            <builtin-default-prefix>Built-in default:</builtin-default-prefix>
                            <builtin-always-enabled>Always enabled</builtin-always-enabled>
                            <insert-formula>Insert:</insert-formula>
                            <chip-wizard-last>Last wizard page</chip-wizard-last>
                            <chip-edit-mode>Edit mode</chip-edit-mode>
                            <chip-new-mode>New mode</chip-new-mode>
                            <chip-admin-role>User role</chip-admin-role>
                            <section-action>Action (Process) &amp; Loading</section-action>
