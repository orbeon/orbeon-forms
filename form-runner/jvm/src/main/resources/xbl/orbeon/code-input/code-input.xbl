<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:CodeInputSupport="java:org.orbeon.xbl.CodeInputSupportJava">

    <xbl:binding
        id="fr-code-input"
        element="fr|code-input"
        xxbl:mode="lhha binding value external-value focus javascript-lifecycle allow-minimal-label-hint"
        xxf:external-events="DOMActivate"
        xxbl:label-for="fr-code-input-elem"
        xxbl:type="xs:string"
        xxbl:constraint="
            CodeInputSupport:isValidCode(
                string(.),
                string(fr:component-param-value('mask')),
                string(fr:component-param-value('length')),
                string(fr:component-param-value('character-type'))
            )"
    >

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Code Input</display-name>
            <display-name lang="fr">Saisie de code</display-name>
            <display-name lang="no">Kodeinndata</display-name>
            <display-name lang="ru">Ввод кода</display-name>
            <display-name lang="it">Inserimento codice</display-name>
            <display-name lang="de">Code-Eingabe</display-name>
            <display-name lang="fi">Koodisyöttö</display-name>
            <display-name lang="es">Entrada de código</display-name>
            <display-name lang="nl">Code-invoer</display-name>
            <display-name lang="pt">Entrada de código</display-name>
            <display-name lang="sv">Kodinmatning</display-name>
            <display-name lang="ar">إدخال الرمز</display-name>
            <display-name lang="pl">Wprowadzanie kodu</display-name>
            <display-name lang="ja">コード入力</display-name>
            <icon>
                <icon-class>fa fa-fw fa-key</icon-class>
            </icon>
            <templates>
                <bind type="fr:code-input"/>
                <view>
                    <fr:code-input id="" ref="" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </fr:code-input>
                </view>
            </templates>
            <custom-settings>
                <setting name="mask" type="xs:string"/>
            </custom-settings>
            <control-details>
                <xf:model xmlns="" id="fb-editor-code-input-model">

                    <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
                        <xf:var name="c" value="."/>
                        <xf:setvalue
                            ref="$c"
                            value="instance()/@*[name() = name($c)]"/>
                    </xf:action>

                    <xf:instance id="local" xxf:exclude-result-prefixes="#all">
                        <_>
                            <mask/>
                        </_>
                    </xf:instance>

                    <xf:bind ref="instance('local')">
                        <xf:bind
                            ref="mask"
                            xxf:whitespace="trim"/>
                    </xf:bind>

                    <xf:instance id="fr-form-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                        <_>
                            <resource xml:lang="en">
                                <mask>Mask</mask>
                                <mask-hint>9 = digit, A/a = upper/lowercase letter, * = alphanumeric, H = hex; other characters are shown as separators (e.g. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="fr">
                                <mask>Masque</mask>
                                <mask-hint>9 = chiffre, A/a = lettre majuscule/minuscule, * = alphanumérique, H = hex ; les autres caractères sont affichés comme séparateurs (ex. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="no">
                                <mask>Maske</mask>
                                <mask-hint>9 = siffer, A/a = stor/liten bokstav, * = alfanumerisk, H = heks; andre tegn vises som skilletegn (f.eks. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="ru">
                                <mask>Маска</mask>
                                <mask-hint>9 = цифра, A/a = заглавная/строчная буква, * = буква или цифра, H = шестнадцатеричный; прочие символы отображаются как разделители (напр. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="it">
                                <mask>Maschera</mask>
                                <mask-hint>9 = cifra, A/a = lettera maiuscola/minuscola, * = alfanumerico, H = esadecimale; gli altri caratteri sono mostrati come separatori (es. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="de">
                                <mask>Maske</mask>
                                <mask-hint>9 = Ziffer, A/a = Groß-/Kleinbuchstabe, * = alphanumerisch, H = Hex; andere Zeichen werden als Trennzeichen angezeigt (z. B. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="fi">
                                <mask>Maski</mask>
                                <mask-hint>9 = numero, A/a = iso/pieni kirjain, * = aakkosnumeerinen, H = heksa; muut merkit näytetään erottimina (esim. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="es">
                                <mask>Máscara</mask>
                                <mask-hint>9 = dígito, A/a = letra mayúscula/minúscula, * = alfanumérico, H = hex; otros caracteres se muestran como separadores (p. ej. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="nl">
                                <mask>Masker</mask>
                                <mask-hint>9 = cijfer, A/a = hoofd-/kleine letter, * = alfanumeriek, H = hex; andere tekens worden getoond als scheidingstekens (bijv. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="pt">
                                <mask>Máscara</mask>
                                <mask-hint>9 = dígito, A/a = letra maiúscula/minúscula, * = alfanumérico, H = hex; outros caracteres são mostrados como separadores (ex. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="sv">
                                <mask>Mask</mask>
                                <mask-hint>9 = siffra, A/a = versal/gemen, * = alfanumerisk, H = hex; andra tecken visas som avgränsare (t.ex. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="ar">
                                <mask>القناع</mask>
                                <mask-hint>9 = رقم، A/a = حرف كبير/صغير، * = حرف أو رقم، H = ست عشري؛ تُعرض الأحرف الأخرى كفواصل (مثل 999999، 999-999، AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="pl">
                                <mask>Maska</mask>
                                <mask-hint>9 = cyfra, A/a = wielka/mała litera, * = alfanumeryczny, H = szesnastkowy; pozostałe znaki są wyświetlane jako separatory (np. 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                            <resource xml:lang="ja">
                                <mask>マスク</mask>
                                <mask-hint>9 = 数字、A/a = 大文字/小文字の英字、* = 英数字、H = 16進数。その他の文字は区切り文字として表示されます (例: 999999, 999-999, AA-9999)</mask-hint>
                            </resource>
                        </_>
                    </xf:instance>
                </xf:model>
                <fr:grid xmlns="" id="fb-editor-code-input-grid">
                    <xh:tr>
                        <xh:td colspan="6">
                            <xf:input ref="instance('local')/mask" id="mask-control" xxf:placeholder="999999">
                                <xf:label ref="xxf:r('mask')"/>
                                <xf:hint ref="xxf:r('mask-hint')"/>
                                <xf:alert/>
                            </xf:input>
                        </xh:td>
                    </xh:tr>
                </fr:grid>
                <xf:action
                    id="fb-editor-code-input-action"
                    event="xforms-value-changed"
                    observer="mask-control">

                    <xf:var name="name"      value="name(event('xxf:binding'))"/>
                    <xf:var name="new-value" value="string(event('xxf:binding'))"/>
                    <xf:insert
                        context="instance()"
                        if="xxf:non-blank($new-value)"
                        origin="xf:attribute($name, $new-value)"/>
                    <xf:delete
                        if="xxf:is-blank($new-value)"
                        ref="instance()/@*[name() = $name]"/>
                </xf:action>
            </control-details>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/code-input/code-input.css"/>
        </xbl:resources>

        <xbl:template>
            <xf:var name="binding"        value="xxf:binding('fr-code-input')"/>
            <xf:var name="raw-mask"       value="string(fr:component-param-value('mask'))"/>
            <xf:var name="raw-length"     value="string(fr:component-param-value('length'))"/>
            <xf:var name="raw-char-type"  value="string(fr:component-param-value('character-type'))"/>
            <xf:var name="effective-mask" value="CodeInputSupport:effectiveMask($raw-mask, $raw-length, $raw-char-type)"/>
            <xf:var name="token-count"    value="CodeInputSupport:tokenCount($raw-mask, $raw-length, $raw-char-type)"/>
            <xf:var
                name="view"
                value="
                    xxf:is-control-static-readonly('fr-code-input') or
                    fr:mode() = 'pdf'
                "/>

            <xf:group
                id="fr-code-input-elem"
                ref="$binding"
                class="fr-code-input-container"
                data-fr-mask="{$effective-mask}"
                data-fr-label="{xxf:label('fr-code-input')}">

                <!-- Interactive segmented boxes managed by FrCodeInputCompanion -->
                <xh:div class="fr-code-input-boxes{' xforms-hidden'[$view]}"/>

                <!-- Static-readonly / Automatic PDF segmented boxes and literal separators -->
                <xh:div class="fr-code-input-static-boxes{' xforms-hidden'[not($view)]}"><xf:repeat ref="(1 to $token-count)[$view]"><xh:span class="{if (CodeInputSupport:isSlotToken($raw-mask, $raw-length, $raw-char-type, .)) then 'fr-code-input-cell' else 'fr-code-input-separator'}"><xf:output value="CodeInputSupport:tokenValueAt(string($binding), $raw-mask, $raw-length, $raw-char-type, .)"/></xh:span></xf:repeat></xh:div>
            </xf:group>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>
