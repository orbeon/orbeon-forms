<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:peu="java:org.orbeon.oxf.fr.process.ProcessEditorUI"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

    <xbl:binding
        id="fr-dialog-process-editor"
        element="fr|dialog-process-editor"
        xxf:external-events="fr-move-process-step">

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/process-editor/process-editor.css"/>
        </xbl:resources>

        <xbl:handlers>

            <!-- Handler to open dialog -->
            <xbl:handler event="fr-show-dialog xxforms-dialog-open" phase="target">

                <xf:setvalue ref="instance('ui-instance')/mode"           value="(event('mode')[xxf:non-blank()], 'multi')[1]"/>
                <xf:setvalue ref="instance('ui-instance')/name-readonly"  value="(event('name-readonly')[xxf:non-blank()], 'false')[1]"/>
                <xf:setvalue ref="instance('ui-instance')/existing-names" value="(event('existing-names'), '')[1]"/>
                <xf:setvalue ref="instance('ui-instance')/title"          value="(event('title'), '')[1]"/>

                <xf:insert
                    ref="instance()"
                    origin="peu:deserializeProcesses((event('config'), instance('empty-processes-instance'))[1])"/>

                <xf:insert
                    ref="instance('form-context-instance')"
                    origin="(event('form-context'), instance('empty-form-context-instance'))[1]"/>

                <xf:rebuild/>
                <xf:recalculate/>
                <xxf:setvisited control="dialog" visited="false" recurse="true"/>
                <xxf:show dialog="dialog"/>
                <xf:setfocus if="instance('ui-instance')/name-readonly != 'true'" control="fr-process-name"/>
            </xbl:handler>

            <!-- Save and close if valid -->
            <xbl:handler event="DOMActivate" observer="fr-save-trigger" if="instance('validity-instance') = 'true' and valid(instance())">
                <xf:dispatch name="fr-update" targetid="fr-dialog-process-editor">
                    <xf:property name="config" value="peu:serializeProcesses(instance())"/>
                </xf:dispatch>
                <xxf:hide dialog="dialog"/>
            </xbl:handler>

            <xbl:handler event="DOMActivate" observer="fr-save-trigger" if="not(instance('validity-instance') = 'true' and valid(instance()))">
                <xxf:setvisited control="dialog" recurse="true"/>
            </xbl:handler>

            <xbl:handler event="fr-move-process-step" phase="target">
                <xf:var name="process"     value="instance()/process[xs:integer(event('process-index'))]"/>
                <xf:var name="all-rows"    value="$process//*[self::step or self::else]"/>
                <xf:var name="source-step" value="$all-rows[xs:integer(event('source-index'))][self::step]"/>
                <xf:var name="into-row"    value="if (xxf:non-blank(event('into-index'))) then $all-rows[xs:integer(event('into-index'))] else ()"/>
                <xf:var name="dest-parent" value="
                    if (empty($into-row)) then
                        $process
                    else if ($into-row/self::step[@type = 'condition']) then
                        $into-row/then
                    else if ($into-row/self::step[@type = 'group'] or $into-row/self::else) then
                        $into-row
                    else
                        ()
                "/>
                <xf:var name="after-step"  value="if (xxf:non-blank(event('after-index'))) then $all-rows[xs:integer(event('after-index'))][self::step] else ()"/>
                <xf:var name="is-noop"     value="
                    if (empty($after-step)) then
                        $dest-parent/step[1] is $source-step
                    else
                        $after-step/following-sibling::step[1] is $source-step
                "/>

                <xf:action if="
                    exists($source-step) and
                    count($source-step/../step) gt 1 and
                    exists($dest-parent) and
                    empty($dest-parent/ancestor-or-self::* intersect $source-step) and
                    (empty($after-step) or (($after-step/.. is $dest-parent) and not($after-step is $source-step))) and
                    not($is-noop)
                ">
                    <xf:insert
                        if="exists($after-step)"
                        ref="$after-step"
                        position="after"
                        origin="$source-step"/>
                    <xf:insert
                        if="empty($after-step) and exists($dest-parent/step)"
                        ref="$dest-parent/step[1]"
                        position="before"
                        origin="$source-step"/>
                    <xf:insert
                        if="empty($after-step) and empty($dest-parent/step)"
                        context="$dest-parent"
                        origin="$source-step"/>

                    <xf:delete ref="$source-step"/>

                    <xf:setvalue
                        iterate="$process//step[empty(preceding-sibling::step) and @combinator != 'then']"
                        ref="@combinator"
                        value="'then'"/>
                </xf:action>
            </xbl:handler>

        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="model">

                <xf:instance id="_" xxf:exclude-result-prefixes="#all">
                    <processes/>
                </xf:instance>

                <xf:instance id="ui-instance" xxf:exclude-result-prefixes="#all">
                    <ui>
                        <mode>multi</mode>
                        <name-readonly>false</name-readonly>
                        <existing-names/>
                        <title/>
                    </ui>
                </xf:instance>

                <xf:instance id="empty-processes-instance" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <processes/>
                </xf:instance>

                <xf:instance id="actions-instance" xxf:readonly="false" xxf:exclude-result-prefixes="#all">
                    <actions/>
                </xf:instance>

                <xf:instance id="empty-form-context-instance" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <form-context>
                        <controls/>
                        <sections/>
                        <email-templates/>
                        <pdf-templates/>
                        <custom-modes/>
                        <processes/>
                    </form-context>
                </xf:instance>

                <xf:instance id="form-context-instance" xxf:readonly="false" xxf:exclude-result-prefixes="#all">
                    <form-context>
                        <controls/>
                        <sections/>
                        <email-templates/>
                        <pdf-templates/>
                        <custom-modes/>
                        <processes/>
                    </form-context>
                </xf:instance>

                <xf:instance id="process-template" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <process name="" _view-mode="visual">
                        <_text/>
                        <step type="action" combinator="then" name="" _add-param=""/>
                    </process>
                </xf:instance>

                <xf:instance id="validity-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="orbeon-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <_>
                        <resource xml:lang="en">
                            <label>Process Editor</label>
                            <apply>Apply</apply>
                            <cancel>Cancel</cancel>
                            <or>or</or>
                            <process-name>
                                <label>Process name</label>
                                <hint>Unique name identifying this process (e.g. save-final)</hint>
                                <alert>A valid and unique process name is required</alert>
                            </process-name>
                            <process-definition>
                                <label>Process definition</label>
                                <hint>Actions separated by combinators, e.g. validate then save</hint>
                                <alert>Process syntax is invalid</alert>
                            </process-definition>
                            <delete-process>Delete Process</delete-process>
                            <new-process>New Process</new-process>
                            <no-steps>No steps defined for this process.</no-steps>
                            <add-step>Add Step</add-step>
                            <select-action>Select an action…</select-action>
                            <visual-editor>Visual</visual-editor>
                            <text-editor>Text</text-editor>
                            <format>Format</format>
                            <copy>Copy</copy>
                            <add-parameter>+ Parameter</add-parameter>
                            <custom-parameter>Custom parameter…</custom-parameter>
                            <remove-parameter>Remove parameter</remove-parameter>
                            <avt-toggle>Toggle dynamic value template ({…})</avt-toggle>
                            <categories>
                                <form-runner>Form Runner Actions</form-runner>
                                <sub-process>Built-in Sub-processes</sub-process>
                                <flow-control>Flow Control</flow-control>
                                <xforms>XForms Actions</xforms>
                                <form-processes>Custom Processes</form-processes>
                            </categories>
                            <alerts>
                                <required>Value is required</required>
                                <action-required>An action is required</action-required>
                                <invalid-xpath>Incorrect XPath expression</invalid-xpath>
                                <invalid-avt>Incorrect XPath value template</invalid-avt>
                                <invalid-boolean>Must be "true", "false", or an AVT expression</invalid-boolean>
                                <invalid-choice>Invalid parameter value</invalid-choice>
                                <invalid-token>Contains an unsupported value</invalid-token>
                                <invalid-duration>Must be a valid duration with unit (e.g. 1000ms or 5s)</invalid-duration>
                                <invalid-at>Must be "start", "end", "all", or a positive integer</invalid-at>
                                <invalid-mode>Unsupported target mode</invalid-mode>
                                <invalid-ncname>Must be a valid XML identifier</invalid-ncname>
                                <unknown-control>Unknown control name</unknown-control>
                                <unknown-section>Unknown section name</unknown-section>
                                <unknown-process>Unknown sub-process name</unknown-process>
                                <self-process>A process cannot call itself</self-process>
                                <unknown-param>Unsupported parameter for this action</unknown-param>
                                <invalid-param-name>A unique, valid parameter name is required</invalid-param-name>
                            </alerts>
                        </resource>
                        <resource xml:lang="fr">
                            <label>Éditeur de processus</label>
                            <apply>Appliquer</apply>
                            <cancel>Annuler</cancel>
                            <or>ou</or>
                            <process-name>
                                <label>Nom du processus</label>
                                <hint>Nom unique identifiant ce processus (ex: save-final)</hint>
                                <alert>Un nom de processus valide et unique est requis</alert>
                            </process-name>
                            <process-definition>
                                <label>Définition du processus</label>
                                <hint>Actions séparées par des combinateurs, ex: validate then save</hint>
                                <alert>La syntaxe du processus est invalide</alert>
                            </process-definition>
                            <delete-process>Supprimer le processus</delete-process>
