<grammar datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"
  xmlns="http://relaxng.org/ns/structure/1.0">

  <start>
    <choice>
      <ref name="publicKeyElement"/>
      <element name="public-keys">
        <oneOrMore>
          <ref name="publicKeyElement"/>
        </oneOrMore>
      </element>
    </choice>
  </start>

  <define name="publicKeyElement">
    <element name="public-key">
      <optional>
        <attribute name="algorithm"/>
      </optional>
      <data type="base64Binary"/>
    </element>
  </define>

</grammar>
