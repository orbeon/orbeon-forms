                            <process-revert-btn>還原流程</process-revert-btn>
                            <process-delete-btn>刪除流程</process-delete-btn>
                            <loading-label>載入指示器</loading-label>
                            <loading-default>預設 ({0})</loading-default>
                            <loading-none>無 (僅頂部進度列)</loading-none>
                            <loading-inline>按鈕內的內嵌載入圖示</loading-inline>
                            <loading-modal>阻擋輸入的強制回應遮罩層</loading-modal>
                            <loading-short-none>無</loading-short-none>
                            <loading-short-inline>內嵌</loading-short-inline>
                            <loading-short-modal>強制回應</loading-short-modal>
                            <close-uri-label>關閉時重新導向 URI</close-uri-label>
                            <close-uri-hint>預設 close 流程導向的選填目標 URI（oxf.fr.detail.close.uri）</close-uri-hint>
                            <apply>套用</apply>
                            <cancel>取消</cancel>
                            <alert-slug>請輸入有效且唯一的按鈕名稱（字母、數字、連字號、底線）</alert-slug>
                            <alert-xpath>請輸入有效的 XPath 2.0 運算式</alert-xpath>
                        </resource>
                    </_>
                </xf:instance>

                <xf:action event="xforms-model-construct-done">
                    <xf:insert
                        ref="instance('catalog')"
                        origin="beu:standardDetailButtonsCatalogXml()"/>
                    <xf:setvalue ref="instance('state')/@initialized" value="'true'"/>
                </xf:action>

                <xf:var name="i"   value="instance('i')"/>
                <xf:var name="dlg" value="instance('dialog')"/>

                <!-- Mirrored <detail-buttons> binds -->
                <xf:bind ref="$i">
                    <xf:bind ref="@close-uri-override" type="xs:boolean"/>
                    <xf:bind ref="bar/@override"       type="xs:boolean"/>
                    <xf:bind ref="button">
                        <xf:bind ref="@visible-override | @enabled-override | @loading-override" type="xs:boolean"/>
                        <xf:bind
                            ref="@visible[string(../@visible-override) = 'true']"
                            required="true()"
                            type="xxf:XPath2"
                            xxf:whitespace="trim"/>
                        <xf:bind
                            ref="@enabled[string(../@enabled-override) = 'true']"
                            required="true()"
                            type="xxf:XPath2"
                            xxf:whitespace="trim"/>
                    </xf:bind>
                </xf:bind>

                <!-- Dialog form validation binds -->
                <xf:bind ref="$dlg/parts/part">
                    <xf:bind
                        ref="@name"
                        xxf:whitespace="trim"
                        readonly="string(../@is-standard) = 'true'"
                        required="string($dlg/@open) = 'true'"
                        constraint="
                            string($dlg/@open) != 'true' or (
                                beu:isValidButtonName(.) and
                                not((../../part/@name except .) = .)
                            )"/>
                    <xf:bind
                        ref="@visible-xpath"
                        relevant="../@visible-mode = 'xpath'"
                        required="string($dlg/@open) = 'true' and ../@visible-mode = 'xpath'"
                        type="xxf:XPath2"
                        xxf:whitespace="trim"/>
                    <xf:bind
                        ref="@enabled-xpath"
                        relevant="../@enabled-mode = 'xpath'"
                        required="string($dlg/@open) = 'true' and ../@enabled-mode = 'xpath'"
                        type="xxf:XPath2"
                        xxf:whitespace="trim"/>
                    <xf:bind ref="@close-uri-override" type="xs:boolean"/>
                    <xf:bind
                        ref="@close-uri"
                        readonly="string(../@close-uri-override) != 'true'"
                        xxf:whitespace="trim"/>
                </xf:bind>

                <xf:bind ref="$dlg/templates/(descendant-or-self::* | descendant-or-self::*/@*)" readonly="true()"/>

                <!-- Sync reorder/insert/delete on instance('bar-items') back to the active <bar> -->
                <xf:action
                    observer="bar-items"
                    event="xforms-insert xforms-delete xxforms-replace"
                    if="instance('state')/@initialized = 'true' and instance('state')/@syncing != 'true' and instance('state')/@readonly != 'true'">
                    <xf:var name="cur-bar-name" value="string(instance('state')/@active-bar)"/>
                    <xf:var name="cur-bar"      value="$i/bar[@name = $cur-bar-name]"/>
                    <xf:action if="exists($cur-bar)">
                        <xf:var name="serialized" value="beu:serializeBarItems(instance('bar-items'))"/>
                        <xf:setvalue ref="$cur-bar/@override" value="'true'"/>
                        <xf:setvalue ref="$cur-bar/@value"    value="$serialized"/>
                        <xf:setvalue ref="instance('state')/@last-bar-sig" value="concat($cur-bar-name, '|true|', $serialized)"/>
                    </xf:action>
                </xf:action>

            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:group id="fr-be-root" appearance="xxf:internal">

                <!-- Outer host parameters -->
                <xf:var name="binding"             as="element()?"   value="xxf:binding('fr-buttons-editor')"/>
                <xf:var name="resources-node"      as="element()?"  ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=resources-ref"/></xf:var>
                <xf:var name="processes-node"      as="element()?"  ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=processes-ref"/></xf:var>
                <xf:var name="inherited-processes" as="element()*"  ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=inherited-processes-ref"/></xf:var>
                <xf:var name="inherited-resources" as="element()*"  ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=inherited-resources-ref"/></xf:var>
                <xf:var name="inherited-edit"      as="xs:string?"  ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=inherited-edit-ref"/></xf:var>
                <xf:var name="inherited-view"      as="xs:string?"  ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=inherited-view-ref"/></xf:var>
                <xf:var name="inherited-inner"     as="xs:string?"  ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=inherited-inner-ref"/></xf:var>
                <xf:var name="languages"           as="xs:string*"  ><xxf:value value="('en')"  xxbl:scope="outer" xbl:attr="model context value=languages-ref"/></xf:var>
                <xf:var name="allow-wildcard-lang" as="xs:string?"  ><xxf:value value="'true'"  xxbl:scope="outer" xbl:attr="model context value=allow-wildcard-lang"/></xf:var>
                <xf:var name="host-app"            as="xs:string?"  ><xxf:value value="'*'"     xxbl:scope="outer" xbl:attr="model context value=app-ref"/></xf:var>
                <xf:var name="host-form"           as="xs:string?"  ><xxf:value value="'*'"     xxbl:scope="outer" xbl:attr="model context value=form-ref"/></xf:var>
                <xf:var name="valid-ref"           as="item()?"     ><xxf:value value="()"      xxbl:scope="outer" xbl:attr="model context value=valid-ref"/></xf:var>

                <xf:var name="i"                   value="instance('i')"/>
                <xf:var name="dlg"                 value="instance('dialog')"/>
                <xf:var name="catalog-buttons"     value="instance('catalog')/buttons/button"/>
                <xf:var name="selectable-buttons"  value="$catalog-buttons[@legacy != 'true']"/>
                <xf:var name="catalog-icons"       value="instance('catalog')/icons/icon"/>
                <xf:var name="eff-app"             value="(string($host-app)[xxf:non-blank()], '*')[1]"/>
                <xf:var name="eff-form"            value="(string($host-form)[xxf:non-blank()], '*')[1]"/>
                <xf:var name="concrete-langs"      value="let $ls := $languages[. != '*'][xxf:non-blank()] return if (exists($ls)) then $ls else ('en')"/>
                <xf:var name="can-wildcard-lang"   value="string($allow-wildcard-lang) != 'false'"/>
                <xf:var name="has-resources-edit"  value="exists($resources-node)"/>
                <xf:var name="ui-lang"             value="(xxf:instance('fr-language-instance')[xxf:non-blank()], xxf:lang()[xxf:non-blank()], 'en')[1]"/>

                <!-- Sync validity to outer valid-ref if provided -->
                <xf:var name="is-valid" value="valid($i)">
                    <xf:setvalue
                        event="xforms-enabled xforms-value-changed"
                        if="exists($valid-ref)"
                        ref="$valid-ref"
                        value="string($is-valid)"/>
                </xf:var>

                <!-- Sync readonly state -->
                <xf:var
                    name="is-readonly"
                    value="fr:is-readonly-mode() or (exists($binding) and xxf:readonly($binding))">
                    <xf:setvalue
                        event="xforms-enabled xforms-value-changed"
                        ref="instance('state')/@readonly"
                        value="string($is-readonly)"/>
                </xf:var>

                <!-- Resolve active bar & effective bar string -->
                <xf:var name="active-bar-name" value="(string(instance('state')/@active-bar)[. = ('edit', 'view', 'inner')], 'edit')[1]"/>
                <xf:var name="active-bar"      value="$i/bar[@name = $active-bar-name]"/>
                <xf:var
                    name="inherited-bar-value"
                    value="
                        if ($active-bar-name = 'view') then
                            if (exists($inherited-view)) then string($inherited-view) else string(instance('catalog')/@default-view)
                        else if ($active-bar-name = 'inner') then
                            if (exists($inherited-inner)) then string($inherited-inner) else string(instance('catalog')/@default-inner)
                        else
                            if (exists($inherited-edit)) then string($inherited-edit) else string(instance('catalog')/@default-edit)
                    "/>
                <xf:var name="is-bar-overridden"   value="string($active-bar/@override) = 'true'"/>
                <xf:var name="effective-bar-value" value="if ($is-bar-overridden) then string($active-bar/@value) else $inherited-bar-value"/>
                <xf:var name="bar-sig"             value="concat($active-bar-name, '|', $is-bar-overridden, '|', $effective-bar-value)">
                    <xf:action
                        event="xforms-enabled xforms-value-changed"
                        if="$bar-sig != string(instance('state')/@last-bar-sig)">
                        <xf:setvalue ref="instance('state')/@syncing"      value="'true'"/>
                        <xf:setvalue ref="instance('state')/@last-bar-sig" value="$bar-sig"/>
                        <xf:insert
                            ref="instance('bar-items')"
                            origin="beu:parseBarTokensXml($effective-bar-value)"/>
                        <xf:setvalue ref="instance('state')/@syncing"      value="'false'"/>
                    </xf:action>
                </xf:var>

                <xf:var name="bar-items"           value="instance('bar-items')/item"/>
                <xf:var name="bar-item-count"      value="count($bar-items)"/>
                <xf:var name="active-bar-part-names" value="distinct-values($bar-items/part/@name/string())"/>
                <xf:var
                    name="extra-rule-buttons"
                    value="
                        $i/button[
                            (@visible-override = 'true' or @enabled-override = 'true' or @loading-override = 'true') and
                            not(@name = $active-bar-part-names)
                        ]"/>

                <!-- Known custom process names not yet placed in the active bar -->
                <xf:var
                    name="builtin-proc-names"
                    value="frf:builtinDetailProcessNames()"/>
                <xf:var
                    name="unplaced-custom-processes"
                    value="
                        distinct-values((
                            $processes-node/process/@name/string(),
                            $inherited-processes/@name/string()
                        )[
                            xxf:non-blank() and
                            not(. = $builtin-proc-names) and
                            not(. = $catalog-buttons/@name) and
                            not(. = $active-bar-part-names)
                        ])"/>

                <!-- ======================================================================= -->
                <!-- Reusable Internal Actions for Populating & Saving the Button Dialog     -->
                <!-- ======================================================================= -->

                <!-- Populate the last <part> in $dlg/parts from model state for event('part-name') -->
                <xf:action event="fr-be-init-last-part" target="fr-be-root">
                    <xf:var name="p"            value="$dlg/parts/part[last()]"/>
                    <xf:var name="pname"        value="xxf:trim(string(event('part-name')))"/>
                    <xf:var name="std-meta"     value="$catalog-buttons[@name = $pname][1]"/>
                    <xf:var name="is-std"       value="exists($std-meta)"/>
                    <xf:var name="rule"         value="$i/button[@name = $pname][1]"/>
                    <xf:var name="res-key"      value="concat('buttons.', $pname)"/>
                    <xf:var name="scope-msgs"   value="$resources-node/message[@name = $res-key]"/>
                    <xf:var name="wild-msg"     value="$scope-msgs[@xml:lang = '*'][1]"/>
                    <xf:var name="lang-msgs"    value="$scope-msgs[@xml:lang != '*']"/>

                    <xf:setvalue ref="$p/@original-name" value="$pname"/>
                    <xf:setvalue ref="$p/@name"          value="$pname"/>
                    <xf:setvalue ref="$p/@is-standard"   value="string($is-std)"/>

                    <!-- Initialize per-language translation slots -->
                    <xf:delete ref="$p/translations/*"/>
                    <xf:action iterate="$concrete-langs">
                        <xf:var name="lc"  value="string(.)"/>
                        <xf:var name="msg" value="$lang-msgs[@xml:lang = $lc][1]"/>
                        <xf:var
                            name="parsed"
                            value="
                                if (exists($msg)) then
                                    beu:parseButtonLabelXml(string($msg), string($msg/@html) = 'true')
                                else
                                    ()"/>
                        <xf:insert
                            context="$p/translations"
                            ref="*"
                            origin="$dlg/templates/translation"/>
                        <xf:setvalue ref="$p/translations/*[last()]/@lang" value="$lc"/>
                        <xf:setvalue
                            ref="$p/translations/*[last()]"
                            value="if (exists($parsed)) then string($parsed) else ''"/>
                    </xf:action>

                    <!-- Determine label-mode, icon, single-text, raw-html -->
                    <xf:action if="exists($wild-msg)">
                        <xf:var name="parsed-wild" value="beu:parseButtonLabelXml(string($wild-msg), string($wild-msg/@html) = 'true')"/>
                        <xf:action if="$parsed-wild/@mode = 'raw-html'">
                            <xf:setvalue ref="$p/@label-mode"  value="'raw-html'"/>
                            <xf:setvalue ref="$p/@icon"        value="string($std-meta/@default-icon)"/>
                            <xf:setvalue ref="$p/@single-text" value="''"/>
                            <xf:setvalue ref="$p/@raw-html"    value="string($wild-msg)"/>
                        </xf:action>
                        <xf:action if="$parsed-wild/@mode != 'raw-html'">
                            <xf:setvalue ref="$p/@label-mode"  value="'single'"/>
                            <xf:setvalue ref="$p/@icon"        value="string($parsed-wild/@icon)"/>
                            <xf:setvalue ref="$p/@single-text" value="string($parsed-wild)"/>
                            <xf:setvalue ref="$p/@raw-html"    value="string($wild-msg)"/>
                        </xf:action>
                    </xf:action>
                    <xf:action if="empty($wild-msg) and exists($lang-msgs)">
                        <xf:var name="first-msg"    value="$lang-msgs[1]"/>
                        <xf:var name="parsed-first" value="beu:parseButtonLabelXml(string($first-msg), string($first-msg/@html) = 'true')"/>
                        <xf:action if="$parsed-first/@mode = 'raw-html'">
                            <xf:setvalue ref="$p/@label-mode"  value="'raw-html'"/>
                            <xf:setvalue ref="$p/@icon"        value="string($std-meta/@default-icon)"/>
                            <xf:setvalue ref="$p/@single-text" value="''"/>
                            <xf:setvalue ref="$p/@raw-html"    value="string($first-msg)"/>
                        </xf:action>
                        <xf:action if="$parsed-first/@mode != 'raw-html'">
                            <xf:setvalue ref="$p/@label-mode"  value="'localized'"/>
                            <xf:setvalue ref="$p/@icon"        value="string($parsed-first/@icon)"/>
                            <xf:setvalue ref="$p/@single-text" value="string($parsed-first)"/>
                            <xf:setvalue ref="$p/@raw-html"    value="string($first-msg)"/>
                        </xf:action>
                    </xf:action>
                    <xf:action if="empty($scope-msgs)">
                        <xf:setvalue
                            ref="$p/@label-mode"
                            value="
                                if ($is-std or xxf:is-blank($pname) or not($has-resources-edit)) then
                                    if (xxf:is-blank($pname) and $has-resources-edit) then
                                        (if ($can-wildcard-lang) then 'single' else 'localized')
                                    else
                                        'default'
                                else
                                    'default'"/>
                        <xf:setvalue ref="$p/@icon"        value="if ($is-std) then string($std-meta/@default-icon) else ''"/>
                        <xf:setvalue ref="$p/@single-text" value="''"/>
                        <xf:setvalue ref="$p/@raw-html"    value="''"/>
                    </xf:action>

                    <!-- Visibility -->
                    <xf:var name="vis-ov"  value="string($rule/@visible-override) = 'true'"/>
                    <xf:var name="vis-val" value="xxf:trim(string($rule/@visible))"/>
                    <xf:setvalue
                        ref="$p/@visible-mode"
                        value="
                            if (not($vis-ov)) then 'default'
                            else if ($vis-val = ('true()', 'true')) then 'always'
                            else if ($vis-val = ('false()', 'false')) then 'hidden'
                            else 'xpath'"/>
                    <xf:setvalue
                        ref="$p/@visible-xpath"
                        value="if ($vis-ov and not($vis-val = ('true()', 'true', 'false()', 'false'))) then $vis-val else ''"/>

                    <!-- Enabled -->
                    <xf:var name="en-ov"  value="string($rule/@enabled-override) = 'true'"/>
                    <xf:var name="en-val" value="xxf:trim(string($rule/@enabled))"/>
                    <xf:setvalue
                        ref="$p/@enabled-mode"
                        value="
                            if (not($en-ov)) then 'default'
                            else if ($en-val = ('false()', 'false')) then 'disabled'
                            else 'xpath'"/>
                    <xf:setvalue
                        ref="$p/@enabled-xpath"
                        value="if ($en-ov and not($en-val = ('false()', 'false'))) then $en-val else ''"/>

                    <!-- Loading indicator -->
                    <xf:var name="ld-ov"  value="string($rule/@loading-override) = 'true'"/>
                    <xf:var name="ld-val" value="xxf:trim(string($rule/@loading-indicator))"/>
                    <xf:setvalue
                        ref="$p/@loading-mode"
                        value="
                            if (not($ld-ov)) then 'default'
                            else if ($ld-val = 'inline') then 'inline'
                            else if ($ld-val = 'modal') then 'modal'
                            else 'none'"/>

                    <!-- Close redirect URI -->
                    <xf:setvalue ref="$p/@close-uri-override" value="string(string($i/@close-uri-override) = 'true')"/>
                    <xf:setvalue ref="$p/@close-uri"          value="string($i/@close-uri)"/>
                </xf:action>

                <!-- Open dialog by button name (either in active bar or as rule-only / add-to-bar) -->
                <xf:action event="fr-be-open-by-name" target="fr-be-root">
                    <xf:var name="target-name" value="xxf:trim(string(event('name')))"/>
                    <xf:var name="add-to-bar"  value="string(event('add-to-bar')) = 'true'"/>
                    <xf:var name="match-idx"   value="(for $idx in 1 to count($bar-items) return if ($bar-items[$idx]/part/@name = $target-name) then $idx else ())[1]"/>
                    <xf:action if="exists($match-idx)">
                        <xf:var name="matched-item" value="$bar-items[$match-idx]"/>
                        <xf:var name="sub-idx"      value="(for $pi in 1 to count($matched-item/part) return if ($matched-item/part[$pi]/@name = $target-name) then $pi else ())[1]"/>
                        <xf:delete ref="$dlg/parts/*"/>
                        <xf:action iterate="$matched-item/part">
                            <xf:var name="pn" value="string(@name)"/>
                            <xf:insert context="$dlg/parts" ref="*" origin="$dlg/templates/part"/>
                            <xf:dispatch name="fr-be-init-last-part" targetid="fr-be-root">
                                <xf:property name="part-name" value="$pn"/>
                            </xf:dispatch>
                        </xf:action>
                        <xf:setvalue ref="$dlg/@mode"              value="'edit-bar-item'"/>
                        <xf:setvalue ref="$dlg/@bar-index"         value="$match-idx"/>
                        <xf:setvalue ref="$dlg/@active-part-index" value="($sub-idx, 1)[1]"/>
                        <xf:setvalue ref="$dlg/@show-errors"       value="'false'"/>
                        <xf:setvalue ref="$dlg/@open"              value="'true'"/>
                        <xxf:show dialog="fr-button-config-dialog"/>
                    </xf:action>
                    <xf:action if="empty($match-idx)">
                        <xf:delete ref="$dlg/parts/*"/>
                        <xf:insert context="$dlg/parts" ref="*" origin="$dlg/templates/part"/>
                        <xf:dispatch name="fr-be-init-last-part" targetid="fr-be-root">
                            <xf:property name="part-name" value="$target-name"/>
                        </xf:dispatch>
                        <xf:setvalue ref="$dlg/@mode"              value="if ($add-to-bar) then 'add-custom' else 'edit-rule-only'"/>
                        <xf:setvalue ref="$dlg/@bar-index"         value="'0'"/>
                        <xf:setvalue ref="$dlg/@active-part-index" value="'1'"/>
                        <xf:setvalue ref="$dlg/@show-errors"       value="'false'"/>
                        <xf:setvalue ref="$dlg/@open"              value="'true'"/>
                        <xxf:show dialog="fr-button-config-dialog"/>
                    </xf:action>
                </xf:action>

                <!-- Persist all <part> edits from $dlg/parts back to $i, $resources-node, $processes-node, and bar-items -->
                <xf:action event="fr-be-commit-dialog" target="fr-be-root">
                    <xf:var name="close-after" value="string(event('close-after')) != 'false'"/>

                    <xf:action iterate="$dlg/parts/part">
                        <xf:var name="p"        value="."/>
                        <xf:var name="old-name" value="xxf:trim(string($p/@original-name))"/>
                        <xf:var name="new-name" value="xxf:trim(string($p/@name))"/>
                        <xf:var name="renamed"  value="xxf:non-blank($old-name) and $old-name != $new-name"/>

                        <!-- 1. Coordinated rename across overridden bars, rules, resources, and processes in this scope -->
                        <xf:action if="$renamed">
                            <xf:action iterate="$i/bar[@override = 'true']">
                                <xf:setvalue ref="@value" value="beu:renameButtonInBarValue(string(@value), $old-name, $new-name)"/>
                            </xf:action>
                            <xf:action if="exists($i/button[@name = $old-name]) and empty($i/button[@name = $new-name])">
                                <xf:setvalue ref="$i/button[@name = $old-name]/@name" value="$new-name"/>
                            </xf:action>
                            <xf:delete if="exists($i/button[@name = $old-name])" ref="$i/button[@name = $old-name]"/>

                            <xf:action if="exists($resources-node)">
                                <xf:action iterate="$resources-node/message[@name = concat('buttons.', $old-name)]">
                                    <xf:setvalue ref="@name" value="concat('buttons.', $new-name)"/>
                                </xf:action>
                            </xf:action>

                            <xf:action if="exists($processes-node) and exists($processes-node/process[@name = $old-name]) and empty($processes-node/process[@name = $new-name])">
                                <xf:setvalue ref="$processes-node/process[@name = $old-name]/@name" value="$new-name"/>
                            </xf:action>
                        </xf:action>

                        <xf:setvalue ref="$p/@original-name" value="$new-name"/>

                        <!-- 2. Persist per-button rules (<button name="..."/>) in $i -->
                        <xf:var name="vis-ov"  value="$p/@visible-mode != 'default'"/>
                        <xf:var
                            name="vis-val"
                            value="
                                if ($p/@visible-mode = 'always') then 'true()'
                                else if ($p/@visible-mode = 'hidden') then 'false()'
                                else if ($p/@visible-mode = 'xpath') then xxf:trim(string($p/@visible-xpath))
                                else ''"/>
                        <xf:var name="en-ov"   value="$p/@enabled-mode != 'default'"/>
                        <xf:var
                            name="en-val"
                            value="
                                if ($p/@enabled-mode = 'disabled') then 'false()'
                                else if ($p/@enabled-mode = 'xpath') then xxf:trim(string($p/@enabled-xpath))
                                else ''"/>
                        <xf:var name="ld-ov"   value="$p/@loading-mode != 'default'"/>
                        <xf:var
                            name="ld-val"
                            value="
                                if ($p/@loading-mode = 'inline') then 'inline'
                                else if ($p/@loading-mode = 'modal') then 'modal'
                                else ''"/>

                        <xf:action if="not($vis-ov) and not($en-ov) and not($ld-ov)">
                            <xf:delete ref="$i/button[@name = $new-name]"/>
                        </xf:action>
                        <xf:action if="$vis-ov or $en-ov or $ld-ov">
                            <xf:insert
                                if="empty($i/button[@name = $new-name])"
                                context="$i"
                                ref="*"
                                origin="
                                    xf:element(
                                        'button',
                                        (
                                            xf:attribute('name', $new-name),
                                            xf:attribute('visible-override', 'false'),
                                            xf:attribute('visible', ''),
                                            xf:attribute('enabled-override', 'false'),
                                            xf:attribute('enabled', ''),
                                            xf:attribute('loading-override', 'false'),
                                            xf:attribute('loading-indicator', '')
                                        )
                                    )"/>
                            <xf:var name="target-rule" value="$i/button[@name = $new-name][1]"/>
                            <xf:setvalue ref="$target-rule/@visible-override"  value="string($vis-ov)"/>
                            <xf:setvalue ref="$target-rule/@visible"           value="$vis-val"/>
                            <xf:setvalue ref="$target-rule/@enabled-override"  value="string($en-ov)"/>
                            <xf:setvalue ref="$target-rule/@enabled"           value="$en-val"/>
                            <xf:setvalue ref="$target-rule/@loading-override"  value="string($ld-ov)"/>
                            <xf:setvalue ref="$target-rule/@loading-indicator" value="$ld-val"/>
                        </xf:action>

                        <!-- 3. Persist close redirect URI when configuring 'close' -->
                        <xf:action if="$new-name = 'close'">
                            <xf:var name="cu-ov" value="string($p/@close-uri-override) = 'true'"/>
                            <xf:setvalue ref="$i/@close-uri-override" value="string($cu-ov)"/>
                            <xf:setvalue ref="$i/@close-uri"          value="if ($cu-ov) then xxf:trim(string($p/@close-uri)) else ''"/>
                        </xf:action>

                        <!-- 4. Persist button label & icon in $resources-node (live sync with <fr:resources-editor>) -->
                        <xf:action if="exists($resources-node)">
                            <xf:var name="res-key" value="concat('buttons.', $new-name)"/>
                            <xf:delete ref="$resources-node/message[@name = $res-key]"/>

                            <xf:action if="$p/@label-mode = 'single'">
                                <xf:var name="composed" value="beu:composeButtonLabelXml(string($p/@icon), string($p/@single-text))"/>
                                <xf:action if="xxf:non-blank(string($composed))">
                                    <xf:delete
                                        if="count($resources-node/message) = 1 and xxf:is-blank($resources-node/message/@name) and xxf:is-blank($resources-node/message) and string($resources-node/message/@html) != 'true'"
                                        ref="$resources-node/message"/>
                                    <xf:insert
                                        context="$resources-node"
                                        ref="*"
                                        origin="
                                            xf:element(
                                                'message',
                                                (
                                                    xf:attribute('xml:lang', if ($can-wildcard-lang) then '*' else $concrete-langs[1]),
                                                    xf:attribute('name', $res-key),
                                                    xf:attribute('html', string($composed/@html)),
                                                    string($composed)
                                                )
                                            )"/>
                                </xf:action>
                            </xf:action>

                            <xf:action if="$p/@label-mode = 'localized'">
                                <xf:action iterate="$p/translations/*[xxf:non-blank(.) or xxf:non-blank($p/@icon)]">
                                    <xf:var name="tr"       value="."/>
                                    <xf:var name="tr-lang"  value="string($tr/@lang)"/>
                                    <xf:var name="composed" value="beu:composeButtonLabelXml(string($p/@icon), string($tr))"/>
                                    <xf:action if="xxf:non-blank($tr) and xxf:non-blank(string($composed))">
                                        <xf:delete
                                            if="count($resources-node/message) = 1 and xxf:is-blank($resources-node/message/@name) and xxf:is-blank($resources-node/message) and string($resources-node/message/@html) != 'true'"
                                            ref="$resources-node/message"/>
                                        <xf:insert
                                            context="$resources-node"
                                            ref="*"
                                            origin="
                                                xf:element(
                                                    'message',
                                                    (
                                                        xf:attribute('xml:lang', $tr-lang),
                                                        xf:attribute('name', $res-key),
                                                        xf:attribute('html', string($composed/@html)),
                                                        string($composed)
                                                    )
                                                )"/>
                                    </xf:action>
                                </xf:action>
                            </xf:action>

                            <xf:action if="$p/@label-mode = 'raw-html' and xxf:non-blank($p/@raw-html)">
                                <xf:delete
                                    if="count($resources-node/message) = 1 and xxf:is-blank($resources-node/message/@name) and xxf:is-blank($resources-node/message) and string($resources-node/message/@html) != 'true'"
                                    ref="$resources-node/message"/>
                                <xf:insert
                                    context="$resources-node"
                                    ref="*"
                                    origin="
                                        xf:element(
                                            'message',
                                            (
                                                xf:attribute('xml:lang', if ($can-wildcard-lang) then '*' else $concrete-langs[1]),
                                                xf:attribute('name', $res-key),
                                                xf:attribute('html', 'true'),
                                                string($p/@raw-html)
                                            )
                                        )"/>
                            </xf:action>

                            <!-- Ensure $resources-node keeps a blank template row if all messages were removed -->
                            <xf:insert
                                if="empty($resources-node/message)"
                                context="$resources-node"
                                origin="
                                    xf:element(
                                        'message',
                                        (
                                            xf:attribute('xml:lang', if ($can-wildcard-lang) then '*' else $concrete-langs[1]),
                                            xf:attribute('name', ''),
                                            xf:attribute('html', 'false')
                                        )
                                    )"/>
                        </xf:action>
                    </xf:action>

                    <!-- 5. Update bar-items if adding a custom button or if split parts / button name changed -->
                    <xf:var name="part-names" value="for $pt in $dlg/parts/part return xxf:trim(string($pt/@name))"/>
                    <xf:var
                        name="new-item-elem"
                        value="
                            xf:element(
                                'item',
                                (
                                    xf:attribute('token', string-join($part-names, '|')),
                                    xf:attribute('primary', $part-names[1]),
                                    xf:attribute('is-split', string(count($part-names) gt 1)),
                                    for $pn in $part-names return xf:element('part', xf:attribute('name', $pn))
                                )
                            )"/>

                    <xf:action if="$dlg/@mode = 'add-custom'">
                        <xf:insert context="instance('bar-items')" ref="item" origin="$new-item-elem"/>
                        <xf:setvalue ref="$dlg/@mode"      value="'edit-bar-item'"/>
                        <xf:setvalue ref="$dlg/@bar-index" value="count(instance('bar-items')/item)"/>
                    </xf:action>

                    <xf:action if="$dlg/@mode = 'edit-bar-item'">
                        <xf:var name="bidx"        value="xs:integer($dlg/@bar-index)"/>
                        <xf:var name="target-item" value="instance('bar-items')/item[$bidx]"/>
                        <xf:action if="exists($target-item) and string($target-item/@token) != string($new-item-elem/@token)">
                            <xf:insert ref="$target-item" position="after" origin="$new-item-elem"/>
                            <xf:delete ref="$target-item"/>
                        </xf:action>
                    </xf:action>

                    <xf:action if="$close-after">
                        <xf:setvalue ref="$dlg/@open" value="'false'"/>
                        <xxf:hide dialog="fr-button-config-dialog"/>
                    </xf:action>
                </xf:action>

                <!-- ======================================================================= -->
                <!-- Main Editor Layout                                                      -->
                <!-- ======================================================================= -->
                <xh:div class="fr-buttons-editor {'fr-be-is-readonly'[$is-readonly]}">

                    <!-- Screen-reader live region -->
                    <xh:p class="fr-be-sr-status" role="status">
                        <xf:output value="instance('state')/@announcement"/>
                    </xh:p>

                    <!-- 1. Bar Switcher Pills (Edit / New | View / Review | Inner) -->
                    <xh:div class="fr-be-bar-header">
                        <xh:div class="fr-be-bar-tabs" role="tablist">
                            <xf:repeat ref="('edit', 'view', 'inner')">
                                <xf:var name="bname"      value="string(.)"/>
                                <xf:var name="bnode"      value="$i/bar[@name = $bname]"/>
                                <xf:var name="is-active"  value="$bname = $active-bar-name"/>
                                <xf:var name="b-override" value="string($bnode/@override) = 'true'"/>
                                <xf:var
                                    name="blabel"
                                    value="
                                        if ($bname = 'view') then fr:r('bar-view')
                                        else if ($bname = 'inner') then fr:r('bar-inner')
                                        else fr:r('bar-edit')"/>
                                <xh:span class="fr-be-bar-tab {'fr-be-bar-tab-active'[$is-active]}">
                                    <xf:trigger appearance="minimal" id="fr-be-select-bar-btn">
                                        <xf:label>
                                            <xh:span class="fr-be-bar-tab-label"><xf:output value="$blabel"/></xh:span>
                                            <xh:span class="fr-be-bar-tab-dot {'xforms-hidden'[not($b-override)]}" title="{fr:r('badge-overridden')}" aria-hidden="true"/>
                                        </xf:label>
                                        <xf:setvalue event="DOMActivate" ref="instance('state')/@active-bar" value="$bname"/>
                                    </xf:trigger>
                                </xh:span>
                            </xf:repeat>
                        </xh:div>

                        <xh:div class="fr-be-bar-meta">
                            <xh:span class="fr-be-bar-hint">
                                <xf:output
                                    value="
                                        if ($active-bar-name = 'view') then fr:r('bar-view-hint')
                                        else if ($active-bar-name = 'inner') then fr:r('bar-inner-hint')
                                        else fr:r('bar-edit-hint')"/>
                            </xh:span>
                            <xh:code class="fr-be-bar-prop">
                                <xf:output
                                    value="
                                        concat(
                                            'oxf.fr.detail.buttons',
                                            if ($active-bar-name = 'view') then '.view' else if ($active-bar-name = 'inner') then '.inner' else '',
                                            '.',
                                            $eff-app,
                                            '.',
                                            $eff-form
                                        )"/>
                            </xh:code>
                        </xh:div>
                    </xh:div>

                    <!-- 2. Action Toolbar -->
                    <xh:div class="fr-be-toolbar">
                        <xh:div class="fr-be-toolbar-start">
                            <xf:group ref=".[not($is-readonly)]" class="fr-be-add-controls">
                                <xf:select1
                                    id="fr-be-add-standard-select"
                                    ref="instance('state')/@add-standard-choice"
                                    appearance="minimal"
                                    class="fr-be-add-standard-select">
                                    <xf:label class="xforms-hidden" value="fr:r('add-standard-placeholder')"/>
                                    <xf:item>
                                        <xf:label value="fr:r('add-standard-placeholder')"/>
                                        <xf:value/>
                                    </xf:item>
                                    <xf:itemset ref="$selectable-buttons">
                                        <xf:label
                                            value="
                                                let $nm       := string(@name),
                                                    $cat      := string(@category),
                                                    $cat-lbl  := if ($cat = 'navigation') then fr:r('cat-navigation') else if ($cat = 'export') then fr:r('cat-export') else fr:r('cat-workflow'),
                                                    $fr-raw   := xxf:r(concat('buttons.', $nm), '|fr-fr-resources|'),
                                                    $parsed   := beu:parseButtonLabelXml($fr-raw, true()),
                                                    $disp     := (string($parsed)[xxf:non-blank()], string(@default-en-label)[xxf:non-blank()], $nm)[1],
                                                    $in-bar   := $nm = $active-bar-part-names
                                                return concat(
                                                    if ($in-bar) then '✓ ' else '',
                                                    $disp,
                                                    ' (', $nm, ') — ', $cat-lbl
                                                )"/>
                                        <xf:value ref="@name"/>
                                    </xf:itemset>
                                    <xf:action event="xforms-value-changed" if="xxf:non-blank(context())">
                                        <xf:var name="chosen" value="string(context())"/>
                                        <xf:setvalue ref="instance('state')/@add-standard-choice" value="''"/>
                                        <xf:insert
                                            if="not($chosen = $active-bar-part-names)"
                                            context="instance('bar-items')"
                                            ref="item"
                                            origin="
                                                xf:element(
                                                    'item',
                                                    (
                                                        xf:attribute('token', $chosen),
                                                        xf:attribute('primary', $chosen),
                                                        xf:attribute('is-split', 'false'),
                                                        xf:element('part', xf:attribute('name', $chosen))
                                                    )
                                                )"/>
                                    </xf:action>
                                </xf:select1>

                                <xf:trigger id="fr-be-add-custom-btn" class="fr-be-add-btn">
                                    <xf:label>
                                        <xh:i class="fa fa-fw fa-plus" aria-hidden="true"/>
                                        <xh:span><xf:output value="fr:r('add-custom')"/></xh:span>
                                    </xf:label>
                                    <xf:action event="DOMActivate">
                                        <xf:delete ref="$dlg/parts/*"/>
                                        <xf:insert context="$dlg/parts" ref="*" origin="$dlg/templates/part"/>
                                        <xf:dispatch name="fr-be-init-last-part" targetid="fr-be-root">
                                            <xf:property name="part-name" value="''"/>
                                        </xf:dispatch>
                                        <xf:setvalue ref="$dlg/@mode"              value="'add-custom'"/>
                                        <xf:setvalue ref="$dlg/@bar-index"         value="'0'"/>
                                        <xf:setvalue ref="$dlg/@active-part-index" value="'1'"/>
                                        <xf:setvalue ref="$dlg/@show-errors"       value="'false'"/>
                                        <xf:setvalue ref="$dlg/@open"              value="'true'"/>
                                        <xxf:show dialog="fr-button-config-dialog"/>
                                    </xf:action>
                                </xf:trigger>
                            </xf:group>
                        </xh:div>

                        <xh:div class="fr-be-toolbar-end">
                            <xf:group ref="$active-bar[not($is-readonly)]" class="fr-be-override-controls">
                                <fr:checkbox-input id="fr-be-override-bar-checkbox" ref="@override" class="fr-be-override-checkbox">
                                    <xf:label value="fr:r('override-list')"/>
                                    <xf:action event="xforms-value-changed">
                                        <xf:action if="string(context()) = 'true'">
                                            <xf:setvalue ref="../@value" value="beu:serializeBarItems(instance('bar-items'))"/>
                                        </xf:action>
                                        <xf:action if="string(context()) = 'false'">
                                            <xf:setvalue ref="../@value" value="../@default"/>
                                        </xf:action>
                                    </xf:action>
                                </fr:checkbox-input>

                                <xf:trigger
                                    id="fr-be-clear-bar-btn"
                                    appearance="minimal"
                                    ref=".[$bar-item-count gt 0]"
                                    class="fr-be-utility-btn">
                                    <xf:label>
                                        <xh:i class="fa fa-fw fa-eraser" aria-hidden="true"/>
                                        <xh:span><xf:output value="fr:r('clear-bar')"/></xh:span>
                                    </xf:label>
                                    <xf:action event="DOMActivate">
                                        <xf:delete ref="instance('bar-items')/item"/>
                                    </xf:action>
                                </xf:trigger>

                                <xf:trigger
                                    id="fr-be-reset-bar-btn"
                                    appearance="minimal"
                                    ref=".[@override = 'true']"
                                    class="fr-be-utility-btn">
                                    <xf:label>
                                        <xh:i class="fa fa-fw fa-rotate-left" aria-hidden="true"/>
                                        <xh:span><xf:output value="fr:r('reset-bar')"/></xh:span>
                                    </xf:label>
                                    <xf:action event="DOMActivate">
                                        <xf:setvalue ref="@override" value="'false'"/>
                                        <xf:setvalue ref="@value"    value="@default"/>
                                    </xf:action>
                                </xf:trigger>
                            </xf:group>
                        </xh:div>
                    </xh:div>

                    <!-- Subtle banner when viewing inherited button list -->
                    <xh:div class="fr-be-inherited-banner {'xforms-hidden'[$is-bar-overridden or $is-readonly]}">
                        <xh:i class="fa fa-fw fa-circle-info" aria-hidden="true"/>
                        <xh:span><xf:output value="fr:r('inherited-note')"/></xh:span>
                    </xh:div>

                    <!-- Empty bar state -->
                    <xh:div class="fr-be-empty {'xforms-hidden'[$bar-item-count gt 0]}">
                        <xf:output value="if ($is-bar-overridden) then fr:r('empty-bar-overridden') else fr:r('empty-bar')"/>
                    </xh:div>

                    <!-- 3. Reorderable Button Bar Rows (<fr:dnd-repeat>) -->
                    <fr:dnd-repeat id="fr-be-dnd-repeat" ref="instance('bar-items')/item" class="fr-dnd-drop-indicator">
                        <xf:var name="item"          value="."/>
                        <xf:var name="pos"           value="position()"/>
                        <xf:var name="is-last"       value="$pos = $bar-item-count"/>
                        <xf:var name="primary-name"  value="string(@primary)"/>
                        <xf:var name="is-split"      value="@is-split = 'true'"/>
                        <xf:var name="parts"         value="part/@name/string()"/>
                        <xf:var name="std-meta"      value="$catalog-buttons[@name = $primary-name][1]"/>
                        <xf:var name="is-standard"   value="exists($std-meta)"/>

                        <!-- Resolve display chip HTML for primary button (scope resource -> inherited resource -> fr-resources -> catalog default) -->
                        <xf:var name="res-key"       value="concat('buttons.', $primary-name)"/>
                        <xf:var
                            name="scope-msg"
                            value="
                                (
                                    $resources-node/message[@name = $res-key and @xml:lang = $ui-lang],
                                    $resources-node/message[@name = $res-key and @xml:lang = '*'],
                                    $resources-node/message[@name = $res-key]
                                )[1]"/>
                        <xf:var
                            name="inh-msg"
                            value="
                                (
                                    $inherited-resources[@name = $res-key and @xml:lang = $ui-lang],
                                    $inherited-resources[@name = $res-key and @xml:lang = '*'],
                                    $inherited-resources[@name = $res-key]
                                )[1]"/>
                        <xf:var
                            name="chip-html"
                            value="
                                if (exists($scope-msg)) then
                                    beu:formatButtonChipHtml(string($scope-msg), string($scope-msg/@html) = 'true', $primary-name)
                                else if (exists($inh-msg)) then
                                    beu:formatButtonChipHtml(string($inh-msg), string($inh-msg/@html) = 'true', $primary-name)
                                else if ($is-standard) then
                                    beu:formatButtonChipHtml(xxf:r($res-key, '|fr-fr-resources|'), true(), $primary-name)
                                else
                                    beu:formatButtonChipHtml('', false(), $primary-name)"/>

                        <!-- Aggregate customization flags across all parts of this item -->
                        <xf:var name="has-label-override" value="exists($resources-node/message[@name = (for $p in $parts return concat('buttons.', $p))])"/>
                        <xf:var name="item-rules"         value="$i/button[@name = $parts]"/>
                        <xf:var name="has-rule-error"     value="exists($item-rules/(@visible | @enabled)[not(xxf:valid(.))])"/>
                        <xf:var name="primary-rule"       value="$i/button[@name = $primary-name][1]"/>
                        <xf:var name="scope-proc"         value="$processes-node/process[@name = $primary-name][1]"/>
                        <xf:var name="inh-proc"           value="$inherited-processes[@name = $primary-name][1]"/>
                        <xf:var name="builtin-proc-def"   value="frf:defaultDetailProcessDefinition($primary-name, $eff-app, $eff-form)"/>
                        <xf:var
                            name="missing-process"
                            value="
                                not($is-standard) and
                                not($primary-name = $builtin-proc-names) and
                                empty($scope-proc) and
                                empty($inh-proc) and
                                xxf:is-blank($builtin-proc-def)"/>

                        <xh:div class="xforms-dnd-item {'xforms-dnd-moves'[not($is-readonly) and $bar-item-count gt 1]} fr-be-row {'fr-be-row-invalid'[$has-rule-error]}">

                            <!-- Drag handle -->
                            <xh:span
                                class="fr-be-drag-handle xforms-dnd-handle {'xforms-hidden'[$is-readonly or $bar-item-count le 1]}"
                                title="{fr:r('drag-to-reorder')}"
                                aria-hidden="true">
                                <xh:i class="fa fa-grip-vertical"/>
                            </xh:span>

                            <!-- Main Row Summary (clickable via Configure or direct button) -->
                            <xh:div class="fr-be-row-main">
                                <!-- Live Button Preview Chip -->
                                <xh:span class="fr-be-button-chip {'fr-be-button-chip-primary'[$is-last]}">
                                    <xf:output mediatype="text/html" value="$chip-html"/>
                                    <xh:span class="fr-be-split-caret {'xforms-hidden'[not($is-split)]}" aria-hidden="true">
                                        <xh:i class="fa fa-caret-down"/>
                                    </xh:span>
                                </xh:span>

                                <!-- Identifier token -->
                                <xh:code class="fr-be-token-code">
                                    <xf:output value="if ($is-split) then string-join($parts, ' | ') else $primary-name"/>
                                </xh:code>

                                <!-- Primary CTA badge on last button -->
                                <xh:span
                                    class="fr-be-pill fr-be-pill-primary {'xforms-hidden'[not($is-last)]}"
                                    title="{fr:r('badge-primary-hint')}">
                                    <xf:output value="fr:r('badge-primary')"/>
                                </xh:span>

                                <!-- Built-in keyboard shortcut hint (e.g. ⌘S) -->
                                <xh:kbd class="fr-be-kbd {'xforms-hidden'[xxf:is-blank($std-meta/@keyboard-shortcut)]}">
                                    <xf:output value="$std-meta/@keyboard-shortcut"/>
                                </xh:kbd>

                                <!-- Active Override / Status Pills -->
                                <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[not($has-label-override)]}">
                                    <xh:i class="fa fa-fw fa-tag" aria-hidden="true"/>
                                    <xf:output value="fr:r('badge-label')"/>
                                </xh:span>

                                <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[string($primary-rule/@visible-override) != 'true']}">
                                    <xh:i class="fa fa-fw fa-eye" aria-hidden="true"/>
                                    <xf:output
                                        value="
                                            let $v := xxf:trim(string($primary-rule/@visible))
                                            return
                                                if ($v = ('true()', 'true')) then fr:r('badge-visible-always')
                                                else if ($v = ('false()', 'false')) then fr:r('badge-visible-hidden')
                                                else fr:r('badge-visible-formula')"/>
                                </xh:span>

                                <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[string($primary-rule/@enabled-override) != 'true']}">
                                    <xh:i class="fa fa-fw fa-toggle-on" aria-hidden="true"/>
                                    <xf:output
                                        value="
                                            let $v := xxf:trim(string($primary-rule/@enabled))
                                            return
                                                if ($v = ('false()', 'false')) then fr:r('badge-enabled-disabled')
                                                else fr:r('badge-enabled-formula')"/>
                                </xh:span>

                                <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[string($primary-rule/@loading-override) != 'true']}">
                                    <xh:i class="fa fa-fw fa-spinner" aria-hidden="true"/>
                                    <xf:output
                                        value="
                                            let $v := xxf:trim(string($primary-rule/@loading-indicator))
                                            return
                                                if ($v = 'inline') then fr:r('badge-loading-inline')
                                                else if ($v = 'modal') then fr:r('badge-loading-modal')
                                                else fr:r('badge-loading-none')"/>
                                </xh:span>

                                <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[not($primary-name = 'close' and string($i/@close-uri-override) = 'true')]}">
                                    <xh:i class="fa fa-fw fa-arrow-up-right-from-square" aria-hidden="true"/>
                                    <xf:output value="fr:r('badge-close-uri')"/>
                                </xh:span>

                                <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[empty($scope-proc)]}">
                                    <xh:i class="fa fa-fw fa-diagram-project" aria-hidden="true"/>
                                    <xf:output value="if ($is-standard or $primary-name = $builtin-proc-names) then fr:r('badge-process-overridden') else fr:r('badge-process-custom')"/>
                                </xh:span>

                                <xh:span class="fr-be-pill fr-be-pill-muted {'xforms-hidden'[exists($scope-proc) or empty($inh-proc)]}">
                                    <xh:i class="fa fa-fw fa-diagram-project" aria-hidden="true"/>
                                    <xf:output value="fr:r('badge-process-inherited')"/>
                                </xh:span>

                                <!-- Missing Process Warning Action for Custom Buttons -->
                                <xf:trigger
                                    id="fr-be-define-missing-process-btn"
                                    appearance="minimal"
                                    ref=".[$missing-process and not($is-readonly)]"
                                    class="fr-be-missing-process-btn">
                                    <xf:label>
                                        <xh:i class="fa fa-fw fa-triangle-exclamation" aria-hidden="true"/>
                                        <xh:span><xf:output value="fr:r('badge-no-process')"/></xh:span>
                                    </xf:label>
                                    <xf:hint value="fr:r('badge-no-process-hint')"/>
                                    <xf:dispatch event="DOMActivate" name="fr-edit-process" targetid="fr-buttons-editor">
                                        <xf:property name="name"               value="$primary-name"/>
                                        <xf:property name="is-builtin"         value="false()"/>
                                        <xf:property name="initial-definition" value="''"/>
                                    </xf:dispatch>
                                </xf:trigger>
                            </xh:div>

                            <!-- Row Actions -->
                            <xh:div class="fr-be-row-actions">
                                <xf:trigger
                                    id="fr-be-configure-row-btn"
                                    appearance="xxf:mini"
                                    ref=".[not($is-readonly)]"
                                    class="fr-be-configure-btn">
                                    <xf:label>
                                        <xh:i class="fa fa-fw fa-sliders" aria-hidden="true"/>
                                        <xh:span><xf:output value="fr:r('configure')"/></xh:span>
                                    </xf:label>
                                    <xf:action event="DOMActivate">
                                        <xf:delete ref="$dlg/parts/*"/>
                                        <xf:action iterate="$item/part">
                                            <xf:var name="pn" value="string(@name)"/>
                                            <xf:insert context="$dlg/parts" ref="*" origin="$dlg/templates/part"/>
                                            <xf:dispatch name="fr-be-init-last-part" targetid="fr-be-root">
                                                <xf:property name="part-name" value="$pn"/>
                                            </xf:dispatch>
                                        </xf:action>
                                        <xf:setvalue ref="$dlg/@mode"              value="'edit-bar-item'"/>
                                        <xf:setvalue ref="$dlg/@bar-index"         value="$pos"/>
                                        <xf:setvalue ref="$dlg/@active-part-index" value="'1'"/>
                                        <xf:setvalue ref="$dlg/@show-errors"       value="'false'"/>
                                        <xf:setvalue ref="$dlg/@open"              value="'true'"/>
                                        <xxf:show dialog="fr-button-config-dialog"/>
                                    </xf:action>
                                </xf:trigger>

                                <xf:group ref=".[not($is-readonly) and $bar-item-count gt 1]" class="fr-be-move-btns">
                                    <xf:trigger
                                        id="fr-be-move-up-btn"
                                        appearance="minimal"
                                        ref=".[exists($item/preceding-sibling::item)]"
                                        class="fr-be-icon-btn fr-be-move-up">
                                        <xf:label><xh:i class="fa fa-arrow-up" aria-hidden="true"/></xf:label>
                                        <xf:hint value="fr:r('move-up')"/>
                                        <xf:action event="DOMActivate">
                                            <xf:var name="prev" value="$item/preceding-sibling::item[1]"/>
                                            <xf:insert ref="$prev" position="before" origin="$item"/>
                                            <xf:delete ref="$item"/>
                                            <xf:setvalue
                                                ref="instance('state')/@announcement"
                                                value="xxf:format-message(fr:r('moved-announcement'), ($primary-name, $pos - 1, $bar-item-count))"/>
                                        </xf:action>
                                    </xf:trigger>
                                    <xf:trigger
                                        id="fr-be-move-down-btn"
                                        appearance="minimal"
                                        ref=".[exists($item/following-sibling::item)]"
                                        class="fr-be-icon-btn fr-be-move-down">
                                        <xf:label><xh:i class="fa fa-arrow-down" aria-hidden="true"/></xf:label>
                                        <xf:hint value="fr:r('move-down')"/>
                                        <xf:action event="DOMActivate">
                                            <xf:var name="next" value="$item/following-sibling::item[1]"/>
                                            <xf:insert ref="$next" position="after" origin="$item"/>
                                            <xf:delete ref="$item"/>
                                            <xf:setvalue
                                                ref="instance('state')/@announcement"
                                                value="xxf:format-message(fr:r('moved-announcement'), ($primary-name, $pos + 1, $bar-item-count))"/>
                                        </xf:action>
                                    </xf:trigger>
                                </xf:group>

                                <xf:trigger
                                    id="fr-be-remove-row-btn"
                                    appearance="minimal"
                                    ref=".[not($is-readonly)]"
                                    class="fr-be-icon-btn fr-be-remove-btn">
                                    <xf:label><xh:i class="fa fa-xmark" aria-hidden="true"/></xf:label>
                                    <xf:hint value="fr:r('remove-button')"/>
                                    <xf:action event="DOMActivate">
                                        <xf:delete ref="$item"/>
                                        <xf:setvalue
                                            ref="instance('state')/@announcement"
                                            value="xxf:format-message(fr:r('removed-announcement'), $primary-name)"/>
                                    </xf:action>
                                </xf:trigger>
                            </xh:div>
                        </xh:div>
                    </fr:dnd-repeat>

                    <!-- 4. Additional Per-Button Rules (for buttons not in the currently viewed bar) -->
                    <xf:group ref=".[exists($extra-rule-buttons)]" class="fr-be-extra-rules">
                        <xh:div class="fr-be-extra-rules-header">
                            <xh:span class="fr-be-extra-rules-title"><xf:output value="fr:r('extra-rules-title')"/></xh:span>
                            <xh:span class="fr-be-extra-rules-hint"><xf:output value="fr:r('extra-rules-hint')"/></xh:span>
                        </xh:div>
                        <xh:div class="fr-be-extra-rules-list">
                            <xf:repeat id="fr-be-extra-rules-repeat" ref="$extra-rule-buttons">
                                <xf:var name="rbtn"  value="."/>
                                <xf:var name="rname" value="string(@name)"/>
                                <xh:div class="fr-be-row fr-be-extra-row {'fr-be-row-invalid'[exists((@visible | @enabled)[not(xxf:valid(.))])] }">
                                    <xh:div class="fr-be-row-main">
                                        <xh:code class="fr-be-token-code"><xf:output value="$rname"/></xh:code>
                                        <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[string(@visible-override) != 'true']}">
                                            <xh:i class="fa fa-fw fa-eye" aria-hidden="true"/>
                                            <xf:output
                                                value="
                                                    let $v := xxf:trim(string(@visible))
                                                    return
                                                        if ($v = ('true()', 'true')) then fr:r('badge-visible-always')
                                                        else if ($v = ('false()', 'false')) then fr:r('badge-visible-hidden')
                                                        else fr:r('badge-visible-formula')"/>
                                        </xh:span>
                                        <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[string(@enabled-override) != 'true']}">
                                            <xh:i class="fa fa-fw fa-toggle-on" aria-hidden="true"/>
                                            <xf:output
                                                value="
                                                    let $v := xxf:trim(string(@enabled))
                                                    return
                                                        if ($v = ('false()', 'false')) then fr:r('badge-enabled-disabled')
                                                        else fr:r('badge-enabled-formula')"/>
                                        </xh:span>
                                        <xh:span class="fr-be-pill fr-be-pill-override {'xforms-hidden'[string(@loading-override) != 'true']}">
                                            <xh:i class="fa fa-fw fa-spinner" aria-hidden="true"/>
                                            <xf:output
                                                value="
                                                    let $v := xxf:trim(string(@loading-indicator))
                                                    return
                                                        if ($v = 'inline') then fr:r('badge-loading-inline')
                                                        else if ($v = 'modal') then fr:r('badge-loading-modal')
                                                        else fr:r('badge-loading-none')"/>
                                        </xh:span>
                                    </xh:div>
                                    <xh:div class="fr-be-row-actions">
                                        <xf:trigger
                                            id="fr-be-configure-extra-btn"
                                            appearance="xxf:mini"
                                            ref=".[not($is-readonly)]"
                                            class="fr-be-configure-btn">
                                            <xf:label>
                                                <xh:i class="fa fa-fw fa-sliders" aria-hidden="true"/>
                                                <xh:span><xf:output value="fr:r('configure')"/></xh:span>
                                            </xf:label>
                                            <xf:dispatch event="DOMActivate" name="fr-be-open-by-name" targetid="fr-be-root">
                                                <xf:property name="name"       value="$rname"/>
                                                <xf:property name="add-to-bar" value="'false'"/>
                                            </xf:dispatch>
                                        </xf:trigger>
                                        <xf:trigger
                                            id="fr-be-revert-extra-btn"
                                            appearance="minimal"
                                            ref=".[not($is-readonly)]"
                                            class="fr-be-icon-btn fr-be-remove-btn">
                                            <xf:label><xh:i class="fa fa-rotate-left" aria-hidden="true"/></xf:label>
                                            <xf:hint value="fr:r('revert-rules')"/>
                                            <xf:delete event="DOMActivate" ref="$rbtn"/>
                                        </xf:trigger>
                                    </xh:div>
                                </xh:div>
                            </xf:repeat>
                        </xh:div>
                    </xf:group>

                    <!-- =================================================================== -->
                    <!-- Unified Configure Button Modal Dialog                               -->
                    <!-- =================================================================== -->
                    <xxf:dialog
                        id="fr-button-config-dialog"
                        level="modal"
                        close="true"
                        draggable="true"
                        class="fr-button-config-dialog">
                        <xf:label
                            value="
                                if ($dlg/@mode = 'add-custom') then
                                    fr:r('dialog-title-add-custom')
                                else
                                    let $ap := $dlg/parts/part[xs:integer($dlg/@active-part-index)]/@name/string()
                                    return
                                        if (xxf:non-blank($ap)) then concat(fr:r('dialog-title-configure'), ': ', $ap)
                                        else fr:r('dialog-title-configure')
                            "/>

                        <xf:action event="xxforms-dialog-close" observer="fr-button-config-dialog" phase="target">
                            <xf:setvalue ref="$dlg/@open"        value="'false'"/>
                            <xf:setvalue ref="$dlg/@show-errors" value="'false'"/>
                        </xf:action>

                        <xf:group ref="$dlg[string(@open) = 'true']" class="fr-be-dialog-body">
                            <xf:var name="part-count"        value="count(parts/part)"/>
                            <xf:var name="active-part-idx"   value="min((max((1, xs:integer(@active-part-index))), max((1, $part-count))))"/>
                            <xf:var name="active-part"       value="parts/part[$active-part-idx]"/>
                            <xf:var name="part-name"         value="xxf:trim(string($active-part/@name))"/>
                            <xf:var name="part-is-standard"  value="string($active-part/@is-standard) = 'true'"/>
                            <xf:var name="part-std-meta"     value="$catalog-buttons[@name = $part-name][1]"/>
                            <xf:var name="dialog-all-valid"  value="every $pt in parts/part satisfies valid($pt)"/>

                            <!-- Split-Dropdown Part Selector & Add Dropdown Action (for bar items) -->
                            <xf:group ref=".[@mode != 'edit-rule-only']" class="fr-be-split-bar">
                                <xh:div class="fr-be-split-bar-row">
                                    <xh:div class="fr-be-split-pills">
                                        <xh:span class="fr-be-split-label"><xf:output value="fr:r('split-group-label')"/></xh:span>
                                        <xf:repeat id="fr-be-split-parts-repeat" ref="parts/part">
                                            <xf:var name="pidx"      value="position()"/>
                                            <xf:var name="is-sel"    value="$pidx = $active-part-idx"/>
                                            <xf:var name="disp-name" value="(xxf:trim(string(@name))[xxf:non-blank()], '?')[1]"/>
                                            <xh:span class="fr-be-split-pill {'fr-be-split-pill-active'[$is-sel]}">
                                                <xf:trigger appearance="minimal" id="fr-be-select-part-btn">
                                                    <xf:label value="$disp-name"/>
                                                    <xf:setvalue event="DOMActivate" ref="$dlg/@active-part-index" value="$pidx"/>
                                                </xf:trigger>
                                                <xf:trigger
                                                    id="fr-be-remove-part-btn"
                                                    appearance="minimal"
                                                    ref=".[$part-count gt 1]"
                                                    class="fr-be-split-pill-remove">
                                                    <xf:label><xh:i class="fa fa-xmark" aria-hidden="true"/></xf:label>
                                                    <xf:hint value="fr:r('split-remove-part')"/>
                                                    <xf:action event="DOMActivate">
                                                        <xf:delete ref="context()"/>
                                                        <xf:setvalue
                                                            ref="$dlg/@active-part-index"
                                                            value="min((xs:integer($dlg/@active-part-index), count($dlg/parts/part)))"/>
                                                    </xf:action>
                                                </xf:trigger>
                                            </xh:span>
                                        </xf:repeat>
                                    </xh:div>

                                    <xh:div class="fr-be-split-add">
                                        <xf:select1
                                            id="fr-be-add-split-standard-select"
                                            ref="@add-split-choice"
                                            appearance="minimal"
                                            class="fr-be-split-select">
                                            <xf:label class="xforms-hidden" value="fr:r('split-add-standard')"/>
                                            <xf:item>
                                                <xf:label value="fr:r('split-add-standard')"/>
                                                <xf:value/>
                                            </xf:item>
                                            <xf:itemset ref="$selectable-buttons[not(@name = $dlg/parts/part/@name)]">
                                                <xf:label value="concat(@default-en-label[xxf:non-blank()], if (xxf:non-blank(@default-en-label)) then concat(' (', @name, ')') else @name)"/>
                                                <xf:value ref="@name"/>
                                            </xf:itemset>
                                            <xf:action event="xforms-value-changed" if="xxf:non-blank(context())">
                                                <xf:var name="chosen" value="string(context())"/>
                                                <xf:setvalue ref="$dlg/@add-split-choice" value="''"/>
                                                <xf:insert context="$dlg/parts" ref="*" origin="$dlg/templates/part"/>
                                                <xf:dispatch name="fr-be-init-last-part" targetid="fr-be-root">
                                                    <xf:property name="part-name" value="$chosen"/>
                                                </xf:dispatch>
                                                <xf:setvalue ref="$dlg/@active-part-index" value="count($dlg/parts/part)"/>
                                            </xf:action>
                                        </xf:select1>

                                        <xf:trigger id="fr-be-add-split-custom-btn" appearance="minimal" class="fr-be-utility-btn">
                                            <xf:label value="fr:r('split-add-custom')"/>
                                            <xf:action event="DOMActivate">
                                                <xf:insert context="$dlg/parts" ref="*" origin="$dlg/templates/part"/>
                                                <xf:dispatch name="fr-be-init-last-part" targetid="fr-be-root">
                                                    <xf:property name="part-name" value="''"/>
                                                </xf:dispatch>
                                                <xf:setvalue ref="$dlg/@active-part-index" value="count($dlg/parts/part)"/>
                                            </xf:action>
                                        </xf:trigger>
                                    </xh:div>
                                </xh:div>
                            </xf:group>

                            <!-- Active Part Editor -->
                            <xf:group ref="$active-part" id="fr-be-active-part-group" class="fr-be-part-editor">

                                <!-- SECTION 1: Identity -->
                                <xh:div class="fr-be-dialog-section">
                                    <xh:div class="fr-be-section-head">
                                        <xh:span class="fr-be-section-title"><xf:output value="fr:r('section-identity')"/></xh:span>
                                        <xh:span class="fr-be-pill {if ($part-is-standard) then 'fr-be-pill-muted' else 'fr-be-pill-override'}">
                                            <xf:output value="if ($part-is-standard) then fr:r('standard-button-badge') else fr:r('custom-button-badge')"/>
                                        </xh:span>
                                    </xh:div>

                                    <xf:group ref=".[$part-is-standard]" class="fr-be-readonly-identity">
                                        <xh:code class="fr-be-token-code"><xf:output value="@name"/></xh:code>
                                        <xh:span class="fr-be-field-hint"><xf:output value="fr:r('button-name-hint')"/></xh:span>
                                    </xf:group>

                                    <xf:group ref=".[not($part-is-standard)]" class="fr-be-custom-identity">
                                        <xf:input id="fr-be-part-name-input" ref="@name" incremental="true" class="fr-be-name-input">
                                            <xf:label value="fr:r('button-name-label')"/>
                                            <xf:hint value="fr:r('button-name-hint')"/>
                                            <xf:alert value="fr:r('alert-slug')"/>
                                        </xf:input>

                                        <!-- Quick-pick chips for existing unplaced custom processes -->
                                        <xf:group ref=".[exists($unplaced-custom-processes)]" class="fr-be-quick-chips">
                                            <xh:span class="fr-be-chips-label"><xf:output value="fr:r('pick-existing-process')"/></xh:span>
                                            <xf:repeat ref="$unplaced-custom-processes">
                                                <xf:var name="suggested-proc" value="string(.)"/>
                                                <xf:trigger appearance="minimal" id="fr-be-pick-proc-chip" class="fr-be-chip-btn">
                                                    <xf:label>
                                                        <xh:i class="fa fa-fw fa-diagram-project" aria-hidden="true"/>
                                                        <xh:code><xf:output value="$suggested-proc"/></xh:code>
                                                    </xf:label>
                                                    <xf:action event="DOMActivate">
                                                        <xf:setvalue ref="$active-part/@name" value="$suggested-proc"/>
                                                        <xf:setvalue
                                                            if="xxf:is-blank($active-part/@single-text)"
                                                            ref="$active-part/@single-text"
                                                            value="$suggested-proc"/>
                                                    </xf:action>
                                                </xf:trigger>
                                            </xf:repeat>
                                        </xf:group>
                                    </xf:group>
                                </xh:div>

                                <!-- SECTION 2: Label & Icon -->
                                <xh:div class="fr-be-dialog-section">
                                    <xf:var
                                        name="preview-chip-html"
                                        value="
                                            if (@label-mode = 'single') then
                                                let $c := beu:composeButtonLabelXml(string(@icon), string(@single-text))
                                                return beu:formatButtonChipHtml(string($c), string($c/@html) = 'true', ($part-name[xxf:non-blank()], '?')[1])
                                            else if (@label-mode = 'localized') then
                                                let $tr := (translations/*[@lang = $ui-lang][xxf:non-blank()], translations/*[xxf:non-blank()])[1],
                                                    $c  := beu:composeButtonLabelXml(string(@icon), string($tr))
                                                return beu:formatButtonChipHtml(string($c), string($c/@html) = 'true', ($part-name[xxf:non-blank()], '?')[1])
                                            else if (@label-mode = 'raw-html') then
                                                beu:formatButtonChipHtml(string(@raw-html), true(), ($part-name[xxf:non-blank()], '?')[1])
                                            else if ($part-is-standard) then
                                                beu:formatButtonChipHtml(xxf:r(concat('buttons.', $part-name), '|fr-fr-resources|'), true(), $part-name)
                                            else
                                                beu:formatButtonChipHtml('', false(), ($part-name[xxf:non-blank()], '?')[1])
                                        "/>

                                    <xh:div class="fr-be-section-head">
                                        <xh:span class="fr-be-section-title"><xf:output value="fr:r('section-label-icon')"/></xh:span>
                                        <xh:span class="fr-be-button-chip">
                                            <xf:output mediatype="text/html" value="$preview-chip-html"/>
                                        </xh:span>
                                    </xh:div>

                                    <xf:group ref=".[not($has-resources-edit)]" class="fr-be-info-note">
                                        <xh:i class="fa fa-fw fa-circle-info" aria-hidden="true"/>
                                        <xh:span><xf:output value="fr:r('profiled-resources-note')"/></xh:span>
                                    </xf:group>

                                    <xf:group ref=".[$has-resources-edit]" class="fr-be-label-controls">
                                        <xf:select1 id="fr-be-label-mode-select" ref="@label-mode" appearance="full xxf:horizontal" class="fr-be-mode-radios">
                                            <xf:label class="xforms-hidden" value="fr:r('section-label-icon')"/>
                                            <xf:item>
                                                <xf:label value="fr:r('label-mode-default')"/>
                                                <xf:value>default</xf:value>
                                            </xf:item>
                                            <xf:itemset ref=".[$can-wildcard-lang]">
                                                <xf:label value="fr:r('label-mode-single')"/>
                                                <xf:value value="'single'"/>
                                            </xf:itemset>
                                            <xf:item>
                                                <xf:label value="fr:r('label-mode-localized')"/>
                                                <xf:value>localized</xf:value>
                                            </xf:item>
                                            <xf:item>
                                                <xf:label value="fr:r('label-mode-raw-html')"/>
                                                <xf:value>raw-html</xf:value>
                                            </xf:item>
                                        </xf:select1>

                                        <!-- Icon Picker + Text Input(s) for single / localized modes -->
                                        <xf:group ref=".[@label-mode = ('single', 'localized')]" class="fr-be-structured-label">
                                            <xh:div class="fr-be-icon-picker-block">
                                                <xh:span class="fr-be-sub-label"><xf:output value="fr:r('icon-label')"/></xh:span>
                                                <xh:div class="fr-be-icon-palette">
                                                    <xf:repeat ref="$catalog-icons">
                                                        <xf:var name="icls"   value="string(@class)"/>
                                                        <xf:var name="ihint"  value="if ($icls = '') then fr:r('icon-none') else string(@hint)"/>
                                                        <xf:var name="ic-sel" value="string($active-part/@icon) = $icls"/>
                                                        <xh:span class="fr-be-icon-choice {'fr-be-icon-choice-selected'[$ic-sel]}">
                                                            <xf:trigger appearance="minimal" id="fr-be-pick-icon-btn">
                                                                <xf:label>
                                                                    <xh:i class="fa fa-fw {if ($icls = '') then 'fa-ban' else $icls}" aria-hidden="true"/>
                                                                </xf:label>
                                                                <xf:hint value="$ihint"/>
                                                                <xf:setvalue event="DOMActivate" ref="$active-part/@icon" value="$icls"/>
                                                            </xf:trigger>
                                                        </xh:span>
                                                    </xf:repeat>
                                                </xh:div>
                                            </xh:div>

                                            <xf:group ref=".[@label-mode = 'single']">
                                                <xf:input id="fr-be-single-label-input" ref="@single-text" incremental="true">
                                                    <xf:label value="fr:r('label-text-label')"/>
                                                    <xf:hint appearance="minimal" value="fr:r('label-text-placeholder')"/>
                                                </xf:input>
                                            </xf:group>

                                            <xf:group ref=".[@label-mode = 'localized']" class="fr-be-translations-grid">
                                                <xf:repeat id="fr-be-translations-repeat" ref="translations/*">
                                                    <xf:var name="lang-code" value="string(@lang)"/>
                                                    <xf:var
                                                        name="lang-display"
                                                        value="(xxf:instance('fr-languages-instance')/language[@code = $lang-code]/@native-name/string(), $lang-code)[1]"/>
                                                    <xh:div class="fr-be-translation-row">
                                                        <xh:span class="fr-be-lang-badge">
                                                            <xf:output value="concat($lang-display, ' (', $lang-code, ')')"/>
                                                        </xh:span>
                                                        <xf:input id="fr-be-lang-text-input" ref="." incremental="true" class="fr-be-lang-input">
                                                            <xf:label class="xforms-hidden" value="$lang-display"/>
                                                            <xf:hint appearance="minimal" value="fr:r('label-text-placeholder')"/>
                                                        </xf:input>
                                                    </xh:div>
                                                </xf:repeat>
                                            </xf:group>
                                        </xf:group>

                                        <!-- Raw HTML mode -->
                                        <xf:group ref=".[@label-mode = 'raw-html']">
                                            <xf:textarea id="fr-be-raw-html-textarea" ref="@raw-html" incremental="true" class="fr-be-code-textarea">
                                                <xf:label value="fr:r('raw-html-label')"/>
                                            </xf:textarea>
                                        </xf:group>
                                    </xf:group>
                                </xh:div>

                                <!-- SECTION 3: Visibility & Enabled -->
                                <xh:div class="fr-be-dialog-section">
                                    <xh:div class="fr-be-section-head">
                                        <xh:span class="fr-be-section-title"><xf:output value="fr:r('section-conditions')"/></xh:span>
                                    </xh:div>

                                    <!-- Visibility -->
                                    <xh:div class="fr-be-condition-block">
                                        <xf:select1 id="fr-be-visible-mode-select" ref="@visible-mode" appearance="full xxf:horizontal" class="fr-be-mode-radios">
                                            <xf:label value="fr:r('visible-label')"/>
                                            <xf:item>
                                                <xf:label value="fr:r('visible-default')"/>
                                                <xf:value>default</xf:value>
                                            </xf:item>
                                            <xf:item>
                                                <xf:label value="fr:r('visible-always')"/>
                                                <xf:value>always</xf:value>
                                            </xf:item>
                                            <xf:item>
                                                <xf:label value="fr:r('visible-hidden')"/>
                                                <xf:value>hidden</xf:value>
                                            </xf:item>
                                            <xf:item>
                                                <xf:label value="fr:r('visible-xpath')"/>
                                                <xf:value>xpath</xf:value>
                                            </xf:item>
                                        </xf:select1>

                                        <xh:div class="fr-be-builtin-formula {'xforms-hidden'[@visible-mode != 'default']}">
                                            <xh:span><xf:output value="fr:r('builtin-default-prefix')"/></xh:span>
                                            <xh:code>
                                                <xf:output value="(string($part-std-meta/@default-visible)[xxf:non-blank()], 'fr:owns-lease-or-none-required()')[1]"/>
                                            </xh:code>
                                        </xh:div>

                                        <xf:group ref=".[@visible-mode = 'xpath']" class="fr-be-xpath-box">
                                            <xf:textarea id="fr-be-visible-xpath-input" ref="@visible-xpath" incremental="true" class="fr-be-code-textarea">
                                                <xf:label class="xforms-hidden" value="fr:r('visible-xpath')"/>
                                                <xf:alert value="fr:r('alert-xpath')"/>
                                            </xf:textarea>
                                            <xh:div class="fr-be-quick-chips">
                                                <xh:span class="fr-be-chips-label"><xf:output value="fr:r('insert-formula')"/></xh:span>
                                                <xf:trigger appearance="minimal" id="fr-be-vis-chip-wizard" class="fr-be-chip-btn">
                                                    <xf:label value="fr:r('chip-wizard-last')"/>
                                                    <xf:setvalue event="DOMActivate" ref="$active-part/@visible-xpath" value="'fr:is-wizard-last-page()'"/>
                                                </xf:trigger>
                                                <xf:trigger appearance="minimal" id="fr-be-vis-chip-edit" class="fr-be-chip-btn">
                                                    <xf:label value="fr:r('chip-edit-mode')"/>
                                                    <xf:setvalue event="DOMActivate" ref="$active-part/@visible-xpath" value="'fr:mode() = ''edit'''"/>
                                                </xf:trigger>
                                                <xf:trigger appearance="minimal" id="fr-be-vis-chip-new" class="fr-be-chip-btn">
                                                    <xf:label value="fr:r('chip-new-mode')"/>
                                                    <xf:setvalue event="DOMActivate" ref="$active-part/@visible-xpath" value="'fr:mode() = ''new'''"/>
                                                </xf:trigger>
                                                <xf:trigger appearance="minimal" id="fr-be-vis-chip-role" class="fr-be-chip-btn">
                                                    <xf:label value="fr:r('chip-admin-role')"/>
                                                    <xf:setvalue event="DOMActivate" ref="$active-part/@visible-xpath" value="'fr:user-roles() = ''admin'''"/>
                                                </xf:trigger>
                                            </xh:div>
                                        </xf:group>
                                    </xh:div>

                                    <!-- Enabled -->
                                    <xh:div class="fr-be-condition-block">
                                        <xf:select1 id="fr-be-enabled-mode-select" ref="@enabled-mode" appearance="full xxf:horizontal" class="fr-be-mode-radios">
                                            <xf:label value="fr:r('enabled-label')"/>
                                            <xf:item>
                                                <xf:label value="fr:r('enabled-default')"/>
                                                <xf:value>default</xf:value>
                                            </xf:item>
                                            <xf:item>
                                                <xf:label value="fr:r('enabled-disabled')"/>
                                                <xf:value>disabled</xf:value>
                                            </xf:item>
                                            <xf:item>
                                                <xf:label value="fr:r('enabled-xpath')"/>
                                                <xf:value>xpath</xf:value>
                                            </xf:item>
                                        </xf:select1>

                                        <xh:div class="fr-be-builtin-formula {'xforms-hidden'[@enabled-mode != 'default']}">
                                            <xh:span><xf:output value="fr:r('builtin-default-prefix')"/></xh:span>
                                            <xh:code>
                                                <xf:output value="(string($part-std-meta/@default-enabled)[xxf:non-blank()], fr:r('builtin-always-enabled'))[1]"/>
                                            </xh:code>
                                        </xh:div>

                                        <xf:group ref=".[@enabled-mode = 'xpath']" class="fr-be-xpath-box">
                                            <xf:textarea id="fr-be-enabled-xpath-input" ref="@enabled-xpath" incremental="true" class="fr-be-code-textarea">
                                                <xf:label class="xforms-hidden" value="fr:r('enabled-xpath')"/>
                                                <xf:alert value="fr:r('alert-xpath')"/>
                                            </xf:textarea>
                                            <xh:div class="fr-be-quick-chips">
                                                <xh:span class="fr-be-chips-label"><xf:output value="fr:r('insert-formula')"/></xh:span>
                                                <xf:trigger appearance="minimal" id="fr-be-en-chip-wizard" class="fr-be-chip-btn">
                                                    <xf:label value="fr:r('chip-wizard-last')"/>
                                                    <xf:setvalue event="DOMActivate" ref="$active-part/@enabled-xpath" value="'fr:is-wizard-last-page()'"/>
                                                </xf:trigger>
                                                <xf:trigger appearance="minimal" id="fr-be-en-chip-edit" class="fr-be-chip-btn">
                                                    <xf:label value="fr:r('chip-edit-mode')"/>
                                                    <xf:setvalue event="DOMActivate" ref="$active-part/@enabled-xpath" value="'fr:mode() = ''edit'''"/>
                                                </xf:trigger>
                                                <xf:trigger appearance="minimal" id="fr-be-en-chip-role" class="fr-be-chip-btn">
                                                    <xf:label value="fr:r('chip-admin-role')"/>
                                                    <xf:setvalue event="DOMActivate" ref="$active-part/@enabled-xpath" value="'fr:user-roles() = ''admin'''"/>
                                                </xf:trigger>
                                            </xh:div>
                                        </xf:group>
                                    </xh:div>
                                </xh:div>

                                <!-- SECTION 4: Action (Process Tied by Name) & Loading Indicator -->
                                <xh:div class="fr-be-dialog-section">
                                    <xf:var name="dlg-scope-proc"   value="$processes-node/process[@name = $part-name][1]"/>
                                    <xf:var name="dlg-inh-proc"     value="$inherited-processes[@name = $part-name][1]"/>
                                    <xf:var name="dlg-builtin-proc" value="if (xxf:non-blank($part-name)) then frf:defaultDetailProcessDefinition($part-name, $eff-app, $eff-form) else ''"/>
                                    <xf:var name="dlg-is-builtin"   value="$part-is-standard or ($part-name = $builtin-proc-names) or xxf:non-blank($dlg-builtin-proc)"/>
                                    <xf:var
                                        name="effective-proc-body"
                                        value="(string($dlg-scope-proc)[xxf:non-blank()], string($dlg-inh-proc)[xxf:non-blank()], $dlg-builtin-proc[xxf:non-blank()])[1]"/>
                                    <xf:var
                                        name="default-loading-label"
                                        value="
                                            let $dl := string($part-std-meta/@default-loading)
                                            return
                                                if ($dl = 'inline') then fr:r('loading-short-inline')
                                                else if ($dl = 'modal') then fr:r('loading-short-modal')
                                                else fr:r('loading-short-none')"/>

                                    <xh:div class="fr-be-section-head">
                                        <xh:span class="fr-be-section-title"><xf:output value="fr:r('section-action')"/></xh:span>
                                    </xh:div>

                                    <!-- Associated Process Card -->
                                    <xh:div class="fr-be-process-box">
                                        <xh:div class="fr-be-process-box-head">
                                            <xh:div class="fr-be-process-box-title">
                                                <xh:span class="fr-be-sub-label"><xf:output value="fr:r('process-label')"/></xh:span>
                                                <xh:code class="fr-be-bar-prop {'xforms-hidden'[xxf:is-blank($part-name)]}">
                                                    <xf:output value="concat('oxf.fr.detail.process.', $part-name, '.', $eff-app, '.', $eff-form)"/>
                                                </xh:code>
                                                <xh:span
                                                    class="
                                                        fr-be-pill
                                                        {
                                                            if (exists($dlg-scope-proc)) then 'fr-be-pill-override'
                                                            else if (exists($effective-proc-body)) then 'fr-be-pill-muted'
                                                            else 'fr-be-pill-warning'
                                                        }
                                                    ">
                                                    <xf:output
                                                        value="
                                                            if (exists($dlg-scope-proc)) then
                                                                (if ($dlg-is-builtin) then fr:r('process-status-overridden') else fr:r('process-status-custom'))
                                                            else if (exists($dlg-inh-proc)) then
                                                                fr:r('process-status-inherited')
                                                            else if (exists($effective-proc-body)) then
                                                                fr:r('process-status-builtin')
                                                            else
                                                                fr:r('process-status-missing')"/>
                                                </xh:span>
                                            </xh:div>

                                            <xh:div class="fr-be-process-box-actions">
                                                <xf:trigger
                                                    id="fr-be-open-process-editor-btn"
                                                    appearance="xxf:mini"
                                                    ref=".[beu:isValidButtonName($part-name)]">
                                                    <xf:label>
                                                        <xh:i class="fa fa-fw {if (exists($dlg-scope-proc)) then 'fa-pen' else if (exists($effective-proc-body)) then 'fa-code-branch' else 'fa-plus'}" aria-hidden="true"/>
                                                        <xh:span>
                                                            <xf:output
                                                                value="
                                                                    if (exists($dlg-scope-proc)) then fr:r('process-edit-btn')
                                                                    else if (exists($effective-proc-body)) then fr:r('process-override-btn')
                                                                    else fr:r('process-define-btn')"/>
                                                        </xh:span>
                                                    </xf:label>
                                                    <xf:action event="DOMActivate">
                                                        <!-- If dialog is valid, commit pending button changes (e.g. new custom button) without closing before launching Process Editor -->
                                                        <xf:dispatch if="$dialog-all-valid" name="fr-be-commit-dialog" targetid="fr-be-root">
                                                            <xf:property name="close-after" value="'false'"/>
                                                        </xf:dispatch>
                                                        <xf:dispatch name="fr-edit-process" targetid="fr-buttons-editor">
                                                            <xf:property name="name"               value="$part-name"/>
                                                            <xf:property name="is-builtin"         value="$dlg-is-builtin"/>
                                                            <xf:property name="initial-definition" value="($effective-proc-body, '')[1]"/>
                                                        </xf:dispatch>
                                                    </xf:action>
                                                </xf:trigger>

                                                <xf:trigger
                                                    id="fr-be-revert-process-btn"
                                                    appearance="xxf:mini xxf:danger"
                                                    ref="$dlg-scope-proc">
                                                    <xf:label>
                                                        <xh:i class="fa fa-fw {if ($dlg-is-builtin) then 'fa-rotate-left' else 'fa-trash'}" aria-hidden="true"/>
                                                        <xh:span><xf:output value="if ($dlg-is-builtin) then fr:r('process-revert-btn') else fr:r('process-delete-btn')"/></xh:span>
                                                    </xf:label>
                                                    <xf:delete event="DOMActivate" ref="$dlg-scope-proc"/>
                                                </xf:trigger>
                                            </xh:div>
                                        </xh:div>

                                        <xh:code class="fr-be-process-preview {'xforms-hidden'[empty($effective-proc-body)]}">
                                            <xf:output mediatype="text/html" value="frf:formatProcessDefinitionHtml(($effective-proc-body, '')[1])"/>
                                        </xh:code>
                                        <xh:div class="fr-be-process-empty {'xforms-hidden'[exists($effective-proc-body)]}">
                                            <xf:output value="fr:r('process-missing-hint')"/>
                                        </xh:div>
                                    </xh:div>

                                    <!-- Loading Indicator -->
                                    <xf:select1 id="fr-be-loading-select" ref="@loading-mode" appearance="minimal" class="fr-be-loading-select">
                                        <xf:label value="fr:r('loading-label')"/>
                                        <xf:item>
                                            <xf:label value="xxf:format-message(fr:r('loading-default'), $default-loading-label)"/>
                                            <xf:value>default</xf:value>
                                        </xf:item>
                                        <xf:item>
                                            <xf:label value="fr:r('loading-none')"/>
                                            <xf:value>none</xf:value>
                                        </xf:item>
                                        <xf:item>
                                            <xf:label value="fr:r('loading-inline')"/>
                                            <xf:value>inline</xf:value>
                                        </xf:item>
                                        <xf:item>
                                            <xf:label value="fr:r('loading-modal')"/>
                                            <xf:value>modal</xf:value>
                                        </xf:item>
                                    </xf:select1>

                                    <!-- Close Redirect URI (for 'close' button) -->
                                    <xf:group ref=".[$part-name = 'close']" class="fr-be-close-uri-block">
                                        <fr:checkbox-input id="fr-be-close-uri-override" ref="@close-uri-override" class="fr-be-override-checkbox">
                                            <xf:label value="fr:r('close-uri-label')"/>
                                        </fr:checkbox-input>
                                        <xf:input id="fr-be-close-uri-input" ref="@close-uri" incremental="true">
                                            <xf:label class="xforms-hidden" value="fr:r('close-uri-label')"/>
                                            <xf:hint value="fr:r('close-uri-hint')"/>
                                        </xf:input>
                                    </xf:group>
                                </xh:div>
                            </xf:group>

                            <!-- Dialog Footer Buttons -->
                            <xh:div class="fr-be-dialog-footer">
                                <xf:trigger id="fr-be-apply-dialog-btn" appearance="xxf:primary">
                                    <xf:label value="fr:r('apply')"/>
                                    <xf:action event="DOMActivate">
                                        <xf:action if="$dialog-all-valid">
                                            <xf:dispatch name="fr-be-commit-dialog" targetid="fr-be-root">
                                                <xf:property name="close-after" value="'true'"/>
                                            </xf:dispatch>
                                        </xf:action>
                                        <xf:action if="not($dialog-all-valid)">
                                            <xf:setvalue ref="$dlg/@show-errors" value="'true'"/>
                                            <xxf:setvisited control="fr-be-active-part-group" recurse="true"/>
                                        </xf:action>
                                    </xf:action>
                                </xf:trigger>
                                <xf:trigger id="fr-be-cancel-dialog-btn" appearance="minimal">
                                    <xf:label value="fr:r('cancel')"/>
                                    <xxf:hide event="DOMActivate" dialog="fr-button-config-dialog"/>
                                </xf:trigger>
                            </xh:div>
                        </xf:group>
                    </xxf:dialog>

                </xh:div>
            </xf:group>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
