<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
    xmlns:fbf="java:org.orbeon.oxf.fb.FormBuilderXPathApi">

    <xbl:binding
        id="fb-dialog-edit-source"
        element="fb|dialog-edit-source"
        xxbl:mode="binding">

        <xbl:handlers>
            <xbl:handler event="xxforms-dialog-open">

                <xf:delete ref="instance()/validation/*"/>
                <xf:setvalue ref="instance()/validation/@valid" value="'true'"/>

                <xf:setvalue
                    ref="source"
                    value="
                        xxf:serialize(
                            xxf:call-xpl(
                                'oxf:/forms/orbeon/builder/form/deannotate.xpl',
                                'data',
                                xxf:instance('fb-form-instance'),
                                'data'
                            ),
                            xxf:instance('fr-xsl-output-instance')
                        )"/>

                <xxf:show dialog="dialog"/>
            </xbl:handler>

            <xbl:handler event="DOMActivate" observer="apply-trigger code-mirror" if="valid(source)">
                <xf:var name="parsed" value="xf:parse(instance()/source)"/>
                <xf:delete ref="instance()/validation"/>
                <xf:insert
                    context="instance()"
                    origin="fbf:validateFormStructure($parsed, xxf:get-variable('fr-form-model', 'form-resources'))"/>

                <xf:action if="instance()/validation/@valid = 'true'">
                    <xf:dispatch targetid="fb-dialog-edit-source" name="fr-save">
                        <xf:property name="value" value="$parsed/root()"/>
                    </xf:dispatch>
                    <xf:setvalue ref="source"/>
                    <xxf:hide dialog="dialog"/>
                </xf:action>
            </xbl:handler>

            <xbl:handler event="DOMActivate" observer="cancel-trigger">
                <xf:delete ref="instance()/validation/*"/>
                <xf:setvalue ref="instance()/validation/@valid" value="'true'"/>
                <xf:setvalue ref="source"/>
                <xxf:hide dialog="dialog"/>
            </xbl:handler>

        </xbl:handlers>
        <xbl:implementation>
            <xf:model>

                <xf:instance id="i">
                    <source-editor>
                        <source/>
                        <apply-trigger/>
                        <validation valid="true" blocking="false" error-count="0" warning-count="0" info-count="0" data-compatibility=""/>
                    </source-editor>
                </xf:instance>

                <xf:bind
                    ref="instance('i')//*"
                    readonly="fr:is-readonly-mode()"/>

                <xf:bind
                    ref="source"
                    type="xxf:XML"
                    required="true()"
                    constraint="xxf:non-blank()"/>

            </xf:model>
        </xbl:implementation>
        <xbl:template>
            <!-- Bindings specified on control -->
            <xf:var name="resources"><xxf:value value=". treat as element()" xxbl:scope="outer" xbl:attr="model context ref=resources-ref"/></xf:var>

            <xxf:dialog
                id="dialog"
                level="modal"
                close="true"
                draggable="true"
                class="fb-edit-source-dialog">

                <xf:label ref="$resources/dialog-edit-source/label"/>

                <xf:group ref=".[exists(instance()/validation/issue)]">
                    <xh:div class="fb-edit-source-validation-banner fb-validation-callout fb-validation-error" role="alert">
                        <xh:i class="fa fa-circle-exclamation fb-validation-callout-icon" aria-hidden="true"/>
                        <xh:div class="fb-validation-callout-content">
                            <xh:div class="fb-validation-callout-title">
                                <xf:output value="$resources/dialog-check-form/structural-errors"/>
                            </xh:div>
                            <xh:ul role="list" class="fb-validation-callout-list">
                                <xf:repeat ref="instance()/validation/issue">
                                    <xh:li><xf:output value="."/></xh:li>
                                </xf:repeat>
                            </xh:ul>
                        </xh:div>
                    </xh:div>
                </xf:group>

                <fr:code-mirror ref="source" id="code-mirror">
                    <xf:alert ref="$resources/dialog-edit-source/source/alert"/>
                </fr:code-mirror>
                <xh:div class="fr-dialog-buttons">
                    <xh:span>
                        <xf:trigger appearance="xxf:primary" id="apply-trigger" ref="apply-trigger">
                            <xf:label ref="$resources/apply/label"/>
                        </xf:trigger>
                        <xf:output value="$resources/or/label"/>
                        <xf:trigger appearance="minimal" id="cancel-trigger">
                            <xf:label ref="$resources/cancel/label"/>
                        </xf:trigger>
                    </xh:span>
                </xh:div>
            </xxf:dialog>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
