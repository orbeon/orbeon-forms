<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:OpenSelectSupport="java:org.orbeon.xbl.OpenSelectSupportJava">

    <xbl:binding
        id="fr-tags-input"
        element="fr|tags-input"
        xxbl:container="span"
        xxbl:mode="lhha binding value focus javascript-lifecycle"
        xxbl:label-for="tags-input">

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Tags</display-name>
            <display-name lang="fr">Étiquettes (Tags)</display-name>
            <display-name lang="no">Stikkord (Tags)</display-name>
            <display-name lang="ru">Теги</display-name>
            <display-name lang="it">Tag</display-name>
            <display-name lang="de">Schlagwörter (Tags)</display-name>
            <display-name lang="fi">Tunnisteet (Tags)</display-name>
            <display-name lang="es">Etiquetas (Tags)</display-name>
            <display-name lang="nl">Tags</display-name>
            <display-name lang="pt">Etiquetas (Tags)</display-name>
            <display-name lang="sv">Taggar</display-name>
            <display-name lang="ar">الوسوم (Tags)</display-name>
            <display-name lang="pl">Tagi</display-name>
            <display-name lang="ja">タグ</display-name>
            <icon>
                <icon-class>fa fa-fw fa-tags</icon-class>
            </icon>
            <templates>
                <view>
                    <fr:tags-input id="" ref="" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </fr:tags-input>
                </view>
            </templates>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/open-select/open-select.css"/>
        </xbl:resources>

        <xbl:handlers>
            <xbl:handler event="xforms-enabled xforms-readonly xforms-readwrite" phase="target">
                <xf:setvalue
                    ref="instance('i')/readonly"
                    value="xxf:is-control-readonly('fr-tags-input')"/>
            </xbl:handler>
        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="tags-input-model">
                <xf:instance id="i" xxf:exclude-result-prefixes="#all">
                    <_>
                        <readonly>false</readonly>
                    </_>
                </xf:instance>
            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:group appearance="xxf:internal">

                <xf:var name="binding" value="xxf:binding('fr-tags-input')"/>
                <xf:var
                    name="view"
                    value="
                        property('xxf:readonly-appearance') = 'static' or
                        fr:mode() = 'pdf'
                    "/>

                <xh:div
                    class="fr-open-select-tags-wrapper"
                    data-fr-open-tokens="{string($binding)}"
                    data-fr-readonly="{instance('i')/readonly = 'true'}"
                    data-fr-view="{$view}">

                    <xh:div class="fr-open-select-tags-container{' fr-open-select-tags-disabled'[$view or instance('i')/readonly = 'true']}">
                        <!-- Client-side pills container for interactive mode -->
                        <xh:span class="fr-open-select-pills{' xforms-hidden'[$view]}"/>

                        <!-- Server-rendered static pills for view / Automatic PDF modes -->
                        <xh:span class="fr-open-select-static-pills{' xforms-hidden'[not($view)]}">
                            <xf:repeat ref="xxf:split(string($binding))[$view]">
                                <xh:span class="fr-open-select-pill">
                                    <xf:output class="fr-open-select-pill-label" value="OpenSelectSupport:decodeToken(.)"/>
                                </xh:span>
                            </xf:repeat>
                        </xh:span>

                        <xh:input
                            id="tags-input"
                            type="text"
                            class="fr-open-select-tags-input{' xforms-hidden'[$view]}"
                            xxf:control="true"
                            autocomplete="off"/>
                    </xh:div>

                    <xf:input
                        id="open-tokens-input"
                        ref="$binding"
                        class="fr-open-select-hidden-input xforms-hidden">
                        <xf:label class="xforms-hidden"/>
                        <xf:action event="xforms-value-changed">
                            <xxf:setvisited control="fr-tags-input"/>
                        </xf:action>
                    </xf:input>
                </xh:div>
            </xf:group>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
