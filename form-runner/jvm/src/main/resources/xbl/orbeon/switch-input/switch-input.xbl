<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:oxf="http://www.orbeon.com/oxf/processors"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <xbl:binding
        id="fr-switch-input-binding"
        element="fr|switch-input, xf|input:xxf-type('xs:boolean')[appearance ~= switch]"
        xxbl:mode="lhha custom-lhha -custom-alert -custom-hint binding value selection"
        xxbl:container="span"
        xxbl:label-for="select"
    >

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Toggle Switch</display-name>
            <display-name lang="fr">Interrupteur à bascule</display-name>
            <display-name lang="no">Vippebryter</display-name>
            <display-name lang="ru">Переключатель</display-name>
            <display-name lang="it">Interruttore</display-name>
            <display-name lang="de">Kippschalter</display-name>
            <display-name lang="fi">Kytkin</display-name>
            <display-name lang="es">Interruptor</display-name>
            <display-name lang="nl">Tuimelschakelaar</display-name>
            <display-name lang="pt">Interruptor</display-name>
            <display-name lang="sv">Vippströmbrytare</display-name>
            <display-name lang="ar">مفتاح تبديل</display-name>
            <display-name lang="pl">Przełącznik</display-name>
            <display-name lang="ja">トグルスイッチ</display-name>
            <icon>
                <icon-class>fa fa-fw fa-toggle-on</icon-class>
            </icon>
            <templates>
                <bind type="xf:boolean"/>
                <instance>false</instance>
                <view>
                    <fr:switch-input>
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </fr:switch-input>
                </view>
            </templates>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/switch-input/switch-input.css"/>
        </xbl:resources>

        <xbl:handlers>
            <!-- As done for XForms selection controls, consider the control visited on selection -->
            <xbl:handler event="xforms-select xforms-deselect" observer="select">
                <xxf:setvisited control="fr-switch-input-binding"/>
            </xbl:handler>
        </xbl:handlers>

        <xbl:template xxbl:transform="oxf:unsafe-xslt">
            <xf:select
                id="select"
                appearance="full"
                role="switch"
                ref="xxf:binding('fr-switch-input-binding')"

                class="xforms-help-popover-control"
                xsl:version="2.0"
            >
                <xsl:variable name="root" select="/*[1]"/>
                <xf:help value="xxf:help('fr-switch-input-binding')"><xsl:copy-of select="$root/xf:help/@mediatype"/></xf:help>
                <xf:item>
                    <xf:label value="xxf:label('fr-switch-input-binding')"><xsl:copy-of select="$root/xf:label/@mediatype"/></xf:label>
                    <xf:hint value="xxf:hint('fr-switch-input-binding')"><xsl:copy-of select="$root/xf:hint/@mediatype"/></xf:hint>
                    <xsl:choose>
                        <xsl:when test="exists($root/@template)">
                            <xf:copy xxbl:scope="outer" xbl:attr="ref=template"/>
                        </xsl:when>
                        <xsl:otherwise>
                            <xf:value xbl:attr="xbl:text=selected-value">true</xf:value>
                        </xsl:otherwise>
                    </xsl:choose>
                </xf:item>
                <xf:action event="xforms-select">
                    <xf:dispatch name="xforms-select" targetid="fr-switch-input-binding"/>
                    <xsl:if test="empty($root/@template)">
                        <!-- Q: Is this necessary? -->
                        <xf:setvalue ref="." xbl:attr="xbl:text=selected-value">true</xf:setvalue>
                    </xsl:if>
                </xf:action>
                <xf:action event="xforms-deselect">
                    <xf:dispatch name="xforms-deselect" targetid="fr-switch-input-binding"/>
                    <xsl:if test="empty($root/@template)">
                        <xf:setvalue ref="." xbl:attr="xbl:text=deselected-value">false</xf:setvalue>
                    </xsl:if>
                </xf:action>
            </xf:select>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
