                                    <item value="-1">Käytä oletusta</item>
                                    <item value="-2">Säilytä</item>
                                </format>
                            </resource>
                            <resource xml:lang="es">
                                <size>
                                    <label>Tamaño de la imagen</label>
                                    <item value="-1">Usar predeterminado</item>
                                    <item value="auto">Automático</item>
                                    <item value="small">Pequeño</item>
                                    <item value="medium">Mediano</item>
                                    <item value="large">Grande</item>
                                </size>
                                <view-mode>
                                    <label>Modo de visualización</label>
                                    <item value="-1">Usar predeterminado</item>
                                    <item value="grid">Cuadrícula</item>
                                    <item value="carousel">Carrusel</item>
                                </view-mode>
                                <carousel-size>
                                    <label>Tamaño del carrusel</label>
                                    <item value="-1">Usar predeterminado</item>
                                    <item value="small">Pequeño</item>
                                    <item value="medium">Mediano</item>
                                    <item value="large">Grande</item>
                                </carousel-size>
                                <columns>
                                    <label>Número de columnas</label>
                                    <item value="-1">Usar predeterminado</item>
                                    <item value="-2">Automático</item>
                                </columns>
                                <max-rows>
                                    <label>Máximo de filas visibles</label>
                                    <item value="-1">Usar predeterminado</item>
                                    <item value="-2">Ilimitado</item>
                                </max-rows>
                                <max-width>
                                    <label>Ajustar ancho máximo a</label>
                                    <item value="-1">Usar predeterminado</item>
                                    <item value="-2">Sin ajuste</item>
                                </max-width>
                                <max-height>
                                    <label>Ajustar alto máximo a</label>
                                </max-height>
                                <quality>
                                    <label>Calidad de la imagen comprimida</label>
                                    <item value="-1">Usar predeterminado</item>
                                    <item value="90">Alta (90%)</item>
                                    <item value="80">Media (80%)</item>
                                    <item value="70">Baja (70%)</item>
                                    <item value="50">Muy baja (50%)</item>
