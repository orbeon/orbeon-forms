<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
         xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
         xmlns:oxf="http://www.orbeon.com/oxf/processors">

    <xbl:script src="/xbl/orbeon/xpath-completion/text-expander-element-bundle.js"/>
    <xbl:binding
            id="fr-xpath-completion"
            element="
                fr|xpath-completion,
                fb|xpath-completion,
                xf|input[appearance ~= xpath-completion],
                xf|textarea[appearance ~= xpath-completion]"
            xxbl:mode="binding lhha value external-value javascript-lifecycle allow-minimal-label-hint"
            xxbl:label-for="field"
            xxbl:container="span"
            xxf:external-events="fr-query-completions">

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/xpath-completion/xpath-completion.css"/>
        </xbl:resources>

        <xbl:handlers>
            <xbl:handler event="fr-query-completions" phase="target" defaultAction="cancel">
                <xf:action type="javascript" xmlns:frf="java:org.orbeon.oxf.fr.FormRunner">
                    <xf:param
                        name="completions"
                        value="frf:controlNameCompletionsJson(event('text'), 15, fr:component-param-value('xpath-completion-updates'))"/>
                    <xf:body>
                        ORBEON.xforms.XBL.instanceForControl(this).returnCompletions(completions);
                    </xf:body>
                </xf:action>
            </xbl:handler>
        </xbl:handlers>

        <xbl:template xxbl:transform="oxf:xslt">
            <xh:span xsl:version="2.0" class="fr-xpath-completion-wrapper">
                <xsl:choose>
                    <xsl:when test="/*/@avt = ('true', 'false')">
                        <xsl:attribute name="data-avt" select="/*/@avt"/>
                    </xsl:when>
                    <xsl:when test="exists(/*/@avt)">
                        <xsl:attribute name="data-avt">{fr:component-param-value('avt') = 'true'}</xsl:attribute>
                    </xsl:when>
                </xsl:choose>
                <xsl:choose>
                    <xsl:when test="/*/@completion = ('true', 'false')">
                        <xsl:attribute name="data-completion" select="/*/@completion"/>
                    </xsl:when>
                    <xsl:when test="exists(/*/@completion)">
                        <xsl:attribute name="data-completion">{fr:component-param-value('completion') = 'true'}</xsl:attribute>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:attribute name="data-completion">{fr:is-form-builder()}</xsl:attribute>
                    </xsl:otherwise>
                </xsl:choose>

                <xf:var
                    name="binding"
                    value="xxf:binding('fr-xpath-completion')"/>

                <xh:div class="fr-xpath-completion-backdrop" aria-hidden="true">
                    <xh:div class="fr-xpath-completion-highlights"/>
                </xh:div>

                <xh:text-expander keys="$" suffix="">
                    <xsl:element name="{name(/*)}">
                        <xsl:attribute name="id"          select="'field'"/>
                        <xsl:attribute name="ref"         select="'$binding'"/>
                        <xsl:attribute name="appearance"  select="tokenize(/*/@appearance, '\s+')[. != 'xpath-completion']"/>
                        <xsl:copy-of select="/*/@incremental"/>
                        <xsl:copy-of select="/*/@mediatype"/>
                    </xsl:element>
                </xh:text-expander>

                <xsl:if test="local-name(/*) = 'textarea'">
                    <xh:div class="fr-xpath-completion-buttons">
                        <xh:button
                            type="button"
                            class="fr-xpath-completion-expand-button"
                            title="Expand"
                            aria-label="Expand"
                            aria-expanded="false"
                            tabindex="-1">
                            <xh:i class="fa fa-expand fa-fw"/>
                        </xh:button>
                        <xsl:if test="not(/*/@avt = 'true')">
                            <xh:button
                                type="button"
                                class="fr-xpath-completion-format-button"
                                title="Format XPath expression (Shift+Alt+F)"
                                aria-label="Format XPath expression"
                                tabindex="-1">
                                <xh:i class="fa fa-wand-magic-sparkles fa-fw"/>
                            </xh:button>
                        </xsl:if>
                        <xh:button
                            type="button"
                            class="fr-xpath-completion-copy-button"
                            title="Copy to clipboard"
                            aria-label="Copy to clipboard"
                            tabindex="-1">
                            <xh:i class="fa fa-copy fa-fw"/>
                        </xh:button>
                    </xh:div>
                </xsl:if>

            </xh:span>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>
