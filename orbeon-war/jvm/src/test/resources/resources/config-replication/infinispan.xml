<?xml version="1.0" encoding="UTF-8"?>
<infinispan
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="urn:infinispan:config:16.2 https://infinispan.org/schemas/infinispan-config-16.2.xsd"
    xmlns="urn:infinispan:config:16.2">

    <cache-container name="orbeon-container" statistics="true">
        <!-- ORBEON: This uses port 7800 "for its JGroups cluster transport" by default. -->
        <transport cluster="orbeon-cluster" stack="tcp"/>

        <serialization marshaller="org.infinispan.commons.marshall.JavaSerializationMarshaller">
          <allow-list>
              <class>org.orbeon.oxf.xforms.state.DynamicState</class>
              <regex>scala.*</regex>
          </allow-list>
        </serialization>

        <global-state>
            <persistent-location path="orbeon/cache" relative-to="orbeon.webapp.tmpdir"/>
        </global-state>

        <!-- XForms dynamic state store -->
        <replicated-cache name="xforms.store.dynamic-states" statistics="true">
            <expiration max-idle="1h" lifespan="7d" interval="1m"/>
            <persistence passivation="true">
                <file-store purge="true" path="xforms.store.dynamic-states" shared="false" compaction-threshold="0.25">
                    <write-behind modification-queue-size="1024" />
                </file-store>
            </persistence>
            <memory max-count="500" when-full="REMOVE"/>
        </replicated-cache>

        <!-- XForms serialized static state store -->
        <replicated-cache name="xforms.store.static-states" statistics="true">
            <expiration max-idle="4h" lifespan="7d" interval="2m"/>
            <persistence passivation="true">
                <file-store purge="true" path="xforms.store.static-states" shared="false" compaction-threshold="0.25">
                    <write-behind modification-queue-size="1024" />
                </file-store>
            </persistence>
            <memory max-count="200" when-full="REMOVE"/>
        </replicated-cache>

        <!-- XForms aggregated JS/CSS asset bundles store -->
        <replicated-cache name="xforms.store.asset-bundles" statistics="true">
            <expiration max-idle="24h" lifespan="7d" interval="5m"/>
            <memory max-count="200" when-full="REMOVE"/>
        </replicated-cache>

        <!-- Form Runner external modes store -->
        <replicated-cache name="fr.store.external-modes" statistics="true">
            <expiration lifespan="16m" interval="2m"/>
            <memory max-count="200" when-full="REMOVE"/>
        </replicated-cache>

        <!-- Form Runner persistence form metadata cache -->
        <local-cache name="fr.cache.form-metadata" statistics="true">
            <expiration lifespan="5m" interval="2m"/>
            <memory max-count="100" when-full="REMOVE"/>
        </local-cache>

        <!-- Configuration properties cache -->
        <local-cache name="core.cache.properties" statistics="true">
            <memory max-count="50" when-full="REMOVE"/>
        </local-cache>

    </cache-container>
</infinispan>
