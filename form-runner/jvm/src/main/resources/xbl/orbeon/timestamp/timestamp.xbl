<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:DateTimeSupport="java:org.orbeon.xbl.DateTimeSupportJava"
>

    <xbl:binding
        id="fr-timestamp"
        element="fr|timestamp"
        xxbl:container="span"
        xxbl:mode="lhha binding value external-value javascript-lifecycle"
        xxbl:label-for="span"
    >

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Timestamp</display-name>
            <display-name lang="fr">Horodatage</display-name>
            <display-name lang="no">Tidsstempel</display-name>
            <display-name lang="ru">Метка времени</display-name>
            <display-name lang="it">Marca temporale</display-name>
            <display-name lang="de">Zeitstempel</display-name>
            <display-name lang="fi">Aikaleima</display-name>
            <display-name lang="es">Marca de tiempo</display-name>
            <display-name lang="nl">Tijdstempel</display-name>
            <display-name lang="pt">Carimbo de tempo</display-name>
            <display-name lang="sv">Tidsstämpel</display-name>
            <display-name lang="ar">طابع زمني</display-name>
            <display-name lang="pl">Znacznik czasu</display-name>
            <display-name lang="ja">タイムスタンプ</display-name>

            <icon>
                <icon-class>fa fa-fw fa-user-clock</icon-class>
            </icon>
            <templates>
                <bind type="xf:dateTime" xxf:default="current-dateTime()"/>
                <view>
                    <fr:timestamp>
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </fr:timestamp>
                </view>
            </templates>
            <custom-settings>
                <setting name="field-width" type="xs:string" values="full natural"/>
            </custom-settings>
            <control-details>
                <xf:model xmlns="" id="fb-editor-timestamp-model">

                    <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
                        <xf:var name="c" value="."/>
                        <xf:setvalue ref="$c" value="instance()/@*[name() = name($c)]"/>
                    </xf:action>

                    <xf:instance id="local" xxf:exclude-result-prefixes="#all">
                        <_>
                            <field-width/>
                        </_>
                    </xf:instance>
                </xf:model>
                <fr:grid xmlns="" id="fb-editor-timestamp-grid">
                    <xh:tr>
                        <xh:td colspan="6">
                            <xf:select1 ref="instance('local')/field-width" appearance="full xxf:horizontal" id="field-width-control">
                                <xf:label ref="xxf:r('xbl-control-settings.field-width', '|fr-form-resources|')"/>
                                <xf:item>
                                    <xf:label ref="xxf:r('xbl-control-settings.default', '|fr-form-resources|')"/>
                                    <xf:value/>
                                </xf:item>
                                <xf:item>
                                    <xf:label ref="xxf:r('xbl-control-settings.full', '|fr-form-resources|')"/>
                                    <xf:value>full</xf:value>
                                </xf:item>
                                <xf:item>
                                    <xf:label ref="xxf:r('xbl-control-settings.natural', '|fr-form-resources|')"/>
                                    <xf:value>natural</xf:value>
                                </xf:item>
                            </xf:select1>
                        </xh:td>
                    </xh:tr>
                </fr:grid>
                <xf:action
                    id="fb-editor-timestamp-action"
                    event="xforms-value-changed"
                    observer="field-width-control">

                    <xf:var name="name"      value="name(event('xxf:binding'))"/>
                    <xf:var name="new-value" value="string(event('xxf:binding'))"/>
                    <xf:insert
                        context="instance()"
                        if="xxf:non-blank($new-value)"
                        origin="xf:attribute($name, $new-value)"/>
                    <xf:delete
                        if="xxf:is-blank($new-value)"
                        ref="instance()/@*[name() = $name]"/>
                </xf:action>
            </control-details>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/timestamp/timestamp.css"/>
        </xbl:resources>

        <xbl:template>
            <xh:span
                id="span"
                class="xforms-field fr-field-width-{fr:component-param-value('field-width')}"
                data-orbeon-output-format="{fr:component-param-value('output-format')}"/>
        </xbl:template>
    </xbl:binding>

    <xbl:binding
        id="fr-timestamp-output"
        element="
            fr|timestamp[fr|pdf-automatic = true],
            fr|timestamp[fr|pdf-template = true]"
        xxbl:mode="lhha binding value"
        xxbl:label-for="output"
    >
        <xbl:template>
            <xf:output
                id="output"
                class="xforms-field"
                value="DateTimeSupport:formatReadonlyModeDateTime(xxf:binding('fr-timestamp-output'), fr:component-param-value('output-format'))"/>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>
