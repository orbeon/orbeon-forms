                            <invalid-json>Некорректный JSON удалённых серверов</invalid-json>
                        </resource>
                        <resource xml:lang="da">
                            <readonly-hint>Aktivér Tilsidesæt for at tilføje, fjerne, omarrangere eller redigere fjernservere.</readonly-hint>
                            <visual-mode>Visuel</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formatér</format-json>
                            <copy-json>Kopiér</copy-json>
                            <add-server>Tilføj fjernserver</add-server>
                            <empty-servers>Ingen fjernservere konfigureret. Klik på "Tilføj fjernserver" for at tilføje en.</empty-servers>
                            <drag-to-reorder>Træk for at ændre rækkefølge</drag-to-reorder>
                            <move-up>Flyt server op</move-up>
                            <move-down>Flyt server ned</move-down>
                            <remove-server>Fjern server</remove-server>
                            <moved-announcement>Flyttede server til position {0} af {1}</moved-announcement>
                            <removed-announcement>Fjernede server</removed-announcement>
                            <label-label>Etiket</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Navn</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Server-URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>UI-adgang (Formularadministration)</ui-access-label>
                            <api-access-label>API-adgang (push/pull)</api-access-label>
                            <alert-url-required>Server-URL er påkrævet</alert-url-required>
                            <alert-duplicate-name>Duplikeret servernavn</alert-duplicate-name>
                            <invalid-json>Ugyldig JSON for fjernservere</invalid-json>
