<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <!--
        Component to represent a month/year control based on drop-down menus.
     -->
    <xbl:binding
        id="fr-dropdown-month-year-binding"
        element="fr|dropdown-month-year, xf|input:xxf-type('xs:gYearMonth')[appearance ~= dropdowns]"
        xxbl:container="span"
        xxbl:mode="lhha binding value"
        xxbl:label-for="fr-dropdown-month-year-elem">

        <!-- Orbeon Form Builder Component Metadata -->
        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Dropdown Month/Year</display-name>
            <display-name lang="fr">Mois/année avec menus</display-name>
            <display-name lang="no">Rullegardinmeny for måned/år</display-name>
            <display-name lang="ru">Месяц и год выпадающим меню</display-name>
            <display-name lang="it">Mese/anno a tendina</display-name>
            <display-name lang="de">Dropdown-Monat/Jahr</display-name>
            <display-name lang="fi">Kuukauden ja vuoden pudotusvalikko</display-name>
            <display-name lang="es">Mes/Año Desplegable</display-name>
            <display-name lang="nl">Selectie maand/jaar</display-name>
            <display-name lang="pt">Lista de Opções para Mês/Ano</display-name>
            <display-name lang="sv">Månad/år med rullgardinsmeny</display-name>
            <display-name lang="ar">شهر وسنة منسدلة</display-name>
            <display-name lang="pl">Miesiąc/rok w liście rozwijanej</display-name>
            <display-name lang="ja">ドロップダウン年月</display-name>
            <icon>
                <icon-class>fa fa-fw fa-calendar</icon-class>
            </icon>
            <templates>
                <bind type="xf:gYearMonth"/>
                <view>
                    <fr:dropdown-month-year>
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </fr:dropdown-month-year>
                </view>
            </templates>
            <custom-settings>
                <setting name="start-year" type="xs:string"/>
                <setting name="end-year" type="xs:string"/>
            </custom-settings>
            <control-details>
                <xf:model xmlns="">

                    <xf:action event="xforms-model-construct-done">
                        <xf:action iterate="instance('local')/*">
                            <xf:var name="c" value="."/>
                            <xf:setvalue
                                ref="$c"
                                value="(instance()/@*[name() = name($c)], $c/@default)[1]"/>
                        </xf:action>
                    </xf:action>

                    <xf:instance id="local" xxf:exclude-result-prefixes="#all">
                        <_>
                            <start-year default=""/>
                            <end-year   default=""/>
                        </_>
                    </xf:instance>

                    <xf:bind ref="instance('local')">
                        <xf:bind
                            ref="start-year | end-year"
                            xxf:whitespace="trim"
                            type="xxf:XPath2ValueTemplate"/>
                    </xf:bind>

                    <xf:instance id="fr-form-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                        <_>
                            <resource xml:lang="en">
                                <start-year>
                                    <label>Start year</label>
                                    <hint>Constant or XPath value template</hint>
                                </start-year>
                                <end-year>
                                    <label>End year</label>
                                    <hint>Constant or XPath value template</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="fr">
                                <start-year>
                                    <label>Année de début</label>
                                    <hint>Constante ou modèle XPath</hint>
                                </start-year>
                                <end-year>
                                    <label>Année de fin</label>
                                    <hint>Constante ou modèle XPath</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="ar">
                                <start-year>
                                    <label>سنة البداية</label>
                                    <hint>قيمة ثابتة أو قالب XPath</hint>
                                </start-year>
                                <end-year>
                                    <label>سنة النهاية</label>
                                    <hint>قيمة ثابتة أو قالب XPath</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="no">
                                <start-year>
                                    <label>Startår</label>
                                    <hint>Konstant eller XPath-mal</hint>
                                </start-year>
                                <end-year>
                                    <label>Sluttår</label>
                                    <hint>Konstant eller XPath-mal</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="ru">
                                <start-year>
                                    <label>Начальный год</label>
                                    <hint>Константа или шаблон значения XPath</hint>
                                </start-year>
                                <end-year>
                                    <label>Конечный год</label>
                                    <hint>Константа или шаблон значения XPath</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="it">
                                <start-year>
                                    <label>Anno iniziale</label>
                                    <hint>Costante o modello di valore XPath</hint>
                                </start-year>
                                <end-year>
                                    <label>Anno finale</label>
                                    <hint>Costante o modello di valore XPath</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="de">
                                <start-year>
                                    <label>Startjahr</label>
                                    <hint>Konstante oder XPath-Wertvorlage</hint>
                                </start-year>
                                <end-year>
                                    <label>Endjahr</label>
                                    <hint>Konstante oder XPath-Wertvorlage</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="fi">
                                <start-year>
                                    <label>Alkuvuosi</label>
                                    <hint>Vakio tai XPath-arvopohja</hint>
                                </start-year>
                                <end-year>
                                    <label>Loppuvuosi</label>
                                    <hint>Vakio tai XPath-arvopohja</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="es">
                                <start-year>
                                    <label>Año inicial</label>
                                    <hint>Constante o plantilla de valor XPath</hint>
                                </start-year>
                                <end-year>
                                    <label>Año final</label>
                                    <hint>Constante o plantilla de valor XPath</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="nl">
                                <start-year>
                                    <label>Startjaar</label>
                                    <hint>Constante of XPath-waardesjabloon</hint>
                                </start-year>
                                <end-year>
                                    <label>Eindjaar</label>
                                    <hint>Constante of XPath-waardesjabloon</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="pt">
                                <start-year>
                                    <label>Ano inicial</label>
                                    <hint>Constante ou modelo de valor XPath</hint>
                                </start-year>
                                <end-year>
                                    <label>Ano final</label>
                                    <hint>Constante ou modelo de valor XPath</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="sv">
                                <start-year>
                                    <label>Startår</label>
                                    <hint>Konstant eller XPath-värdemall</hint>
                                </start-year>
                                <end-year>
                                    <label>Slutår</label>
                                    <hint>Konstant eller XPath-värdemall</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="pl">
                                <start-year>
                                    <label>Rok początkowy</label>
                                    <hint>Stała lub szablon wartości XPath</hint>
                                </start-year>
                                <end-year>
                                    <label>Rok końcowy</label>
                                    <hint>Stała lub szablon wartości XPath</hint>
                                </end-year>
                            </resource>
                            <resource xml:lang="ja">
                                <start-year>
                                    <label>開始年</label>
                                    <hint>定数またはXPath値テンプレート</hint>
                                </start-year>
                                <end-year>
                                    <label>終了年</label>
                                    <hint>定数またはXPath値テンプレート</hint>
                                </end-year>
                            </resource>
                        </_>
                    </xf:instance>

                </xf:model>
                <fr:grid xmlns="" id="fb-editor-dropdown-month-year-grid">
                    <fr:c x="1" y="1" w="6">
                        <xf:input ref="instance('local')/start-year" id="start-year-control" appearance="xpath-completion" avt="true">
                            <xf:label ref="xxf:r('start-year.label')"/>
                            <xf:hint ref="xxf:r('start-year.hint')"/>
                            <xf:alert ref="xxf:r('detail.labels.alert', '|fr-fr-resources|')"/>
                        </xf:input>
                    </fr:c>
                    <fr:c x="7" y="1" w="6">
                        <xf:input ref="instance('local')/end-year" id="end-year-control" appearance="xpath-completion" avt="true">
                            <xf:label ref="xxf:r('end-year.label')"/>
                            <xf:hint ref="xxf:r('end-year.hint')"/>
                            <xf:alert ref="xxf:r('detail.labels.alert', '|fr-fr-resources|')"/>
                        </xf:input>
                    </fr:c>
                </fr:grid>
                <xf:action
                    id="fb-editor-dropdown-month-year-action"
                    event="xforms-value-changed"
                    observer="
                        start-year-control
                        end-year-control">

                    <xf:var
                        name="name"
                        value="name(event('xxf:binding'))"/>

                    <xf:var
                        name="new-value"
                        value="
                            let $binding := event('xxf:binding'),
                                $v       := string($binding),
                                $default := $binding/@default/string()
                            return
                                if ($v != $default) then
                                    $v
                                else
                                    ()
                        "/>

                    <xf:insert
                        context="instance()"
                        if="exists($new-value)"
                        origin="xf:attribute($name, $new-value)"/>
                    <xf:delete
                        if="empty($new-value)"
                        ref="instance()/@*[name() = $name]"/>
                </xf:action>
            </control-details>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/dropdown-month-year/dropdown-month-year.css"/>
        </xbl:resources>
        <xbl:handlers>
            <!-- Propagate readonly -->
            <xbl:handler event="xforms-enabled xforms-readonly xforms-readwrite" phase="target">
                <xf:setvalue
                    ref="instance('i')/is-readonly"
                    value="xxf:is-control-readonly('fr-dropdown-month-year-binding')"/>
            </xbl:handler>
        </xbl:handlers>
        <xbl:implementation>
            <!-- Local model -->
            <xf:model id="month-year-model">
                <xf:instance id="i">
                    <_>
                        <!-- Individual components of the year/month -->
                        <year/>
                        <month/>
                        <!-- Whether the resulting year/month is valid -->
                        <is-valid/>
                        <!-- Whether the values are readonly -->
                        <is-readonly/>
                    </_>
                </xf:instance>

                <!-- Make instance read-only when the form must be read-only -->
                <xf:bind ref="." readonly="is-readonly = 'true'"/>

                <xf:instance id="years-itemset">
                    <_ start="" end=""/>
                </xf:instance>

                <xf:instance id="months-itemset">
                    <_/>
                </xf:instance>

                <!-- Initialize itemsets upon initialization -->
                <xf:action event="xxforms-instances-ready" if="empty(instance('years-itemset')/*)">

                    <xf:action iterate="instance('years-itemset')/@*">
                        <xf:var name="start-end" value="."/>
                        <xf:setvalue
                            ref="$start-end"
                            value="
                                let $param-name := concat(local-name($start-end), '-year'),
                                    $r          := fr:component-param-value($param-name)
                                return
                                    if ($r castable as xs:integer) then
                                        $r cast as xs:integer
                                    else
                                        xxf:evaluate($r)
                            "/>
                    </xf:action>

                    <xf:var name="start-year" value="instance('years-itemset')/@start" as="xs:integer"/>
                    <xf:var name="end-year"   value="instance('years-itemset')/@end  " as="xs:integer"/>

                    <xf:action iterate="if ($start-year le $end-year) then ($start-year to $end-year) else reverse($end-year to $start-year)">
                        <xf:var name="year" value="." as="xs:string"/>
                        <xf:insert context="instance('years-itemset')" origin="xf:element('year', $year)"/>
                    </xf:action>
                    <xf:action iterate="1 to 12">
                        <xf:var name="month" value="." as="xs:string"/>
                        <xf:insert context="instance('months-itemset')" ref="*" origin="xf:element('month', $month)"/>
                    </xf:action>
                </xf:action>
            </xf:model>
        </xbl:implementation>
        <xbl:template>
            <!-- Read external value -->
            <xf:var
                name="binding"
                value="xxf:binding('fr-dropdown-month-year-binding')"/>
            <xf:var
                name="view"
                value="is-readonly = 'true' and property('xxf:readonly-appearance') = 'static'"/>
            <xf:var name="value" as="xs:string" value="xxf:value('fr-dropdown-month-year-binding')">
                <xf:action event="xforms-value-changed xforms-enabled">

                    <!-- Only set local values if the bound node is a valid `xs:gYearMonth` -->
                    <xf:action if="$value castable as xs:gYearMonth and concat($value, '-01') castable as xs:date">
                        <xf:var name="as-date" value="xs:date(concat($value, '-01'))"/>
                        <xf:setvalue ref="instance('i')/year"  value="year-from-date ($as-date)"/>
                        <xf:setvalue ref="instance('i')/month" value="month-from-date($as-date)"/>
                    </xf:action>
                    <xf:action if="not($value castable as xs:gYearMonth) and xxf:is-blank($value)">
                        <xf:setvalue ref="instance('i')/year"/>
                        <xf:setvalue ref="instance('i')/month"/>
                    </xf:action>
                    <xf:action if="not($value castable as xs:gYearMonth) and count(tokenize($value, '-')) ge 2">
                        <xf:action iterate="tokenize($value, '-')[position() le 2]">
                            <xf:var name="position" value="position()" as="xs:integer"/>
                            <xf:setvalue ref="instance('i')/*[$position]"
                                         value="if (context() castable as xs:integer) then xs:integer(context()) else ''"/>
                        </xf:action>
                    </xf:action>
                </xf:action>
            </xf:var>

            <xh:div id="fr-dropdown-month-year-elem" class="fr-component-group" xxf:control="true">
                <xf:group ref=".[not($view)]">
                    <!-- Don't show fields at all in static readonly mode -->
                    <xf:var name="month-label" value="xxf:r('components.date-time.month', '|fr-fr-resources|')"/>
                    <xf:var name="year-label"  value="xxf:r('components.date-time.year',  '|fr-fr-resources|')"/>

                    <xf:select1 ref="month" id="month-select" xxf:title="{$month-label}" xbl:attr="xxf:encrypt-item-values">
                        <xf:item>
                            <xf:label value="$month-label"/>
                            <xf:value/>
                        </xf:item>
                        <xf:itemset ref="instance('months-itemset')/month">
                            <xf:label ref="."/>
                            <xf:value ref="."/>
                        </xf:itemset>
                    </xf:select1>
                    <xf:select1 ref="year" id="year-select" xxf:title="{$year-label}" xbl:attr="navindex navindex=tabindex xxf:encrypt-item-values">
                        <xf:item>
                            <xf:label value="$year-label"/>
                            <xf:value/>
                        </xf:item>
                        <xf:itemset ref="instance('years-itemset')/year">
                            <xf:label ref="."/>
                            <xf:value ref="."/>
                        </xf:itemset>
                    </xf:select1>

                    <!-- React to update to local values -->
                    <xf:action event="xforms-enabled xforms-value-changed">
                        <xf:var name="empty" value="xxf:is-blank(string-join((year, month), ''))" as="xs:boolean"/>
                        <xf:action if="$empty">
                            <xf:setvalue ref="is-valid" value="valid($binding)"/>
                            <xf:setvalue ref="$binding"/>
                        </xf:action>
                        <xf:action if="not($empty)">
                            <!-- Compute year and month parts -->
                            <xf:var name="y" value="if (year castable as xs:integer)  then format-number(xs:integer(year), '0000') else '____'"/>
                            <xf:var name="m" value="if (month castable as xs:integer) then format-number(xs:integer(month), '00')  else '__'"/>

                            <!-- Create year-month string -->
                            <xf:var name="year-month-string" value="string-join(($y, $m), '-')"/>

                            <!-- Set value to format like 2026-__ or ____-11 if parts are unknown -->
                            <xf:setvalue ref="is-valid" value="$year-month-string castable as xs:gYearMonth"/>
                            <xf:setvalue ref="$binding" value="$year-month-string"/>
                        </xf:action>
                    </xf:action>
                </xf:group>
                <xf:group ref=".[$view]">
                    <!-- Static readonly mode -->
                    <xf:input ref="$binding"/>
                </xf:group>
            </xh:div>
        </xbl:template>
    </xbl:binding>

    <xbl:binding
        id="fr-dropdown-month-year-output"
        element="fr|dropdown-month-year[fr|static-readonly = true]"
        xxbl:mode="lhha binding value"
        xxbl:label-for="input"
    >
        <xbl:resources>
            <xbl:style src="/xbl/orbeon/dropdown-month-year/dropdown-month-year.css"/>
        </xbl:resources>
        <xbl:template>
            <xf:input
                id="input"
                ref="xxf:binding('fr-dropdown-month-year-output')"
                xbl:attr="xxf:readonly-appearance"/>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>
