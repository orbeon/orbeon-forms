                    </xf:instance>

                </xf:model>
                <fr:grid xmlns="" id="fb-editor-image-attachment-grid">
                    <fr:c x="1" y="1" w="12">
                        <xf:select1
                            ref="instance('local')/size"
                            appearance="full xxf:horizontal"
                            id="size-control">
                            <xf:label ref="fr:r('size.label')"/>
                            <xf:itemset ref="xxf:resource-elements('size.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>
                        </xf:select1>
                    </fr:c>
                    <fr:c x="1" y="2" w="12">
                        <xf:select1
                            ref="instance('local')/view-mode"
                            appearance="full xxf:horizontal"
                            id="view-mode-control">
                            <xf:label ref="fr:r('view-mode.label')"/>
                            <xf:itemset ref="xxf:resource-elements('view-mode.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>
                        </xf:select1>
                    </fr:c>
                    <fr:c x="1" y="3" w="12">
                        <xf:select1
                            ref="instance('local')/carousel-size"
                            appearance="full xxf:horizontal"
                            id="carousel-size-control">
                            <xf:label ref="fr:r('carousel-size.label')"/>
                            <xf:itemset ref="xxf:resource-elements('carousel-size.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>
                        </xf:select1>
                    </fr:c>
                    <fr:c x="1" y="4" w="6">
                        <fr:open-select1
                            ref="instance('local')/columns"
                            appearance="minimal"
                            id="columns-control"
                            type="integer">
                            <xf:label ref="fr:r('columns.label')"/>
                            <xf:alert ref="fr:r('components.parameters-editor.name.alert', '|fr-form-resources|')"/>
                            <xf:itemset ref="xxf:resource-elements('columns.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>
                        </fr:open-select1>
                    </fr:c>
                    <fr:c x="7" y="4" w="6">
                        <fr:open-select1
                            ref="instance('local')/max-rows"
                            appearance="minimal"
                            id="max-rows-control"
                            type="integer">
                            <xf:label ref="fr:r('max-rows.label')"/>
                            <xf:alert ref="fr:r('components.parameters-editor.name.alert', '|fr-form-resources|')"/>
                            <xf:itemset ref="xxf:resource-elements('max-rows.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>
                        </fr:open-select1>
                    </fr:c>
                    <fr:c x="1" y="5" w="6">
                        <fr:open-select1
                            ref="instance('local')/max-width"
                            appearance="minimal"
                            id="max-width-control"

                            type="integer"

                            suffix="px">
                            <xf:label ref="fr:r('max-width.label')"/>
                            <xf:alert ref="fr:r('components.parameters-editor.name.alert', '|fr-form-resources|')"/>

                            <xf:itemset ref="xxf:resource-elements('max-width.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>

                        </fr:open-select1>
                    </fr:c>
                    <fr:c x="7" y="5" w="6">
                        <fr:open-select1
                            ref="instance('local')/max-height"
                            appearance="minimal"
                            id="max-height-control"

                            type="integer"

                            suffix="px">
                            <xf:label ref="fr:r('max-height.label')"/>
                            <xf:alert ref="fr:r('components.parameters-editor.name.alert', '|fr-form-resources|')"/>

                            <xf:itemset ref="xxf:resource-elements('max-width.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>

                        </fr:open-select1>
                    </fr:c>
                    <fr:c x="1" y="6" w="6">
                        <xf:select1 ref="instance('local')/format" id="format-control">
                            <xf:label ref="fr:r('format.label')"/>
                            <xf:itemset ref="xxf:resource-elements('format.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>
                            <xf:item>
                                <xf:label>JPEG</xf:label>
                                <xf:value>jpg</xf:value>
                            </xf:item>
                            <xf:item>
                                <xf:label>PNG</xf:label>
                                <xf:value>png</xf:value>
                            </xf:item>
                        </xf:select1>
                    </fr:c>
                    <fr:c x="7" y="6" w="6">
                        <fr:open-select1
                            ref="instance('local')/quality"
                            appearance="minimal"
                            id="quality-control"

                            type="integer"

                            suffix="%"
                            digits-after-decimal="0"
                            round-when-storing="true"
                            round-when-formatting="true">

                            <xf:label ref="fr:r('quality.label')"/>
                            <xf:alert ref="fr:r('components.parameters-editor.name.alert', '|fr-form-resources|')"/>

                            <xf:itemset ref="xxf:resource-elements('quality.item')">
                                <xf:label ref="."/>
                                <xf:value ref="@value"/>
                            </xf:itemset>

                        </fr:open-select1>
                    </fr:c>
                </fr:grid>
                <xf:action
                    id="fb-editor-action"
                    event="xforms-value-changed"
                    observer="
                        size-control
                        view-mode-control
                        carousel-size-control
                        columns-control
                        max-rows-control
                        max-width-control
                        max-height-control
                        quality-control
                        format-control">

                    <xf:var
                        name="param-name"
                        value="name(event('xxf:binding'))"/>

                    <xf:var
                        name="att-name"
                        value="
                            if ($param-name = ('size', 'view-mode', 'carousel-size', 'columns', 'max-rows')) then
                                $param-name
                            else
                                concat('transform-', $param-name)"/>

                    <xf:var
                        name="new-value"
                        value="
                            let $binding := event('xxf:binding'),
                                $v       := $binding/string(),
                                $default := $binding/@default/string()
                            return
                                if ($v = '-1') then
                                    ()
                                else if ($v = $default) then
                                    ''
                                else
                                    $v
                        "/>

                    <xf:insert
                        context="instance()"
                        if="exists($new-value)"
                        origin="
                            xf:attribute($att-name, $new-value)"/>
                    <xf:delete
                        if="empty($new-value)"
                        ref="instance()/@*[name() = $att-name]"/>
                </xf:action>
            </control-details>

        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/image-attachment/image-attachment.css"/>
        </xbl:resources>

        <xbl:implementation>
            <xf:model>
                <xf:instance id="orbeon-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <_>
                        <resource xml:lang="en">
                            <zoom>Expand image</zoom>
