                                <invalid-boolean>Deve essere "true", "false" o un'espressione AVT</invalid-boolean>
                                <invalid-choice>Valore del parametro non valido</invalid-choice>
                                <invalid-token>Contiene un valore non supportato</invalid-token>
                                <invalid-duration>Deve essere una durata valida con unità (es. 1000ms o 5s)</invalid-duration>
                                <invalid-at>Deve essere "start", "end", "all" o un numero intero positivo</invalid-at>
                                <invalid-mode>Modalità di destinazione non supportata</invalid-mode>
                                <invalid-ncname>Deve essere un identificatore XML valido</invalid-ncname>
