<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
        xmlns:frf="java:org.orbeon.oxf.fr.FormRunner">

    <xbl:binding
        id="fr-card-published-forms"
        element="fr|card-published-forms"
        xxbl:mode="lhha custom-lhha binding"
    >
        <xbl:implementation>
            <xf:model>

                <xf:var
                    name="page-size"
                    value="xs:integer(xxf:property('oxf.fr.landing.page-size'))"/>

                <xf:var
                    name="tz"
                    value="
                        for $offset in frf:defaultTimezoneToOffsetString()
                        return xs:dayTimeDuration($offset)"/>

                <xf:var
                    name="link-to-tokens"
                    value="
                        let $tokens := xxf:split(fr:component-param-value('link-to'))[. = ('new', 'summary')]
                        return
                            if (empty($tokens)) then
                                'summary' (: default for backward compatibility :)
                            else
                                $tokens
                    "/>

                <xf:instance id="fr-search-request-instance" xxf:exclude-result-prefixes="#all">
                    <search ignore-admin-permissions="true" xml:lang=""/>
                </xf:instance>

                <xf:instance id="fr-forms-instance" xxf:exclude-result-prefixes="#all">
                    <_ state="initial"/>
                </xf:instance>

                <xf:submission
                    id="fr-read-demo-forms-submission"
                    method="post"
                    ref="instance('fr-search-request-instance')"
                    serialization="application/xml"
                    mediatype="application/xml"
                    resource="/fr/service/persistence/form"
                    replace="instance"
                    targetref="instance('fr-forms-instance')"
                    mode="asynchronous"
                    xxf:response-must-await="200ms"
                >
                    <xf:action event="xforms-submit">
                        <xf:var
                            name="app"
                            value="fr:component-param-value('app')[xxf:non-blank()]"/>

                        <xf:var
                            name="sort-by"
                            value="(fr:component-param-value('sort-by')[xxf:non-blank()], 'last-modified')[1]"/>

                        <xf:var
                            name="sort-direction"
                            value="
                                let $direction := fr:component-param-value('sort-direction')[. = ('asc', 'desc', 'ascending', 'descending')],
                                    $adjusted  := if ($direction = 'ascending') then 'asc' else if ($direction = 'descending') then 'desc' else $direction
                                return
                                    if (empty($adjusted)) then
                                        if ($sort-by = ('created', 'last-modified')) then 'desc' else 'asc'
                                    else
                                        $adjusted"/>

                        <xf:var
                            name="operations-filter"
                            value="
                                string-join(
                                    (
                                        'create'[$link-to-tokens = 'new'],
                                        'list'  [$link-to-tokens = 'summary']
                                    ),
                                    ' '
                                )"/>

                        <xf:insert
                            ref="instance('fr-forms-instance')"
                            origin="xf:element('_', xf:attribute('state', 'loading'))"/>

                        <xf:setvalue
                            ref="instance('fr-search-request-instance')/@xml:lang"
                            value="xxf:lang()"/>

                        <xf:delete
                            ref="instance('fr-search-request-instance')/*"/>

                        <xf:insert
                            context="instance('fr-search-request-instance')"
                            origin="
                                (
                                    for $a in $app
                                    return xf:element('filter', (xf:attribute('metadata', 'application-name'), xf:attribute('match', 'exact'), $a)),
                                    xf:element('filter', (xf:attribute('metadata', 'form-version'), xf:attribute('match', 'exact'), 'latest')),
                                    xf:element('filter', (xf:attribute('metadata', 'operations'),   xf:attribute('match', 'token'), xf:attribute('combinator', 'or'), $operations-filter)),
                                    xf:element('sort',   (xf:attribute('metadata', $sort-by), xf:attribute('direction', $sort-direction)))
                                )"/>
                    </xf:action>

                    <xf:setvalue
                        event="xforms-submit-error"
                        ref="instance('fr-forms-instance')/@state"
                        value="'error'"/>
                </xf:submission>

                <xf:action event="xforms-model-construct-done">
                    <xf:send submission="fr-read-demo-forms-submission"/>
                </xf:action>
            </xf:model>
        </xbl:implementation>
        <xbl:template>
            <fr:card
                    status="{(instance('fr-forms-instance')/@state, 'done')[1]}"
                >
                <xf:label ref="xxf:label('fr-card-published-forms')"/>
                <xf:itemset ref="instance('fr-forms-instance')/*[position() le $page-size]">
                    <!-- 2022-12-30: Don't use `<description>` as 1. it's not present with relational and 2. it can
                         be in HTML and shows unescaped markup in the list. Not ideal. -->
<!--                        <xf:label ref="string-join(((title[@xml:lang = xxf:lang()], title)[normalize-space()][1], (description[@xml:lang = xxf:lang()], description)[normalize-space()][1]), ' - ')"/>-->
                    <xf:label ref="(title[@xml:lang = xxf:lang()], title)[normalize-space()][1]"/>
                    <xf:value ref="
                        let $ops                  := xxf:split(@operations),
                            $can-navigate-summary := $ops = ('*', 'list'),
                            $can-navigate-new     := $ops = ('*', 'create'),
                            $link-to              := $link-to-tokens[
                                                         (. = 'summary' and $can-navigate-summary) or
                                                         (. = 'new'     and $can-navigate-new)
                                                     ][1]
                        return
                            if (empty($link-to)) then (: This should not happen as we search only for forms which have at least one of the permissions :)
                                concat('#', string-join((application-name, form-name, form-version), '/'))
                            else
                                concat(
                                    '/fr/',
                                    application-name,
                                    '/',
                                    form-name,
                                    '/',
                                    $link-to,
                                    '?form-version=',
                                    form-version
                                )"/>
                    <!-- This doesn't work because we remove the form description from the metadata -->
<!--                        <xf:hint ref="(description[@xml:lang = xxf:lang()], description)[normalize-space()][1]"/>-->
                </xf:itemset>
                <xf:itemset ref=".[count(instance('fr-forms-instance')/*) gt $page-size]">
                    <xf:label ref="xxf:r('landing.show-more', '|fr-fr-resources|')"/>
                    <!-- https://github.com/orbeon/orbeon-forms/issues/5255
                         https://github.com/orbeon/orbeon-forms/issues/5274 -->
                    <xf:value
                        ref="
                            string-join(
                                (
                                    '/fr/forms',
                                    if (xxf:non-blank(fr:component-param-value('app'))) then
                                        ('?fr-search-app=exact:', fr:component-param-value('app'))
                                    else
                                        ()
                                ),
                                ''
                            )"/>
                </xf:itemset>
                <fr:card-body>
                    <xh:p class="card-text lead"><xf:output ref="xxf:help('fr-card-published-forms')"/></xh:p>
                </fr:card-body>
                <fr:card-thumbnail>
                    <xh:img src="{fr:component-param-value('thumbnail')}" class="img-thumbnail img-invertible"/>
                </fr:card-thumbnail>
                <fr:card-footer>
                    <xh:span>
                        <xf:output value="
                            (: TODO: Make this a reusable function :)
                            let $date-time := max(instance('fr-forms-instance')/*/last-modified-time/xs:dateTime(.)),
                                $v :=
                                    if (exists($tz)) then
                                        adjust-dateTime-to-timezone(
                                            $date-time,
                                            $tz
                                        )
                                    else
                                        adjust-dateTime-to-timezone(
                                            $date-time
                                        )
                            return
                                if (current-dateTime() - $v lt xs:dayTimeDuration('P1D'))
                                then format-dateTime($v, xxf:r('common.formats.within-day', '|fr-fr-resources|'), xxf:lang(), (), ())
                                else if (year-from-dateTime(current-dateTime()) = year-from-dateTime($v))
                                then format-dateTime($v, xxf:r('common.formats.day-this-year', '|fr-fr-resources|'), xxf:lang(), (), ())
                                else format-dateTime($v, xxf:r('common.formats.short-date', '|fr-fr-resources|'), xxf:lang(), (), ())">
                            <xf:label ref="xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')"/>
                        </xf:output>
                    </xh:span>
                </fr:card-footer>
            </fr:card>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
