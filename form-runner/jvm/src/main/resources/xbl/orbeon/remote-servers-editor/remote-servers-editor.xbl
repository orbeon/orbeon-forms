                            <drag-to-reorder>Yeniden sıralamak için sürükleyin</drag-to-reorder>
                            <move-up>Sunucuyu yukarı taşı</move-up>
                            <move-down>Sunucuyu aşağı taşı</move-down>
                            <remove-server>Sunucuyu kaldır</remove-server>
                            <moved-announcement>Sunucu {0} / {1} konumuna taşındı</moved-announcement>
                            <removed-announcement>Sunucu kaldırıldı</removed-announcement>
                            <label-label>Etiket</label-label>
                            <label-placeholder>Hazırlık</label-placeholder>
                            <name-label>Ad</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Sunucu URL'si</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>Arayüz erişimi (Form Yönetimi)</ui-access-label>
                            <api-access-label>API erişimi (push/pull)</api-access-label>
                            <alert-url-required>Sunucu URL'si gereklidir</alert-url-required>
                            <alert-duplicate-name>Yinelenen sunucu adı</alert-duplicate-name>
