<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:rse="java:org.orbeon.oxf.fr.RemoteServersEditorUI">

    <xbl:binding
        id="fr-remote-servers-editor"
        element="fr|remote-servers-editor"
        xxbl:mode="lhha binding value">

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/remote-servers-editor/remote-servers-editor.css"/>
        </xbl:resources>

        <xbl:implementation>
            <xf:model id="remote-servers-editor-model">

                <xf:instance id="editor" xxf:exclude-result-prefixes="#all">
                    <editor>
                        <servers/>
                    </editor>
                </xf:instance>

                <xf:instance id="server-template" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <server name="" label="" url="" ui-access="true" api-access="false"/>
                </xf:instance>

                <xf:instance id="state" xxf:exclude-result-prefixes="#all">
                    <state
                        initialized="false"
                        readonly="true"
                        syncing="false"
                        mode="visual"
                        last-json=""
                        announcement="">
                        <raw-json/>
                    </state>
                </xf:instance>

                <xf:instance id="orbeon-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <_>
                        <resource xml:lang="en">
                            <readonly-hint>Enable Override to add, remove, reorder, or edit remote servers.</readonly-hint>
                            <visual-mode>Visual</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Format</format-json>
                            <copy-json>Copy</copy-json>
                            <add-server>Add remote server</add-server>
                            <empty-servers>No remote servers configured. Click "Add remote server" to add one.</empty-servers>
                            <drag-to-reorder>Drag to reorder</drag-to-reorder>
                            <move-up>Move server up</move-up>
                            <move-down>Move server down</move-down>
                            <remove-server>Remove server</remove-server>
                            <moved-announcement>Moved server to position {0} of {1}</moved-announcement>
                            <removed-announcement>Removed server</removed-announcement>
                            <label-label>Label</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Name</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Server URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>UI access (Forms Admin)</ui-access-label>
                            <api-access-label>API access (push/pull)</api-access-label>
                            <alert-url-required>Server URL is required</alert-url-required>
                            <alert-duplicate-name>Duplicate server name</alert-duplicate-name>
                            <invalid-json>Invalid remote servers JSON</invalid-json>
                        </resource>
                        <resource xml:lang="fr">
                            <readonly-hint>Activez Surcharger pour ajouter, supprimer, réordonner ou modifier les serveurs distants.</readonly-hint>
                            <visual-mode>Visuel</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formater</format-json>
                            <copy-json>Copier</copy-json>
                            <add-server>Ajouter un serveur distant</add-server>
                            <empty-servers>Aucun serveur distant configuré. Cliquez sur « Ajouter un serveur distant » pour en ajouter un.</empty-servers>
                            <drag-to-reorder>Glisser pour réordonner</drag-to-reorder>
                            <move-up>Monter le serveur</move-up>
                            <move-down>Descendre le serveur</move-down>
                            <remove-server>Supprimer le serveur</remove-server>
                            <moved-announcement>Serveur déplacé à la position {0} sur {1}</moved-announcement>
                            <removed-announcement>Serveur supprimé</removed-announcement>
                            <label-label>Libellé</label-label>
                            <label-placeholder>Préproduction</label-placeholder>
                            <name-label>Nom</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>URL du serveur</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>Accès interface (Administration des formulaires)</ui-access-label>
                            <api-access-label>Accès API (push/pull)</api-access-label>
                            <alert-url-required>L'URL du serveur est requise</alert-url-required>
                            <alert-duplicate-name>Nom de serveur en double</alert-duplicate-name>
                            <invalid-json>JSON des serveurs distants invalide</invalid-json>
                        </resource>
                        <resource xml:lang="de">
                            <readonly-hint>Aktivieren Sie Überschreiben, um Remote-Server hinzuzufügen, zu entfernen, neu anzuordnen oder zu bearbeiten.</readonly-hint>
                            <visual-mode>Visuell</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formatieren</format-json>
                            <copy-json>Kopieren</copy-json>
                            <add-server>Remote-Server hinzufügen</add-server>
                            <empty-servers>Keine Remote-Server konfiguriert. Klicken Sie auf „Remote-Server hinzufügen“, um einen hinzuzufügen.</empty-servers>
                            <drag-to-reorder>Zum Neuordnen ziehen</drag-to-reorder>
                            <move-up>Server nach oben verschieben</move-up>
                            <move-down>Server nach unten verschieben</move-down>
                            <remove-server>Server entfernen</remove-server>
                            <moved-announcement>Server an Position {0} von {1} verschoben</moved-announcement>
                            <removed-announcement>Server entfernt</removed-announcement>
                            <label-label>Beschriftung</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Name</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Server-URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>UI-Zugriff (Formularverwaltung)</ui-access-label>
                            <api-access-label>API-Zugriff (Push/Pull)</api-access-label>
                            <alert-url-required>Server-URL ist erforderlich</alert-url-required>
                            <alert-duplicate-name>Doppelter Servername</alert-duplicate-name>
                            <invalid-json>Ungültiges Remote-Server-JSON</invalid-json>
                        </resource>
                        <resource xml:lang="es">
                            <readonly-hint>Active Sobrescribir para añadir, eliminar, reordenar o editar servidores remotos.</readonly-hint>
                            <visual-mode>Visual</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formatear</format-json>
                            <copy-json>Copiar</copy-json>
                            <add-server>Añadir servidor remoto</add-server>
                            <empty-servers>No hay servidores remotos configurados. Haga clic en «Añadir servidor remoto» para añadir uno.</empty-servers>
                            <drag-to-reorder>Arrastrar para reordenar</drag-to-reorder>
                            <move-up>Subir servidor</move-up>
                            <move-down>Bajar servidor</move-down>
                            <remove-server>Eliminar servidor</remove-server>
                            <moved-announcement>Servidor movido a la posición {0} de {1}</moved-announcement>
                            <removed-announcement>Servidor eliminado</removed-announcement>
                            <label-label>Etiqueta</label-label>
                            <label-placeholder>Preproducción</label-placeholder>
                            <name-label>Nombre</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>URL del servidor</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>Acceso UI (Administración de formularios)</ui-access-label>
                            <api-access-label>Acceso API (push/pull)</api-access-label>
                            <alert-url-required>La URL del servidor es obligatoria</alert-url-required>
                            <alert-duplicate-name>Nombre de servidor duplicado</alert-duplicate-name>
                            <invalid-json>JSON de servidores remotos no válido</invalid-json>
                        </resource>
                        <resource xml:lang="it">
                            <readonly-hint>Attiva Sovrascrivi per aggiungere, rimuovere, riordinare o modificare i server remoti.</readonly-hint>
                            <visual-mode>Visuale</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formatta</format-json>
                            <copy-json>Copia</copy-json>
                            <add-server>Aggiungi server remoto</add-server>
                            <empty-servers>Nessun server remoto configurato. Fai clic su «Aggiungi server remoto» per aggiungerne uno.</empty-servers>
                            <drag-to-reorder>Trascina per riordinare</drag-to-reorder>
                            <move-up>Sposta server in alto</move-up>
                            <move-down>Sposta server in basso</move-down>
                            <remove-server>Rimuovi server</remove-server>
                            <moved-announcement>Server spostato alla posizione {0} di {1}</moved-announcement>
                            <removed-announcement>Server rimosso</removed-announcement>
                            <label-label>Etichetta</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Nome</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>URL del server</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>Accesso UI (Amministrazione moduli)</ui-access-label>
                            <api-access-label>Accesso API (push/pull)</api-access-label>
                            <alert-url-required>L'URL del server è obbligatorio</alert-url-required>
                            <alert-duplicate-name>Nome server duplicato</alert-duplicate-name>
                            <invalid-json>JSON dei server remoti non valido</invalid-json>
                        </resource>
                        <resource xml:lang="pt">
                            <readonly-hint>Ative Substituir para adicionar, remover, reordenar ou editar servidores remotos.</readonly-hint>
                            <visual-mode>Visual</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formatar</format-json>
                            <copy-json>Copiar</copy-json>
                            <add-server>Adicionar servidor remoto</add-server>
                            <empty-servers>Nenhum servidor remoto configurado. Clique em «Adicionar servidor remoto» para adicionar um.</empty-servers>
                            <drag-to-reorder>Arrastar para reordenar</drag-to-reorder>
                            <move-up>Mover servidor para cima</move-up>
                            <move-down>Mover servidor para baixo</move-down>
                            <remove-server>Remover servidor</remove-server>
                            <moved-announcement>Servidor movido para a posição {0} de {1}</moved-announcement>
                            <removed-announcement>Servidor removido</removed-announcement>
                            <label-label>Etiqueta</label-label>
                            <label-placeholder>Homologação</label-placeholder>
                            <name-label>Nome</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>URL do servidor</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>Acesso UI (Administração de formulários)</ui-access-label>
                            <api-access-label>Acesso API (push/pull)</api-access-label>
                            <alert-url-required>O URL do servidor é obrigatório</alert-url-required>
                            <alert-duplicate-name>Nome de servidor duplicado</alert-duplicate-name>
                            <invalid-json>JSON de servidores remotos inválido</invalid-json>
                        </resource>
                        <resource xml:lang="sv">
                            <readonly-hint>Aktivera Åsidosätt för att lägga till, ta bort, ordna om eller redigera fjärrservrar.</readonly-hint>
                            <visual-mode>Visuellt</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formatera</format-json>
                            <copy-json>Kopiera</copy-json>
                            <add-server>Lägg till fjärrserver</add-server>
                            <empty-servers>Inga fjärrservrar konfigurerade. Klicka på "Lägg till fjärrserver" för att lägga till en.</empty-servers>
                            <drag-to-reorder>Dra för att ordna om</drag-to-reorder>
                            <move-up>Flytta server uppåt</move-up>
                            <move-down>Flytta server nedåt</move-down>
                            <remove-server>Ta bort server</remove-server>
                            <moved-announcement>Flyttade server till position {0} av {1}</moved-announcement>
                            <removed-announcement>Tog bort server</removed-announcement>
                            <label-label>Etikett</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Namn</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Server-URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>UI-åtkomst (Formuläradmin)</ui-access-label>
                            <api-access-label>API-åtkomst (push/pull)</api-access-label>
                            <alert-url-required>Server-URL krävs</alert-url-required>
                            <alert-duplicate-name>Dubblett av servernamn</alert-duplicate-name>
                            <invalid-json>Ogiltig JSON för fjärrservrar</invalid-json>
                        </resource>
                        <resource xml:lang="fi">
                            <readonly-hint>Ota Korvaa käyttöön lisätäksesi, poistaaksesi, järjestääksesi tai muokataksesi etäpalvelimia.</readonly-hint>
                            <visual-mode>Visuaalinen</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Muotoile</format-json>
                            <copy-json>Kopioi</copy-json>
                            <add-server>Lisää etäpalvelin</add-server>
                            <empty-servers>Etäpalvelimia ei ole määritetty. Lisää palvelin napsauttamalla "Lisää etäpalvelin".</empty-servers>
                            <drag-to-reorder>Järjestä vetämällä</drag-to-reorder>
                            <move-up>Siirrä palvelinta ylös</move-up>
                            <move-down>Siirrä palvelinta alas</move-down>
                            <remove-server>Poista palvelin</remove-server>
                            <moved-announcement>Palvelin siirretty sijaintiin {0}/{1}</moved-announcement>
                            <removed-announcement>Palvelin poistettu</removed-announcement>
                            <label-label>Nimike</label-label>
                            <label-placeholder>Testaus</label-placeholder>
                            <name-label>Nimi</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Palvelimen URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>Käyttöliittymäpääsy (Lomakkeiden hallinta)</ui-access-label>
                            <api-access-label>API-pääsy (push/pull)</api-access-label>
                            <alert-url-required>Palvelimen URL on pakollinen</alert-url-required>
                            <alert-duplicate-name>Palvelimen nimi on jo käytössä</alert-duplicate-name>
                            <invalid-json>Virheellinen etäpalvelimien JSON</invalid-json>
                        </resource>
                        <resource xml:lang="nl">
                            <readonly-hint>Schakel Overschrijven in om externe servers toe te voegen, te verwijderen, te herschikken of te bewerken.</readonly-hint>
                            <visual-mode>Visueel</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Opmaak</format-json>
                            <copy-json>Kopiëren</copy-json>
                            <add-server>Externe server toevoegen</add-server>
                            <empty-servers>Geen externe servers geconfigureerd. Klik op "Externe server toevoegen" om er een toe te voegen.</empty-servers>
                            <drag-to-reorder>Slepen om te herschikken</drag-to-reorder>
                            <move-up>Server omhoog verplaatsen</move-up>
                            <move-down>Server omlaag verplaatsen</move-down>
                            <remove-server>Server verwijderen</remove-server>
                            <moved-announcement>Server verplaatst naar positie {0} van {1}</moved-announcement>
                            <removed-announcement>Server verwijderd</removed-announcement>
                            <label-label>Label</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Naam</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Server-URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>UI-toegang (Formulierenbeheer)</ui-access-label>
                            <api-access-label>API-toegang (push/pull)</api-access-label>
                            <alert-url-required>Server-URL is verplicht</alert-url-required>
                            <alert-duplicate-name>Dubbele servernaam</alert-duplicate-name>
                            <invalid-json>Ongeldige JSON voor externe servers</invalid-json>
                        </resource>
                        <resource xml:lang="no">
                            <readonly-hint>Aktiver Overstyr for å legge til, fjerne, endre rekkefølge på eller redigere eksterne servere.</readonly-hint>
                            <visual-mode>Visuell</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formater</format-json>
                            <copy-json>Kopier</copy-json>
                            <add-server>Legg til ekstern server</add-server>
                            <empty-servers>Ingen eksterne servere konfigurert. Klikk på «Legg til ekstern server» for å legge til en.</empty-servers>
                            <drag-to-reorder>Dra for å endre rekkefølge</drag-to-reorder>
                            <move-up>Flytt server opp</move-up>
                            <move-down>Flytt server ned</move-down>
                            <remove-server>Fjern server</remove-server>
                            <moved-announcement>Flyttet server til posisjon {0} av {1}</moved-announcement>
                            <removed-announcement>Fjernet server</removed-announcement>
                            <label-label>Etikett</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Navn</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Server-URL</url-label>
