<xbl:xbl xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl">

    <xbl:binding id="fb-cards-select1-horizontal" element="xf|select1[appearance ~= cards][appearance ~= 'xxf:horizontal']">
        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Horizontal Choice Cards</display-name>
            <display-name lang="fr">Cartes de choix horizontales</display-name>
            <display-name lang="no">Horisontale valgkort</display-name>
            <display-name lang="ru">Горизонтальные карточки выбора</display-name>
            <display-name lang="it">Schede di scelta orizzontali</display-name>
            <display-name lang="de">Horizontale Auswahlkarten</display-name>
            <display-name lang="fi">Vaakasuuntaiset valintakortit</display-name>
            <display-name lang="es">Tarjetas de opción horizontales</display-name>
            <display-name lang="nl">Horizontale keuzekaarten</display-name>
            <display-name lang="pt">Cartões de opção horizontais</display-name>
            <display-name lang="sv">Horisontella valkort</display-name>
            <display-name lang="ar">بطاقات اختيار أفقية</display-name>
            <display-name lang="pl">Poziome karty wyboru</display-name>
            <display-name lang="ja">水平選択カード</display-name>
            <toolbox show="false"/>
            <icon>
                <icon-class>fa fa-fw fa-th-large</icon-class>
            </icon>
            <editors static-itemset="true" item-hint="true"/>
            <templates>
                <view>
                    <xf:select1 id="" ref="" appearance="cards xxf:horizontal" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                        <xf:itemset ref="">
                            <xf:label ref="label"/>
                            <xf:value ref="value"/>
                            <xf:hint ref="hint"/>
                        </xf:itemset>
                    </xf:select1>
                </view>
            </templates>
        </metadata>
    </xbl:binding>

</xbl:xbl>
