                        </resource>
                        <resource xml:lang="pt">
                            <label>Editor de processos</label>
                            <apply>Aplicar</apply>
                            <cancel>Cancelar</cancel>
                            <or>ou</or>
                            <process-name>
                                <label>Nome do processo</label>
                                <hint>Nome único que identifica este processo (ex.: save-final)</hint>
                                <alert>É necessário um nome de processo válido e único</alert>
                            </process-name>
                            <process-definition>
                                <label>Definição do processo</label>
                                <hint>Ações separadas por combinadores, ex.: validate then save</hint>
                                <alert>A sintaxe do processo é inválida</alert>
                            </process-definition>
                            <delete-process>Excluir processo</delete-process>
                            <new-process>Novo processo</new-process>
                            <no-steps>Nenhuma etapa definida para este processo.</no-steps>
                            <add-step>Adicionar etapa</add-step>
                            <select-action>Selecionar uma ação…</select-action>
                            <visual-editor>Visual</visual-editor>
                            <text-editor>Texto</text-editor>
                            <format>Formatar</format>
                            <copy>Copiar</copy>
                            <add-parameter>+ Parâmetro</add-parameter>
                            <custom-parameter>Parâmetro personalizado…</custom-parameter>
                            <remove-parameter>Remover parâmetro</remove-parameter>
                            <avt-toggle>Alternar modelo de valor dinâmico ({…})</avt-toggle>
                            <categories>
                                <form-runner>Ações do Form Runner</form-runner>
                                <sub-process>Subprocessos integrados</sub-process>
                                <flow-control>Controle de fluxo</flow-control>
                                <xforms>Ações XForms</xforms>
                                <form-processes>Processos personalizados</form-processes>
                            </categories>
                            <alerts>
                                <required>O valor é obrigatório</required>
