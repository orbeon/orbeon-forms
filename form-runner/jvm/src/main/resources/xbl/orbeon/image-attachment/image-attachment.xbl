                            <remove>Pašalinti priedą</remove>
                        </resource>
                        <resource xml:lang="da">
                            <zoom>Forstør billede</zoom>
                            <close>Luk</close>
                            <previous>Forrige billede</previous>
                            <next>Næste billede</next>
                            <remove>Fjern vedhæftning</remove>
                        </resource>
                        <resource xml:lang="ar">
                            <zoom>تكبير الصورة</zoom>
                            <close>إغلاق</close>
                            <previous>الصورة السابقة</previous>
                            <next>الصورة التالية</next>
                            <remove>إزالة المرفق</remove>
                        </resource>
                        <resource xml:lang="ca">
                            <zoom>Ampliar la imatge</zoom>
                            <close>Tancar</close>
                            <previous>Imatge anterior</previous>
                            <next>Imatge següent</next>
                            <remove>Eliminar adjunt</remove>
                        </resource>
                        <resource xml:lang="hu">
                            <zoom>Kép nagyítása</zoom>
                            <close>Bezárás</close>
                            <previous>Előző kép</previous>
                            <next>Következő kép</next>
                            <remove>Melléklet eltávolítása</remove>
                        </resource>
                        <resource xml:lang="ja">
                            <zoom>画像を拡大</zoom>
                            <close>閉じる</close>
                            <previous>前の画像</previous>
                            <next>次の画像</next>
                            <remove>添付ファイルを削除</remove>
                        </resource>
                        <resource xml:lang="no">
                            <zoom>Forstørr bilde</zoom>
                            <close>Lukk</close>
                            <previous>Forrige bilde</previous>
                            <next>Neste bilde</next>
                            <remove>Fjern vedlegg</remove>
                        </resource>
                        <resource xml:lang="pl">
                            <zoom>Powiększ obraz</zoom>
                            <close>Zamknij</close>
                            <previous>Poprzedni obraz</previous>
                            <next>Następny obraz</next>
                            <remove>Usuń załącznik</remove>
                        </resource>
                        <resource xml:lang="tr">
                            <zoom>Görseli büyüt</zoom>
                            <close>Kapat</close>
                            <previous>Önceki görsel</previous>
                            <next>Sonraki görsel</next>
                            <remove>Eki kaldır</remove>
                        </resource>
                        <resource xml:lang="zh-Hans">
                            <zoom>放大图片</zoom>
                            <close>关闭</close>
                            <previous>上一张图片</previous>
                            <next>下一张图片</next>
                            <remove>删除附件</remove>
                        </resource>
                        <resource xml:lang="zh-Hant">
                            <zoom>放大圖片</zoom>
                            <close>關閉</close>
                            <previous>上一張圖片</previous>
                            <next>下一張圖片</next>
                            <remove>刪除附件</remove>
                        </resource>
                    </_>
                </xf:instance>
            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:var
                name="multiple"
                value="xxf:component-param-value('multiple') = 'true'"/>
            <xf:var
                name="size"
                value="
                    let $raw := lower-case(normalize-space(string(fr:component-param-value('size'))))
                    return
                        if ($raw = ('small', 's')) then
                            'small'
                        else if ($raw = ('medium', 'm')) then
                            'medium'
                        else if ($raw = ('large', 'l')) then
                            'large'
                        else
                            'auto'
                "/>
            <xf:var
                name="view-mode"
                value="if ($multiple and fr:component-param-value('view-mode') = 'carousel') then 'carousel' else 'grid'"/>
            <xf:var
                name="carousel-size"
                value="
                    let $raw := lower-case(normalize-space(string(fr:component-param-value('carousel-size'))))
                    return
                        if ($raw = ('small', 's')) then
                            'small'
                        else if ($raw = ('large', 'l')) then
                            'large'
                        else
                            'medium'
                "/>
            <xf:var
                name="columns"
                value="fr:component-param-value('columns')[. castable as xs:integer and xs:integer(.) ge 1]"/>
            <xf:var
                name="max-rows"
                value="fr:component-param-value('max-rows')[. castable as xs:integer and xs:integer(.) ge 1]"/>
            <xf:var
                name="binding"
                value="xxf:binding('fr-image-attachment')"/>

            <xh:div
                id="fr-image-attachment-elem"
                xxf:control="true"
                tabindex="-1"
                data-size="{$size}"
                data-view-mode="{$view-mode}"
                data-carousel-size="{$carousel-size}"
                data-columns="{$columns}"
                data-max-rows="{$max-rows}"
                class="{
                    string-join(
                        (
                            if ($multiple) then
                                if ($view-mode = 'carousel') then
                                    (
                                        'fr-image-attachment-view-carousel',
                                        concat('fr-image-attachment-carousel-size-', $carousel-size)
                                    )
                                else
                                    'fr-image-attachment-view-grid'
                            else if ($size != 'auto') then
                                concat('fr-image-attachment-size-', $size)
                            else
                                (),
                            if ($multiple and $view-mode = 'grid' and exists($columns)) then
                                'fr-image-attachment-has-columns'
                            else
                                (),
                            if ($multiple and $view-mode = 'grid' and exists($max-rows)) then
                                'fr-image-attachment-has-max-rows'
                            else
                                ()
                        ),
                        ' '
                    )
                }">
                <xf:group
                    ref=".[$multiple and $view-mode = 'carousel']"
                    class="fr-image-attachment-carousel-stage xforms-hidden">
                    <xh:div class="fr-image-attachment-carousel-viewport">
                        <xh:button
                            type="button"
                            class="btn fr-image-attachment-carousel-prev"
                            aria-label="{fr:r('previous')}"
                            title="{fr:r('previous')}">
                            <xh:i class="fa fa-fw fa-chevron-left" aria-hidden="true"/>
                        </xh:button>
                        <xh:img class="fr-image-attachment-carousel-img" alt=""/>
                        <xh:button
                            type="button"
                            class="btn fr-image-attachment-carousel-zoom"
                            aria-label="{fr:r('zoom')}"
                            title="{fr:r('zoom')}">
                            <xh:i class="fa fa-fw fa-expand" aria-hidden="true"/>
                        </xh:button>
                        <xh:button
                            type="button"
                            class="btn fr-image-attachment-carousel-next"
                            aria-label="{fr:r('next')}"
                            title="{fr:r('next')}">
                            <xh:i class="fa fa-fw fa-chevron-right" aria-hidden="true"/>
                        </xh:button>
                    </xh:div>
                    <xh:div class="fr-image-attachment-carousel-footer">
                        <xh:a href="javascript:void(0)" class="fr-image-attachment-carousel-filename"/>
                        <xh:span class="fr-image-attachment-carousel-size"/>
                        <xh:span class="fr-image-attachment-carousel-counter"/>
                        <xh:button
                            type="button"
                            class="btn-link fr-image-attachment-carousel-remove"
                            aria-label="{fr:r('remove')}"
                            title="{fr:r('remove')}">
                            <xh:i class="fa fa-fw fa-times" aria-hidden="true"/>
                        </xh:button>
                    </xh:div>
                </xf:group>
                <fr:attachment
                    ref="$binding"
                    xbl:attr="multiple"
                    image-preview="true"
                    accept="{(xxf:custom-mip($binding, 'upload-mediatypes')[xxf:non-blank()], 'image/*')[1]}">

                    <xf:filename  ref="@filename"  xxbl:scope="outer"/>
                    <xf:mediatype ref="@mediatype" xxbl:scope="outer"/>
                    <xxf:size     ref="@size"      xxbl:scope="outer"/>

                    <!-- Retarget of upload events -->
                    <!-- NOTE: Duplicated logic in attachment.xbl -->
                    <xf:dispatch
                        event="xxforms-upload-start xxforms-upload-cancel"
                        targetid="fr-image-attachment"
                        name="{event('xxf:type')}"/>

                    <xf:action
                        event="xxforms-upload-done"
                        if="exists(
                            (
                                fr:component-param-value('transform-max-width'),
                                fr:component-param-value('transform-max-height'),
                                fr:component-param-value('transform-quality'),
                                fr:component-param-value('transform-format')
                            )
                        )"
                        type="xpath">
                        fr:transform-uploaded-image(
                            xxf:absolute-id('fr-image-attachment'),
                            if ($multiple) then $binding/*:_[last()] else $binding,
                            fr:component-param-value('transform-max-width'),
                            fr:component-param-value('transform-max-height'),
                            fr:component-param-value('transform-quality'),
                            fr:component-param-value('transform-format')
                        )
                    </xf:action>

                    <xf:dispatch
                        event="xxforms-upload-done"
                        targetid="fr-image-attachment"
                        name="{event('xxf:type')}"
                        propagate="stop"
                        defaultAction="cancel">
                        <xf:property name="filename"       value="event('filename')"/>
                        <xf:property name="content-type"   value="event('content-type')"/>
                        <xf:property name="content-length" value="event('content-length')"/>
                    </xf:dispatch>

                    <xf:dispatch
                        event="xforms-value-changed"
                        targetid="fr-image-attachment"
                        name="{event('xxf:type')}"
                        propagate="stop"
                        defaultAction="cancel">
                        <xf:property name="xxf:value" value="event('xxf:value')"/>
                    </xf:dispatch>

                </fr:attachment>
                <xf:output mediatype="image/*" ref="$binding[not($multiple) and xxf:non-blank()]">
                    <xf:filename  ref="@filename"  xxbl:scope="outer"/>
                    <xf:mediatype ref="@mediatype" xxbl:scope="outer"/>
                    <xf:header ref="fr:attachment-form-version()">
                        <xf:name>Orbeon-Form-Definition-Version</xf:name>
                        <xf:value value="."/>
                    </xf:header>
                    <xf:header ref="$binding[@fr:attachment-encrypted = 'true']">
                        <xf:name>Orbeon-Decrypt</xf:name>
                        <xf:value>true</xf:value>
                    </xf:header>
                </xf:output>
                <xh:dialog
                    class="fr-image-attachment-lightbox"
                    closedby="any"
                    aria-label="{fr:r('zoom')}">
                    <xh:div class="fr-image-attachment-lightbox-header">
                        <xh:span class="fr-image-attachment-lightbox-filename"/>
                        <xh:span class="fr-image-attachment-lightbox-counter"/>
                        <xh:button
                            type="button"
                            class="btn-link fr-image-attachment-lightbox-close"
                            aria-label="{fr:r('close')}"
                            title="{fr:r('close')}"
                            autofocus="autofocus">
                            <xh:i class="fa fa-fw fa-times" aria-hidden="true"/>
                        </xh:button>
                    </xh:div>
                    <xh:div class="fr-image-attachment-lightbox-body">
                        <xh:button
                            type="button"
                            class="btn fr-image-attachment-lightbox-prev"
                            aria-label="{fr:r('previous')}"
                            title="{fr:r('previous')}">
                            <xh:i class="fa fa-fw fa-chevron-left" aria-hidden="true"/>
                        </xh:button>
                        <xh:img class="fr-image-attachment-lightbox-img" alt=""/>
                        <xh:button
                            type="button"
                            class="btn fr-image-attachment-lightbox-next"
                            aria-label="{fr:r('next')}"
                            title="{fr:r('next')}">
                            <xh:i class="fa fa-fw fa-chevron-right" aria-hidden="true"/>
                        </xh:button>
                    </xh:div>
                </xh:dialog>
            </xh:div>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
