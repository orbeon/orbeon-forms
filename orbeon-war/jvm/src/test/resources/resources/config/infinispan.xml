<?xml version="1.0" encoding="UTF-8"?>
<infinispan
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="urn:infinispan:config:16.0 https://infinispan.org/schemas/infinispan-config-16.0.xsd"
    xmlns="urn:infinispan:config:16.0">

    <cache-container name="orbeon-container" statistics="true">

        <serialization marshaller="org.infinispan.commons.marshall.JavaSerializationMarshaller">
            <allow-list>
                <class>org.orbeon.oxf.xforms.state.DynamicState</class>
                <regex>scala.*</regex>
            </allow-list>
        </serialization>

        <global-state>
            <persistent-location path="orbeon/cache" relative-to="orbeon.webapp.tmpdir"/>
        </global-state>

        <!-- XForms dynamic state store -->
        <local-cache name="xforms.store.dynamic-states" statistics="true">
            <expiration max-idle="18000000" interval="120000"/>
            <persistence passivation="true">
                <file-store purge="true" path="xforms.store.dynamic-states">
                    <write-behind modification-queue-size="1024" />
                </file-store>
            </persistence>
            <memory max-count="500" when-full="REMOVE"/>
        </local-cache>

        <!-- XForms serialized static state store -->
        <local-cache name="xforms.store.static-states" statistics="true">
            <expiration max-idle="4h" lifespan="7d" interval="2m"/>
            <persistence passivation="true">
                <file-store purge="true" path="xforms.store.static-states" compaction-threshold="0.25">
                    <write-behind modification-queue-size="1024" />
                </file-store>
            </persistence>
            <memory max-count="200" when-full="REMOVE"/>
        </local-cache>

        <!-- XForms aggregated JS/CSS asset bundles store -->
        <local-cache name="xforms.store.asset-bundles" statistics="true">
            <expiration max-idle="24h" lifespan="7d" interval="5m"/>
            <persistence passivation="true">
                <file-store purge="true" path="xforms.store.asset-bundles" compaction-threshold="0.25">
                    <write-behind modification-queue-size="1024" />
                </file-store>
            </persistence>
            <memory max-count="200" when-full="REMOVE"/>
        </local-cache>

        <!-- Form Runner external modes store -->
        <local-cache name="fr.store.external-modes" statistics="true">
            <expiration lifespan="960000" interval="120000"/>
            <memory max-count="200" when-full="REMOVE"/>
        </local-cache>

        <!-- Form Runner persistence form metadata cache -->
        <local-cache name="fr.cache.form-metadata" statistics="true">
            <expiration lifespan="300000" interval="120000"/>
            <memory max-count="100" when-full="REMOVE"/>
        </local-cache>

        <!-- Configuration properties cache -->
        <local-cache name="core.cache.properties" statistics="true">
            <memory max-count="50" when-full="REMOVE"/>
        </local-cache>

    </cache-container>
</infinispan>
