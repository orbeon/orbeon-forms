<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:frf="java:org.orbeon.oxf.fr.FormRunner">

    <xbl:binding
        id="fr-card-published-forms"
        element="fr|card-published-forms"
        xxbl:mode="lhha custom-lhha binding"
        class="h-100"
    >
        <xbl:implementation>
            <xf:model>

                <xf:var
                    name="page-size"
                    value="xs:integer(xxf:property('oxf.fr.landing.page-size'))"/>

                <xf:var
                    name="max-rows"
                    value="$page-size + 6"/>

                <xf:var
                    name="tz"
                    value="
                        for $offset in frf:defaultTimezoneToOffsetString()
                        return xs:dayTimeDuration($offset)"/>

                <xf:var
                    name="link-to-tokens"
                    value="
                        let $tokens := xxf:split(fr:component-param-value('link-to'))[. = ('new', 'summary')]
                        return
                            if (empty($tokens)) then
                                'summary' (: default for backward compatibility :)
                            else
                                $tokens
                    "/>

                <xf:instance id="fr-ui-instance" xxf:exclude-result-prefixes="#all">
                    <ui state="initial" has-loaded="false" sort-by="" sort-direction="" sort-announcement=""/>
                </xf:instance>

                <xf:instance id="fr-search-request-instance" xxf:exclude-result-prefixes="#all">
                    <search ignore-admin-permissions="true" xml:lang=""/>
                </xf:instance>

                <xf:instance id="fr-forms-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:submission
                    id="fr-read-demo-forms-submission"
                    method="post"
                    ref="instance('fr-search-request-instance')"
                    serialization="application/xml"
                    mediatype="application/xml"
                    resource="/fr/service/persistence/form"
                    replace="instance"
                    targetref="instance('fr-forms-instance')"
                    mode="asynchronous"
                    xxf:response-must-await="200ms"
                    xxf:show-progress="false"
                >
                    <xf:action event="xforms-submit">
                        <xf:var
                            name="app"
                            value="fr:component-param-value('app')[xxf:non-blank()]"/>

                        <xf:var
                            name="sort-by"
                            value="(instance('fr-ui-instance')/@sort-by[xxf:non-blank()], fr:component-param-value('sort-by')[xxf:non-blank()], 'last-modified')[1]"/>

                        <xf:var
                            name="sort-direction"
                            value="
                                let $direction := (instance('fr-ui-instance')/@sort-direction[xxf:non-blank()], fr:component-param-value('sort-direction')[. = ('asc', 'desc', 'ascending', 'descending')])[1],
                                    $adjusted  := if ($direction = 'ascending') then 'asc' else if ($direction = 'descending') then 'desc' else $direction
                                return
                                    if (empty($adjusted)) then
                                        if ($sort-by = ('created', 'last-modified')) then 'desc' else 'asc'
                                    else
                                        $adjusted"/>

                        <xf:var
                            name="operations-filter"
                            value="
                                string-join(
                                    (
                                        'create'[$link-to-tokens = 'new'],
                                        'list'  [$link-to-tokens = 'summary']
                                    ),
                                    ' '
                                )"/>

                        <xf:setvalue ref="instance('fr-ui-instance')/@state"          value="'loading'"/>
                        <xf:setvalue ref="instance('fr-ui-instance')/@sort-by"        value="$sort-by"/>
                        <xf:setvalue ref="instance('fr-ui-instance')/@sort-direction" value="$sort-direction"/>

                        <xf:setvalue
                            ref="instance('fr-search-request-instance')/@xml:lang"
                            value="(xxf:instance('fr-fr-language-instance')[xxf:non-blank()], 'en')[1]"/>

                        <xf:delete
                            ref="instance('fr-search-request-instance')/*"/>

                        <xf:insert
                            context="instance('fr-search-request-instance')"
                            origin="
                                (
                                    for $a in $app
                                    return xf:element('filter', (xf:attribute('metadata', 'application-name'), xf:attribute('match', 'exact'), $a)),
                                    xf:element('filter', (xf:attribute('metadata', 'form-version'), xf:attribute('match', 'exact'), 'latest')),
                                    xf:element('filter', (xf:attribute('metadata', 'operations'),   xf:attribute('match', 'token'), xf:attribute('combinator', 'or'), $operations-filter)),
                                    xf:element('sort',   (xf:attribute('metadata', $sort-by), xf:attribute('direction', $sort-direction)))
                                )"/>
                    </xf:action>

                    <xf:action event="xforms-submit-done">
                        <xf:setvalue ref="instance('fr-ui-instance')/@state"      value="'done'"/>
                        <xf:setvalue ref="instance('fr-ui-instance')/@has-loaded" value="'true'"/>
                    </xf:action>

                    <xf:setvalue
                        event="xforms-submit-error"
                        ref="instance('fr-ui-instance')/@state"
                        value="'error'"/>
                </xf:submission>

                <xf:action event="xforms-model-construct-done" if="not(fr:component-param-value('active') = 'false')">
                    <xf:send submission="fr-read-demo-forms-submission"/>
                </xf:action>
            </xf:model>
        </xbl:implementation>
        <xbl:template>

            <xf:var name="app-filter"       value="fr:component-param-value('app')[xxf:non-blank()]"/>
            <xf:var name="all-forms"        value="instance('fr-forms-instance')/*"/>
            <xf:var name="total-form-count" value="count($all-forms)"/>
            <xf:var name="filter"           value="lower-case(xxf:trim(fr:component-param-value('filter')))"/>
            <xf:var name="is-filtering"     value="xxf:non-blank($filter)"/>
            <xf:var
                name="card-title-matches"
                value="
                    $is-filtering and (
                        contains(lower-case(string(xxf:label('fr-card-published-forms'))), $filter) or
                        (exists($app-filter) and contains(lower-case($app-filter), $filter))
                    )"/>
            <xf:var
                name="forms"
                value="
                    if (not($is-filtering) or $card-title-matches) then
                        $all-forms
                    else
                        $all-forms[
                            let $t := string((title[@xml:lang = xxf:lang()], title, form-name)[normalize-space()][1])
                            return
                                contains(lower-case($t), $filter)                       or
                                contains(lower-case(string(application-name)), $filter) or
                                contains(lower-case(string(form-name)), $filter)
                        ]"/>
            <xf:var name="form-count"       value="count($forms)"/>
            <xf:var
                name="count-display"
                value="
                    if ($is-filtering and $form-count != $total-form-count) then
                        concat($form-count, ' / ', $total-form-count)
                    else
                        string($form-count)"/>
            <xf:var
                name="is-filtered-out"
                value="$is-filtering and not($card-title-matches) and instance('fr-ui-instance')/@has-loaded = 'true' and $form-count = 0"/>
            <xf:var name="show-more"        value="$form-count gt $page-size"/>
            <xf:var
                name="show-more-href"
                value="
                    string-join(
                        (
                            '/fr/forms',
                            if (exists($app-filter)) then
                                ('?fr-search-app=exact:', $app-filter)
                            else
                                ()
                        ),
                        ''
                    )"/>
            <xf:var
                name="latest-modified-dt"
                value="max($forms/last-modified-time[. castable as xs:dateTime]/xs:dateTime(.))"/>
            <xf:var name="is-sorted-by-title" value="instance('fr-ui-instance')/@sort-by = 'title'"/>
            <xf:var
                name="sort-toggle-label"
                value="
                    if ($is-sorted-by-title) then
                        xxf:r('landing.buttons.sort-by-last-modified', '|fr-fr-resources|')
                    else
                        xxf:r('landing.buttons.sort-by-title', '|fr-fr-resources|')"/>
            <xf:var name="refresh-label" value="xxf:r('landing.buttons.refresh', '|fr-fr-resources|')"/>

            <xf:var
                name="refresh-watch"
                value="concat(fr:component-param-value('refresh-token'), '|', xxf:instance('fr-fr-language-instance'))">
                <xf:send
                    event="xforms-value-changed"
                    if="instance('fr-ui-instance')/@has-loaded = 'true' or instance('fr-ui-instance')/@state = 'error'"
                    submission="fr-read-demo-forms-submission"/>
            </xf:var>

            <fr:card
                status="{instance('fr-ui-instance')/@state}"
                has-loaded="{instance('fr-ui-instance')/@has-loaded}"
                count="{$count-display}"
                total-count="{$form-count}"
                filtered-out="{$is-filtered-out}"
                is-empty="{empty($forms)}"
                empty-message="{xxf:r('landing.messages.no-forms', '|fr-fr-resources|')}"
            >
                <xf:label ref="xxf:label('fr-card-published-forms')"/>

                <fr:card-status>
                    <xf:output value="instance('fr-ui-instance')/@sort-announcement"/>
                </fr:card-status>

                <fr:card-actions>
                    <xf:trigger
                        appearance="minimal"
                        class="fr-card-action-btn fr-card-sort-mode-btn {'xforms-hidden'[$form-count le 1]}">
                        <xf:label>
                            <xh:i class="fa {if ($is-sorted-by-title) then 'fa-arrow-down-a-z' else 'fa-clock'}" aria-hidden="true"/>
                            <xh:span class="xforms-hidden"><xf:output value="$sort-toggle-label"/></xh:span>
                        </xf:label>
                        <xf:hint value="$sort-toggle-label"/>
                        <xf:action event="DOMActivate">
                            <xf:var name="next-sort-by"  value="if ($is-sorted-by-title) then 'last-modified' else 'title'"/>
                            <xf:var name="next-sort-dir" value="if ($next-sort-by = 'title') then 'asc' else 'desc'"/>
                            <xf:setvalue ref="instance('fr-ui-instance')/@sort-by"        value="$next-sort-by"/>
                            <xf:setvalue ref="instance('fr-ui-instance')/@sort-direction" value="$next-sort-dir"/>
                            <xf:setvalue
                                ref="instance('fr-ui-instance')/@sort-announcement"
                                value="
                                    if ($next-sort-by = 'title') then
                                        xxf:format-message(
                                            xxf:r('landing.messages.sorted-by-ascending', '|fr-fr-resources|'),
                                            xxf:r('home-summary.titles.form-title', '|fr-fr-resources|')
                                        )
                                    else
                                        xxf:format-message(
                                            xxf:r('landing.messages.sorted-by-descending', '|fr-fr-resources|'),
                                            xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')
                                        )"/>
                            <xf:send submission="fr-read-demo-forms-submission"/>
                        </xf:action>
                    </xf:trigger>

                    <xf:trigger
                        appearance="minimal"
                        class="fr-card-action-btn fr-card-refresh-btn {'is-spinning'[instance('fr-ui-instance')/@state = 'loading' and instance('fr-ui-instance')/@has-loaded = 'true']}">
                        <xf:label>
                            <xh:i class="fa fa-rotate-right" aria-hidden="true"/>
                            <xh:span class="xforms-hidden"><xf:output value="$refresh-label"/></xh:span>
                        </xf:label>
                        <xf:hint value="$refresh-label"/>
                        <xf:send event="DOMActivate" submission="fr-read-demo-forms-submission"/>
                    </xf:trigger>
                </fr:card-actions>

                <fr:card-body>
                    <xf:group ref=".[xxf:non-blank(xxf:help('fr-card-published-forms'))]">
                        <xh:p class="card-text"><xf:output ref="xxf:help('fr-card-published-forms')"/></xh:p>
                    </xf:group>
                </fr:card-body>

                <fr:card-thumbnail>
                    <xf:var name="param-thumbnail" value="fr:component-param-value('thumbnail')[xxf:non-blank()]"/>
                    <xf:group ref=".[exists($param-thumbnail)]">
                        <xh:img
                            src="{($param-thumbnail, 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7')[1]}"
                            alt=""
                            class="img-thumbnail img-invertible"/>
                    </xf:group>
                </fr:card-thumbnail>

                <fr:rows>
                    <xf:repeat ref="$forms[position() le $max-rows]">
                        <xf:var name="is-extra-row" value="position() gt $page-size"/>
                        <xf:var name="form-app"     value="string(application-name)"/>
                        <xf:var name="form-name"    value="string(form-name)"/>
                        <xf:var name="form-version" value="string(form-version)"/>
                        <xf:var name="form-title"   value="string((title[@xml:lang = xxf:lang()], title, form-name)[normalize-space()][1])"/>
                        <xf:var name="ops"          value="xxf:split(@operations)"/>
                        <xf:var name="can-summary"  value="$ops = ('*', 'list')"/>
                        <xf:var name="can-new"      value="$ops = ('*', 'create')"/>
                        <xf:var
                            name="summary-href"
                            value="
                                concat(
                                    '/fr/',
                                    $form-app,
                                    '/',
                                    $form-name,
                                    '/summary',
                                    if (
                                        $form-version != '1' and
                                        xxf:property(string-join(('oxf.fr.summary.show-version-selector', $form-app, $form-name), '.'))
                                    ) then
                                        concat('?form-version=', $form-version)
                                    else
                                        ''
                                )"/>
                        <xf:var name="new-href" value="concat('/fr/', $form-app, '/', $form-name, '/new')"/>
                        <xf:var
                            name="primary-mode"
                            value="
                                $link-to-tokens[
                                    (. = 'summary' and $can-summary) or
                                    (. = 'new'     and $can-new)
                                ][1]"/>
                        <xf:var
                            name="primary-href"
                            value="
                                if ($primary-mode = 'new') then
                                    $new-href
                                else if ($primary-mode = 'summary') then
                                    $summary-href
                                else
                                    concat('#', string-join(($form-app, $form-name, $form-version), '/'))"/>
                        <xf:var
                            name="secondary-mode"
                            value="
                                if ($primary-mode = 'summary' and $can-new) then
                                    'new'
                                else if ($primary-mode = 'new' and $can-summary) then
                                    'summary'
                                else
                                    ()"/>
                        <xf:var
                            name="secondary-href"
                            value="
                                if ($secondary-mode = 'new') then
                                    $new-href
                                else if ($secondary-mode = 'summary') then
                                    $summary-href
                                else
                                    '#'"/>
                        <xf:var
                            name="secondary-label"
                            value="
                                if ($secondary-mode = 'new') then
                                    xxf:r('landing.buttons.new', '|fr-fr-resources|')
                                else
                                    xxf:r('landing.buttons.summary', '|fr-fr-resources|')"/>

                        <xh:li class="list-group-item fr-card-published-row {'fr-card-extra-row fr-card-extra-row-hidden'[$is-extra-row]}">
                            <xh:a
                                href="{$primary-href}"
                                title="{if (empty($app-filter)) then concat($form-title, ' (', $form-app, '/', $form-name, ')') else $form-title}"
                                class="fr-card-row-primary">
                                <xh:span class="fr-card-col fr-card-col-single">
                                    <xh:span class="fr-card-col-text text-truncate">
                                        <xf:output value="$form-title"/>
                                    </xh:span>
                                    <xh:span class="fr-card-app-pill {'xforms-hidden'[exists($app-filter)]}">
                                        <xf:output value="$form-app"/>
                                    </xh:span>
                                </xh:span>
                            </xh:a>
                            <xh:a
                                href="{$secondary-href}"
                                title="{concat($secondary-label, ': ', $form-title)}"
                                aria-label="{concat($secondary-label, ': ', $form-title)}"
                                class="fr-card-row-secondary {'xforms-hidden'[empty($secondary-mode)]}">
                                <xh:i class="fa {if ($secondary-mode = 'new') then 'fa-plus' else 'fa-list'}" aria-hidden="true"/>
                            </xh:a>
                        </xh:li>
                    </xf:repeat>
                </fr:rows>

                <fr:card-footer>
                    <xh:span class="fr-card-footer-meta {'xforms-hidden'[empty($latest-modified-dt)]}">
                        <xf:output value="
                            if (empty($latest-modified-dt)) then
                                ''
                            else
                                let $v :=
                                    if (exists($tz)) then
                                        adjust-dateTime-to-timezone($latest-modified-dt, $tz)
                                    else
                                        adjust-dateTime-to-timezone($latest-modified-dt)
                                return
                                    if (current-dateTime() - $v lt xs:dayTimeDuration('P1D'))
                                    then format-dateTime($v, xxf:r('common.formats.within-day', '|fr-fr-resources|'), xxf:lang(), (), ())
                                    else if (year-from-dateTime(current-dateTime()) = year-from-dateTime($v))
                                    then format-dateTime($v, xxf:r('common.formats.day-this-year', '|fr-fr-resources|'), xxf:lang(), (), ())
                                    else format-dateTime($v, xxf:r('common.formats.short-date', '|fr-fr-resources|'), xxf:lang(), (), ())">
                            <xf:label ref="xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')"/>
                        </xf:output>
                    </xh:span>
                    <xh:a href="{$show-more-href}" class="fr-card-show-more {'xforms-hidden'[not($show-more)]}">
                        <xh:span><xf:output value="xxf:r('landing.show-more', '|fr-fr-resources|')"/></xh:span>
                        <xh:i class="fa fa-arrow-right" aria-hidden="true"/>
                    </xh:a>
                </fr:card-footer>
            </fr:card>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
