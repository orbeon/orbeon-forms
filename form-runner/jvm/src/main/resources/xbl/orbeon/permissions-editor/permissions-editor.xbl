                            <anyone>所有人</anyone>
                            <anyone-with-token>需要令牌</anyone-with-token>
                            <any-authenticated-user>任何已认证用户</any-authenticated-user>
                            <owner>所有者</owner>
                            <group-member>组成员</group-member>
                            <create>创建</create>
                            <read>读取</read>
                            <update>更新</update>
                            <delete>删除</delete>
                            <list>列出</list>
                            <role-required>角色名称为必填项</role-required>
                            <role-duplicate>角色名称重复</role-duplicate>
                            <invalid-json>无效的权限 JSON</invalid-json>
                        </resource>
                        <resource xml:lang="zh-Hant">
                            <readonly-hint>啟用「覆寫」以設定權限。</readonly-hint>
                            <enable-permissions>啟用權限</enable-permissions>
                            <visual-mode>視覺化</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>格式化</format-json>
                            <copy-json>複製</copy-json>
                            <role>角色</role>
                            <anyone>所有人</anyone>
                            <anyone-with-token>需要權杖</anyone-with-token>
                            <any-authenticated-user>任何已驗證使用者</any-authenticated-user>
                            <owner>擁有者</owner>
                            <group-member>群組成員</group-member>
                            <create>建立</create>
                            <read>讀取</read>
                            <update>更新</update>
                            <delete>刪除</delete>
                            <list>列出</list>
                            <role-required>角色名稱為必填項</role-required>
                            <role-duplicate>角色名稱重複</role-duplicate>
                            <invalid-json>無效的權限 JSON</invalid-json>
                        </resource>
                    </_>
                </xf:instance>

                <xf:var name="show-token-permissions"       value="not(string(fr:component-param-value('show-token'))       = 'false')"/>
                <xf:var name="show-owner-group-permissions" value="not(string(fr:component-param-value('show-owner-group')) = 'false')"/>
                <xf:var name="show-list-permissions"        value="not(string(fr:component-param-value('show-list'))        = 'false')"/>

                <xf:bind
                    ref="instance('editor')/descendant-or-self::*"
                    readonly="instance('state')/@readonly = 'true'"/>

                <xf:bind ref="instance('state')">
                    <xf:bind ref="readonly-checked | readonly-unchecked" readonly="true()"/>
                    <xf:bind
                        ref="raw-json"
                        readonly="instance('state')/@readonly = 'true'"
                        constraint="instance('state')/@readonly = 'true' or pui:isValidPermissionsJson(.)"/>
                </xf:bind>

                <xf:bind ref="instance('editor')/permissions" id="permissions-bind">
                    <xf:bind ref="permission[1]"                               id="anyone-permission-bind"/>
                    <xf:bind
                        id="anyone-with-token-bind"
                        ref="permission[@for = 'anyone-with-token']"
                        relevant="$show-token-permissions"/>
                    <xf:bind ref="permission[@for = 'any-authenticated-user']" id="any-authenticated-user-bind"/>
                    <xf:bind
                        id="permission-bind"
                        ref="permission"
                        relevant="$show-owner-group-permissions or not(@for = ('owner', 'group-member'))">

                        <xf:bind
                            ref="role"
                            required="instance('state')/@readonly != 'true'"
                            xxf:whitespace="trim"
                            constraint="
                                instance('state')/@readonly = 'true' or (
                                    xxf:non-blank() and
                                    not((../../permission/role except .) = .)
                                )"/>
                    </xf:bind>
                </xf:bind>

                <xf:action
                    observer="editor permissions-editor-model"
                    event="xforms-insert xforms-delete xxforms-replace xxforms-value-changed fr-pe-push-json"
                    if="
                        instance('state')/@initialized = 'true' and
                        instance('state')/@syncing != 'true' and
                        instance('state')/@readonly != 'true' and
                        instance('state')/@mode = 'visual'">
                    <xf:var
                        name="new-json"
                        value="pui:uiXmlToJson(instance('editor')/has-permissions = 'true', instance('editor')/permissions)"/>
                    <xf:action if="$new-json != string(instance('state')/@last-json)">
                        <xf:setvalue ref="instance('state')/@last-json" value="$new-json"/>
                        <xf:setvalue ref="instance('state')/raw-json"   value="$new-json"/>
                        <xf:setvalue ref="xxf:binding('fr-permissions-editor')" value="$new-json"/>
                    </xf:action>
                </xf:action>

            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:group appearance="xxf:internal" id="fr-permissions-editor-root">

                <xf:var name="binding"                  value="xxf:binding('fr-permissions-editor')"/>
                <xf:var name="state"                    value="instance('state')"/>
                <xf:var name="editor"                   value="instance('editor')"/>
                <xf:var name="show-token-permissions"   value="not(string(fr:component-param-value('show-token'))       = 'false')"/>
                <xf:var name="show-owner-group-permissions" value="not(string(fr:component-param-value('show-owner-group')) = 'false')"/>
                <xf:var name="show-list-permissions"    value="not(string(fr:component-param-value('show-list'))        = 'false')"/>
                <xf:var name="show-json-tab"            value="not(string(fr:component-param-value('show-json-tab'))    = 'false')"/>
                <xf:var name="always-show-roles-json"   value="string(fr:component-param-value('always-show-roles'))"/>
                <xf:var name="custom-enable-label"      value="string(fr:component-param-value('enable-label'))"/>
                <xf:var name="effective-enable-label"   value="($custom-enable-label[xxf:non-blank()], fr:r('enable-permissions'))[1]"/>
                <xf:var name="inherited-json"           value="string(fr:component-param-value('inherited-value'))"/>

                <xf:var
                    name="is-overridden"
                    value="(
                        string(fr:component-param-value('override'))[xxf:non-blank()],
                        $binding/../@override/string()[xxf:non-blank()],
                        'true'
                    )[1]"/>

                <xf:var
                    name="effective-source-json"
                    value="
                        if ($is-overridden = 'true') then
                            string($binding)
                        else
                            (
                                $inherited-json[xxf:non-blank()],
                                string($binding)[xxf:non-blank()],
                                ''
                            )[1]"/>

                <xf:var
                    name="sync-trigger"
                    value="concat($state/@reload-seq, '|', $always-show-roles-json, '|', $effective-source-json)">
                    <xf:action
                        event="xforms-enabled xforms-value-changed"
                        if="$state/@initialized != 'true' or $effective-source-json != string($state/@last-json)">
                        <xf:setvalue ref="$state/@syncing" value="'true'"/>
                        <xf:var name="is-valid-source" value="pui:isValidPermissionsJson($effective-source-json)"/>
                        <xf:insert
                            ref="$editor"
                            origin="pui:jsonToUiXml($effective-source-json, $always-show-roles-json)"/>
                        <xf:setvalue ref="$state/raw-json"    value="pui:formatPermissionsJson($effective-source-json)"/>
                        <xf:setvalue ref="$state/@last-json"  value="$effective-source-json"/>
                        <xf:setvalue
                            if="not($is-valid-source) and $show-json-tab"
                            ref="$state/@mode"
                            value="'json'"/>
                        <xf:setvalue
                            if="$is-valid-source and not($show-json-tab)"
                            ref="$state/@mode"
                            value="'visual'"/>
                        <xf:setvalue ref="$state/@initialized" value="'true'"/>
                        <xf:setvalue ref="$state/@syncing"     value="'false'"/>
                    </xf:action>
                </xf:var>

                <xf:var
                    name="is-readonly"
                    value="fr:is-readonly-mode() or xxf:readonly($binding)">
                    <xf:action event="xforms-enabled">
                        <xf:setvalue ref="$state/@readonly" value="string($is-readonly)"/>
                    </xf:action>
                    <xf:action event="xforms-value-changed">
                        <xf:setvalue ref="$state/@readonly" value="string($is-readonly)"/>
                        <xf:action if="not($is-readonly) and $state/@mode = 'visual'">
                            <xf:dispatch name="fr-pe-push-json" targetid="permissions-editor-model"/>
                        </xf:action>
                    </xf:action>
                </xf:var>

                <xh:div class="fr-permissions-editor {'fr-permissions-is-readonly'[$is-readonly]} {'fr-permissions-with-tabs'[$show-json-tab]}">

                    <!-- Mode switcher tabs (Visual | JSON) when enabled -->
                    <xf:group ref=".[$show-json-tab]">
                        <xh:div class="fr-permissions-mode-tabs" role="tablist">
                            <xf:trigger
                                appearance="minimal"
                                id="fr-permissions-visual-tab"
                                class="fr-permissions-mode-tab {'fr-permissions-mode-active'[$state/@mode != 'json']}">
                                <xf:label value="fr:r('visual-mode')"/>
                                <xf:action event="DOMActivate" if="$state/@mode = 'json'">
                                    <xf:action if="pui:isValidPermissionsJson($state/raw-json)">
                                        <xf:setvalue ref="$state/@syncing" value="'true'"/>
                                        <xf:insert
                                            ref="$editor"
                                            origin="pui:jsonToUiXml($state/raw-json, $always-show-roles-json)"/>
                                        <xf:setvalue ref="$state/@mode"    value="'visual'"/>
                                        <xf:setvalue ref="$state/@syncing" value="'false'"/>
                                    </xf:action>
                                    <xf:action if="not(pui:isValidPermissionsJson($state/raw-json))">
                                        <xxf:setvisited control="fr-permissions-json-editor" visited="true"/>
                                    </xf:action>
                                </xf:action>
                            </xf:trigger>

                            <xf:trigger
                                appearance="minimal"
                                id="fr-permissions-json-tab"
                                class="fr-permissions-mode-tab {'fr-permissions-mode-active'[$state/@mode = 'json']}">
                                <xf:label value="fr:r('json-mode')"/>
                                <xf:action event="DOMActivate" if="$state/@mode != 'json'">
                                    <xf:setvalue
                                        ref="$state/raw-json"
                                        value="pui:uiXmlToJson($editor/has-permissions = 'true', $editor/permissions)"/>
                                    <xf:setvalue ref="$state/@mode" value="'json'"/>
                                    <xf:action type="javascript">
                                        <xf:body>
                                            const root = (this instanceof Element &amp;&amp; this.closest('.fr-permissions-editor')) || document.querySelector('.fr-permissions-editor');
                                            if (root) {
                                                requestAnimationFrame(() =&gt; {
                                                    const cmEl = root.querySelector('.CodeMirror');
                                                    if (cmEl &amp;&amp; cmEl.CodeMirror) cmEl.CodeMirror.refresh();
                                                });
                                            }
                                        </xf:body>
                                    </xf:action>
                                </xf:action>
                            </xf:trigger>
                        </xh:div>
                    </xf:group>

                    <xh:div class="fr-permissions-panel">

                        <!-- Read-only note when Override is off -->
                        <xf:group ref=".[$is-readonly and exists($binding/../@override)]" class="fr-permissions-readonly-note">
                            <xh:i class="fa fa-fw fa-lock" aria-hidden="true"/>
                            <xh:span><xf:output value="fr:r('readonly-hint')"/></xh:span>
                        </xf:group>

                        <xf:switch caseref="$state/@mode" class="fr-permissions-mode-switch">

                            <!-- Visual Mode -->
                            <xf:case value="'visual'">
                                <xh:div class="fr-permissions-visual-body">
                                    <xf:select ref="$editor/has-permissions" appearance="full" class="fr-has-permissions">
                                        <xf:item>
                                            <xf:label value="$effective-enable-label"/>
                                            <xf:value>true</xf:value>
                                        </xf:item>
                                    </xf:select>

                                    <xf:group ref=".[$editor/has-permissions = 'true']">
                                        <xf:var name="anyone-operations"                 value="xxf:split(bind('anyone-permission-bind')/operations)"/>
                                        <xf:var name="anyone-with-token-operations"      value="xxf:split(bind('anyone-with-token-bind')/operations)"/>
                                        <xf:var name="any-authenticated-user-operations" value="xxf:split(bind('any-authenticated-user-bind')/operations)"/>

                                        <!-- Heading fallback shadowed inside each repeat iteration -->
                                        <xf:var name="is-anyone-with-token" value="false()"/>

                                        <fr:grid
                                            id="fr-permissions-grid"
                                            repeat="content"
                                            bind="permissions-bind"
                                            template="instance('permission-with-role-template')"
                                            iteration-name="permission"
                                            freeze="{
                                                2 +
                                                (if ($show-token-permissions)       then 1 else 0) +
                                                (if ($show-owner-group-permissions) then 2 else 0) +
                                                count($editor/always-show-roles/role)
                                            }"
                                            clear-constraint="exists(role)"
                                            columns="24"
                                            class="fr-permissions-grid">

                                            <xf:var name="is-anyone"                 value="empty(role) and empty(@for)"/>
                                            <xf:var name="is-anyone-with-token"      value="@for = 'anyone-with-token'"/>
                                            <xf:var name="is-any-authenticated-user" value="@for = 'any-authenticated-user'"/>
                                            <xf:var name="is-owner-group"            value="@for = ('owner', 'group-member')"/>
                                            <xf:var name="current-ops"               value="xxf:split(operations)"/>

                                            <!-- Column 1: Role name or condition label -->
                                            <fr:c class="fr-role" x="1" w="9">
                                                <xf:output
                                                    appearance="minimal"
                                                    ref=".[$is-anyone or exists(@for)]"
                                                    class="fr-permission-condition-label{' fr-permission-token-label'[$is-anyone-with-token]}"
                                                    value="
                                                        let $for-value := string(context()/@for)
                                                        return
                                                            if (xxf:non-blank($for-value)) then
                                                                fr:r($for-value)
                                                            else
                                                                fr:r('anyone')">
                                                    <xf:label value="fr:r('role')"/>
                                                </xf:output>
                                                <xf:group ref=".[exists(role)]">
                                                    <xf:var name="is-always-show-roles" value="role = $editor/always-show-roles/role"/>
                                                    <xf:output appearance="minimal" ref="role[$is-always-show-roles]" class="fr-permission-condition-label"/>
                                                    <xf:input
                                                        id="fr-permissions-role-input"
                                                        ref="role[not($is-always-show-roles)]"
                                                        incremental="true"
                                                        class="fr-role-name">
                                                        <xf:alert value="if (xxf:is-blank()) then fr:r('role-required') else fr:r('role-duplicate')"/>
                                                    </xf:input>
                                                </xf:group>
                                            </fr:c>

                                            <!-- Column 2: Create -->
                                            <fr:c x="10" w="3">
                                                <xf:select
                                                    id="fr-permissions-create-checkbox"
                                                    ref="
                                                        if ($is-anyone) then
                                                            operations
                                                        else if ($is-anyone-with-token) then
                                                            ()
                                                        else if ($is-any-authenticated-user) then
                                                            if ($anyone-operations = 'create' and not($anyone-with-token-operations = 'create')) then
                                                                $state/readonly-checked
                                                            else
                                                                operations
                                                        else if ($is-owner-group) then
                                                            ()
                                                        else if (
                                                            $anyone-operations = 'create' and not($anyone-with-token-operations = 'create') or
                                                            $any-authenticated-user-operations = 'create'
                                                        ) then
                                                            $state/readonly-checked
                                                        else
                                                            operations"
                                                    appearance="full"
                                                    class="fr-create-permission{' fr-align-right'[$is-anyone-with-token]}">
                                                    <xf:label value="fr:r('create')"/>
                                                    <xf:item>
                                                        <xf:label value="fr:r('create')"/>
                                                        <xf:value>create</xf:value>
                                                    </xf:item>
                                                </xf:select>
                                            </fr:c>

                                            <!-- Column 3: Read -->
                                            <fr:c x="13" w="3">
                                                <xf:select
                                                    id="fr-permissions-read-checkbox"
                                                    ref="
                                                        if ($is-anyone) then
                                                            if (xxf:split(operations) = 'update') then
                                                                $state/readonly-checked
                                                            else
                                                                operations
                                                        else if ($is-anyone-with-token) then
                                                            if ($anyone-with-token-operations = 'update') then
                                                                $state/readonly-checked
                                                            else if ($anyone-operations = ('read', 'update')) then
                                                                operations
                                                            else
                                                                $state/readonly-unchecked
                                                        else if ($is-any-authenticated-user) then
                                                            if (
                                                                $anyone-operations = ('read', 'update') and
                                                                not($anyone-with-token-operations = ('read', 'update')) or
                                                                $any-authenticated-user-operations = 'update'
                                                            ) then
                                                                $state/readonly-checked
                                                            else
                                                                operations
                                                        else if (
                                                            $anyone-operations = ('read', 'update') and
                                                            not($anyone-with-token-operations = ('read', 'update')) or
                                                            $any-authenticated-user-operations = ('read', 'update') or
                                                            $current-ops = 'update'
                                                        ) then
                                                            $state/readonly-checked
                                                        else
                                                            operations"
                                                    appearance="full"
                                                    class="fr-read-permission{' fr-align-right'[$is-anyone-with-token]}">
                                                    <xf:label value="fr:r('read')"/>
                                                    <xf:item>
                                                        <xf:label value="fr:r('read')"/>
                                                        <xf:value>read</xf:value>
                                                    </xf:item>
                                                </xf:select>
                                            </fr:c>

                                            <!-- Column 4: Update -->
                                            <fr:c x="16" w="3">
                                                <xf:select
                                                    id="fr-permissions-update-checkbox"
                                                    ref="
                                                        let $op := 'update'
                                                        return
                                                            if ($is-anyone) then
                                                                operations
                                                            else if ($is-anyone-with-token) then
                                                                if ($anyone-operations = $op) then
                                                                    operations
                                                                else
                                                                    $state/readonly-unchecked
                                                            else if ($is-any-authenticated-user) then
                                                                if ($anyone-operations = $op and not($anyone-with-token-operations = $op)) then
                                                                    $state/readonly-checked
                                                                else
                                                                    operations
                                                            else if (
                                                                $anyone-operations = $op and not($anyone-with-token-operations = $op) or
                                                                $any-authenticated-user-operations = $op
                                                            ) then
                                                                $state/readonly-checked
                                                            else
                                                                operations"
                                                    appearance="full"
                                                    class="fr-update-permission{' fr-align-right'[$is-anyone-with-token]}">
                                                    <xf:label value="fr:r('update')"/>
                                                    <xf:item>
                                                        <xf:label value="fr:r('update')"/>
                                                        <xf:value>update</xf:value>
                                                    </xf:item>
                                                </xf:select>
                                            </fr:c>

                                            <!-- Column 5: Delete -->
                                            <fr:c x="19" w="3">
                                                <xf:select
                                                    id="fr-permissions-delete-checkbox"
                                                    ref="
                                                        let $op := 'delete'
                                                        return
                                                            if ($is-anyone) then
                                                                operations
                                                            else if ($is-anyone-with-token) then
                                                                ()
                                                            else if ($is-any-authenticated-user) then
                                                                if ($anyone-operations = $op and not($anyone-with-token-operations = $op)) then
                                                                    $state/readonly-checked
                                                                else
                                                                    operations
                                                            else if (
                                                                $anyone-operations = $op and not($anyone-with-token-operations = $op) or
                                                                $any-authenticated-user-operations = $op
                                                            ) then
                                                                $state/readonly-checked
                                                            else
                                                                operations"
                                                    appearance="full"
                                                    class="fr-delete-permission{' fr-align-right'[$is-anyone-with-token]}">
                                                    <xf:label value="fr:r('delete')"/>
                                                    <xf:item>
                                                        <xf:label value="fr:r('delete')"/>
                                                        <xf:value>delete</xf:value>
                                                    </xf:item>
                                                </xf:select>
                                            </fr:c>

                                            <!-- Column 6: List -->
                                            <fr:c x="22" w="3">
                                                <xf:select
                                                    id="fr-permissions-list-checkbox"
                                                    ref="
                                                        let $op := 'list'
                                                        return
                                                            if (not($show-list-permissions)) then
                                                                ()
                                                            else if ($is-anyone) then
                                                                operations
                                                            else if ($is-anyone-with-token) then
                                                                ()
                                                            else if ($is-any-authenticated-user) then
                                                                if ($anyone-operations = $op and not($anyone-with-token-operations = $op)) then
                                                                    $state/readonly-checked
                                                                else
                                                                    operations
                                                            else if ($is-owner-group) then
                                                                ()
                                                            else if (
                                                                $anyone-operations = $op and not($anyone-with-token-operations = $op) or
                                                                $any-authenticated-user-operations = $op
                                                            ) then
                                                                $state/readonly-checked
                                                            else
                                                                operations"
                                                    appearance="full"
                                                    class="fr-list-permission{' fr-align-right'[$is-anyone-with-token]}">
                                                    <xf:label value="fr:r('list')"/>
                                                    <xf:item>
                                                        <xf:label value="fr:r('list')"/>
                                                        <xf:value>list</xf:value>
                                                    </xf:item>
                                                </xf:select>
                                            </fr:c>
                                        </fr:grid>
                                    </xf:group>
                                </xh:div>
                            </xf:case>

                            <!-- JSON Mode -->
                            <xf:case value="'json'">
                                <xh:div class="fr-permissions-json-wrap">
                                    <xh:div class="fr-permissions-json-overlay">
                                        <fr:code-mirror
                                            id="fr-permissions-json-editor"
                                            ref="$state/raw-json"
                                            mediatype="application/json"
                                            class="fr-permissions-json-codemirror">
                                            <xf:alert value="fr:r('invalid-json')"/>
                                            <xf:action event="xforms-value-changed" if="not($is-readonly)">
                                                <xf:var name="raw" value="string($state/raw-json)"/>
                                                <xf:action if="$raw != string($state/@last-json)">
                                                    <xf:setvalue ref="$state/@last-json" value="$raw"/>
                                                    <xf:setvalue ref="$binding"          value="$raw"/>
                                                </xf:action>
                                            </xf:action>
                                        </fr:code-mirror>

                                        <xh:div class="fr-permissions-json-buttons">
                                            <xf:group ref=".[not($is-readonly)]">
                                                <xf:trigger appearance="minimal" id="fr-permissions-format-json" class="fr-permissions-json-btn">
                                                    <xf:label><xh:i class="fa fa-fw fa-align-left" aria-hidden="true"/></xf:label>
                                                    <xf:hint value="fr:r('format-json')"/>
                                                    <xf:action event="DOMActivate">
                                                        <xf:var name="formatted" value="pui:formatPermissionsJson($state/raw-json)"/>
                                                        <xf:setvalue ref="$state/raw-json"   value="$formatted"/>
                                                        <xf:setvalue ref="$state/@last-json" value="$formatted"/>
                                                        <xf:setvalue ref="$binding"          value="$formatted"/>
                                                    </xf:action>
                                                </xf:trigger>
                                            </xf:group>
                                            <xf:trigger appearance="minimal" id="fr-permissions-copy-json" class="fr-permissions-json-btn">
                                                <xf:label><xh:i class="fa fa-fw fa-copy" aria-hidden="true"/></xf:label>
                                                <xf:hint value="fr:r('copy-json')"/>
                                                <xf:action event="DOMActivate" type="javascript">
                                                    <xf:param name="text" value="string($state/raw-json)"/>
                                                    <xf:body>
                                                        const btn = (this instanceof Element &amp;&amp; this.querySelector('button')) || this;
                                                        if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {
                                                            navigator.clipboard.writeText(text).then(() =&gt; {
                                                                if (btn &amp;&amp; btn.classList) {
                                                                    btn.classList.add('fr-permissions-copy-success');
                                                                    const icon = btn.querySelector('i');
                                                                    if (icon) icon.className = 'fa fa-fw fa-check';
                                                                    setTimeout(() =&gt; {
                                                                        btn.classList.remove('fr-permissions-copy-success');
                                                                        if (icon) icon.className = 'fa fa-fw fa-copy';
                                                                    }, 1200);
                                                                }
                                                            });
                                                        }
                                                    </xf:body>
                                                </xf:action>
                                            </xf:trigger>
                                        </xh:div>
                                    </xh:div>
                                </xh:div>
                            </xf:case>
                        </xf:switch>
                    </xh:div>
                </xh:div>

            </xf:group>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
