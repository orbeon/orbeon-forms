<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:exf="http://www.exforms.org/exf/1-0"
    xmlns:oxf="http://www.orbeon.com/oxf/processors"
    xmlns:fn="http://www.w3.org/2005/xpath-functions"
    xmlns:math="http://www.w3.org/2005/xpath-functions/math"
    xmlns:map="http://www.w3.org/2005/xpath-functions/map"
    xmlns:array="http://www.w3.org/2005/xpath-functions/array"
    xmlns:saxon="http://saxon.sf.net/"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:frf="java:org.orbeon.oxf.fr.FormRunner"
    xmlns:fbf="java:org.orbeon.oxf.fb.FormBuilderXPathApi"
    xmlns:beu="java:org.orbeon.oxf.fr.ButtonsEditorUI"
    xmlns:pui="java:org.orbeon.oxf.fb.process.ProcessUI"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

    <xbl:binding id="fb-dialog-buttons-editor" element="fb|dialog-buttons-editor">

        <xbl:resources>
            <xbl:style src="/xbl/fb/dialog-buttons-editor/dialog-buttons-editor.css"/>
        </xbl:resources>

        <xbl:handlers>
            <xbl:handler event="fb-show-dialog" phase="target">
                <!-- 1. Refresh inherited Global/App property context for this form's app & form name -->
                <xf:insert
                    ref="instance('fb-be-inherited')"
                    origin="beu:inheritedPropertyContextXml($eff-app, $eff-form)"/>

                <!-- 2. Stage <detail-buttons> from form metadata -->
                <xf:insert
                    ref="instance('fb-be-detail-buttons')"
                    origin="
                        beu:metadataToEditorDetailButtonsXml(
                            $metadata,
                            string(instance('fb-be-inherited')/@default-edit),
                            string(instance('fb-be-inherited')/@default-view),
                            string(instance('fb-be-inherited')/@default-inner)
                        )"/>

                <!-- 3. Stage button labels/icons from $metadata/resources/resource/buttons/button -->
                <xf:delete ref="instance('fb-be-resources')/*"/>
                <xf:action iterate="$metadata/resources/resource">
                    <xf:var name="lang" value="xxf:trim(string(@xml:lang))"/>
                    <xf:action if="xxf:non-blank($lang)" iterate="buttons/button[xxf:non-blank(@name)]">
                        <xf:var name="bname" value="xxf:trim(string(@name))"/>
                        <xf:var name="html"  value="if (exists(@html)) then string(@html) else 'false'"/>
                        <xf:var name="val"   value="string(.)"/>
                        <xf:insert
                            context="instance('fb-be-resources')"
                            ref="*"
                            origin="
                                xf:element(
                                    'message',
                                    (
                                        xf:attribute('xml:lang', $lang),
                                        xf:attribute('name', concat('buttons.', $bname)),
                                        xf:attribute('html', $html),
                                        $val
                                    )
                                )"/>
                    </xf:action>
                </xf:action>

                <xf:insert
                    if="empty(instance('fb-be-resources')/message)"
                    context="instance('fb-be-resources')"
                    origin="
                        xf:element(
                            'message',
                            (
                                xf:attribute('xml:lang', '*'),
                                xf:attribute('name', ''),
                                xf:attribute('html', 'false')
                            )
                        )"/>

                <!-- 4. Stage <processes> from form metadata -->
                <xf:delete ref="instance('fb-be-processes')/*"/>
                <xf:insert
                    if="exists($metadata/processes/process)"
                    context="instance('fb-be-processes')"
                    origin="$metadata/processes/process"/>

                <xf:rebuild/>
                <xf:recalculate/>
                <xxf:setvisited control="dialog" visited="false" recurse="true"/>
                <xxf:show dialog="dialog"/>
            </xbl:handler>

            <!-- Prevent Apply when invalid -->
            <xbl:handler if="not($valid = 'true')" event="DOMActivate" observer="fb-save-trigger">
                <xxf:setvisited control="dialog" recurse="true"/>
            </xbl:handler>

            <!-- Commit staged <detail-buttons>, button <resources>, and <processes> to form metadata -->
            <xbl:handler if="$valid = 'true'" event="DOMActivate" observer="fb-save-trigger">
                <!-- 1. Save minimal <detail-buttons> (omitted when nothing is overridden) -->
                <xf:delete ref="$metadata/detail-buttons"/>
                <xf:var name="clean-db" value="beu:editorDetailButtonsToMetadataXml(instance('fb-be-detail-buttons'))"/>
                <xf:insert
                    if="exists($clean-db)"
                    context="$metadata"
                    ref="*"
                    origin="$clean-db"/>

                <!-- 2. Save button labels/icons under $metadata/resources/resource/buttons (preserving sibling <messages>) -->
                <xf:delete ref="$metadata/resources/resource/buttons"/>
                <xf:var
                    name="valid-btn-msgs"
                    value="
                        instance('fb-be-resources')/message[
                            starts-with(@name, 'buttons.') and
                            xxf:non-blank(substring-after(@name, 'buttons.')) and
                            (xxf:non-blank(.) or string(@html) = 'true')
                        ]"/>

                <xf:action iterate="distinct-values($valid-btn-msgs/@xml:lang/string()[xxf:non-blank()])">
                    <xf:var name="lang" value="string(.)"/>

                    <xf:insert
                        if="empty($metadata/resources)"
                        context="$metadata"
                        ref="*"
                        origin="xf:element('resources')"/>

                    <xf:insert
                        if="empty($metadata/resources/resource[@xml:lang = $lang])"
                        context="$metadata/resources"
                        ref="*"
                        origin="xf:element('resource', xf:attribute('xml:lang', $lang))"/>

                    <xf:insert
                        if="empty($metadata/resources/resource[@xml:lang = $lang]/buttons)"
                        context="$metadata/resources/resource[@xml:lang = $lang]"
                        ref="*"
                        origin="xf:element('buttons')"/>

                    <xf:action iterate="$valid-btn-msgs[@xml:lang = $lang]">
                        <xf:var name="bname" value="xxf:trim(substring-after(@name, 'buttons.'))"/>
                        <xf:var name="html"  value="string(string(@html) = 'true')"/>
                        <xf:var name="val"   value="string(.)"/>
                        <xf:insert
                            context="$metadata/resources/resource[@xml:lang = $lang]/buttons"
                            ref="*"
                            origin="
                                xf:element(
                                    'button',
                                    (
                                        xf:attribute('name', $bname),
                                        xf:attribute('html', $html),
                                        $val
                                    )
                                )"/>
                    </xf:action>
                </xf:action>

                <xf:delete ref="$metadata/resources/resource[empty(*)]"/>
                <xf:delete ref="$metadata/resources[empty(*)]"/>

                <!-- 3. Save <processes> -->
                <xf:delete ref="$metadata/processes"/>
                <xf:insert
                    if="exists(instance('fb-be-processes')/process)"
                    context="$metadata"
                    ref="*"
                    origin="xf:element('processes', instance('fb-be-processes')/process)"/>

                <xxf:hide dialog="dialog"/>
            </xbl:handler>
        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="model">
                <!-- Keep XPath namespaces in scope on fb-be-detail-buttons for xxf:XPath2 validation in <fr:buttons-editor> -->
                <xf:instance id="fb-be-detail-buttons">
                    <detail-buttons/>
                </xf:instance>

                <xf:instance id="fb-be-resources" xxf:exclude-result-prefixes="#all">
                    <resources/>
                </xf:instance>

                <xf:instance id="fb-be-processes" xxf:exclude-result-prefixes="#all">
                    <processes/>
                </xf:instance>

                <xf:instance id="fb-be-inherited" xxf:exclude-result-prefixes="#all">
                    <inherited default-edit="" default-view="" default-inner="">
                        <processes/>
                        <resources/>
                    </inherited>
                </xf:instance>

                <xf:instance id="fb-be-ui" xxf:exclude-result-prefixes="#all">
                    <ui editing-process-name=""/>
                </xf:instance>

                <xf:instance id="fb-be-valid" xxf:exclude-result-prefixes="#all">
                    <_>true</_>
                </xf:instance>

                <xf:var name="valid"               value="instance('fb-be-valid')"/>
                <xf:var name="form-resources-root" value="xxf:instance('fb-form-instance')/xh:head/xf:model[@id = 'fr-form-model']/xf:instance[@id = 'fr-form-resources']/*[1]"/>
                <xf:var name="available-languages" value="if (exists($form-resources-root)) then frf:allLangs($form-resources-root) else ('en')"/>
                <xf:var name="metadata"            value="xxf:instance('fb-form-instance')/xh:head/xf:model[@id = 'fr-form-model']/xf:instance[@id = 'fr-form-metadata']/*[1]"/>
                <xf:var name="eff-app"             value="(xxf:trim(string($metadata/application-name))[xxf:non-blank()], '*')[1]"/>
                <xf:var name="eff-form"            value="(xxf:trim(string($metadata/form-name))[xxf:non-blank()], '*')[1]"/>

                <xf:bind
                    ref="instance('fb-be-detail-buttons')"
                    readonly="fr:is-readonly-mode()"/>
            </xf:model>
        </xbl:implementation>

        <xbl:template xxbl:transform="oxf:unsafe-xslt">
            <xf:group xsl:version="2.0">

                <xf:var name="resources"   ><xxf:value value=". treat as element()" xxbl:scope="outer" xbl:attr="model context ref=resources-ref"/></xf:var>
                <xf:var name="fr-resources"><xxf:value value=". treat as element()" xxbl:scope="outer" xbl:attr="model context ref=fr-resources-ref"/></xf:var>

                <xxf:dialog id="dialog" class="fb-dialog-buttons-editor" appearance="full" model="model" level="modal">
                    <xf:label ref="$resources/dialog-buttons-editor/label"/>
                    <xh:div class="fb-dialog-body fb-hide-alert">
                        <xh:div class="fb-dialog-buttons-editor-scroll">
                            <fr:buttons-editor
                                id="fb-buttons-editor"
                                ref="instance('fb-be-detail-buttons')"
                                resources-ref="instance('fb-be-resources')"
                                processes-ref="instance('fb-be-processes')"
                                inherited-processes-ref="instance('fb-be-inherited')/processes/process"
                                inherited-resources-ref="instance('fb-be-inherited')/resources/message"
                                inherited-edit-ref="string(instance('fb-be-inherited')/@default-edit)"
                                inherited-view-ref="string(instance('fb-be-inherited')/@default-view)"
                                inherited-inner-ref="string(instance('fb-be-inherited')/@default-inner)"
                                languages-ref="$available-languages"
                                allow-wildcard-lang="'true'"
                                app-ref="$eff-app"
                                form-ref="$eff-form"
                                valid-ref="$valid">
                                <xf:action event="fr-edit-process">
                                    <xf:var name="pname"         value="xxf:trim(string(event('name')))"/>
                                    <xf:var name="is-builtin"    value="string(event('is-builtin')) = 'true'"/>
                                    <xf:var name="init-def"      value="string(event('initial-definition'))"/>
                                    <xf:var name="existing-proc" value="instance('fb-be-processes')/process[@name = $pname][1]"/>
                                    <xf:var
                                        name="proc-elem"
                                        value="
                                            if (exists($existing-proc)) then
                                                $existing-proc
                                            else
                                                xf:element('process', (xf:attribute('name', $pname), $init-def))"/>
                                    <xf:var
                                        name="other-names"
                                        value="string-join(instance('fb-be-processes')/process/@name[string(.) != $pname]/string(), ' ')"/>

                                    <xf:setvalue ref="instance('fb-be-ui')/@editing-process-name" value="$pname"/>
                                    <xf:dispatch name="fr-show-dialog" targetid="fb-be-process-editor-dialog">
                                        <xf:property name="mode"           value="'single'"/>
                                        <xf:property name="name-readonly"  value="string($is-builtin)"/>
                                        <xf:property name="existing-names" value="$other-names"/>
                                        <xf:property name="config"         value="xf:element('processes', $proc-elem)"/>
                                        <xf:property name="form-context"   value="pui:formContextXml()"/>
                                    </xf:dispatch>
                                </xf:action>
                            </fr:buttons-editor>
                        </xh:div>

                        <xh:div class="fr-dialog-buttons" xml:space="preserve">
                            <xf:trigger id="fb-save-trigger" appearance="xxf:primary">
                                <xf:label mediatype="text/html" value="$resources/apply/label"/>
                            </xf:trigger>
                            <xf:output value="$resources/or/label"/>
                            <xf:trigger appearance="minimal">
                                <xf:label mediatype="text/html" value="$resources/cancel/label"/>
                                <xxf:hide event="DOMActivate" dialog="dialog"/>
                            </xf:trigger>
                        </xh:div>
                    </xh:div>
                </xxf:dialog>

                <!-- Single-process editor launched from Buttons Editor with full Form Builder formContextXml() -->
                <fr:dialog-process-editor id="fb-be-process-editor-dialog">
                    <xf:action event="fr-update" model="model">
                        <xf:var name="updated-proc" value="event('config')/process[1]"/>
                        <xf:action if="exists($updated-proc)">
                            <xf:var name="prev-name" value="xxf:trim(string(instance('fb-be-ui')/@editing-process-name))"/>
                            <xf:var name="new-name"  value="xxf:trim(string($updated-proc/@name))"/>
                            <xf:var name="new-body"  value="string($updated-proc)"/>
                            <xf:var
                                name="existing-proc"
                                value="
                                    if (xxf:non-blank($prev-name)) then
                                        instance('fb-be-processes')/process[@name = $prev-name][1]
                                    else
                                        instance('fb-be-processes')/process[@name = $new-name][1]"/>
                            <xf:action if="exists($existing-proc)">
                                <xf:setvalue ref="$existing-proc/@name" value="$new-name"/>
                                <xf:setvalue ref="$existing-proc"       value="$new-body"/>
                            </xf:action>
                            <xf:insert
                                if="empty($existing-proc)"
                                context="instance('fb-be-processes')"
                                ref="process"
                                origin="xf:element('process', (xf:attribute('name', $new-name), $new-body))"/>

                            <!-- Keep button bars, rules, and labels in sync if custom process was renamed -->
                            <xf:action if="xxf:non-blank($prev-name) and $prev-name != $new-name">
                                <xf:action iterate="instance('fb-be-detail-buttons')/bar[@override = 'true']">
                                    <xf:setvalue ref="@value" value="beu:renameButtonInBarValue(string(@value), $prev-name, $new-name)"/>
                                </xf:action>
                                <xf:action if="exists(instance('fb-be-detail-buttons')/button[@name = $prev-name]) and empty(instance('fb-be-detail-buttons')/button[@name = $new-name])">
                                    <xf:setvalue ref="instance('fb-be-detail-buttons')/button[@name = $prev-name]/@name" value="$new-name"/>
                                </xf:action>
                                <xf:action iterate="instance('fb-be-resources')/message[@name = concat('buttons.', $prev-name)]">
                                    <xf:setvalue ref="@name" value="concat('buttons.', $new-name)"/>
                                </xf:action>
                            </xf:action>
                        </xf:action>
                    </xf:action>
                </fr:dialog-process-editor>

            </xf:group>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
