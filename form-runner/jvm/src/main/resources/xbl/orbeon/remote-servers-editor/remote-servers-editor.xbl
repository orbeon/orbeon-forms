                            <format-json>Formázás</format-json>
                            <copy-json>Másolás</copy-json>
                            <add-server>Távoli kiszolgáló hozzáadása</add-server>
                            <empty-servers>Nincs beállított távoli kiszolgáló. Kattintson a „Távoli kiszolgáló hozzáadása” gombra.</empty-servers>
                            <drag-to-reorder>Húzza az átrendezéshez</drag-to-reorder>
                            <move-up>Kiszolgáló mozgatása felfelé</move-up>
                            <move-down>Kiszolgáló mozgatása lefelé</move-down>
                            <remove-server>Kiszolgáló eltávolítása</remove-server>
                            <moved-announcement>Kiszolgáló áthelyezve a(z) {0}/{1}. helyre</moved-announcement>
                            <removed-announcement>Kiszolgáló eltávolítva</removed-announcement>
                            <label-label>Címke</label-label>
                            <label-placeholder>Staging</label-placeholder>
                            <name-label>Név</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>Kiszolgáló URL-je</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>UI-hozzáférés (Űrlapkezelő)</ui-access-label>
                            <api-access-label>API-hozzáférés (push/pull)</api-access-label>
                            <alert-url-required>A kiszolgáló URL-je kötelező</alert-url-required>
                            <alert-duplicate-name>Ismétlődő kiszolgálónév</alert-duplicate-name>
