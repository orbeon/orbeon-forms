                            <next>Nächstes Bild</next>
                            <remove>Anhang entfernen</remove>
                        </resource>
                        <resource xml:lang="sv">
                            <zoom>Förstora bild</zoom>
                            <close>Stäng</close>
                            <previous>Föregående bild</previous>
                            <next>Nästa bild</next>
