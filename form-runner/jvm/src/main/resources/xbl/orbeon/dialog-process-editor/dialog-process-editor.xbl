                            <format>Formatear</format>
                            <copy>Copiar</copy>
                            <add-parameter>+ Parámetro</add-parameter>
                            <custom-parameter>Parámetro personalizado…</custom-parameter>
                            <remove-parameter>Eliminar parámetro</remove-parameter>
                            <avt-toggle>Alternar plantilla de valor dinámico ({…})</avt-toggle>
                            <categories>
                                <form-runner>Acciones de Form Runner</form-runner>
                                <sub-process>Subprocesos integrados</sub-process>
                                <flow-control>Control de flujo</flow-control>
                                <xforms>Acciones XForms</xforms>
                                <form-processes>Procesos personalizados</form-processes>
                            </categories>
                            <alerts>
                                <required>El valor es obligatorio</required>
                                <action-required>Se requiere una acción</action-required>
                                <invalid-xpath>Expresión XPath incorrecta</invalid-xpath>
                                <invalid-avt>Plantilla de valor XPath incorrecta</invalid-avt>
                                <invalid-boolean>Debe ser "true", "false" o una expresión AVT</invalid-boolean>
                                <invalid-choice>Valor de parámetro no válido</invalid-choice>
                                <invalid-token>Contiene un valor no compatible</invalid-token>
                                <invalid-duration>Debe ser una duración válida con unidad (p. ej. 1000ms o 5s)</invalid-duration>
                                <invalid-at>Debe ser "start", "end", "all" o un entero positivo</invalid-at>
                                <invalid-mode>Modo de destino no compatible</invalid-mode>
                                <invalid-ncname>Debe ser un identificador XML válido</invalid-ncname>
                                <unknown-control>Nombre de control desconocido</unknown-control>
                                <unknown-section>Nombre de sección desconocido</unknown-section>
                                <unknown-process>Nombre de subproceso desconocido</unknown-process>
                                <self-process>Un proceso no puede llamarse a sí mismo</self-process>
                                <unknown-param>Parámetro no compatible con esta acción</unknown-param>
                                <invalid-param-name>Se requiere un nombre de parámetro válido y único</invalid-param-name>
                            </alerts>
                        </resource>
