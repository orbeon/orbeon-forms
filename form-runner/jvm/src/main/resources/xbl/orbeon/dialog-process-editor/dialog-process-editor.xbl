                                <unknown-control>不明なコントロール名です</unknown-control>
                                <unknown-section>不明なセクション名です</unknown-section>
                                <unknown-process>不明なサブプロセス名です</unknown-process>
                                <self-process>プロセスは自身を呼び出せません</self-process>
                                <unknown-param>このアクションではサポートされていないパラメータです</unknown-param>
                                <invalid-param-name>一意で有効なパラメータ名が必要です</invalid-param-name>
                            </alerts>
                        </resource>
                        <resource xml:lang="ar">
                            <label>محرر العمليات</label>
                            <apply>تطبيق</apply>
                            <cancel>إلغاء</cancel>
                            <or>أو</or>
                            <process-name>
                                <label>اسم العملية</label>
                                <hint>اسم فريد يحدد هذه العملية (مثال: save-final)</hint>
                                <alert>مطلوب اسم عملية صالح وفريد</alert>
                            </process-name>
                            <process-definition>
                                <label>تعريف العملية</label>
                                <hint>إجراءات مفصولة بروابط، مثال: validate then save</hint>
                                <alert>صيغة العملية غير صالحة</alert>
                            </process-definition>
                            <delete-process>حذف العملية</delete-process>
                            <new-process>عملية جديدة</new-process>
                            <no-steps>لا توجد خطوات محددة لهذه العملية.</no-steps>
                            <add-step>إضافة خطوة</add-step>
                            <select-action>اختر إجراءً…</select-action>
                            <visual-editor>مرئي</visual-editor>
                            <text-editor>نص</text-editor>
                            <format>تنسيق</format>
                            <copy>نسخ</copy>
                            <add-parameter>+ معامل</add-parameter>
                            <custom-parameter>معامل مخصص…</custom-parameter>
                            <remove-parameter>إزالة المعامل</remove-parameter>
                            <avt-toggle>تبديل قالب القيمة الديناميكية ({…})</avt-toggle>
                            <categories>
                                <form-runner>إجراءات Form Runner</form-runner>
                                <sub-process>العمليات الفرعية المضمنة</sub-process>
                                <flow-control>التحكم في التدفق</flow-control>
                                <xforms>إجراءات XForms</xforms>
                                <form-processes>العمليات المخصصة</form-processes>
                            </categories>
                            <alerts>
                                <required>القيمة مطلوبة</required>
                                <action-required>مطلوب تحديد إجراء</action-required>
                                <invalid-xpath>تعبير XPath غير صحيح</invalid-xpath>
                                <invalid-avt>قالب قيمة XPath غير صحيح</invalid-avt>
                                <invalid-boolean>يجب أن يكون "true" أو "false" أو تعبير AVT</invalid-boolean>
                                <invalid-choice>قيمة معامل غير صالحة</invalid-choice>
                                <invalid-token>يحتوي على قيمة غير مدعومة</invalid-token>
                                <invalid-duration>يجب أن تكون مدة صالحة مع وحدة (مثال: 1000ms أو 5s)</invalid-duration>
                                <invalid-at>يجب أن يكون "start" أو "end" أو "all" أو عدداً صحيحاً موجباً</invalid-at>
                                <invalid-mode>الوضع المستهدف غير مدعوم</invalid-mode>
                                <invalid-ncname>يجب أن يكون معرف XML صالحاً</invalid-ncname>
                                <unknown-control>اسم عنصر تحكم غير معروف</unknown-control>
                                <unknown-section>اسم قسم غير معروف</unknown-section>
                                <unknown-process>اسم عملية فرعية غير معروف</unknown-process>
                                <self-process>لا يمكن للعملية استدعاء نفسها</self-process>
                                <unknown-param>معامل غير مدعوم لهذا الإجراء</unknown-param>
                                <invalid-param-name>مطلوب اسم معامل صالح وفريد</invalid-param-name>
                            </alerts>
                        </resource>
                    </_>
                </xf:instance>

                <xf:action event="xforms-model-construct-done">
                    <xf:insert
                        context="instance('actions-instance')"
                        origin="peu:availableActionsXml()/*"/>
                </xf:action>

                <xf:var name="i" value="instance()"/>

                <xf:bind
                    ref="$i//*"
                    readonly="fr:is-readonly-mode()"/>

                <xf:bind ref="$i/process" name="process">
                    <xf:bind
                        ref="@name"
                        xxf:whitespace="trim"
                        required="true()"
                        readonly="instance('ui-instance')/name-readonly = 'true'"
                        constraint="
                            xxf:non-blank() and
                            matches(., '^[A-Za-z_\-][A-Za-z0-9_\-]*$') and
                            not(($i/process/@name except .) = .) and
                            not(. = tokenize(instance('ui-instance')/existing-names, '\s+'))"/>
                    <xf:bind
                        ref="."
                        constraint="@_view-mode = 'text' or exists(step)"/>
                    <xf:bind
                        ref="_text"
                        relevant="../@_view-mode = 'text'"
                        required="true()"
                        constraint="peu:isProcessSyntaxValid(.)"/>
                    <xf:bind
                        ref="step"
                        relevant="not(../@_view-mode = 'text')"/>
                    <xf:bind
                        ref=".//step[@type = 'condition']/@condition"
                        type="xxf:XPath2"
                        required="true()"
                        constraint="xxf:non-blank()"/>
                    <xf:bind
                        ref=".//step[@type = 'action']/@name"
                        required="true()"
                        constraint="peu:isActionStepValid(.., instance('form-context-instance'))"/>
                    <xf:bind ref=".//step[@type = 'action']/param">
                        <xf:bind
                            ref=".[peu:paramValueMode(.) = 'xpath']"
                            type="xxf:XPath2"/>
                        <xf:bind
                            ref=".[peu:paramValueMode(.) = 'avt']"
                            type="xxf:XPath2ValueTemplate"/>
                        <xf:bind
                            ref="."
                            constraint="peu:isParamValueValid(., instance('form-context-instance'))"/>
                        <xf:bind
                            ref="@name[../@custom = 'true']"
                            xxf:whitespace="trim"
                            required="true()"
                            constraint="peu:isCustomParamNameValid(..)"/>
                    </xf:bind>
                </xf:bind>

            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:group>

                <xf:var
                    name="r"
                    value="(instance('orbeon-resources')/resource[@xml:lang = xxf:instance('fr-language-instance')], instance('orbeon-resources')/resource[@xml:lang = 'en'])[1]"/>
                <xf:var
                    name="is-single-mode"
                    value="instance('ui-instance')/mode = 'single'"/>
                <xf:var
                    name="is-name-readonly"
                    value="instance('ui-instance')/name-readonly = 'true'"/>

                <xxf:dialog id="dialog" class="fr-dialog-process-editor">
                    <xf:label value="if (xxf:non-blank(instance('ui-instance')/title)) then instance('ui-instance')/title else $r/label"/>

                    <xh:div class="fr-process-editor-body {'fr-process-editor-single'[$is-single-mode]}">
                    <fr:tabbable
                        appearance="left"
                        id="fr-processes-tabbable"
                        ref="$i"
                        readonly="{$is-single-mode}"
                        class="fr-tabbable-dnd">

                        <fr:tab ref="process">
                            <fr:label value="if (xxf:non-blank(@name)) then @name else $r/new-process"/>

                            <xf:var name="view-mode" value="(@_view-mode[xxf:non-blank()], 'visual')[1]"/>

                            <xh:div class="fr-process-tab-content">
                                <!-- Inline process name (shown only when editable) -->
                                <xh:div class="fr-process-name-inline {'xforms-hidden'[$is-name-readonly]}">
                                    <xf:input ref="@name[not($is-name-readonly)]" id="fr-process-name" class="fr-process-name-input">
                                        <xf:label value="$r/process-name/label"/>
                                        <xf:hint value="$r/process-name/hint" appearance="minimal"/>
                                        <xf:alert value="$r/process-name/alert"/>
                                    </xf:input>
                                </xh:div>

                                <!-- Full-width Visual | Text tabs -->
                                <xh:div class="fr-process-mode-tabs" role="tablist">
                                    <xf:trigger
                                        appearance="minimal"
                                        class="fr-process-mode-tab {'fr-process-mode-active'[$view-mode != 'text']}">
                                        <xf:label><xf:output value="$r/visual-editor"/></xf:label>
                                        <xf:action event="DOMActivate" if="$view-mode = 'text'">
                                            <xf:action if="xxf:is-blank(_text) or peu:isProcessSyntaxValid(_text)">
                                                <xf:delete ref="step"/>
                                                <xf:insert context="." origin="peu:processStringToXml(_text)/step"/>
                                                <xf:setvalue ref="@_view-mode" value="'visual'"/>
                                            </xf:action>
                                            <xf:action if="xxf:non-blank(_text) and not(peu:isProcessSyntaxValid(_text))">
                                                <xxf:setvisited control="fr-process-text-textarea" visited="true"/>
                                            </xf:action>
                                        </xf:action>
                                    </xf:trigger>
                                    <xf:trigger
                                        appearance="minimal"
                                        class="fr-process-mode-tab {'fr-process-mode-active'[$view-mode = 'text']}">
                                        <xf:label><xf:output value="$r/text-editor"/></xf:label>
                                        <xf:action event="DOMActivate" if="$view-mode != 'text'">
                                            <xf:var name="proc" value="."/>
                                            <xf:setvalue ref="_text" value="peu:xmlToIndentedProcessString($proc)"/>
                                            <xf:setvalue ref="@_view-mode" value="'text'"/>
                                            <xf:rebuild/>
                                            <xf:recalculate/>
                                            <xf:revalidate/>
                                            <xf:refresh/>
                                            <xxf:setvisited control="fr-process-text-textarea" visited="false"/>
                                        </xf:action>
                                    </xf:trigger>
                                </xh:div>

                                <xh:div class="fr-process-editor-panel">
                                <xf:switch caseref="$view-mode" xxf:update="full" class="fr-process-mode-switch">
                                    <xf:case value="'visual'">
                                        <xh:div class="fr-process-steps-container">
                                            <!-- Visual editor rows -->
                                            <xf:group ref=".[exists(step)]" id="fr-process-steps-group">
                                                <xf:action event="fr-focus-step">
                                                    <xf:setindex repeat="fr-process-steps-repeat" index="event('index')"/>
                                                    <xf:setfocus control="fr-process-action-select1"/>
                                                </xf:action>
                                                <xf:var name="process-index" value="count(preceding-sibling::process) + 1"/>
                                                <xh:div class="fr-process-steps-list" data-orbeon-process-index="{$process-index}">
                                                <xf:repeat ref=".//*[self::step or self::else]" id="fr-process-steps-repeat">

                                                    <xf:var
                                                        name="current"
                                                        value="."/>
                                                    <xf:var
                                                        name="step-type"
                                                        value="if (self::else) then 'else' else (@type, 'action')[1]"/>
                                                    <xf:var
                                                        name="ancestor-body-boxes"
                                                        value="ancestor::*[self::step[@type = 'group'] or self::then or self::else]"/>
                                                    <xf:var
                                                        name="active-boxes"
                                                        value="ancestor::*[self::step[@type = ('group', 'condition')] or self::then or self::else] | self::step[@type = 'condition']"/>
                                                    <xf:var
                                                        name="indent-level"
                                                        value="count($ancestor-body-boxes)"/>
                                                    <xf:var
                                                        name="active-boxes-count"
                                                        value="count($active-boxes)"/>
                                                    <xf:var
                                                        name="has-opening-box"
                                                        value="exists($active-boxes[if (self::step[@type = 'condition']) then (. is $current) else ($current is step[1])])"/>
                                                    <xf:var
                                                        name="closing-boxes-count"
                                                        value="count($active-boxes[$current is (descendant::*[self::step or self::else])[last()]])"/>
                                                    <xf:var
                                                        name="first-closing-box"
                                                        value="$active-boxes-count - $closing-boxes-count + 1"/>
                                                    <xf:var
                                                        name="extra-closing-levels"
                                                        value="max(($closing-boxes-count - 1, 0))"/>
                                                    <xf:var
                                                        name="has-combinator"
                                                        value="self::step and exists(preceding-sibling::step)"/>
                                                    <xf:var
                                                        name="has-combinator-slot"
                                                        value="exists(ancestor::*[self::process or self::step[@type = 'group'] or self::then or self::else][count(step) gt 1])"/>
                                                    <xf:var
                                                        name="can-move"
                                                        value="self::step and count(../step) gt 1 and not(fr:is-readonly-mode())"/>

                                                    <xh:div
                                                        class="{
                                                            'fr-process-iteration',
                                                            'fr-process-can-move'[$can-move],
                                                            'fr-process-row-opening-box'[$has-opening-box],
                                                            'fr-process-row-closing-box'[$closing-boxes-count gt 0]
                                                        }"
                                                        data-orbeon-row-index="{position()}"
                                                        data-orbeon-step-type="{$step-type}"
                                                        data-orbeon-level="{$indent-level}"
                                                        data-orbeon-can-move="{$can-move}">
                                                        <xh:div class="fr-process-row-main">
                                                            <xf:repeat ref="$active-boxes">
                                                                <xf:var name="box-pos"              value="position()"/>
                                                                <xf:var name="is-cond-box"          value="exists(self::step[@type = 'condition'])"/>
                                                                <xf:var name="box-depth"            value="count(ancestor::*[self::step[@type = 'group'] or self::then or self::else])"/>
                                                                <xf:var name="box-inset-px"         value="$box-depth * 20 + (if ($is-cond-box) then 0 else 12)"/>
                                                                <xf:var name="is-box-start"         value="if ($is-cond-box) then (. is $current) else ($current is step[1])"/>
                                                                <xf:var name="is-box-end"           value="$box-pos ge $first-closing-box"/>
                                                                <xf:var name="outer-closing-levels" value="if ($is-box-end) then $box-pos - $first-closing-box else 0"/>
                                                                <xh:div
                                                                    class="{
                                                                        'fr-process-box-slice',
                                                                        'fr-process-box-condition'[$is-cond-box],
                                                                        'fr-process-box-start'[$is-box-start],
                                                                        'fr-process-box-end'[$is-box-end]
                                                                    }"
                                                                    data-orbeon-box-depth="{$box-depth}"
                                                                    data-orbeon-body-level="{if ($is-cond-box) then '' else $box-depth + 1}"
                                                                    style="--fr-box-inset: {$box-inset-px}px; --fr-outer-closing: {$outer-closing-levels}"/>
                                                            </xf:repeat>
                                                            <xh:div
                                                                class="{
                                                                    'fr-process-row-content',
                                                                    'fr-process-has-combinator'[$has-combinator-slot]
                                                                }"
                                                                style="--fr-indent-level: {$indent-level}; --fr-extra-closing: {$extra-closing-levels}">

                                                                <!-- Combinator dropdown (then / recover) -->
                                                                <xf:select1
                                                                    ref="
                                                                        if ($has-combinator) then
                                                                            $current/@combinator
                                                                        else if ($has-combinator-slot) then
                                                                            'then'
                                                                        else
                                                                            ()"
                                                                    class="{
                                                                        'fr-process-combinator-select1',
                                                                        'fr-process-combinator-placeholder'[not($has-combinator)]
                                                                    }">
                                                                    <xf:item><xf:label>then</xf:label><xf:value>then</xf:value></xf:item>
                                                                    <xf:item><xf:label>recover</xf:label><xf:value>recover</xf:value></xf:item>
                                                                </xf:select1>

                                                                <!-- Row content based on type -->
                                                                <xf:switch caseref="$step-type" class="fr-process-row-switch" xxf:update="full">
                                                                    <!-- Action step -->
                                                                    <xf:case value="'action'">
                                                                        <xf:var name="action-def"           value="instance('actions-instance')/action[@name = $current/@name]"/>
                                                                        <xf:var name="present-param-names"  value="$current/param/@name[xxf:non-blank()]"/>
                                                                        <xf:var name="addable-params"       value="$action-def/param[@deprecated = 'false' and not(@name = $present-param-names)]"/>
                                                                        <xf:var name="allows-custom-params" value="$action-def/@allows-custom-params = 'true'"/>

                                                                        <xh:div class="fr-process-action-bar">
                                                                            <xf:select1 ref="@name" id="fr-process-action-select1" class="fr-process-action-select1">
                                                                                <xf:label value="$r/process-definition/label"/>
                                                                                <xf:alert value="peu:actionStepAlertMessage($current, $r, instance('form-context-instance'))"/>

                                                                                <xf:item>
                                                                                    <xf:label ref="$r/select-action"/>
                                                                                    <xf:value/>
                                                                                </xf:item>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$r/categories/form-runner"/>
                                                                                    <xf:itemset ref="instance('actions-instance')/action[@category = 'form-runner' and @deprecated = 'false']">
                                                                                        <xf:label ref="@label"/>
                                                                                        <xf:value ref="@name"/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$r/categories/flow-control"/>
                                                                                    <xf:itemset ref="instance('actions-instance')/action[@category = 'flow-control' and @deprecated = 'false']">
                                                                                        <xf:label ref="@label"/>
                                                                                        <xf:value ref="@name"/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$r/categories/xforms"/>
                                                                                    <xf:itemset ref="instance('actions-instance')/action[@category = 'xforms' and @deprecated = 'false']">
                                                                                        <xf:label ref="@label"/>
                                                                                        <xf:value ref="@name"/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:itemset ref="$action-def[@deprecated = 'true']">
                                                                                    <xf:label ref="@label"/>
                                                                                    <xf:value ref="@name"/>
                                                                                </xf:itemset>

                                                                                <xf:itemset ref="$current/@name[xxf:non-blank(.) and empty($action-def)]">
                                                                                    <xf:label value="."/>
                                                                                    <xf:value value="."/>
                                                                                </xf:itemset>

                                                                                <xf:action event="xforms-value-changed">
                                                                                    <xf:delete ref="$current/param"/>
                                                                                    <xf:insert context="$current" origin="peu:actionParamsXml(@name)/*"/>
                                                                                </xf:action>
                                                                            </xf:select1>

                                                                            <!-- + Parameter menu -->
                                                                            <xf:select1
                                                                                ref="@_add-param[exists($addable-params) or $allows-custom-params]"
                                                                                class="fr-process-add-param">
                                                                                <xf:label value="$r/add-parameter"/>
                                                                                <xf:item>
                                                                                    <xf:label ref="$r/add-parameter"/>
                                                                                    <xf:value/>
                                                                                </xf:item>
                                                                                <xf:itemset ref="$addable-params">
                                                                                    <xf:label ref="@name"/>
                                                                                    <xf:value ref="@name"/>
                                                                                </xf:itemset>
                                                                                <xf:itemset ref=".[$allows-custom-params]">
                                                                                    <xf:label ref="$r/custom-parameter"/>
                                                                                    <xf:value value="'__custom__'"/>
                                                                                </xf:itemset>
                                                                                <xf:action event="xforms-value-changed" if="xxf:non-blank(.)">
                                                                                    <xf:var name="chosen" value="string(.)"/>
                                                                                    <xf:setvalue ref="." value="''"/>
                                                                                    <xf:insert
                                                                                        context="$current"
                                                                                        ref="param"
                                                                                        origin="peu:singleParamTemplateXml($current/@name, $chosen)"/>
                                                                                </xf:action>
                                                                            </xf:select1>
                                                                        </xh:div>
                                                                    </xf:case>

                                                                    <!-- Group container -->
                                                                    <xf:case value="'group'">
                                                                        <xh:span class="fr-process-keyword fr-process-keyword-group">group</xh:span>
                                                                    </xf:case>

                                                                    <!-- Condition -->
                                                                    <xf:case value="'condition'">
                                                                        <xh:div class="fr-process-keyword-with-condition">
                                                                            <xh:span class="fr-process-keyword fr-process-keyword-if">if</xh:span>
                                                                            <xh:div class="fr-process-condition-control">
                                                                                <xf:input ref="@condition" appearance="xpath-completion" class="fr-process-condition-input">
                                                                                    <xf:label value="'if'"/>
                                                                                    <xf:hint value="'XPath condition'" appearance="minimal"/>
                                                                                    <xf:alert value="
                                                                                        if (xxf:is-blank()) then
                                                                                            $r/alerts/required
                                                                                        else
                                                                                            $r/alerts/invalid-xpath"/>
                                                                                </xf:input>
                                                                            </xh:div>
                                                                        </xh:div>
                                                                    </xf:case>

                                                                    <!-- Else branch -->
                                                                    <xf:case value="'else'">
                                                                        <xh:span class="fr-process-keyword fr-process-keyword-else">else</xh:span>
                                                                    </xf:case>
                                                                </xf:switch>

                                                                <!-- Parameters stacked below the action selector -->
                                                                <xh:div class="fr-process-row-content-params {'xforms-hidden'[not($step-type = 'action' and exists($current/param))]}">
                                                                    <xf:switch caseref="$step-type" class="fr-process-params-switch" xxf:update="full">
                                                                        <xf:case value="'action'">
                                                                            <xf:repeat ref="param">
                                                                                <xf:var name="param-elem"          value="."/>
                                                                                <xf:var name="action-def"          value="instance('actions-instance')/action[@name = $current/@name]"/>
                                                                                <xf:var name="param-def"           value="$action-def/param[@name = $param-elem/@name]"/>
                                                                                <xf:var name="is-custom"           value="@custom = 'true'"/>
                                                                                <xf:var name="is-required"         value="$param-def/@tier = 'required'"/>
                                                                                <xf:var name="has-widget"          value="$param-def/@has-widget = 'true'"/>
                                                                                <xf:var name="supports-avt-toggle" value="$has-widget and $param-def/@value-mode = 'avt'"/>
                                                                                <xf:var name="is-avt-mode"         value="@avt-mode = 'true'"/>
                                                                                <xf:var name="raw-kind"            value="($param-def/@kind, 'text')[1]"/>
                                                                                <xf:var name="param-value-mode"    value="peu:paramValueMode($param-elem)"/>
                                                                                <xf:var name="text-widget"         value="
                                                                                    if ($param-value-mode = 'xpath') then
                                                                                        'xpath'
                                                                                    else if ($param-value-mode = 'avt') then
                                                                                        'avt'
                                                                                    else
                                                                                        'text'
                                                                                "/>
                                                                                <xf:var name="enclosing-proc-name" value="($current/ancestor::process/@name)[1]"/>
                                                                                <xf:var name="effective-widget"    value="
                                                                                    if ($is-avt-mode or $is-custom) then
                                                                                        $text-widget
                                                                                    else if ($raw-kind = 'control-name') then
                                                                                        if (exists($current/param[@name = 'section-name']) or empty(instance('form-context-instance')/controls/item)) then $text-widget else 'control-name'
                                                                                    else if ($raw-kind = 'section-name') then
                                                                                        if (empty(instance('form-context-instance')/sections/item)) then $text-widget else 'section-name'
                                                                                    else if ($raw-kind = 'email-template') then
                                                                                        if (empty(instance('form-context-instance')/email-templates/item)) then $text-widget else 'email-template'
                                                                                    else if ($raw-kind = 'pdf-template') then
                                                                                        if (empty(instance('form-context-instance')/pdf-templates/item)) then $text-widget else 'pdf-template'
                                                                                    else if ($raw-kind = ('boolean', 'enum', 'tokens', 'detail-mode', 'process-name', 'duration')) then
                                                                                        $raw-kind
                                                                                    else
                                                                                        $text-widget
                                                                                "/>
                                                                                <xf:var name="summary-label" value="
                                                                                    concat(
                                                                                        if (xxf:non-blank($enclosing-proc-name)) then concat($enclosing-proc-name, ': ') else '',
                                                                                        $current/@name,
                                                                                        ' — ',
                                                                                        if (xxf:non-blank(@name)) then @name else 'parameter'
                                                                                    )"/>
                                                                                <xf:var name="alert-text"    value="peu:paramAlertMessage($param-elem, $r, instance('form-context-instance'))"/>

                                                                                <xh:div class="fr-process-param-row">
                                                                                    <!-- Parameter name / custom name input -->
                                                                                    <xh:div class="fr-process-param-name">
                                                                                        <xh:span class="fr-process-param-label {'fr-process-param-required'[$is-required]} {'xforms-hidden'[$is-custom]}">
                                                                                            <xf:output value="if (xxf:non-blank(@name)) then @name else 'value'"/>
                                                                                        </xh:span>
                                                                                        <xf:input ref="@name[$is-custom]" class="fr-process-custom-name-input">
                                                                                            <xf:label value="concat(if (xxf:non-blank($enclosing-proc-name)) then concat($enclosing-proc-name, ': ') else '', $current/@name, ' — name')"/>
                                                                                            <xf:hint value="'property'" appearance="minimal"/>
                                                                                            <xf:alert value="$r/alerts/invalid-param-name"/>
                                                                                        </xf:input>
                                                                                    </xh:div>

                                                                                    <!-- Parameter value control -->
                                                                                    <xh:div class="fr-process-param-control">
                                                                                        <xf:switch caseref="$effective-widget" xxf:update="full">

                                                                                            <xf:case value="'boolean'">
                                                                                                <xf:select1 ref=".[$effective-widget = 'boolean']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:item><xf:label>true</xf:label><xf:value>true</xf:value></xf:item>
                                                                                                    <xf:item><xf:label>false</xf:label><xf:value>false</xf:value></xf:item>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'enum'">
                                                                                                <xf:var name="enum-items" value="$param-def/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'enum']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$enum-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $enum-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'tokens'">
                                                                                                <xf:select ref=".[$effective-widget = 'tokens']" appearance="full" class="fr-process-param-tokens">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref="$param-def/item">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select>
                                                                                            </xf:case>

                                                                                            <xf:case value="'detail-mode'">
                                                                                                <xf:var name="mode-items" value="$param-def/item | instance('form-context-instance')/custom-modes/item[not(@value = $param-def/item/@value)]"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'detail-mode']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$mode-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $mode-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'control-name'">
                                                                                                <xf:var name="ctrl-items" value="instance('form-context-instance')/controls/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'control-name']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$ctrl-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $ctrl-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'section-name'">
                                                                                                <xf:var name="sec-items" value="instance('form-context-instance')/sections/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'section-name']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$sec-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $sec-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'email-template'">
                                                                                                <xf:var name="email-items" value="instance('form-context-instance')/email-templates/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'email-template']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$email-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $email-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'pdf-template'">
                                                                                                <xf:var name="pdf-items" value="instance('form-context-instance')/pdf-templates/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'pdf-template']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$pdf-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $pdf-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'process-name'">
                                                                                                <xf:var
                                                                                                    name="form-procs"
                                                                                                    value="distinct-values(($i/process/@name, instance('form-context-instance')/processes/item/@value)[xxf:non-blank() and . != $enclosing-proc-name])"/>
                                                                                                <xf:var
                                                                                                    name="builtin-procs"
                                                                                                    value="instance('actions-instance')/sub-process[@deprecated = 'false' and not(@name = $form-procs)]"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'process-name']" class="fr-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:choices>
                                                                                                        <xf:label ref="$r/categories/form-processes[exists($form-procs)]"/>
                                                                                                        <xf:itemset ref="$form-procs">
                                                                                                            <xf:label value="."/>
                                                                                                            <xf:value value="."/>
                                                                                                        </xf:itemset>
                                                                                                    </xf:choices>
                                                                                                    <xf:choices>
                                                                                                        <xf:label ref="$r/categories/sub-process"/>
                                                                                                        <xf:itemset ref="$builtin-procs">
                                                                                                            <xf:label ref="@name"/>
                                                                                                            <xf:value ref="@name"/>
                                                                                                        </xf:itemset>
                                                                                                    </xf:choices>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $form-procs) and not(. = $builtin-procs/@name)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'duration'">
                                                                                                <fr:quantity
                                                                                                    ref=".[$effective-widget = 'duration']"
                                                                                                    unit-preset="custom"
                                                                                                    custom-units="ms, s, min, h"
                                                                                                    default-unit="ms"
                                                                                                    digits-after-decimal="0"
                                                                                                    grouping-separator=""
                                                                                                    field-width="full"
                                                                                                    class="fr-process-param-quantity">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                </fr:quantity>
                                                                                            </xf:case>

                                                                                            <xf:case value="'xpath'">
                                                                                                <xf:input ref=".[$effective-widget = 'xpath']" appearance="xpath-completion" class="fr-process-param-input fr-process-code-input">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:hint value="($param-def/@placeholder, '')[1]" appearance="minimal"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                </xf:input>
                                                                                            </xf:case>

                                                                                            <xf:case value="'avt'">
                                                                                                <xf:input ref=".[$effective-widget = 'avt']" appearance="xpath-completion" avt="true" class="fr-process-param-input {'fr-process-code-input'[$is-avt-mode]}">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:hint value="($param-def/@placeholder, '')[1]" appearance="minimal"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                </xf:input>
                                                                                            </xf:case>

                                                                                            <xf:case value="'text'">
                                                                                                <xf:input ref=".[$effective-widget = 'text']" class="fr-process-param-input">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:hint value="($param-def/@placeholder, '')[1]" appearance="minimal"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                </xf:input>
                                                                                            </xf:case>

                                                                                        </xf:switch>
                                                                                    </xh:div>

                                                                                    <!-- AVT toggle & remove buttons -->
                                                                                    <xh:div class="fr-process-param-actions">
                                                                                        <xf:trigger
                                                                                            ref=".[$supports-avt-toggle]"
                                                                                            appearance="minimal"
                                                                                            class="fr-process-btn fr-process-avt-toggle {'fr-process-avt-active'[$is-avt-mode]}">
                                                                                            <xf:label>
                                                                                                <xh:span class="fr-process-avt-badge" title="{$r/avt-toggle}">{…}</xh:span>
                                                                                            </xf:label>
                                                                                            <xf:action event="DOMActivate">
                                                                                                <xf:delete ref="$param-elem/@unnamed"/>
                                                                                                <xf:action if="$is-avt-mode">
                                                                                                    <xf:action if="$raw-kind = 'duration'">
                                                                                                        <xf:var name="dur-amount" value="peu:durationAmountWhenLeavingAvtMode($param-elem)"/>
                                                                                                        <xf:var name="dur-unit"   value="peu:durationUnitWhenLeavingAvtMode($param-elem)"/>
                                                                                                        <xf:setvalue ref="$param-elem" value="$dur-amount"/>
                                                                                                        <xf:insert if="empty($param-elem/@unit)" context="$param-elem" origin="xf:attribute('unit', $dur-unit)"/>
                                                                                                        <xf:setvalue if="exists($param-elem/@unit)" ref="$param-elem/@unit" value="$dur-unit"/>
                                                                                                    </xf:action>
                                                                                                    <xf:setvalue
                                                                                                        if="$raw-kind != 'duration'"
                                                                                                        ref="$param-elem"
                                                                                                        value="peu:defaultValueWhenLeavingAvtMode($current/@name, $param-elem/@name, $param-elem)"/>
                                                                                                    <xf:setvalue ref="$param-elem/@avt-mode" value="'false'"/>
                                                                                                </xf:action>
                                                                                                <xf:action if="not($is-avt-mode)">
                                                                                                    <xf:action if="$raw-kind = 'duration'">
                                                                                                        <xf:setvalue
                                                                                                            if="xxf:non-blank($param-elem) and xxf:non-blank($param-elem/@unit)"
                                                                                                            ref="$param-elem"
                                                                                                            value="concat(xxf:trim($param-elem), $param-elem/@unit)"/>
                                                                                                        <xf:delete ref="$param-elem/@unit"/>
                                                                                                    </xf:action>
                                                                                                    <xf:setvalue ref="$param-elem/@avt-mode" value="'true'"/>
                                                                                                </xf:action>
                                                                                            </xf:action>
                                                                                        </xf:trigger>

                                                                                        <xf:trigger
                                                                                            ref=".[not($is-required)]"
                                                                                            appearance="minimal"
                                                                                            class="fr-process-btn fr-process-param-remove">
                                                                                            <xf:label><xh:i class="fa fa-fw fa-minus-circle" title="{$r/remove-parameter}"/></xf:label>
                                                                                            <xf:action event="DOMActivate">
                                                                                                <xf:delete ref="$param-elem"/>
                                                                                            </xf:action>
                                                                                        </xf:trigger>
                                                                                    </xh:div>
                                                                                </xh:div>
                                                                            </xf:repeat>
                                                                        </xf:case>
                                                                    </xf:switch>
                                                                </xh:div>
                                                            </xh:div>
                                                        </xh:div>

                                                        <!-- Row action buttons on the right -->
                                                        <xh:div class="fr-process-row-buttons">
                                                            <xh:i class="fa fa-fw fa-bars fr-process-grab" title="Move"/>

                                                            <!-- Remove button -->
                                                            <xf:trigger appearance="minimal" class="fr-process-btn fr-process-btn-remove">
                                                                <xf:label><xh:i class="fa fa-fw fa-minus-circle" title="Remove"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:delete ref="$current"/>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Add button -->
                                                            <xf:trigger appearance="minimal" class="fr-process-btn fr-process-btn-add">
                                                                <xf:label><xh:i class="fa fa-fw fa-plus-circle" title="Add step"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="process" value="$current/ancestor::process[1]"/>
                                                                    <xf:insert
                                                                        if="$current[self::else]"
                                                                        context="$current"
                                                                        origin="peu:newActionTemplateXml('', 'then')"/>
                                                                    <xf:insert
                                                                        if="$current[not(self::else)]"
                                                                        ref="$current"
                                                                        position="after"
                                                                        origin="peu:newActionTemplateXml('', 'then')"/>
                                                                    <xf:var
                                                                        name="new-step"
                                                                        value="if ($current[self::else]) then $current/step[last()] else $current/following-sibling::step[1]"/>
                                                                    <xf:var
                                                                        name="new-index"
                                                                        value="count($process//*[self::step or self::else][. &lt;&lt; $new-step]) + 1"/>
                                                                    <xf:rebuild/>
                                                                    <xf:recalculate/>
                                                                    <xf:revalidate/>
                                                                    <xf:refresh/>
                                                                    <xf:dispatch if="exists($new-index)" name="fr-focus-step" targetid="fr-process-steps-group">
                                                                        <xf:property name="index" value="$new-index"/>
                                                                    </xf:dispatch>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Group button -->
                                                            <xf:trigger appearance="minimal" class="fr-process-btn fr-process-btn-group" ref="$current[self::step and @type != 'group']">
                                                                <xf:label><xh:i class="fa fa-fw fa-object-group" title="Group"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="new-group" value="peu:newGroupTemplateXml($current/@combinator)"/>
                                                                    <xf:insert context="$new-group" origin="xxf:mutable-document($current)"/>
                                                                    <xf:setvalue ref="$new-group/*/@combinator" value="'then'"/>
                                                                    <xf:insert ref="$current" position="after" origin="$new-group"/>
                                                                    <xf:delete ref="$current"/>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Ungroup button -->
                                                            <xf:trigger
                                                                appearance="minimal"
                                                                class="fr-process-btn fr-process-btn-ungroup"
                                                                ref="$current[exists(parent::then | parent::else | parent::step[@type = 'group'] | self::step[@type = 'group'] | self::step[@type = 'condition' and empty(else)])]">
                                                                <xf:label><xh:i class="fa fa-fw fa-object-ungroup" title="Ungroup"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="unwrap-group" value="$current/@type = 'group'"/>
                                                                    <xf:var name="unwrap-cond"  value="$current/@type = 'condition' and empty($current/else)"/>
                                                                    <xf:action if="$unwrap-group">
                                                                        <xf:var name="comb" value="string($current/@combinator)"/>
                                                                        <xf:insert ref="$current" position="after" origin="$current/step"/>
                                                                        <xf:setvalue if="exists($current/step)" ref="$current/following-sibling::step[1]/@combinator" value="$comb"/>
                                                                        <xf:delete ref="$current"/>
                                                                    </xf:action>
                                                                    <xf:action if="$unwrap-cond">
                                                                        <xf:var name="comb" value="string($current/@combinator)"/>
                                                                        <xf:insert ref="$current" position="after" origin="$current/then/step"/>
                                                                        <xf:setvalue if="exists($current/then/step)" ref="$current/following-sibling::step[1]/@combinator" value="$comb"/>
                                                                        <xf:delete ref="$current"/>
                                                                    </xf:action>
                                                                    <xf:action if="not($unwrap-group or $unwrap-cond) and $current/parent::step[@type = 'group']">
                                                                        <xf:var name="parent-grp" value="$current/parent::step[@type = 'group']"/>
                                                                        <xf:insert ref="$parent-grp" position="after" origin="$current"/>
                                                                        <xf:delete ref="$current"/>
                                                                        <xf:delete if="empty($parent-grp/step)" ref="$parent-grp"/>
                                                                    </xf:action>
                                                                    <xf:action if="not($unwrap-group or $unwrap-cond) and ($current/parent::then or $current/parent::else)">
                                                                        <xf:var name="parent-cnd" value="$current/ancestor::step[@type = 'condition'][1]"/>
                                                                        <xf:insert ref="$parent-cnd" position="after" origin="$current"/>
                                                                        <xf:delete ref="$current"/>
                                                                        <xf:delete if="empty($parent-cnd/then/step) and empty($parent-cnd/else/step)" ref="$parent-cnd"/>
                                                                    </xf:action>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Condition button -->
                                                            <xf:trigger appearance="minimal" class="fr-process-btn fr-process-btn-condition" ref="$current[self::step and @type != 'condition']">
                                                                <xf:label><xh:span class="fr-process-btn-badge" title="Condition (if)">if</xh:span></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="new-cond" value="peu:newConditionTemplateXml($current/@combinator)"/>
                                                                    <xf:insert context="$new-cond/then" origin="xxf:mutable-document($current)"/>
                                                                    <xf:setvalue ref="$new-cond/then/*/@combinator" value="'then'"/>
                                                                    <xf:insert ref="$current" position="after" origin="$new-cond"/>
                                                                    <xf:delete ref="$current"/>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Else button on condition -->
                                                            <xf:trigger
                                                                appearance="minimal"
                                                                class="fr-process-btn fr-process-btn-else {'fr-process-btn-active'[exists($current/else)]}"
                                                                ref="$current[self::step[@type = 'condition']]">
                                                                <xf:label>
                                                                    <xh:span
                                                                        class="fr-process-btn-badge"
                                                                        title="{if (exists($current/else)) then 'Remove else branch' else 'Add else branch'}">else</xh:span>
                                                                </xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="add-else" value="empty($current/else)"/>
                                                                    <xf:action if="$add-else">
                                                                        <xf:var name="process" value="$current/ancestor::process[1]"/>
                                                                        <xf:insert
                                                                            context="$current"
                                                                            ref="*"
                                                                            origin="peu:newElseTemplateXml()"/>
                                                                        <xf:var name="new-step" value="$current/else/step[1]"/>
                                                                        <xf:var
                                                                            name="new-index"
                                                                            value="count($process//*[self::step or self::else][. &lt;&lt; $new-step]) + 1"/>
                                                                        <xf:rebuild/>
                                                                        <xf:recalculate/>
                                                                        <xf:revalidate/>
                                                                        <xf:refresh/>
                                                                        <xf:dispatch if="exists($new-index)" name="fr-focus-step" targetid="fr-process-steps-group">
                                                                            <xf:property name="index" value="$new-index"/>
                                                                        </xf:dispatch>
                                                                    </xf:action>
                                                                    <xf:action if="not($add-else)">
                                                                        <xf:delete ref="$current/else"/>
                                                                    </xf:action>
                                                                </xf:action>
                                                            </xf:trigger>
                                                        </xh:div>
                                                    </xh:div>
                                                </xf:repeat>
                                                </xh:div>
                                            </xf:group>

                                            <!-- When process has NO steps -->
                                            <xf:group ref=".[empty(step)]" class="fr-process-empty-steps">
                                                <xf:output value="$r/no-steps"/>
                                                <xf:trigger appearance="minimal">
                                                    <xf:label><xh:i class="fa fa-plus-circle"/> <xf:output value="$r/add-step"/></xf:label>
                                                    <xf:action event="DOMActivate">
                                                        <xf:insert context="." origin="peu:newActionTemplateXml('', 'then')"/>
                                                        <xf:rebuild/>
                                                        <xf:recalculate/>
                                                        <xf:revalidate/>
                                                        <xf:refresh/>
                                                        <xf:dispatch name="fr-focus-step" targetid="fr-process-steps-group">
                                                            <xf:property name="index" value="1"/>
                                                        </xf:dispatch>
                                                    </xf:action>
                                                </xf:trigger>
                                            </xf:group>

                                        </xh:div>
                                    </xf:case>
                                    <xf:case value="'text'">
                                        <xh:div class="fr-process-text-editor">
                                            <xh:div class="fr-process-text-wrapper">
                                                <xh:div class="fr-process-text-backdrop" aria-hidden="true">
                                                    <xh:div class="fr-process-text-highlights"/>
                                                </xh:div>
                                                <xf:textarea ref="_text" id="fr-process-text-textarea" incremental="true" class="fr-process-text-textarea">
                                                    <xf:label value="$r/process-definition/label"/>
                                                    <xf:hint value="$r/process-definition/hint" appearance="minimal"/>
                                                    <xf:alert value="peu:processSyntaxErrorMessage(., $r)"/>
                                                </xf:textarea>
                                                <xh:div class="fr-process-text-buttons">
                                                    <xf:trigger appearance="minimal" class="fr-process-text-format-btn">
                                                        <xf:label><xh:i class="fa fa-wand-magic-sparkles fa-fw" title="{$r/format}"/></xf:label>
                                                        <xf:action event="DOMActivate" if="peu:isProcessSyntaxValid(_text)">
                                                            <xf:setvalue ref="_text" value="peu:formatProcessString(.)"/>
                                                        </xf:action>
                                                    </xf:trigger>
                                                    <xh:button
                                                        type="button"
                                                        class="fr-process-text-copy-btn"
                                                        title="{$r/copy}"
                                                        aria-label="{$r/copy}"
                                                        tabindex="-1">
                                                        <xh:i class="fa fa-copy fa-fw" aria-hidden="true"/>
                                                    </xh:button>
                                                </xh:div>
                                            </xh:div>
                                        </xh:div>
                                    </xf:case>
                                </xf:switch>
                                </xh:div>

                                <xf:group ref=".[not($is-single-mode)]" class="fr-process-delete-container">
                                    <xf:trigger appearance="xxf:mini xxf:danger">
                                        <xf:label value="$r/delete-process"/>
                                        <xf:delete event="DOMActivate" ref="."/>
                                    </xf:trigger>
                                </xf:group>
                            </xh:div>
                        </fr:tab>
                    </fr:tabbable>

                    <xf:action observer="fr-processes-tabbable" event="fr-tabbable-add">
                        <xf:insert
                            context="$i"
                            ref="process"
                            origin="instance('process-template')"/>
                        <xf:setfocus control="fr-process-name"/>
                    </xf:action>
                    </xh:div>

                    <fr:error-summary id="error-summary" observer="dialog" valid-ref="instance('validity-instance')">
                        <fr:label><xf:output value="xxf:r('detail.labels.errors', '|fr-fr-resources|')"/></fr:label>
                    </fr:error-summary>

                    <xh:div class="fr-dialog-buttons" xml:space="preserve">
                        <xf:trigger id="fr-save-trigger" appearance="xxf:primary">
                            <xf:label mediatype="text/html" value="$r/apply"/>
                        </xf:trigger>
                        <xf:output value="$r/or"/>
                        <xf:trigger appearance="minimal">
                            <xf:label mediatype="text/html" value="$r/cancel"/>
                            <xxf:hide
                                event="DOMActivate"
                                dialog="dialog"/>
                        </xf:trigger>
                    </xh:div>

                </xxf:dialog>
            </xf:group>
        </xbl:template>

    </xbl:binding>
</xbl:xbl>
