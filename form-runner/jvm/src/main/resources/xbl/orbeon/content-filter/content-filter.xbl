<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
         xmlns:oxf="http://www.orbeon.com/oxf/processors">

    <xbl:binding
            id="fr-content-filter"
            element="
                fr|content-filter,
                xf|input[appearance ~= content-filter],
                xf|textarea[appearance ~= content-filter]"
            xxbl:mode="binding lhha value external-value javascript-lifecycle"
            xxbl:label-for="field"
            xxbl:container="span">

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Content Filter</display-name>
            <display-name lang="fr">Filtre de contenu</display-name>
            <display-name lang="no">Innholdsfilter</display-name>
            <display-name lang="ru">Фильтр содержимого</display-name>
            <display-name lang="it">Filtro contenuti</display-name>
            <display-name lang="de">Inhaltsfilter</display-name>
            <display-name lang="fi">Sisältösuodatin</display-name>
            <display-name lang="es">Filtro de contenido</display-name>
            <display-name lang="nl">Inhoudsfilter</display-name>
            <display-name lang="pt">Filtro de conteúdo</display-name>
            <display-name lang="sv">Innehållsfilter</display-name>
            <display-name lang="ar">مرشح المحتوى</display-name>
            <display-name lang="pl">Filtr treści</display-name>
            <display-name lang="ja">コンテンツフィルター</display-name>
            <appearance-display-name lang="en">With Content Filter</appearance-display-name>
            <appearance-display-name lang="fr">Avec filtre de contenu</appearance-display-name>
            <appearance-display-name lang="no">Med innholdsfilter</appearance-display-name>
            <appearance-display-name lang="ru">С фильтром содержимого</appearance-display-name>
            <appearance-display-name lang="it">Con filtro contenuti</appearance-display-name>
            <appearance-display-name lang="de">Mit Inhaltsfilter</appearance-display-name>
            <appearance-display-name lang="fi">Sisältösuodattimella</appearance-display-name>
            <appearance-display-name lang="es">Con filtro de contenido</appearance-display-name>
            <appearance-display-name lang="nl">Met inhoudsfilter</appearance-display-name>
            <appearance-display-name lang="pt">Com filtro de conteúdo</appearance-display-name>
            <appearance-display-name lang="sv">Med innehållsfilter</appearance-display-name>
            <appearance-display-name lang="ar">مع مرشح المحتوى</appearance-display-name>
            <appearance-display-name lang="pl">Z filtrem treści</appearance-display-name>
            <appearance-display-name lang="ja">コンテンツフィルター付き</appearance-display-name>
            <toolbox show="false"/>
            <icon>
                <icon-class>fa fa-fw fa-filter</icon-class>
            </icon>
            <templates>
                <view>
                    <xf:textarea id="" ref="" appearance="content-filter" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </xf:textarea>
                </view>
            </templates>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/content-filter/content-filter.css"/>
        </xbl:resources>

        <xbl:handlers>
            <xbl:handler event="xforms-enabled xforms-value-changed">
                <xf:setvalue ref="instance('local')/value" value="xxf:binding('fr-content-filter')"/>
                <xf:setvalue ref="instance('local')/type"  value="xxf:type(xxf:binding('fr-content-filter'))"/>
                <xf:rebuild/>
            </xbl:handler>
            <xbl:handler event="xforms-enabled xforms-readonly xforms-readwrite" phase="target">
                <xf:setvalue
                    ref="instance('local')/readonly"
                    value="xxf:is-control-readonly('fr-content-filter')"/>
            </xbl:handler>
        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="model">
                <xf:instance id="local">
                    <local>
                        <value/>
                        <type/>
                        <readonly/>
                    </local>
                </xf:instance>
                <xf:bind
                    ref="value"
                    readonly="../readonly/string() = 'true'">
                    <xf:constraint
                        id="internal-validation"
                        value="xxf:is-blank(string(.)) or ../readonly/string() = 'true' or fr:is-content-clean(string(.), fr:lang())"/>
                </xf:bind>
                <xf:instance id="orbeon-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <_>
                        <resource xml:lang="en"><alert>This content appears to use inappropriate language.</alert></resource>
                        <resource xml:lang="es"><alert>Este contenido parece utilizar lenguaje inapropiado.</alert></resource>
                        <resource xml:lang="fi"><alert>Tämä sisältö näyttää käyttävän sopimatonta kieltä.</alert></resource>
                        <resource xml:lang="fr"><alert>Ce contenu semble utiliser un langage inapproprié.</alert></resource>
                        <resource xml:lang="de"><alert>Dieser Inhalt scheint unangemessene Sprache zu verwenden.</alert></resource>
                        <resource xml:lang="it"><alert>Questo contenuto sembra utilizzare un linguaggio inappropriato.</alert></resource>
                        <resource xml:lang="sv"><alert>Detta innehåll verkar använda olämpligt språk.</alert></resource>
                        <resource xml:lang="nl"><alert>Deze inhoud lijkt ongepast taalgebruik te bevatten.</alert></resource>
                        <resource xml:lang="pt"><alert>Este conteúdo parece utilizar linguagem inadequada.</alert></resource>
                        <resource xml:lang="pl"><alert>Ta treść wydaje się zawierać niewłaściwy język.</alert></resource>
                        <resource xml:lang="ar"><alert>يبدو أن هذا المحتوى يستخدم لغة غير لائقة.</alert></resource>
                        <resource xml:lang="ca"><alert>Aquest contingut sembla utilitzar un llenguatge inadequat.</alert></resource>
                        <resource xml:lang="da"><alert>Dette indhold ser ud til at bruge upassende sprog.</alert></resource>
                        <resource xml:lang="hu"><alert>Ez a tartalom úgy tűnik, nem megfelelő nyelvezetet használ.</alert></resource>
                        <resource xml:lang="ja"><alert>このコンテンツには不適切な言語が含まれている可能性があります。</alert></resource>
                        <resource xml:lang="no"><alert>Dette innholdet ser ut til å bruke upassende språk.</alert></resource>
                        <resource xml:lang="ru"><alert>Этот контент, похоже, использует недопустимую лексику.</alert></resource>
                        <resource xml:lang="tr"><alert>Bu içerik uygunsuz dil kullanıyor gibi görünüyor.</alert></resource>
                        <resource xml:lang="zh-Hans"><alert>该内容似乎使用了不当语言。</alert></resource>
                        <resource xml:lang="zh-Hant"><alert>該內容似乎使用了不當語言。</alert></resource>
                    </_>
                </xf:instance>
            </xf:model>
        </xbl:implementation>

        <xbl:template xxbl:transform="oxf:xslt">
            <xh:span xsl:version="2.0" class="fr-content-filter-wrapper">
                <xf:var
                    name="binding"
                    value="xxf:binding('fr-content-filter')"/>
                <xh:div class="fr-content-filter-backdrop" aria-hidden="true">
                    <xh:div class="fr-content-filter-highlights"/>
                </xh:div>
                <xsl:element name="{name(/*)}">
                    <xsl:attribute name="id"          select="'field'"/>
                    <xsl:attribute name="ref"         select="'instance(''local'')/value'"/>
                    <xsl:attribute name="appearance"  select="tokenize(/*/@appearance, '\s+')[. != 'content-filter']"/>
                    <xsl:copy-of select="/*/@mediatype"/>
                    <xsl:if test="/*/@autocomplete">
                        <xsl:attribute name="autocomplete">
                            <xsl:value-of select="/*/@autocomplete"/>
                        </xsl:attribute>
                    </xsl:if>
                    <xf:alert validation="internal-validation" ref="fr:r('alert')"/>
                    <xf:setvalue
                        event="DOMActivate DOMFocusOut"
                        ref="$binding"
                        value="instance('local')/value"/>
                </xsl:element>
            </xh:span>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>
