                                    <item value="-1">Käytä oletusta</item>
                                    <item value="-2">Ei säätöä</item>
                                </max-width>
                                <max-height>
                                    <label>Säädä enimmäiskorkeus arvoon</label>
                                </max-height>
                                <quality>
                                    <label>Pakatun kuvan laatu</label>
                                    <item value="-1">Käytä oletusta</item>
                                    <item value="90">Korkea (90%)</item>
                                    <item value="80">Keskitaso (80%)</item>
                                    <item value="70">Matala (70%)</item>
                                    <item value="50">Hyvin matala (50%)</item>
                                </quality>
                                <format>
