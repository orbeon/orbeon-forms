                                <label>Nome del processo</label>
                                <hint>Nome univoco che identifica questo processo (es. save-final)</hint>
                                <alert>È richiesto un nome di processo valido e univoco</alert>
                            </process-name>
                            <process-definition>
                                <label>Definizione del processo</label>
                                <hint>Azioni separate da combinatori, es. validate then save</hint>
                                <alert>La sintassi del processo non è valida</alert>
