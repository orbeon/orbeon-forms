                        </resource>
                        <resource xml:lang="ru">
                            <readonly-hint>Включите Переопределить, чтобы добавлять, удалять, менять порядок или редактировать удалённые серверы.</readonly-hint>
                            <visual-mode>Визуально</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Форматировать</format-json>
                            <copy-json>Копировать</copy-json>
                            <add-server>Добавить удалённый сервер</add-server>
