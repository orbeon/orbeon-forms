<xbl:xbl xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <xbl:binding
        id="fr-open-select-horizontal"
        element="
            fr|open-select[appearance ~= full][appearance ~= 'xxf:horizontal'],
            xf|select[selection = open][appearance ~= full][appearance ~= 'xxf:horizontal']"
        xxbl:container="span"
        xxbl:mode="lhha binding value">

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Horizontal Checkboxes with "Other"</display-name>
            <display-name lang="fr">Cases à cocher horizontales avec "Autre"</display-name>
            <display-name lang="no">Horisontale avkrysningsbokser med "Annet"</display-name>
            <display-name lang="ru">Горизонтальные флажки с вариантом "Другое"</display-name>
            <display-name lang="it">Caselle di controllo orizzontali con "Altro"</display-name>
            <display-name lang="de">Horizontale Kontrollkästchen mit "Andere"</display-name>
            <display-name lang="fi">Vaakasuuntaiset valintaruudut "Muu"-vaihtoehdolla</display-name>
            <display-name lang="es">Casillas de verificación horizontales con "Otros"</display-name>
            <display-name lang="nl">Horizontale selectievakjes met "Andere"</display-name>
            <display-name lang="pt">Caixas de seleção horizontais com "Outro"</display-name>
            <display-name lang="sv">Horisontella kryssrutor med "Annat"</display-name>
            <display-name lang="ar">مربعات اختيار أفقية مع "آخر"</display-name>
            <display-name lang="pl">Poziome pola wyboru z "Inne"</display-name>
            <display-name lang="ja">水平「その他」付きチェックボックス</display-name>
            <toolbox show="false"/>
            <icon>
                <icon-class>fa fa-fw fa-check-square-o</icon-class>
            </icon>
            <editors static-itemset="true" item-hint="true"/>
            <templates>
                <view>
                    <fr:open-select id="" ref="" appearance="full xxf:horizontal" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                        <xf:itemset ref="">
                            <xf:label ref="label"/>
                            <xf:value ref="value"/>
                            <xf:hint  ref="hint"/>
                        </xf:itemset>
                    </fr:open-select>
                </view>
            </templates>
        </metadata>

    </xbl:binding>
</xbl:xbl>
