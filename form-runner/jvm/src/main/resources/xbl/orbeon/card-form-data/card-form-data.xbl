<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:frf="java:org.orbeon.oxf.fr.FormRunner"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner">

    <xbl:binding
        id="fr-card-form-data"
        element="fr|card-form-data"
        xxbl:mode="lhha custom-lhha binding"
        class="h-100"
    >
        <xbl:implementation>
            <xf:model id="model">

                <xf:var
                    name="page-size"
                    value="xs:integer(xxf:property('oxf.fr.landing.page-size'))"/>

                <xf:var
                    name="max-rows"
                    value="$page-size + 6"/>

                <xf:var
                    name="tz"
                    value="
                        for $offset in frf:defaultTimezoneToOffsetString()
                        return xs:dayTimeDuration($offset)"/>

                <!-- `xxf:lang()` isn't available inside `xf:model`, so read `fr-fr-language-instance` directly -->
                <xf:var
                    name="datelang"
                    value="(xxf:instance('fr-fr-language-instance')[frf:hasXPathNumberer(.)], 'en')[1]"/>

                <xf:var name="app"     value="fr:component-param-value('app')"/>
                <xf:var name="form"    value="fr:component-param-value('form')"/>
                <xf:var name="version" value="xs:integer((fr:component-param-value('version')[. castable as xs:integer], 1)[1])"/>

                <xf:instance id="fr-state-instance" xxf:exclude-result-prefixes="#all">
                    <_
                        state="initial"
                        has-loaded="false"
                        source-form-loaded="false"
                        form-not-found="false"
                        app=""
                        form=""
                        card-label=""
                        operations=""
                        latest-modified=""
                        unfiltered-total=""
                        submitted-query=""
                        sort-announcement=""
                        model-absolute-id=""
                    />
                </xf:instance>

                <xf:instance id="fr-source-form-instance" xxf:readonly="false" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="fr-form-resources" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <!-- Used for obtaining item labels in single-column list mode -->
                <xf:var
                    name="form-resources"
                    value="instance('fr-form-resources')/(*[@xml:lang = xxf:instance('fr-fr-language-instance')], *)[1]"/>

                <xf:instance id="fr-search-instance">
                    <search>
                        <query/>
                        <query metadata="created"          match="gte"/>
                        <query metadata="created"          match="lt"/>
                        <query metadata="created-by"       match="exact"/>
                        <query metadata="last-modified"    match="gte" sort="desc"/>
                        <query metadata="last-modified"    match="lt"/>
                        <query metadata="last-modified-by" match="exact"/>
                        <query metadata="workflow-stage"   match="exact"/>
                        <drafts>exclude</drafts>
                        <page-size>5</page-size>
                        <page-number>1</page-number>
                        <lang/>
                    </search>
                </xf:instance>

                <!-- Contains search labels -->
                <xf:instance id="fr-search-labels-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="fr-order-by" xxf:exclude-result-prefixes="#all">
                    <order-by>
                        <column>last-modified</column>
                        <direction>desc</direction>
                    </order-by>
                </xf:instance>

                <xf:instance id="fr-dynamic-instance">
                    <_/>
                </xf:instance>

                <xf:instance id="fr-dynamic-instance-template" xxf:readonly="true">
                    <xh:html
                        xmlns:xh="http://www.w3.org/1999/xhtml"
                        xmlns:xf="http://www.w3.org/2002/xforms"
                        xmlns:xs="http://www.w3.org/2001/XMLSchema"
                        xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
                        xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
                        xmlns:frf="java:org.orbeon.oxf.fr.FormRunner"
                        lang="{xxf:instance('fr-fr-language-instance')}"
                        xml:lang="{xxf:instance('fr-fr-language-instance')}">
                        <xh:head>
                            <xf:model
                                id="fr-summary-dynamic-model"
                                xxf:readonly-appearance.static.select="minimal"
                                xxf:readonly-appearance.static.select1="minimal">
                                <xf:instance id="fr-form-instance">
                                    <documents/>
                                </xf:instance>
                                <xf:instance id="fr-form-resources">
                                    <resources/>
                                </xf:instance>
                                <xf:bind ref="instance('fr-form-instance')">
                                    <xf:bind ref="document" id="fr-document-bind">
                                        <xf:bind ref="details" id="fr-details-bind" readonly="true()"/>
                                    </xf:bind>
                                </xf:bind>
                            </xf:model>
                        </xh:head>
                        <xh:body>
                            <xf:var name="fr-resources"      value="xxf:instance('fr-fr-resources')/resource[@xml:lang = xxf:instance('fr-fr-language-instance')][1]"/>
                            <xf:var name="form-resources"    value="instance('fr-form-resources')/(resource[@xml:lang = xxf:instance('fr-fr-language-instance')], resource[1])[1]"/>
                            <xf:var name="app"               value="string(xxf:instance('fr-state-instance')/@app)"/>
                            <xf:var name="form"              value="string(xxf:instance('fr-state-instance')/@form)"/>
                            <xf:var name="global-operations" value="xxf:split(xxf:instance('fr-state-instance')/@operations)"/>
                            <xf:var name="sort-supported"     value="frf:isSortSupported($app, $form)"/>
                            <xf:var name="order-by-target-id" value="string(xxf:instance('fr-state-instance')/@model-absolute-id)"/>
                            <xf:var name="page-size"          value="xs:integer(xxf:property('oxf.fr.landing.page-size'))"/>

                            <xf:group ref="instance('fr-form-instance')[exists(document)]">
                                <xh:div class="fr-search-results-wrap">
                                    <xh:div
                                        class="fr-search-results"
                                        role="region"
                                        aria-label="{string(xxf:instance('fr-state-instance')/@card-label)}">
                                        <xh:table class="table table-condensed">
                                            <xh:thead>
                                                <xh:tr id="fr-summary-header-row"/>
                                            </xh:thead>
                                            <xh:tbody>
                                                <xf:repeat bind="fr-document-bind" id="documents-repeat">
                                                    <xf:var name="document"                    value="."/>
                                                    <xf:var name="is-extra-row"                value="position() gt $page-size"/>
                                                    <xf:var name="current-document-name"       value="string(@name)"/>
                                                    <xf:var name="current-document-operations" value="if (exists(@operations)) then xxf:split(@operations) else $global-operations"/>
                                                    <xf:var
                                                        name="edit-view-opt"
                                                        value="
                                                            if ($current-document-operations = ('*', 'update')) then
                                                                'edit'
                                                            else if ($current-document-operations = 'read') then
                                                                'view'
                                                            else
                                                                ()"/>
                                                    <xf:var
                                                        name="current-document-href-opt"
                                                        value="
                                                            if (exists($edit-view-opt)) then
                                                                string-join(('/fr', $app, $form, $edit-view-opt, $current-document-name), '/')
                                                            else
                                                                ()"/>
                                                    <xh:tr
                                                        id="fr-summary-body-row"
                                                        class="{'fr-card-extra-row fr-card-extra-row-hidden'[$is-extra-row]}"/>
                                                </xf:repeat>
                                            </xh:tbody>
                                        </xh:table>
                                    </xh:div>
                                </xh:div>
                            </xf:group>
                        </xh:body>
                    </xh:html>
                </xf:instance>

                <!-- Load `form.xhtml` synchronously during initialization so `<xxf:dynamic>` XBL CSS/JS assets are included in `<head>` -->
                <xf:submission
                    id="fr-get-source-form-submission"
                    method="get"
                    serialization="none"
                    resource="/fr/service/persistence/crud/{$app}/{$form}/form/form.xhtml"

                    replace="instance"
                    instance="fr-source-form-instance"

                    xxf:readonly="true"
                    xxf:cache="false"
                    xxf:xinclude="true"

                    xxf:show-progress="false"
                >

                    <xf:header>
                        <xf:name>Orbeon-Form-Definition-Version</xf:name>
                        <xf:value value="$version"/>
                    </xf:header>

                    <xf:action event="xforms-submit">
                        <xf:setvalue ref="instance('fr-state-instance')/@app"               value="$app"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@form"              value="$form"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@model-absolute-id" value="xxf:absolute-id('model')"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@form-not-found"    value="'false'"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@state"             value="'loading'"/>
                    </xf:action>

                    <xf:action event="xforms-submit-done">
                        <xf:delete ref="instance('fr-form-metadata-instance')/*"/>
                        <xf:insert
                            ref="instance('fr-form-metadata-instance')"
                            origin="frf:metadataInstanceRootOpt(instance('fr-source-form-instance'))"/>
                        <xf:var
                            name="property-profile-opt"
                            value="frf:getModelElem(instance('fr-source-form-instance'))/@xxf:property-profile[xxf:non-blank()]/xxf:trim()"/>
                        <xf:var
                            name="operations-from-role"
                            value="frf:authorizedOperationsBasedOnRolesXPath(instance('fr-form-metadata-instance')/permissions, $app, $form, $property-profile-opt)"/>
                        <xf:setvalue
                            ref="instance('fr-state-instance')/@operations"
                            value="string-join($operations-from-role, ' ')"/>
                        <xf:setvalue
                            ref="instance('fr-state-instance')/@card-label"
                            value="string((
                                instance('fr-form-metadata-instance')/(title[@xml:lang = xxf:instance('fr-fr-language-instance')], title)[xxf:non-blank()],
                                $form
                            )[1])"/>
                    </xf:action>

                    <xf:action event="xforms-submit-error" if="event('error-type') != 'submission-in-progress'">
                        <xf:var name="is-not-found" value="event('response-status-code') = (404, 410)"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@form-not-found" value="string($is-not-found)"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@has-loaded"     value="if ($is-not-found) then 'true' else ."/>
                        <xf:setvalue ref="instance('fr-state-instance')/@state"          value="if ($is-not-found and fr:component-param-value('hide-when-empty') = 'true') then 'done' else 'error'"/>
                    </xf:action>

                </xf:submission>

                <xf:instance id="fr-search-results-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="fr-form-metadata-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:submission
                    id="fr-search-submission"
                    ref="instance('fr-search-instance')"
                    validate="false"
                    method="post"
                    resource="/fr/service/persistence/search/{$app}/{$form}"

                    replace="instance"
                    targetref="instance('fr-search-results-instance')"

                    mode="asynchronous"
                    xxf:response-must-await="50ms"
                    xxf:show-progress="false"
                >

                    <xf:header>
                        <xf:name>Orbeon-Form-Definition-Version</xf:name>
                        <xf:value value="$version"/>
                    </xf:header>

                    <xf:action event="xforms-submit">
                        <xf:setvalue ref="instance('fr-state-instance')/@state"           value="'loading'"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@submitted-query" value="string(instance('fr-search-instance')/query[1])"/>
                        <xf:setvalue ref="page-size" value="$max-rows"/>
                        <xf:setvalue ref="lang" value="(xxf:instance('fr-fr-language-instance')[xxf:non-blank()], 'en')[1]"/>
                    </xf:action>

                    <xf:action event="xforms-submit-done">
                        <xf:setvalue ref="instance('fr-state-instance')/@state"      value="'done'"/>
                        <xf:setvalue ref="instance('fr-state-instance')/@has-loaded" value="'true'"/>

                        <xf:var name="returned-docs" value="instance('fr-search-results-instance')/document"/>
                        <xf:var name="search-total"  value="xs:integer((instance('fr-search-results-instance')/@search-total[. castable as xs:integer], 0)[1])"/>

                        <xf:action if="exists(instance('fr-dynamic-instance')/*)">
                            <xf:var name="dyn-docs" value="instance('fr-dynamic-instance')//xf:instance[@id = 'fr-form-instance']/*"/>
                            <xf:delete ref="$dyn-docs/*"/>
                            <xf:insert
                                context="$dyn-docs"
                                origin="$returned-docs[position() le $max-rows]"/>
                        </xf:action>

                        <xf:action if="xxf:is-blank(instance('fr-state-instance')/@submitted-query)">
                            <xf:setvalue
                                ref="instance('fr-state-instance')/@unfiltered-total"
                                value="string($search-total)"/>
                            <xf:setvalue
                                ref="instance('fr-state-instance')/@latest-modified"
                                value="
                                    if ($search-total le 0 or empty($returned-docs)) then
                                        ''
                                    else if (instance('fr-order-by')/column = 'last-modified' and instance('fr-order-by')/direction = 'desc') then
                                        string($returned-docs[1]/@last-modified)
                                    else
                                        string(
                                            max((
                                                instance('fr-state-instance')/@latest-modified[. castable as xs:dateTime]/xs:dateTime(.),
                                                $returned-docs/@last-modified[. castable as xs:dateTime]/xs:dateTime(.)
                                            ))
                                        )"/>
                        </xf:action>

                        <!-- If the filter query changed while this submission was in flight, immediately run the latest query -->
                        <xf:action if="string(instance('fr-search-instance')/query[1]) != string(instance('fr-state-instance')/@submitted-query)">
                            <xf:send submission="fr-search-submission"/>
                        </xf:action>
                    </xf:action>

                    <xf:setvalue
                        event="xforms-submit-error"
                        if="event('error-type') != 'submission-in-progress'"
                        ref="instance('fr-state-instance')/@state"
                        value="'error'"/>

                </xf:submission>

                <xf:action
                    event="xforms-model-construct-done"
                    if="not(fr:component-param-value('active') = 'false') and xxf:non-blank($app) and xxf:non-blank($form)">
                    <xf:send submission="fr-get-source-form-submission"/>
                </xf:action>

                <!-- Out of the box, this submission is used only for the Form Builder Summary page, as it is the only one with
                     an external resources instance (using the `src` attribute). -->
                <xf:submission
                    id="fr-load-form-resources-submission"
                    method="get"
                    resource="{event('fr-resources-uri')}"
                    serialization="none"
                    replace="instance"
                    instance="fr-form-resources"
                    xxf:readonly="true"
                    xxf:cache="true"
                    xxf:xinclude="true"/>

                <xf:action event="xforms-submit-done" observer="fr-get-source-form-submission">

                    <!-- Load resources -->
                    <xf:var
                        name="resources-instance"
                        value="instance('fr-source-form-instance')/xh:head/xf:model/xf:instance[@id = 'fr-form-resources']"/>
                    <xf:action if="exists($resources-instance/@src)">
                        <xf:send submission="fr-load-form-resources-submission">
                            <xf:property name="fr-resources-uri" value="$resources-instance/@src"/>
                        </xf:send>
                    </xf:action>
                    <xf:action if="empty($resources-instance/@src)">
                        <xf:insert
                            ref="instance('fr-form-resources')"
                            origin="$resources-instance/*"/>
                    </xf:action>

                    <xf:setvalue
                        ref="instance('fr-search-instance')/page-size"
                        value="$max-rows"/>

                    <!-- Create elements holding structured search data -->
                    <xf:delete
                        ref="
                            instance('fr-search-labels-instance')/* |
                            instance('fr-search-instance')/query[exists(@name)]"/>

                    <xf:insert
                        context="instance('fr-search-labels-instance')"
                        origin="frf:searchableValues(instance('fr-source-form-instance')/root(), $app, $form, $version, instance('fr-form-resources'))/*"/>

                    <xf:insert
                        context="instance('fr-search-instance')"
                        ref="query"
                        origin="instance('fr-search-labels-instance')/query[exists(@path)]"/>

                    <xf:delete
                        ref="instance('fr-search-labels-instance')/query/*[name() != 'resources']"/>

                    <xf:delete
                        ref="instance('fr-search-instance')/query/*"/>

                    <!-- Build dynamic Summary table for multi-column data cards -->
                    <xf:var
                        name="is-list-mode-init"
                        value="exists(xxf:split(fr:component-param-value('title-field')))"/>

                    <xf:action if="not($is-list-mode-init)">
                        <xf:delete ref="instance('fr-dynamic-instance')/*"/>
                        <xf:insert
                            ref="instance('fr-dynamic-instance')"
                            origin="
                                frf:buildCardSummaryDynamicForm(
                                    instance('fr-source-form-instance')/root(),
                                    instance('fr-dynamic-instance-template'),
                                    $app,
                                    $form,
                                    $version,
                                    instance('fr-form-resources')
                                )"/>
                    </xf:action>

                    <xf:setvalue
                        ref="instance('fr-state-instance')/@source-form-loaded"
                        value="'true'"/>

                    <!-- Query initial list of documents -->
                    <xf:send submission="fr-search-submission"/>

                </xf:action>

                <!-- Event dispatched by `fr:sortable-th` inside `<xxf:dynamic>` -->
                <xf:action event="fr-order-by">
                    <xf:var name="target-col"  value="string(event('column'))"/>
                    <xf:var name="col-label"   value="string(event('label'))"/>
                    <xf:var name="current-col" value="string(instance('fr-order-by')/column)"/>
                    <xf:var name="current-dir" value="string(instance('fr-order-by')/direction)"/>
                    <xf:var name="next-col" value="
                        if ($current-col = $target-col and $current-dir = 'desc') then
                            'last-modified'
                        else
                            $target-col
                    "/>
                    <xf:var name="next-dir" value="
                        if ($current-col = $target-col) then
                            'desc'
                        else
                            'asc'
                    "/>
                    <xf:var name="announce-col-label" value="
                        if ($next-col = 'last-modified') then
                            xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')
                        else
                            $col-label
                    "/>

                    <xf:setvalue ref="instance('fr-order-by')/column"    value="$next-col"/>
                    <xf:setvalue ref="instance('fr-order-by')/direction" value="$next-dir"/>
                    <xf:setvalue
                        ref="instance('fr-state-instance')/@sort-announcement"
                        value="
                            if ($next-dir = 'asc') then
                                xxf:format-message(
                                    xxf:r('landing.messages.sorted-by-ascending', '|fr-fr-resources|'),
                                    $announce-col-label
                                )
                            else
                                xxf:format-message(
                                    xxf:r('landing.messages.sorted-by-descending', '|fr-fr-resources|'),
                                    $announce-col-label
                                )"/>

                    <xf:delete ref="instance('fr-search-instance')/query/@sort"/>

                    <xf:insert
                        context="
                            if ($next-col = 'last-modified') then
                                instance('fr-search-instance')/query[@metadata = 'last-modified'][1]
                            else
                                instance('fr-search-instance')/query[@path = $next-col][1]"
                        origin="xf:attribute('sort', $next-dir)"/>

                    <xf:send submission="fr-search-submission"/>
                </xf:action>
            </xf:model>
        </xbl:implementation>
        <xbl:template>

            <xf:var
                name="title-fields"
                value="xxf:split(fr:component-param-value('title-field'))"/>

            <xf:var
                name="pill-field"
                value="fr:component-param-value('pill-field')[xxf:non-blank()]"/>

            <xf:var
                name="is-list-mode"
                value="exists($title-fields)"/>

            <xf:var
                name="all-named-queries"
                value="instance('fr-search-instance')/query[exists(@name)]"/>

            <xf:var
                name="list-query-positions"
                value="
                    if ($is-list-mode) then
                        $all-named-queries[@name = ($title-fields, $pill-field)]/(count(preceding-sibling::query[@name]) + 1)
                    else
                        ()"/>

            <xf:var
                name="list-query-names"
                value="for $p in $list-query-positions return string($all-named-queries[$p]/@name)"/>

            <xf:var
                name="primary-sort-query"
                value="
                    (
                        for $tf in $title-fields
                        return $all-named-queries[@name = $tf]
                    )[1]"/>

            <xf:var
                name="primary-sort-path"
                value="string($primary-sort-query/@path)"/>

            <xf:var
                name="primary-sort-label"
                value="
                    let $lq := instance('fr-search-labels-instance')/query[@path = $primary-sort-path][1]
                    return string(($lq/resources[@lang = xxf:lang()]/label, $lq/resources/label, $primary-sort-query/@name)[1])"/>

            <xf:var
                name="is-sorted-by-primary"
                value="xxf:non-blank($primary-sort-path) and instance('fr-order-by')/column = $primary-sort-path"/>

            <xf:var
                name="list-sort-toggle-label"
                value="
                    if ($is-sorted-by-primary) then
                        xxf:r('landing.buttons.sort-by-last-modified', '|fr-fr-resources|')
                    else
                        xxf:r('landing.buttons.sort-by-title', '|fr-fr-resources|')"/>

            <xf:var
                name="documents"
                value="instance('fr-search-results-instance')/document"/>

            <xf:var
                name="search-total"
                value="xs:integer((instance('fr-search-results-instance')/@search-total[. castable as xs:integer], count($documents))[1])"/>

            <xf:var
                name="document-count-to-render"
                value="min((count($documents), $max-rows))"/>

            <xf:var
                name="show-more"
                value="$search-total gt $page-size"/>

            <xf:var
                name="ops"
                value="xxf:split(instance('fr-state-instance')/@operations)"/>

            <xf:var
                name="is-singleton"
                value="instance('fr-form-metadata-instance')/singleton = 'true'"/>

            <xf:var
                name="can-create"
                value="$ops = ('*', 'create') and not($is-singleton and $search-total gt 0)"/>

            <xf:var
                name="can-list"
                value="$ops = ('*', 'list')"/>

            <xf:var
                name="new-href"
                value="concat('/fr/', $app, '/', $form, '/new')"/>

            <xf:var
                name="summary-href"
                value="
                    concat(
                        '/fr/',
                        $app,
                        '/',
                        $form,
                        '/summary',
                        if (
                            $version != 1 and
                            xxf:property(string-join(('oxf.fr.summary.show-version-selector', $app, $form), '.'))
                        ) then
                            concat('?form-version=', $version)
                        else
                            ''
                    )"/>

            <xf:var
                name="param-thumbnail"
                value="fr:component-param-value('thumbnail')[xxf:non-blank()]"/>

            <xf:var
                name="metadata-thumbnail"
                value="instance('fr-form-metadata-instance')/thumbnail[xxf:non-blank()]"/>

            <xf:var
                name="svg-thumbnail"
                value="($param-thumbnail, if (empty($metadata-thumbnail) and $app = 'orbeon' and $form = 'builder') then '/apps/fr/style/images/orbeon/library.svg' else ())[1]"/>

            <xf:var
                name="resolved-card-title"
                value="(
                    xxf:label('fr-card-form-data')[xxf:non-blank()],
                    instance('fr-form-metadata-instance')/(title[@xml:lang = xxf:lang()], title)[xxf:non-blank()],
                    $form
                )[1]"/>

            <xf:var
                name="filter"
                value="lower-case(xxf:trim(fr:component-param-value('filter')))"/>

            <xf:var
                name="is-filtering"
                value="xxf:non-blank($filter)"/>

            <xf:var
                name="card-title-matches"
                value="
                    $is-filtering and (
                        contains(lower-case(string($resolved-card-title)), $filter) or
                        contains(lower-case($app), $filter)                         or
                        contains(lower-case($form), $filter)
                    )"/>

            <xf:var
                name="effective-data-query"
                value="if ($is-filtering and not($card-title-matches)) then xxf:trim(fr:component-param-value('filter')) else ''"/>

            <xf:var
                name="latest-modified-dt"
                value="
                    if (xxf:non-blank($effective-data-query)) then
                        max($documents/@last-modified[. castable as xs:dateTime]/xs:dateTime(.))
                    else
                        instance('fr-state-instance')/@latest-modified[. castable as xs:dateTime]/xs:dateTime(.)"/>

            <xf:var
                name="unfiltered-total-opt"
                value="instance('fr-state-instance')/@unfiltered-total[. castable as xs:integer]/xs:integer(.)"/>

            <xf:var
                name="count-display"
                value="
                    if (xxf:non-blank($effective-data-query) and exists($unfiltered-total-opt) and $search-total != $unfiltered-total-opt) then
                        concat($search-total, ' / ', $unfiltered-total-opt)
                    else
                        string($search-total)"/>

            <xf:var
                name="is-filtered-out"
                value="
                    $is-filtering                                       and
                    not($card-title-matches)                            and
                    instance('fr-state-instance')/@has-loaded = 'true'  and
                    instance('fr-state-instance')/@state      = 'done'  and
                    $search-total                             = 0"/>

            <xf:var
                name="is-auto-hidden"
                value="
                    fr:component-param-value('hide-when-empty') = 'true' and (
                        instance('fr-state-instance')/@form-not-found = 'true' or (
                            instance('fr-state-instance')/@has-loaded = 'true' and
                            instance('fr-state-instance')/@state      = 'done' and
                            exists($unfiltered-total-opt)                      and
                            $unfiltered-total-opt                     = 0
                        )
                    )"/>

            <xf:var name="new-label"     value="xxf:r('landing.buttons.new', '|fr-fr-resources|')"/>
            <xf:var name="summary-label" value="xxf:r('landing.buttons.summary', '|fr-fr-resources|')"/>

            <xf:var
                name="refresh-watch"
                value="concat(fr:component-param-value('refresh-token'), '|', xxf:instance('fr-fr-language-instance'), '|', $effective-data-query)">
                <xf:action event="xforms-value-changed">
                    <xf:setvalue ref="instance('fr-search-instance')/query[1]" value="$effective-data-query"/>
                    <xf:setvalue ref="instance('fr-search-instance')/page-number" value="1"/>
                    <xf:send
                        if="instance('fr-state-instance')/@source-form-loaded = 'true'"
                        submission="fr-search-submission"/>
                    <xf:send
                        if="(instance('fr-state-instance')/@state = 'error' or instance('fr-state-instance')/@form-not-found = 'true') and not(instance('fr-state-instance')/@source-form-loaded = 'true')"
                        submission="fr-get-source-form-submission"/>
                </xf:action>
            </xf:var>

            <fr:card
                status="{instance('fr-state-instance')/@state}"
                has-loaded="{instance('fr-state-instance')/@has-loaded}"
                count="{$count-display}"
                total-count="{$search-total}"
                filtered-out="{$is-filtered-out}"
                auto-hidden="{$is-auto-hidden}"
                columns="1"
                show-headings="false"
                show-table="{not($is-list-mode)}"
                is-empty="{empty($documents)}"
                empty-message="{xxf:r('landing.messages.no-data', '|fr-fr-resources|')}"
            >
                <xf:label value="$resolved-card-title"/>

                <fr:card-status>
                    <xf:output value="instance('fr-state-instance')/@sort-announcement"/>
                </fr:card-status>

                <fr:card-actions>
                    <xf:trigger
                        appearance="minimal"
                        class="fr-card-action-btn fr-card-sort-mode-btn {'xforms-hidden'[not($is-list-mode) or xxf:is-blank($primary-sort-path) or $search-total le 1]}">
                        <xf:label>
                            <xh:i class="fa {if ($is-sorted-by-primary) then 'fa-arrow-down-a-z' else 'fa-clock'}" aria-hidden="true"/>
                            <xh:span class="xforms-hidden"><xf:output value="$list-sort-toggle-label"/></xh:span>
                        </xf:label>
                        <xf:hint value="$list-sort-toggle-label"/>
                        <xf:action event="DOMActivate">
                            <xf:var name="next-col" value="if ($is-sorted-by-primary) then 'last-modified' else $primary-sort-path"/>
                            <xf:var name="next-dir" value="if ($next-col = 'last-modified') then 'desc' else 'asc'"/>
                            <xf:var name="announce-col-label" value="
                                if ($next-col = 'last-modified') then
                                    xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')
                                else
                                    $primary-sort-label
                            "/>

                            <xf:setvalue ref="instance('fr-order-by')/column"    value="$next-col"/>
                            <xf:setvalue ref="instance('fr-order-by')/direction" value="$next-dir"/>
                            <xf:setvalue
                                ref="instance('fr-state-instance')/@sort-announcement"
                                value="
                                    if ($next-dir = 'asc') then
                                        xxf:format-message(
                                            xxf:r('landing.messages.sorted-by-ascending', '|fr-fr-resources|'),
                                            $announce-col-label
                                        )
                                    else
                                        xxf:format-message(
                                            xxf:r('landing.messages.sorted-by-descending', '|fr-fr-resources|'),
                                            $announce-col-label
                                        )"/>

                            <xf:delete ref="instance('fr-search-instance')/query/@sort"/>

                            <xf:insert
                                context="
                                    if ($next-col = 'last-modified') then
                                        instance('fr-search-instance')/query[@metadata = 'last-modified'][1]
                                    else
                                        instance('fr-search-instance')/query[@path = $next-col][1]"
                                origin="xf:attribute('sort', $next-dir)"/>

                            <xf:send submission="fr-search-submission"/>
                        </xf:action>
                    </xf:trigger>
                    <xh:a
                        href="{$new-href}"
                        title="{$new-label}"
                        aria-label="{$new-label}"
                        class="fr-card-action-btn {'xforms-hidden'[not($can-create)]}">
                        <xh:i class="fa fa-plus" aria-hidden="true"/>
                    </xh:a>
                    <xh:a
                        href="{$summary-href}"
                        title="{$summary-label}"
                        aria-label="{$summary-label}"
                        class="fr-card-action-btn {'xforms-hidden'[not($can-list)]}">
                        <xh:i class="fa fa-list" aria-hidden="true"/>
                    </xh:a>
                </fr:card-actions>

                <fr:card-body>
                    <xh:p class="card-text">
                        <xf:output
                            value="(
                                xxf:help('fr-card-form-data')[xxf:non-blank()],
                                instance('fr-form-metadata-instance')/(description[@xml:lang = xxf:lang()], description)[xxf:non-blank()]
                            )[1]"/>
                    </xh:p>
                </fr:card-body>

                <fr:card-thumbnail>
                    <!-- https://github.com/orbeon/orbeon-forms/issues/6696 -->
                    <xf:output
                        mediatype="image/*"
                        ref="$metadata-thumbnail[empty($param-thumbnail)]"
                        class="img-thumbnail fr-card-metadata-thumbnail"/>
                    <xf:group ref=".[exists($svg-thumbnail)]">
                        <xh:img
                            src="{($svg-thumbnail, 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7')[1]}"
                            alt=""
                            class="img-thumbnail img-invertible"/>
                    </xf:group>
                </fr:card-thumbnail>

                <fr:card-table>
                    <xxf:dynamic id="fr-card-summary-dynamic" ref="instance('fr-dynamic-instance')[not($is-list-mode)]"/>
                </fr:card-table>

                <fr:rows>
                    <xf:var
                        name="list-column-labels"
                        value="
                            for $p in $list-query-positions,
                                $q in $all-named-queries[$p],
                                $lq in (instance('fr-search-labels-instance')/query[@path = $q/@path][1], $q)[1]
                            return string(($lq/resources[@lang = xxf:lang()]/label, $lq/resources/label, $q/@name)[1])"/>

                    <xf:repeat ref="$documents[$is-list-mode and position() le $document-count-to-render]">
                        <xf:var name="is-extra-row" value="position() gt $page-size"/>
                        <xf:var name="document"     value="."/>
                        <xf:var
                            name="list-values"
                            value="
                                if (empty($list-query-positions)) then
                                    string($document/@name)
                                else
                                    for $detail-position in $list-query-positions
                                    return
                                        let $raw     := $document/details/detail[$detail-position],
                                            $query   := $all-named-queries[$detail-position],
                                            $control := $query/@control,
                                            $value   :=
                                                if (frf:isSingleSelectionControl($control)) then
                                                    for $code in $raw return
                                                        ($form-resources/*[local-name() = $query/@name]/item[value = $code]/label, $code)[1]
                                                else
                                                    $raw
                                        return
                                            if (xxf:is-blank($value)) then
                                                '–'
                                            else
                                                string($value)"/>

                        <xf:var
                            name="row-href"
                            value="
                                let
                                    $current-document-name       := string($document/@name),
                                    $current-document-operations := xxf:split($document/@operations),
                                    $edit-view-opt               :=
                                        if ($current-document-operations = ('*', 'update')) then
                                            'edit'
                                        else if ($current-document-operations = 'read') then
                                            'view'
                                        else
                                            ()
                                return
                                    if (exists($edit-view-opt)) then
                                        string-join(('/fr', $app, $form, $edit-view-opt, $current-document-name), '/')
                                    else
                                        ''"/>

                        <xf:var
                            name="list-title"
                            value="
                                (
                                    for $tf in $title-fields,
                                        $idx in index-of($list-query-names, $tf)[1]
                                    return $list-values[$idx][. != '–'],
                                    string($document/@name)
                                )[1]"/>

                        <xf:var
                            name="list-pill"
                            value="
                                for $pf in $pill-field,
                                    $idx in index-of($list-query-names, $pf)[1]
                                return $list-values[$idx][. != '–']"/>

                        <xf:var
                            name="row-tooltip"
                            value="
                                if (empty($list-column-labels)) then
                                    string-join($list-values, ' · ')
                                else
                                    string-join(
                                        for $idx in 1 to count($list-values)
                                        return
                                            if ($list-values[$idx] = '–') then
                                                ()
                                            else
                                                concat($list-column-labels[$idx], ': ', $list-values[$idx]),
                                        ' · '
                                    )"/>

                        <xh:li
                            class="list-group-item fr-card-published-row {'fr-card-extra-row fr-card-extra-row-hidden'[$is-extra-row]}"
                            role="listitem"
                            title="{$row-tooltip}">
                            <xh:a
                                href="{if (xxf:non-blank($row-href)) then $row-href else '#'}"
                                class="fr-card-row-primary {'xforms-hidden'[xxf:is-blank($row-href)]}">
                                <xh:span class="fr-card-col fr-card-col-single">
                                    <xh:span class="fr-card-col-text text-truncate">
                                        <xf:output value="$list-title"/>
                                    </xh:span>
                                    <xh:span class="fr-card-app-pill {'xforms-hidden'[empty($list-pill)]}">
                                        <xf:output value="$list-pill"/>
                                    </xh:span>
                                </xh:span>
                            </xh:a>
                            <xh:div
                                class="fr-card-row-primary {'xforms-hidden'[xxf:non-blank($row-href)]}">
                                <xh:span class="fr-card-col fr-card-col-single">
                                    <xh:span class="fr-card-col-text text-truncate">
                                        <xf:output value="$list-title"/>
                                    </xh:span>
                                    <xh:span class="fr-card-app-pill {'xforms-hidden'[empty($list-pill)]}">
                                        <xf:output value="$list-pill"/>
                                    </xh:span>
                                </xh:span>
                            </xh:div>
                        </xh:li>
                    </xf:repeat>
                </fr:rows>

                <fr:card-footer>
                    <xh:span class="fr-card-footer-meta {'xforms-hidden'[empty($latest-modified-dt)]}">
                        <xf:output value="
                            if (empty($latest-modified-dt)) then
                                ''
                            else
                                let $v :=
                                    if (exists($tz)) then
                                        adjust-dateTime-to-timezone($latest-modified-dt, $tz)
                                    else
                                        adjust-dateTime-to-timezone($latest-modified-dt)
                                return
                                    if (current-dateTime() - $v lt xs:dayTimeDuration('P1D'))
                                    then format-dateTime($v, xxf:r('common.formats.within-day', '|fr-fr-resources|'), xxf:lang(), (), ())
                                    else if (year-from-dateTime(current-dateTime()) = year-from-dateTime($v))
                                    then format-dateTime($v, xxf:r('common.formats.day-this-year', '|fr-fr-resources|'), xxf:lang(), (), ())
                                    else format-dateTime($v, xxf:r('common.formats.short-date', '|fr-fr-resources|'), xxf:lang(), (), ())">
                            <xf:label ref="xxf:r('home-summary.titles.last-modified', '|fr-fr-resources|')"/>
                        </xf:output>
                    </xh:span>
                    <xh:a href="{$summary-href}" class="fr-card-show-more {'xforms-hidden'[not($show-more)]}">
                        <xh:span><xf:output value="xxf:r('landing.show-more', '|fr-fr-resources|')"/></xh:span>
                        <xh:i class="fa fa-arrow-right" aria-hidden="true"/>
                    </xh:a>
                </fr:card-footer>

            </fr:card>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
