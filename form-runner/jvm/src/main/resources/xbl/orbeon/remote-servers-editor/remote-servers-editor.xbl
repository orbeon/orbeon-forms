                            <ui-access-label>UI-tilgang (Skjemaadmin)</ui-access-label>
                            <api-access-label>API-tilgang (push/pull)</api-access-label>
                            <alert-url-required>Server-URL er påkrevd</alert-url-required>
                            <alert-duplicate-name>Duplisert servernavn</alert-duplicate-name>
                            <invalid-json>Ugyldig JSON for eksterne servere</invalid-json>
                        </resource>
                        <resource xml:lang="pl">
                            <readonly-hint>Włącz Nadpisz, aby dodawać, usuwać, zmieniać kolejność lub edytować serwery zdalne.</readonly-hint>
                            <visual-mode>Wizualny</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Formatuj</format-json>
                            <copy-json>Kopiuj</copy-json>
                            <add-server>Dodaj serwer zdalny</add-server>
