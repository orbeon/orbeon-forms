                            <copy-json>نسخ</copy-json>
                            <add-server>إضافة خادم بعيد</add-server>
                            <empty-servers>لا توجد خوادم بعيدة مهيأة. انقر على «إضافة خادم بعيد» لإضافة خادم.</empty-servers>
                            <drag-to-reorder>اسحب لإعادة الترتيب</drag-to-reorder>
                            <move-up>نقل الخادم لأعلى</move-up>
                            <move-down>نقل الخادم لأسفل</move-down>
                            <remove-server>إزالة الخادم</remove-server>
                            <moved-announcement>تم نقل الخادم إلى الموضع {0} من {1}</moved-announcement>
                            <removed-announcement>تمت إزالة الخادم</removed-announcement>
                            <label-label>التسمية</label-label>
                            <label-placeholder>التجريبي</label-placeholder>
                            <name-label>الاسم</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>عنوان URL للخادم</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>وصول الواجهة (إدارة النماذج)</ui-access-label>
                            <api-access-label>وصول API (الدفع/السحب)</api-access-label>
                            <alert-url-required>عنوان URL للخادم مطلوب</alert-url-required>
                            <alert-duplicate-name>اسم الخادم مكرر</alert-duplicate-name>
                            <invalid-json>صيغة JSON للخوادم البعيدة غير صالحة</invalid-json>
                        </resource>
                        <resource xml:lang="ja">
                            <readonly-hint>リモートサーバーを追加・削除・並べ替え・編集するには「上書き」を有効にしてください。</readonly-hint>
                            <visual-mode>ビジュアル</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>整形</format-json>
                            <copy-json>コピー</copy-json>
                            <add-server>リモートサーバーを追加</add-server>
                            <empty-servers>リモートサーバーが設定されていません。「リモートサーバーを追加」をクリックして追加してください。</empty-servers>
                            <drag-to-reorder>ドラッグして並べ替え</drag-to-reorder>
                            <move-up>サーバーを上へ移動</move-up>
                            <move-down>サーバーを下へ移動</move-down>
                            <remove-server>サーバーを削除</remove-server>
                            <moved-announcement>サーバーを {1} 件中 {0} 番目に移動しました</moved-announcement>
                            <removed-announcement>サーバーを削除しました</removed-announcement>
                            <label-label>ラベル</label-label>
                            <label-placeholder>ステージング</label-placeholder>
                            <name-label>名前</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>サーバーURL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>UIアクセス（フォーム管理）</ui-access-label>
                            <api-access-label>APIアクセス（push/pull）</api-access-label>
                            <alert-url-required>サーバーURLは必須です</alert-url-required>
                            <alert-duplicate-name>サーバー名が重複しています</alert-duplicate-name>
                            <invalid-json>無効なリモートサーバーJSON</invalid-json>
                        </resource>
                        <resource xml:lang="zh-Hans">
                            <readonly-hint>启用覆盖以添加、删除、重新排序或编辑远程服务器。</readonly-hint>
                            <visual-mode>可视化</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>格式化</format-json>
                            <copy-json>复制</copy-json>
                            <add-server>添加远程服务器</add-server>
                            <empty-servers>尚未配置远程服务器。点击“添加远程服务器”以添加一个。</empty-servers>
                            <drag-to-reorder>拖动以重新排序</drag-to-reorder>
                            <move-up>上移服务器</move-up>
                            <move-down>下移服务器</move-down>
                            <remove-server>删除服务器</remove-server>
                            <moved-announcement>已将服务器移至第 {0} / {1} 位</moved-announcement>
                            <removed-announcement>已删除服务器</removed-announcement>
                            <label-label>标签</label-label>
                            <label-placeholder>预发布</label-placeholder>
                            <name-label>名称</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>服务器 URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>界面访问（表单管理）</ui-access-label>
                            <api-access-label>API 访问（推送/拉取）</api-access-label>
                            <alert-url-required>服务器 URL 为必填项</alert-url-required>
                            <alert-duplicate-name>服务器名称重复</alert-duplicate-name>
                            <invalid-json>无效的远程服务器 JSON</invalid-json>
                        </resource>
                        <resource xml:lang="zh-Hant">
                            <readonly-hint>啟用覆寫以新增、刪除、重新排序或編輯遠端伺服器。</readonly-hint>
                            <visual-mode>視覺化</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>格式化</format-json>
                            <copy-json>複製</copy-json>
                            <add-server>新增遠端伺服器</add-server>
                            <empty-servers>尚未設定遠端伺服器。按一下「新增遠端伺服器」以新增一個。</empty-servers>
                            <drag-to-reorder>拖曳以重新排序</drag-to-reorder>
                            <move-up>上移伺服器</move-up>
                            <move-down>下移伺服器</move-down>
                            <remove-server>刪除伺服器</remove-server>
                            <moved-announcement>已將伺服器移至第 {0} / {1} 位</moved-announcement>
                            <removed-announcement>已刪除伺服器</removed-announcement>
                            <label-label>標籤</label-label>
                            <label-placeholder>預發布</label-placeholder>
                            <name-label>名稱</name-label>
                            <name-placeholder>staging</name-placeholder>
                            <url-label>伺服器 URL</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>介面存取（表單管理）</ui-access-label>
                            <api-access-label>API 存取（推送/拉取）</api-access-label>
                            <alert-url-required>伺服器 URL 為必填項目</alert-url-required>
                            <alert-duplicate-name>伺服器名稱重複</alert-duplicate-name>
                            <invalid-json>無效的遠端伺服器 JSON</invalid-json>
                        </resource>
                    </_>
                </xf:instance>

                <xf:bind ref="instance('editor')/servers/server">
                    <xf:bind
                        ref="@*"
                        readonly="instance('state')/@readonly = 'true'"/>
                    <xf:bind
                        ref="@url"
                        required="instance('state')/@readonly != 'true'"
                        xxf:whitespace="trim"/>
                    <xf:bind
                        ref="@name"
                        xxf:whitespace="trim"
                        constraint="instance('state')/@readonly = 'true' or xxf:is-blank(.) or not((../../server/@name except .) = .)"/>
                    <xf:bind
                        ref="@label"
                        xxf:whitespace="trim"/>
                </xf:bind>

                <xf:bind
                    ref="instance('state')/raw-json"
                    readonly="instance('state')/@readonly = 'true'"
                    constraint="instance('state')/@readonly = 'true' or rse:isValidRemoteServersJson(.)"/>

                <!-- Outbound sync: visual UI XML -> bound JSON value -->
                <xf:action
                    observer="editor remote-servers-editor-model"
                    event="xforms-insert xforms-delete xxforms-replace xxforms-value-changed fr-rse-push-json"
                    if="instance('state')/@initialized = 'true' and instance('state')/@syncing != 'true' and instance('state')/@readonly != 'true' and instance('state')/@mode = 'visual'">
                    <xf:var name="new-json" value="rse:uiXmlToJson(instance('editor')/servers)"/>
                    <xf:action if="$new-json != string(instance('state')/@last-json)">
                        <xf:setvalue ref="instance('state')/@last-json" value="$new-json"/>
                        <xf:setvalue ref="instance('state')/raw-json"   value="$new-json"/>
                        <xf:setvalue ref="xxf:binding('fr-remote-servers-editor')" value="$new-json"/>
                    </xf:action>
                </xf:action>

            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:group id="fr-remote-servers-editor-root" appearance="xxf:internal">

                <xf:var name="binding"       value="xxf:binding('fr-remote-servers-editor')"/>
                <xf:var name="editor"        value="instance('editor')"/>
                <xf:var name="state"         value="instance('state')"/>
                <xf:var name="is-overridden" value="string($binding/../@override)"/>

                <xf:var
                    name="effective-source-json"
                    value="
                        if ($is-overridden = 'true') then
                            string($binding)
                        else
                            (
                                xxf:property('oxf.fr.home.remote-servers')[xxf:non-blank()],
                                string($binding)[xxf:non-blank()],
                                '[]'
                            )[1]">
                    <xf:action
                        event="xforms-enabled xforms-value-changed"
                        if="$state/@initialized != 'true' or $effective-source-json != string($state/@last-json)">
                        <xf:setvalue ref="$state/@syncing" value="'true'"/>
                        <xf:var name="is-valid-source" value="rse:isValidRemoteServersJson($effective-source-json)"/>
                        <xf:insert
                            ref="$editor"
                            origin="rse:jsonToUiXml($effective-source-json)"/>
                        <xf:setvalue ref="$state/raw-json"   value="rse:formatRemoteServersJson($effective-source-json)"/>
                        <xf:setvalue ref="$state/@last-json" value="$effective-source-json"/>
                        <xf:setvalue
                            if="not($is-valid-source)"
                            ref="$state/@mode"
                            value="'json'"/>
                        <xf:setvalue ref="$state/@initialized" value="'true'"/>
                        <xf:setvalue ref="$state/@syncing"     value="'false'"/>
                    </xf:action>
                </xf:var>

                <xf:var
                    name="is-readonly"
                    value="fr:is-readonly-mode() or xxf:readonly($binding)">
                    <xf:action event="xforms-enabled">
                        <xf:setvalue ref="$state/@readonly" value="string($is-readonly)"/>
                    </xf:action>
                    <xf:action event="xforms-value-changed">
                        <xf:setvalue ref="$state/@readonly" value="string($is-readonly)"/>
                        <xf:action if="not($is-readonly) and $state/@mode = 'visual'">
                            <xf:dispatch name="fr-rse-push-json" targetid="remote-servers-editor-model"/>
                        </xf:action>
                    </xf:action>
                </xf:var>

                <xf:var name="server-count" value="count($editor/servers/server)"/>

                <!-- Live region for screen reader reorder/remove announcements -->
                <xh:div class="fr-rse-sr-status" role="status" aria-live="polite" aria-atomic="true">
                    <xf:output value="$state/@announcement"/>
                </xh:div>

                <xh:div class="fr-remote-servers-editor {'fr-rse-is-readonly'[$is-readonly]}">

                    <!-- Mode switcher tabs: Visual (left) | JSON (right) -->
                    <xh:div class="fr-rse-mode-tabs" role="tablist">
                        <xf:trigger
                            appearance="minimal"
                            id="fr-rse-visual-tab"
                            class="fr-rse-mode-tab {'fr-rse-mode-active'[$state/@mode != 'json']}">
                            <xf:label value="fr:r('visual-mode')"/>
                            <xf:action event="DOMActivate" if="$state/@mode = 'json'">
                                <xf:action if="rse:isValidRemoteServersJson($state/raw-json)">
                                    <xf:setvalue ref="$state/@syncing" value="'true'"/>
                                    <xf:insert
                                        ref="$editor"
                                        origin="rse:jsonToUiXml($state/raw-json)"/>
                                    <xf:setvalue ref="$state/@mode"    value="'visual'"/>
                                    <xf:setvalue ref="$state/@syncing" value="'false'"/>
                                </xf:action>
                                <xf:action if="not(rse:isValidRemoteServersJson($state/raw-json))">
                                    <xxf:setvisited control="fr-rse-json-editor" visited="true"/>
                                </xf:action>
                            </xf:action>
                        </xf:trigger>

                        <xf:trigger
                            appearance="minimal"
                            id="fr-rse-json-tab"
                            class="fr-rse-mode-tab {'fr-rse-mode-active'[$state/@mode = 'json']}">
                            <xf:label value="fr:r('json-mode')"/>
                            <xf:action event="DOMActivate" if="$state/@mode != 'json'">
                                <xf:setvalue
                                    ref="$state/raw-json"
                                    value="rse:uiXmlToJson($editor/servers)"/>
                                <xf:setvalue ref="$state/@mode" value="'json'"/>
                                <xf:action type="javascript">
                                    <xf:body>
                                        const root = (this instanceof Element &amp;&amp; this.closest('.fr-remote-servers-editor')) || document.querySelector('.fr-remote-servers-editor');
                                        if (root) {
                                            requestAnimationFrame(() =&gt; {
                                                const cmEl = root.querySelector('.CodeMirror');
                                                if (cmEl &amp;&amp; cmEl.CodeMirror) cmEl.CodeMirror.refresh();
                                            });
                                        }
                                    </xf:body>
                                </xf:action>
                            </xf:action>
                        </xf:trigger>
                    </xh:div>

                    <xh:div class="fr-rse-panel">

                        <!-- Read-only note when Override is off -->
                        <xf:group ref=".[$is-readonly and exists($binding/../@override)]" class="fr-rse-readonly-note">
                            <xh:i class="fa fa-fw fa-lock" aria-hidden="true"/>
                            <xh:span><xf:output value="fr:r('readonly-hint')"/></xh:span>
                        </xf:group>

                        <xf:switch caseref="$state/@mode" class="fr-rse-mode-switch">

                            <!-- Visual Mode (left tab) -->
                            <xf:case value="'visual'">
                                <xh:div class="fr-rse-visual-body">

                                    <xf:group ref=".[not($is-readonly)]" class="fr-rse-toolbar">
                                        <xf:trigger id="fr-rse-add-server-btn" class="fr-rse-add-btn">
                                            <xf:label>
                                                <xh:i class="fa fa-fw fa-plus" aria-hidden="true"/>
                                                <xh:span><xf:output value="fr:r('add-server')"/></xh:span>
                                            </xf:label>
                                            <xf:insert
                                                event="DOMActivate"
                                                context="$editor/servers"
                                                ref="server"
                                                origin="instance('server-template')"/>
                                        </xf:trigger>
                                    </xf:group>

                                    <xh:div class="fr-rse-empty {'xforms-hidden'[$server-count gt 0]}">
                                        <xf:output value="fr:r('empty-servers')"/>
                                    </xh:div>

                                    <fr:dnd-repeat
                                        id="fr-rse-servers-repeat"
                                        ref="$editor/servers/server"
                                        class="fr-dnd-drop-indicator">
                                        <xf:var name="srv" value="."/>
                                        <xf:var name="pos" value="position()"/>
                                        <xf:var name="has-invalid" value="exists(@*[not(xxf:valid(.))])"/>

                                        <xh:div class="fr-rse-server-card xforms-dnd-item {'xforms-dnd-moves'[not($is-readonly) and $server-count gt 1]} {'fr-rse-server-invalid'[$has-invalid]}">
                                            <xh:span
                                                class="fr-rse-drag-handle xforms-dnd-handle {'xforms-hidden'[$is-readonly or $server-count le 1]}"
                                                title="{fr:r('drag-to-reorder')}"
                                                aria-hidden="true">
                                                <xh:i class="fa fa-grip-vertical"/>
                                            </xh:span>

                                            <xh:div class="fr-rse-server-fields">
                                                <xh:div class="fr-rse-fields-row">
                                                    <xf:input id="fr-rse-label-input" ref="@label" incremental="true" class="fr-rse-field">
                                                        <xf:label value="fr:r('label-label')"/>
                                                        <xf:hint appearance="minimal" value="fr:r('label-placeholder')"/>
                                                    </xf:input>

                                                    <xf:input id="fr-rse-name-input" ref="@name" incremental="true" class="fr-rse-field fr-rse-field-name">
                                                        <xf:label value="fr:r('name-label')"/>
                                                        <xf:hint appearance="minimal" value="fr:r('name-placeholder')"/>
                                                        <xf:alert value="fr:r('alert-duplicate-name')"/>
                                                    </xf:input>

                                                    <xf:input id="fr-rse-url-input" ref="@url" incremental="true" class="fr-rse-field fr-rse-field-url">
                                                        <xf:label value="fr:r('url-label')"/>
                                                        <xf:hint appearance="minimal" value="fr:r('url-placeholder')"/>
                                                        <xf:alert value="fr:r('alert-url-required')"/>
                                                    </xf:input>
                                                </xh:div>

                                                <xh:div class="fr-rse-toggles-row">
                                                    <fr:checkbox-input id="fr-rse-ui-access-checkbox" ref="@ui-access" class="fr-rse-toggle">
                                                        <xf:label value="fr:r('ui-access-label')"/>
                                                    </fr:checkbox-input>
                                                    <fr:checkbox-input id="fr-rse-api-access-checkbox" ref="@api-access" class="fr-rse-toggle">
                                                        <xf:label value="fr:r('api-access-label')"/>
                                                    </fr:checkbox-input>
                                                </xh:div>
                                            </xh:div>

                                            <xf:group ref=".[not($is-readonly)]" class="fr-rse-row-actions">
                                                <xf:group ref=".[$server-count gt 1]" class="fr-rse-move-btns">
                                                    <xf:trigger
                                                        id="fr-rse-move-up-btn"
                                                        appearance="minimal"
                                                        ref=".[exists($srv/preceding-sibling::server)]"
                                                        class="fr-rse-icon-btn fr-rse-move-up">
                                                        <xf:label><xh:i class="fa fa-arrow-up" aria-hidden="true"/></xf:label>
                                                        <xf:hint value="fr:r('move-up')"/>
                                                        <xf:action event="DOMActivate">
                                                            <xf:var name="prev" value="$srv/preceding-sibling::server[1]"/>
                                                            <xf:insert ref="$prev" position="before" origin="$srv"/>
                                                            <xf:delete ref="$srv"/>
                                                            <xf:setvalue
                                                                ref="$state/@announcement"
                                                                value="xxf:format-message(fr:r('moved-announcement'), ($pos - 1, $server-count))"/>
                                                        </xf:action>
                                                    </xf:trigger>
                                                    <xf:trigger
                                                        id="fr-rse-move-down-btn"
                                                        appearance="minimal"
                                                        ref=".[exists($srv/following-sibling::server)]"
                                                        class="fr-rse-icon-btn fr-rse-move-down">
                                                        <xf:label><xh:i class="fa fa-arrow-down" aria-hidden="true"/></xf:label>
                                                        <xf:hint value="fr:r('move-down')"/>
                                                        <xf:action event="DOMActivate">
                                                            <xf:var name="next" value="$srv/following-sibling::server[1]"/>
                                                            <xf:insert ref="$next" position="after" origin="$srv"/>
                                                            <xf:delete ref="$srv"/>
                                                            <xf:setvalue
                                                                ref="$state/@announcement"
                                                                value="xxf:format-message(fr:r('moved-announcement'), ($pos + 1, $server-count))"/>
                                                        </xf:action>
                                                    </xf:trigger>
                                                </xf:group>

                                                <xf:trigger
                                                    id="fr-rse-remove-btn"
                                                    appearance="minimal"
                                                    class="fr-rse-icon-btn fr-rse-remove-btn">
                                                    <xf:label><xh:i class="fa fa-xmark" aria-hidden="true"/></xf:label>
                                                    <xf:hint value="fr:r('remove-server')"/>
                                                    <xf:action event="DOMActivate">
                                                        <xf:delete ref="$srv"/>
                                                        <xf:setvalue ref="$state/@announcement" value="fr:r('removed-announcement')"/>
                                                    </xf:action>
                                                </xf:trigger>
                                            </xf:group>
                                        </xh:div>
                                    </fr:dnd-repeat>

                                </xh:div>
                            </xf:case>

                            <!-- JSON Mode (right tab) -->
                            <xf:case value="'json'">
                                <xh:div class="fr-rse-json-wrap">
                                    <xh:div class="fr-rse-json-overlay">
                                        <fr:code-mirror
                                            id="fr-rse-json-editor"
                                            ref="$state/raw-json"
                                            mediatype="application/json"
                                            class="fr-rse-json-codemirror">
                                            <xf:alert value="fr:r('invalid-json')"/>
                                            <xf:action event="xforms-value-changed" if="not($is-readonly)">
                                                <xf:var name="raw" value="string($state/raw-json)"/>
                                                <xf:action if="$raw != string($state/@last-json)">
                                                    <xf:setvalue ref="$state/@last-json" value="$raw"/>
                                                    <xf:setvalue ref="$binding"          value="$raw"/>
                                                </xf:action>
                                            </xf:action>
                                        </fr:code-mirror>

                                        <xh:div class="fr-rse-json-buttons">
                                            <xf:group ref=".[not($is-readonly)]">
                                                <xf:trigger appearance="minimal" id="fr-rse-format-json" class="fr-rse-json-btn">
                                                    <xf:label><xh:i class="fa fa-fw fa-align-left" aria-hidden="true"/></xf:label>
                                                    <xf:hint value="fr:r('format-json')"/>
                                                    <xf:action event="DOMActivate">
                                                        <xf:var name="formatted" value="rse:formatRemoteServersJson($state/raw-json)"/>
                                                        <xf:setvalue ref="$state/raw-json"   value="$formatted"/>
                                                        <xf:setvalue ref="$state/@last-json" value="$formatted"/>
                                                        <xf:setvalue ref="$binding"          value="$formatted"/>
                                                    </xf:action>
                                                </xf:trigger>
                                            </xf:group>
                                            <xf:trigger appearance="minimal" id="fr-rse-copy-json" class="fr-rse-json-btn">
                                                <xf:label><xh:i class="fa fa-fw fa-copy" aria-hidden="true"/></xf:label>
                                                <xf:hint value="fr:r('copy-json')"/>
                                                <xf:action event="DOMActivate" type="javascript">
                                                    <xf:param name="text" value="string($state/raw-json)"/>
                                                    <xf:body>
                                                        const btn = (this instanceof Element &amp;&amp; this.querySelector('button')) || this;
                                                        if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {
                                                            navigator.clipboard.writeText(text).then(() =&gt; {
                                                                if (btn &amp;&amp; btn.classList) {
                                                                    btn.classList.add('fr-rse-copy-success');
                                                                    const icon = btn.querySelector('i');
                                                                    if (icon) icon.className = 'fa fa-fw fa-check';
                                                                    setTimeout(() =&gt; {
                                                                        btn.classList.remove('fr-rse-copy-success');
                                                                        if (icon) icon.className = 'fa fa-fw fa-copy';
                                                                    }, 1200);
                                                                }
                                                            });
                                                        }
                                                    </xf:body>
                                                </xf:action>
                                            </xf:trigger>
                                        </xh:div>
                                    </xh:div>
                                </xh:div>
                            </xf:case>
                        </xf:switch>
                    </xh:div>
                </xh:div>

            </xf:group>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
