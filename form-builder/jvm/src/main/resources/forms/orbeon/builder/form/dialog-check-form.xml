<xxf:dialog
    xmlns:xh  = "http://www.w3.org/1999/xhtml"
    xmlns:xf  = "http://www.w3.org/2002/xforms"
    xmlns:xs  = "http://www.w3.org/2001/XMLSchema"
    xmlns:xxf = "http://orbeon.org/oxf/xml/xforms"
    xmlns:fr  = "http://orbeon.org/oxf/xml/form-runner"
    xmlns:fbf = "java:org.orbeon.oxf.fb.FormBuilderXPathApi"

    id        = "fb-check-form-dialog"
    level     = "modal"
    close     = "true"
    draggable = "true"
    model     = "fb-check-form-model"
    class     = "fb-check-form-dialog">

    <xf:label model="fr-form-model" ref="$form-resources/dialog-check-form/label"/>
    <xf:var   model="fr-form-model" name="form-resources" value="$form-resources"/>

    <xf:action event="xxforms-dialog-open">
        <xf:delete ref="instance()/validation"/>
        <xf:insert
            context="instance()"
            origin="fbf:validateForm(xxf:instance('fb-form-instance'), (), $form-resources)"/>
    </xf:action>

    <xh:div class="fb-check-form-dialog-body">
        <xf:var name="errors"        value="instance()/validation/issue[@severity = 'error']"/>
        <xf:var name="warnings"      value="instance()/validation/issue[@severity = 'warning']"/>
        <xf:var name="infos"         value="instance()/validation/issue[@severity = 'info']"/>
        <xf:var name="error-count"   value="count($errors)"/>
        <xf:var name="warning-count" value="count($warnings)"/>
        <xf:var name="info-count"    value="count($infos)"/>

        <xf:group ref=".[empty(instance()/validation/issue)]">
            <xh:div class="fb-validation-callout fb-validation-success" role="status">
                <xh:i class="fa fa-circle-check fb-validation-callout-icon" aria-hidden="true"/>
                <xh:div class="fb-validation-callout-content">
                    <xf:output value="$form-resources/dialog-check-form/no-issues"/>
                </xh:div>
            </xh:div>
        </xf:group>

        <xf:group ref=".[exists(instance()/validation/issue)]">
            <xf:group ref=".[$error-count gt 0]">
                <xh:div class="fb-validation-group fb-validation-group-error">
                    <xh:div class="fb-validation-group-header">
                        <xh:i class="fa fa-circle-exclamation" aria-hidden="true"/>
                        <xh:span class="fb-validation-group-title">
                            <xf:output value="xxf:format-message($form-resources/error-summary/label, (0, $error-count))"/>
                        </xh:span>
                        <xh:span class="fb-validation-count-badge"><xf:output value="$error-count"/></xh:span>
                    </xh:div>
                    <xh:ul role="list" class="fb-validation-list">
                        <xf:repeat ref="$errors">
                            <xh:li class="fb-validation-item fb-validation-item-error">
                                <xh:span class="fb-validation-item-message"><xf:output value="."/></xh:span>
                                <xf:group ref=".[normalize-space(@control-name) != '']">
                                    <xh:code class="fb-validation-control-pill"><xf:output value="@control-name"/></xh:code>
                                </xf:group>
                            </xh:li>
                        </xf:repeat>
                    </xh:ul>
                </xh:div>
            </xf:group>

            <xf:group ref=".[$warning-count gt 0]">
                <xh:div class="fb-validation-group fb-validation-group-warning">
                    <xh:div class="fb-validation-group-header">
                        <xh:i class="fa fa-triangle-exclamation" aria-hidden="true"/>
                        <xh:span class="fb-validation-group-title">
                            <xf:output value="xxf:format-message($form-resources/error-summary/label, (1, $warning-count))"/>
                        </xh:span>
                        <xh:span class="fb-validation-count-badge"><xf:output value="$warning-count"/></xh:span>
                    </xh:div>
                    <xh:ul role="list" class="fb-validation-list">
                        <xf:repeat ref="$warnings">
                            <xh:li class="fb-validation-item fb-validation-item-warning">
                                <xh:span class="fb-validation-item-message"><xf:output value="."/></xh:span>
                                <xf:group ref=".[normalize-space(@control-name) != '']">
                                    <xh:code class="fb-validation-control-pill"><xf:output value="@control-name"/></xh:code>
                                </xf:group>
                            </xh:li>
                        </xf:repeat>
                    </xh:ul>
                </xh:div>
            </xf:group>

            <xf:group ref=".[$info-count gt 0]">
                <xh:div class="fb-validation-group fb-validation-group-info">
                    <xh:div class="fb-validation-group-header">
                        <xh:i class="fa fa-circle-info" aria-hidden="true"/>
                        <xh:span class="fb-validation-group-title">
                            <xf:output value="xxf:format-message($form-resources/error-summary/label, (2, $info-count))"/>
                        </xh:span>
                        <xh:span class="fb-validation-count-badge"><xf:output value="$info-count"/></xh:span>
                    </xh:div>
                    <xh:ul role="list" class="fb-validation-list">
                        <xf:repeat ref="$infos">
                            <xh:li class="fb-validation-item fb-validation-item-info">
                                <xh:span class="fb-validation-item-message"><xf:output value="."/></xh:span>
                                <xf:group ref=".[normalize-space(@control-name) != '']">
                                    <xh:code class="fb-validation-control-pill"><xf:output value="@control-name"/></xh:code>
                                </xf:group>
                            </xh:li>
                        </xf:repeat>
                    </xh:ul>
                </xh:div>
            </xf:group>
        </xf:group>
    </xh:div>

    <xh:div class="fr-dialog-buttons">
        <xf:trigger appearance="xxf:primary" id="fb-check-form-close">
            <xf:label value="$form-resources/close/label"/>
            <xxf:hide event="DOMActivate" dialog="fb-check-form-dialog"/>
        </xf:trigger>
    </xh:div>

    <xf:model id="fb-check-form-model">
        <xf:instance id="fb-check-form-instance">
            <check-form xmlns="">
                <validation valid="true" blocking="false" error-count="0" warning-count="0" info-count="0" data-compatibility=""/>
            </check-form>
        </xf:instance>
    </xf:model>

</xxf:dialog>
