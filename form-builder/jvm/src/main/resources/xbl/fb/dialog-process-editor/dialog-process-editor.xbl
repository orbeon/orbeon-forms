<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:fbf="java:org.orbeon.oxf.fb.FormBuilderXPathApi"
    xmlns:pui="java:org.orbeon.oxf.fb.process.ProcessUI"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:oxf="http://www.orbeon.com/oxf/processors">

    <xbl:binding
        id="fb-dialog-process-editor"
        element="fb|dialog-process-editor"
        xxf:external-events="fb-move-process-step">

        <xbl:handlers>

            <!-- Handler to open dialog -->
            <xbl:handler event="fb-show-dialog xxforms-dialog-open" phase="target">

                <xf:insert
                    ref="instance()"
                    origin="pui:deserializeProcesses((event('config'), instance('empty-processes-instance'))[1])"/>

                <xf:insert
                    ref="instance('form-context-instance')"
                    origin="pui:formContextXml()"/>

                <xxf:show dialog="dialog"/>
                <xf:setfocus control="fb-process-name"/>
            </xbl:handler>

            <!-- Save and close if valid -->
            <xbl:handler event="DOMActivate" observer="fb-save-trigger" if="instance('validity-instance') = 'true' and valid(instance())">
                <xf:dispatch name="fb-update" targetid="fb-dialog-process-editor">
                    <xf:property name="config" value="pui:serializeProcesses(instance())"/>
                </xf:dispatch>
                <xxf:hide dialog="dialog"/>
            </xbl:handler>

            <xbl:handler event="DOMActivate" observer="fb-save-trigger" if="not(instance('validity-instance') = 'true' and valid(instance()))">
                <xxf:setvisited control="dialog" recurse="true"/>
            </xbl:handler>

            <xbl:handler event="fb-move-process-step" phase="target">
                <xf:var name="process"     value="instance()/process[xs:integer(event('process-index'))]"/>
                <xf:var name="all-rows"    value="$process//*[self::step or self::else]"/>
                <xf:var name="source-step" value="$all-rows[xs:integer(event('source-index'))][self::step]"/>
                <xf:var name="into-row"    value="if (xxf:non-blank(event('into-index'))) then $all-rows[xs:integer(event('into-index'))] else ()"/>
                <xf:var name="dest-parent" value="
                    if (empty($into-row)) then
                        $process
                    else if ($into-row/self::step[@type = 'condition']) then
                        $into-row/then
                    else if ($into-row/self::step[@type = 'group'] or $into-row/self::else) then
                        $into-row
                    else
                        ()
                "/>
                <xf:var name="after-step"  value="if (xxf:non-blank(event('after-index'))) then $all-rows[xs:integer(event('after-index'))][self::step] else ()"/>
                <xf:var name="is-noop"     value="
                    if (empty($after-step)) then
                        $dest-parent/step[1] is $source-step
                    else
                        $after-step/following-sibling::step[1] is $source-step
                "/>

                <xf:action if="
                    exists($source-step) and
                    count($source-step/../step) gt 1 and
                    exists($dest-parent) and
                    empty($dest-parent/ancestor-or-self::* intersect $source-step) and
                    (empty($after-step) or (($after-step/.. is $dest-parent) and not($after-step is $source-step))) and
                    not($is-noop)
                ">
                    <xf:insert
                        if="exists($after-step)"
                        ref="$after-step"
                        position="after"
                        origin="$source-step"/>
                    <xf:insert
                        if="empty($after-step) and exists($dest-parent/step)"
                        ref="$dest-parent/step[1]"
                        position="before"
                        origin="$source-step"/>
                    <xf:insert
                        if="empty($after-step) and empty($dest-parent/step)"
                        context="$dest-parent"
                        origin="$source-step"/>

                    <xf:delete ref="$source-step"/>

                    <xf:setvalue
                        iterate="$process//step[empty(preceding-sibling::step) and @combinator != 'then']"
                        ref="@combinator"
                        value="'then'"/>
                </xf:action>
            </xbl:handler>

        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="model">

                <xf:instance id="_" xxf:exclude-result-prefixes="#all">
                    <processes/>
                </xf:instance>

                <xf:instance id="empty-processes-instance" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <processes/>
                </xf:instance>

                <xf:instance id="actions-instance" xxf:readonly="false" xxf:exclude-result-prefixes="#all">
                    <actions/>
                </xf:instance>

                <xf:instance id="form-context-instance" xxf:readonly="false" xxf:exclude-result-prefixes="#all">
                    <form-context>
                        <controls/>
                        <sections/>
                        <email-templates/>
                        <pdf-templates/>
                        <custom-modes/>
                    </form-context>
                </xf:instance>

                <xf:instance id="process-template" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <process name="">
                        <step type="action" combinator="then" name="save" _add-param=""/>
                    </process>
                </xf:instance>

                <xf:instance id="validity-instance" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:instance id="xml-formatting-instance" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <xsl:output method="xml" omit-xml-declaration="yes" indent="yes" saxon:indent-spaces="4" xmlns:saxon="http://saxon.sf.net/"/>
                </xf:instance>

                <xf:action event="xforms-model-construct-done">
                    <xf:insert
                        context="instance('actions-instance')"
                        origin="pui:availableActionsXml()/*"/>
                </xf:action>

                <xf:var name="i" value="instance()"/>

                <xf:bind
                    ref="$i//*"
                    readonly="fr:is-readonly-mode()"/>

                <xf:bind ref="$i/process" name="process">
                    <xf:bind
                        ref="@name"
                        xxf:whitespace="trim"
                        required="true()"
                        constraint="
                            xxf:non-blank() and
                            matches(., '^[a-zA-Z0-9_\-\.]+$') and
                            not(($i/process/@name except .) = .)"/>
                    <xf:bind
                        ref="."
                        constraint="exists(step)"/>
                    <xf:bind
                        ref=".//step[@type = 'condition']/@condition"
                        type="xxf:XPath2"
                        required="true()"
                        constraint="xxf:non-blank()"/>
                    <xf:bind
                        ref=".//step[@type = 'action']/@name"
                        constraint="pui:isActionStepValid(.., instance('form-context-instance'))"/>
                    <xf:bind ref=".//step[@type = 'action']/param">
                        <xf:bind
                            ref=".[pui:paramValueMode(.) = 'xpath']"
                            type="xxf:XPath2"/>
                        <xf:bind
                            ref=".[pui:paramValueMode(.) = 'avt']"
                            type="xxf:XPath2ValueTemplate"/>
                        <xf:bind
                            ref="."
                            constraint="pui:isParamValueValid(., instance('form-context-instance'))"/>
                        <xf:bind
                            ref="@name[../@custom = 'true']"
                            xxf:whitespace="trim"
                            required="true()"
                            constraint="pui:isCustomParamNameValid(..)"/>
                    </xf:bind>
                </xf:bind>

            </xf:model>
        </xbl:implementation>

        <xbl:template>
            <xf:group>

                <!-- Bindings specified on control -->
                <xf:var name="resources">
                    <xxf:value value=". treat as element()" xxbl:scope="outer" xbl:attr="model context ref=resources-ref"/>
                </xf:var>
                <xf:var name="fr-resources">
                    <xxf:value value=". treat as element()" xxbl:scope="outer" xbl:attr="model context ref=fr-resources-ref"/>
                </xf:var>

                <xxf:dialog id="dialog" class="fb-dialog-process-editor">
                    <xf:label value="$resources/dialog-process-editor/label"/>

                    <fr:tabbable
                        appearance="left"
                        id="fb-processes-tabbable"
                        ref="$i"
                        readonly="false"
                        class="fr-tabbable-dnd">

                        <fr:tab ref="process">
                            <fr:label value="if (xxf:non-blank(@name)) then @name else $resources/dialog-process-editor/new-process"/>

                            <xh:div class="fb-process-tab-content">
                                <fr:grid>
                                    <fr:c x="1" y="1" w="12">
                                        <xf:input ref="@name" id="fb-process-name">
                                            <xf:label value="$resources/dialog-process-editor/process-name/label"/>
                                            <xf:hint value="$resources/dialog-process-editor/process-name/hint"/>
                                            <xf:alert value="$resources/dialog-process-editor/process-name/alert"/>
                                        </xf:input>
                                    </fr:c>
                                    <fr:c x="1" y="2" w="12">
                                        <xh:div class="fb-process-steps-container">
                                            <xh:div class="fb-process-steps-header">
                                                <xf:output value="$resources/dialog-process-editor/process-definition/label"/>
                                            </xh:div>

                                            <!-- Visual editor rows -->
                                            <xf:group ref=".[exists(step)]">
                                                <xf:var name="process-index" value="count(preceding-sibling::process) + 1"/>
                                                <xh:div class="fb-process-steps-list" data-orbeon-process-index="{$process-index}">
                                                <xf:repeat ref=".//*[self::step or self::else]">

                                                    <xf:var
                                                        name="current"
                                                        value="."/>
                                                    <xf:var
                                                        name="step-type"
                                                        value="if (self::else) then 'else' else (@type, 'action')[1]"/>
                                                    <xf:var
                                                        name="ancestor-body-boxes"
                                                        value="ancestor::*[self::step[@type = 'group'] or self::then or self::else]"/>
                                                    <xf:var
                                                        name="active-boxes"
                                                        value="ancestor::*[self::step[@type = ('group', 'condition')] or self::then or self::else] | self::step[@type = 'condition']"/>
                                                    <xf:var
                                                        name="indent-level"
                                                        value="count($ancestor-body-boxes)"/>
                                                    <xf:var
                                                        name="active-boxes-count"
                                                        value="count($active-boxes)"/>
                                                    <xf:var
                                                        name="has-opening-box"
                                                        value="exists($active-boxes[if (self::step[@type = 'condition']) then (. is $current) else ($current is step[1])])"/>
                                                    <xf:var
                                                        name="closing-boxes-count"
                                                        value="count($active-boxes[$current is (descendant::*[self::step or self::else])[last()]])"/>
                                                    <xf:var
                                                        name="first-closing-box"
                                                        value="$active-boxes-count - $closing-boxes-count + 1"/>
                                                    <xf:var
                                                        name="extra-closing-levels"
                                                        value="max(($closing-boxes-count - 1, 0))"/>
<!--                                                    xxx indent:-->
<!--                                                    <xf:output value="$indent-level"/>-->
                                                    <xf:var
                                                        name="has-combinator"
                                                        value="self::step and exists(preceding-sibling::step)"/>
                                                    <xf:var
                                                        name="has-combinator-slot"
                                                        value="exists(ancestor::*[self::process or self::step[@type = 'group'] or self::then or self::else][count(step) gt 1])"/>
                                                    <xf:var
                                                        name="can-move"
                                                        value="self::step and count(../step) gt 1 and not(fr:is-readonly-mode())"/>

                                                    <xh:div
                                                        class="{
                                                            'fb-process-iteration',
                                                            'fb-process-can-move'[$can-move],
                                                            'fb-process-row-opening-box'[$has-opening-box],
                                                            'fb-process-row-closing-box'[$closing-boxes-count gt 0]
                                                        }"
                                                        data-orbeon-row-index="{position()}"
                                                        data-orbeon-step-type="{$step-type}"
                                                        data-orbeon-level="{$indent-level}"
                                                        data-orbeon-can-move="{$can-move}">
                                                        <xh:div class="fb-process-row-main">
                                                            <xf:repeat ref="$active-boxes">
                                                                <xf:var name="box-pos"              value="position()"/>
                                                                <xf:var name="is-cond-box"          value="exists(self::step[@type = 'condition'])"/>
                                                                <xf:var name="box-depth"            value="count(ancestor::*[self::step[@type = 'group'] or self::then or self::else])"/>
                                                                <xf:var name="box-inset-px"         value="$box-depth * 20 + (if ($is-cond-box) then 0 else 12)"/>
                                                                <xf:var name="is-box-start"         value="if ($is-cond-box) then (. is $current) else ($current is step[1])"/>
                                                                <xf:var name="is-box-end"           value="$box-pos ge $first-closing-box"/>
                                                                <xf:var name="outer-closing-levels" value="if ($is-box-end) then $box-pos - $first-closing-box else 0"/>
                                                                <xh:div
                                                                    class="{
                                                                        'fb-process-box-slice',
                                                                        'fb-process-box-condition'[$is-cond-box],
                                                                        'fb-process-box-start'[$is-box-start],
                                                                        'fb-process-box-end'[$is-box-end]
                                                                    }"
                                                                    data-orbeon-box-depth="{$box-depth}"
                                                                    data-orbeon-body-level="{if ($is-cond-box) then '' else $box-depth + 1}"
                                                                    style="--fb-box-inset: {$box-inset-px}px; --fb-outer-closing: {$outer-closing-levels}"/>
                                                            </xf:repeat>
                                                            <xh:div
                                                                class="{
                                                                    'fb-process-row-content',
                                                                    'fb-process-has-combinator'[$has-combinator-slot]
                                                                }"
                                                                style="--fb-indent-level: {$indent-level}; --fb-extra-closing: {$extra-closing-levels}">
<!--                                                            <xh:div class="fb-process-row-content-inner">-->

                                                                <!-- Combinator dropdown (then / recover) -->
                                                                <xf:select1
                                                                    ref="
                                                                        if ($has-combinator) then
                                                                            $current/@combinator
                                                                        else if ($has-combinator-slot) then
                                                                            'then'
                                                                        else
                                                                            ()"
                                                                    class="{
                                                                        'fb-process-combinator-select1',
                                                                        'fb-process-combinator-placeholder'[not($has-combinator)]
                                                                    }">
                                                                    <xf:item><xf:label>then</xf:label><xf:value>then</xf:value></xf:item>
                                                                    <xf:item><xf:label>recover</xf:label><xf:value>recover</xf:value></xf:item>
                                                                </xf:select1>

                                                                <!-- Row content based on type -->
                                                                <xf:switch caseref="$step-type" class="fb-process-row-switch" xxf:update="full">
                                                                    <!-- Action step -->
                                                                    <xf:case value="'action'">
                                                                        <xf:var name="enclosing-process-name" value="($current/ancestor::process/@name)[1]"/>
                                                                        <xf:var name="action-def"             value="instance('actions-instance')/action[@name = $current/@name]"/>
                                                                        <xf:var name="present-param-names"    value="$current/param/@name[xxf:non-blank()]"/>
                                                                        <xf:var name="addable-params"         value="$action-def/param[@deprecated = 'false' and not(@name = $present-param-names)]"/>
                                                                        <xf:var name="allows-custom-params"   value="$action-def/@allows-custom-params = 'true'"/>
                                                                        <xf:var name="sibling-processes"      value="
                                                                            $i/process/@name[
                                                                                xxf:non-blank() and
                                                                                . != $enclosing-process-name and
                                                                                matches(., '^[A-Za-z_\-][A-Za-z0-9_\-:]*$') and
                                                                                not(. = instance('actions-instance')/action[@deprecated = 'false']/@name)
                                                                            ]"/>

                                                                        <xh:div class="fb-process-action-bar">
                                                                            <xf:select1 ref="@name" class="fb-process-action-select1">
                                                                                <xf:label value="$resources/dialog-process-editor/process-definition/label"/>
                                                                                <xf:alert value="pui:actionStepAlertMessage($current, $resources, instance('form-context-instance'))"/>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$resources/dialog-process-editor/categories/form-runner"/>
                                                                                    <xf:itemset ref="instance('actions-instance')/action[@category = 'form-runner' and @deprecated = 'false']">
                                                                                        <xf:label ref="@label"/>
                                                                                        <xf:value ref="@name"/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$resources/dialog-process-editor/categories/form-processes[exists($sibling-processes)]"/>
                                                                                    <xf:itemset ref="$sibling-processes">
                                                                                        <xf:label value="."/>
                                                                                        <xf:value value="."/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$resources/dialog-process-editor/categories/sub-process"/>
                                                                                    <xf:itemset ref="instance('actions-instance')/action[@category = 'sub-process' and @deprecated = 'false']">
                                                                                        <xf:label ref="@label"/>
                                                                                        <xf:value ref="@name"/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$resources/dialog-process-editor/categories/flow-control"/>
                                                                                    <xf:itemset ref="instance('actions-instance')/action[@category = 'flow-control' and @deprecated = 'false']">
                                                                                        <xf:label ref="@label"/>
                                                                                        <xf:value ref="@name"/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:choices>
                                                                                    <xf:label ref="$resources/dialog-process-editor/categories/xforms"/>
                                                                                    <xf:itemset ref="instance('actions-instance')/action[@category = 'xforms' and @deprecated = 'false']">
                                                                                        <xf:label ref="@label"/>
                                                                                        <xf:value ref="@name"/>
                                                                                    </xf:itemset>
                                                                                </xf:choices>

                                                                                <xf:itemset ref="$action-def[@deprecated = 'true']">
                                                                                    <xf:label ref="@label"/>
                                                                                    <xf:value ref="@name"/>
                                                                                </xf:itemset>

                                                                                <xf:itemset ref="$current/@name[empty($action-def) and not(. = $sibling-processes)]">
                                                                                    <xf:label value="concat('Sub-process: ', .)"/>
                                                                                    <xf:value value="."/>
                                                                                </xf:itemset>

                                                                                <xf:action event="xforms-value-changed">
                                                                                    <xf:delete ref="$current/param"/>
                                                                                    <xf:insert context="$current" origin="pui:actionParamsXml(@name)/*"/>
                                                                                </xf:action>
                                                                            </xf:select1>

                                                                            <!-- + Parameter menu -->
                                                                            <xf:select1
                                                                                ref="@_add-param[exists($addable-params) or $allows-custom-params]"
                                                                                class="fb-process-add-param">
                                                                                <xf:label value="$resources/dialog-process-editor/add-parameter"/>
                                                                                <xf:item>
                                                                                    <xf:label ref="$resources/dialog-process-editor/add-parameter"/>
                                                                                    <xf:value/>
                                                                                </xf:item>
                                                                                <xf:itemset ref="$addable-params">
                                                                                    <xf:label ref="@name"/>
                                                                                    <xf:value ref="@name"/>
                                                                                </xf:itemset>
                                                                                <xf:itemset ref=".[$allows-custom-params]">
                                                                                    <xf:label ref="$resources/dialog-process-editor/custom-parameter"/>
                                                                                    <xf:value value="'__custom__'"/>
                                                                                </xf:itemset>
                                                                                <xf:action event="xforms-value-changed" if="xxf:non-blank(.)">
                                                                                    <xf:var name="chosen" value="string(.)"/>
                                                                                    <xf:setvalue ref="." value="''"/>
                                                                                    <xf:insert
                                                                                        context="$current"
                                                                                        ref="param"
                                                                                        origin="pui:singleParamTemplateXml($current/@name, $chosen)"/>
                                                                                </xf:action>
                                                                            </xf:select1>
                                                                        </xh:div>
                                                                    </xf:case>

                                                                    <!-- Group container -->
                                                                    <xf:case value="'group'">
                                                                        <xh:span class="fb-process-keyword badge text-bg-primary">group</xh:span>
                                                                    </xf:case>

                                                                    <!-- Condition -->
                                                                    <xf:case value="'condition'">
                                                                        <xh:span class="fb-process-keyword-with-condition">
                                                                            <xh:span class="fb-process-keyword badge text-bg-success">if</xh:span>
                                                                            <xf:input ref="@condition" class="fb-process-condition-input">
                                                                                <xf:label value="'if'"/>
                                                                                <xf:hint value="'XPath condition'" appearance="minimal"/>
                                                                                <xf:alert value="
                                                                                    if (xxf:is-blank()) then
                                                                                        $resources/dialog-process-editor/alerts/required
                                                                                    else
                                                                                        $resources/dialog-process-editor/alerts/invalid-xpath"/>
                                                                            </xf:input>
                                                                        </xh:span>
                                                                    </xf:case>

                                                                    <!-- Else branch -->
                                                                    <xf:case value="'else'">
                                                                        <xh:span class="fb-process-keyword badge text-bg-warning">else</xh:span>
                                                                    </xf:case>
                                                                </xf:switch>

                                                                <!-- Parameters stacked below the action selector -->
                                                                <xh:div class="fb-process-row-content-params {'xforms-hidden'[not($step-type = 'action' and exists($current/param))]}">
                                                                    <xf:switch caseref="$step-type" class="fb-process-params-switch" xxf:update="full">
                                                                        <xf:case value="'action'">
                                                                            <xf:repeat ref="param">
                                                                                <xf:var name="param-elem"          value="."/>
                                                                                <xf:var name="action-def"          value="instance('actions-instance')/action[@name = $current/@name]"/>
                                                                                <xf:var name="param-def"           value="$action-def/param[@name = $param-elem/@name]"/>
                                                                                <xf:var name="is-custom"           value="@custom = 'true'"/>
                                                                                <xf:var name="is-required"         value="$param-def/@tier = 'required'"/>
                                                                                <xf:var name="has-widget"          value="$param-def/@has-widget = 'true'"/>
                                                                                <xf:var name="supports-avt-toggle" value="$has-widget and $param-def/@value-mode = 'avt'"/>
                                                                                <xf:var name="is-avt-mode"         value="@avt-mode = 'true'"/>
                                                                                <xf:var name="raw-kind"            value="($param-def/@kind, 'text')[1]"/>
                                                                                <xf:var name="enclosing-proc-name" value="($current/ancestor::process/@name)[1]"/>
                                                                                <xf:var name="effective-widget"    value="
                                                                                    if ($is-avt-mode or $is-custom) then
                                                                                        'text'
                                                                                    else if ($raw-kind = 'control-name') then
                                                                                        if (exists($current/param[@name = 'section-name']) or empty(instance('form-context-instance')/controls/item)) then 'text' else 'control-name'
                                                                                    else if ($raw-kind = 'section-name') then
                                                                                        if (empty(instance('form-context-instance')/sections/item)) then 'text' else 'section-name'
                                                                                    else if ($raw-kind = 'email-template') then
                                                                                        if (empty(instance('form-context-instance')/email-templates/item)) then 'text' else 'email-template'
                                                                                    else if ($raw-kind = 'pdf-template') then
                                                                                        if (empty(instance('form-context-instance')/pdf-templates/item)) then 'text' else 'pdf-template'
                                                                                    else if ($raw-kind = ('boolean', 'enum', 'tokens', 'detail-mode', 'process-name')) then
                                                                                        $raw-kind
                                                                                    else
                                                                                        'text'
                                                                                "/>
                                                                                <xf:var name="summary-label" value="
                                                                                    concat(
                                                                                        if (xxf:non-blank($enclosing-proc-name)) then concat($enclosing-proc-name, ': ') else '',
                                                                                        $current/@name,
                                                                                        ' — ',
                                                                                        if (xxf:non-blank(@name)) then @name else 'parameter'
                                                                                    )"/>
                                                                                <xf:var name="alert-text"    value="pui:paramAlertMessage($param-elem, $resources, instance('form-context-instance'))"/>

                                                                                <xh:div class="fb-process-param-row">
                                                                                    <!-- Parameter name / custom name input -->
                                                                                    <xh:div class="fb-process-param-name">
                                                                                        <xh:span class="fb-process-param-label {'fb-process-param-required'[$is-required]} {'xforms-hidden'[$is-custom]}">
                                                                                            <xf:output value="if (xxf:non-blank(@name)) then @name else 'value'"/>
                                                                                        </xh:span>
                                                                                        <xf:input ref="@name[$is-custom]" class="fb-process-custom-name-input">
                                                                                            <xf:label value="concat(if (xxf:non-blank($enclosing-proc-name)) then concat($enclosing-proc-name, ': ') else '', $current/@name, ' — name')"/>
                                                                                            <xf:hint value="'property'" appearance="minimal"/>
                                                                                            <xf:alert value="$resources/dialog-process-editor/alerts/invalid-param-name"/>
                                                                                        </xf:input>
                                                                                    </xh:div>

                                                                                    <!-- Parameter value control -->
                                                                                    <xh:div class="fb-process-param-control">
                                                                                        <xf:switch caseref="$effective-widget" xxf:update="full">

                                                                                            <xf:case value="'boolean'">
                                                                                                <xf:select1 ref=".[$effective-widget = 'boolean']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:item><xf:label>true</xf:label><xf:value>true</xf:value></xf:item>
                                                                                                    <xf:item><xf:label>false</xf:label><xf:value>false</xf:value></xf:item>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'enum'">
                                                                                                <xf:var name="enum-items" value="$param-def/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'enum']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$enum-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $enum-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'tokens'">
                                                                                                <xf:select ref=".[$effective-widget = 'tokens']" appearance="full" class="fb-process-param-tokens">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref="$param-def/item">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select>
                                                                                            </xf:case>

                                                                                            <xf:case value="'detail-mode'">
                                                                                                <xf:var name="mode-items" value="$param-def/item | instance('form-context-instance')/custom-modes/item[not(@value = $param-def/item/@value)]"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'detail-mode']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$mode-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $mode-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'control-name'">
                                                                                                <xf:var name="ctrl-items" value="instance('form-context-instance')/controls/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'control-name']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$ctrl-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $ctrl-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'section-name'">
                                                                                                <xf:var name="sec-items" value="instance('form-context-instance')/sections/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'section-name']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$sec-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $sec-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'email-template'">
                                                                                                <xf:var name="email-items" value="instance('form-context-instance')/email-templates/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'email-template']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$email-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $email-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'pdf-template'">
                                                                                                <xf:var name="pdf-items" value="instance('form-context-instance')/pdf-templates/item"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'pdf-template']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref="$pdf-items">
                                                                                                        <xf:label ref="@label"/>
                                                                                                        <xf:value ref="@value"/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $pdf-items/@value)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'process-name'">
                                                                                                <xf:var name="form-procs"    value="$i/process/@name[xxf:non-blank() and . != $enclosing-proc-name]"/>
                                                                                                <xf:var name="builtin-procs" value="instance('actions-instance')/action[@category = 'sub-process' and @name != 'process' and @deprecated = 'false' and not(@name = $form-procs)]"/>
                                                                                                <xf:select1 ref=".[$effective-widget = 'process-name']" class="fb-process-param-select1">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                    <xf:itemset ref=".[. = '']">
                                                                                                        <xf:label value="'—'"/>
                                                                                                        <xf:value/>
                                                                                                    </xf:itemset>
                                                                                                    <xf:choices>
                                                                                                        <xf:label ref="$resources/dialog-process-editor/categories/form-processes[exists($form-procs)]"/>
                                                                                                        <xf:itemset ref="$form-procs">
                                                                                                            <xf:label value="."/>
                                                                                                            <xf:value value="."/>
                                                                                                        </xf:itemset>
                                                                                                    </xf:choices>
                                                                                                    <xf:choices>
                                                                                                        <xf:label ref="$resources/dialog-process-editor/categories/sub-process"/>
                                                                                                        <xf:itemset ref="$builtin-procs">
                                                                                                            <xf:label ref="@name"/>
                                                                                                            <xf:value ref="@name"/>
                                                                                                        </xf:itemset>
                                                                                                    </xf:choices>
                                                                                                    <xf:itemset ref=".[xxf:non-blank() and not(. = $form-procs) and not(. = $builtin-procs/@name)]">
                                                                                                        <xf:label value="."/>
                                                                                                        <xf:value value="."/>
                                                                                                    </xf:itemset>
                                                                                                </xf:select1>
                                                                                            </xf:case>

                                                                                            <xf:case value="'text'">
                                                                                                <xf:input ref=".[$effective-widget = 'text']" class="fb-process-param-input {'fb-process-code-input'[$param-def/@value-mode = 'xpath' or $is-avt-mode]}">
                                                                                                    <xf:label value="$summary-label"/>
                                                                                                    <xf:hint value="($param-def/@placeholder, '')[1]" appearance="minimal"/>
                                                                                                    <xf:alert value="$alert-text"/>
                                                                                                </xf:input>
                                                                                            </xf:case>

                                                                                        </xf:switch>
                                                                                    </xh:div>

                                                                                    <!-- AVT toggle & remove buttons -->
                                                                                    <xh:div class="fb-process-param-actions">
                                                                                        <xf:trigger
                                                                                            ref=".[$supports-avt-toggle]"
                                                                                            appearance="minimal"
                                                                                            class="fb-process-btn fb-process-avt-toggle {'fb-process-avt-active'[$is-avt-mode]}">
                                                                                            <xf:label>
                                                                                                <xh:span class="fb-process-avt-badge" title="{$resources/dialog-process-editor/avt-toggle}">{…}</xh:span>
                                                                                            </xf:label>
                                                                                            <xf:action event="DOMActivate">
                                                                                                <xf:delete ref="$param-elem/@unnamed"/>
                                                                                                <xf:action if="$is-avt-mode">
                                                                                                    <xf:setvalue
                                                                                                        ref="$param-elem"
                                                                                                        value="pui:defaultValueWhenLeavingAvtMode($current/@name, $param-elem/@name, $param-elem)"/>
                                                                                                    <xf:setvalue ref="$param-elem/@avt-mode" value="'false'"/>
                                                                                                </xf:action>
                                                                                                <xf:action if="not($is-avt-mode)">
                                                                                                    <xf:setvalue ref="$param-elem/@avt-mode" value="'true'"/>
                                                                                                </xf:action>
                                                                                            </xf:action>
                                                                                        </xf:trigger>

                                                                                        <xf:trigger
                                                                                            ref=".[not($is-required)]"
                                                                                            appearance="minimal"
                                                                                            class="fb-process-btn fb-process-param-remove">
                                                                                            <xf:label><xh:i class="fa fa-fw fa-minus-circle" title="{$resources/dialog-process-editor/remove-parameter}"/></xf:label>
                                                                                            <xf:action event="DOMActivate">
                                                                                                <xf:delete ref="$param-elem"/>
                                                                                            </xf:action>
                                                                                        </xf:trigger>
                                                                                    </xh:div>
                                                                                </xh:div>
                                                                            </xf:repeat>
                                                                        </xf:case>
                                                                    </xf:switch>
                                                                </xh:div>
<!--                                                            </xh:div>-->
                                                            </xh:div>
                                                        </xh:div>

                                                        <!-- Row action buttons on the right -->
                                                        <xh:div class="fb-process-row-buttons">
                                                            <xh:i class="fa fa-fw fa-bars fb-process-grab" title="Move"/>

                                                            <!-- Remove button -->
                                                            <xf:trigger appearance="minimal" class="fb-process-btn">
                                                                <xf:label><xh:i class="fa fa-fw fa-minus-circle" title="Remove"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:delete ref="$current"/>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Add button -->
                                                            <xf:trigger appearance="minimal" class="fb-process-btn">
                                                                <xf:label><xh:i class="fa fa-fw fa-plus-circle" title="Add step"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:insert
                                                                        if="$current[self::else]"
                                                                        context="$current"
                                                                        origin="pui:newActionTemplateXml('save', 'then')"/>
                                                                    <xf:insert
                                                                        if="$current[not(self::else)]"
                                                                        ref="$current"
                                                                        position="after"
                                                                        origin="pui:newActionTemplateXml('save', 'then')"/>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Group button -->
                                                            <xf:trigger appearance="minimal" class="fb-process-btn" ref="$current[self::step and @type != 'group']">
                                                                <xf:label><xh:i class="fa fa-fw fa-object-group" title="Group"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="new-group" value="pui:newGroupTemplateXml($current/@combinator)"/>
                                                                    <xf:insert context="$new-group" origin="xxf:mutable-document($current)"/>
                                                                    <xf:setvalue ref="$new-group/*/@combinator" value="'then'"/>
<!--                                                                    <xf:message value="xxf:serialize($new-group, instance('xml-formatting-instance'))"/>-->
                                                                    <xf:insert ref="$current" position="after" origin="$new-group"/>
                                                                    <xf:delete ref="$current"/>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Condition button -->
                                                            <xf:trigger appearance="minimal" class="fb-process-btn" ref="$current[self::step and @type != 'condition']">
                                                                <xf:label><xh:i class="fa fa-fw fa-code-fork" title="Condition (if)"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="new-cond" value="pui:newConditionTemplateXml($current/@combinator)"/>
                                                                    <xf:insert context="$new-cond/then" origin="xxf:mutable-document($current)"/>
                                                                    <xf:setvalue ref="$new-cond/then/*/@combinator" value="'then'"/>
                                                                    <xf:insert ref="$current" position="after" origin="$new-cond"/>
                                                                    <xf:delete ref="$current"/>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Else button on condition -->
                                                            <xf:trigger appearance="minimal" class="fb-process-btn" ref="$current[self::step[@type = 'condition']]">
                                                                <xf:label>
                                                                    <xh:span class="fb-process-btn-text">
                                                                        <xf:output value="if (exists($current/else)) then '- Else' else '+ Else'"/>
                                                                    </xh:span>
                                                                </xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:var name="add-else" value="empty($current/else)"/>
                                                                    <xf:action if="$add-else">
                                                                        <xf:insert
                                                                            context="$current"
                                                                            ref="*"
                                                                            origin="pui:newElseTemplateXml()"/>
                                                                    </xf:action>
                                                                    <xf:action if="not($add-else)">
                                                                        <xf:delete ref="$current/else"/>
                                                                    </xf:action>
                                                                </xf:action>
                                                            </xf:trigger>

                                                            <!-- Ungroup button -->
                                                            <xf:trigger appearance="minimal" class="fb-process-btn" ref="$current[exists(parent::then | parent::else | parent::step[@type = 'group'] | self::step[@type = 'group'])]">
                                                                <xf:label><xh:i class="fa fa-fw fa-object-ungroup" title="Ungroup"/></xf:label>
                                                                <xf:action event="DOMActivate">
                                                                    <xf:action if="$current/@type = 'group'">
                                                                        <xf:insert ref="$current" position="after" origin="$current/step"/>
                                                                        <xf:delete ref="$current"/>
                                                                    </xf:action>
                                                                    <xf:action if="$current/parent::step[@type = 'group']">
                                                                        <xf:var name="parent-grp" value="$current/parent::step[@type = 'group']"/>
                                                                        <xf:insert ref="$parent-grp" position="after" origin="$current"/>
                                                                        <xf:delete ref="$current"/>
                                                                        <xf:delete if="empty($parent-grp/step)" ref="$parent-grp"/>
                                                                    </xf:action>
                                                                    <xf:action if="$current/parent::then or $current/parent::else">
                                                                        <xf:var name="parent-cnd" value="$current/ancestor::step[@type = 'condition'][1]"/>
                                                                        <xf:insert ref="$parent-cnd" position="after" origin="$current"/>
                                                                        <xf:delete ref="$current"/>
                                                                    </xf:action>
                                                                </xf:action>
                                                            </xf:trigger>
                                                        </xh:div>
                                                    </xh:div>
                                                </xf:repeat>
                                                </xh:div>
                                            </xf:group>

                                            <!-- When process has NO steps -->
                                            <xf:group ref=".[empty(step)]" class="fb-process-empty-steps">
                                                <xf:output value="$resources/dialog-process-editor/no-steps"/>
                                                <xf:trigger appearance="minimal">
                                                    <xf:label><xh:i class="fa fa-plus-circle"/> <xf:output value="$resources/dialog-process-editor/add-step"/></xf:label>
                                                    <xf:action event="DOMActivate">
                                                        <xf:insert context="." origin="pui:newActionTemplateXml('save', 'then')"/>
                                                    </xf:action>
                                                </xf:trigger>
                                            </xf:group>

                                            <!-- Live Process Syntax Preview -->
                                            <xh:div class="fb-process-preview">
                                                <xh:div class="fb-process-preview-header">
                                                    <xf:output value="$resources/dialog-process-editor/process-preview"/>
                                                </xh:div>
                                                <xh:code class="fb-process-preview-code"><xf:output value="pui:xmlToProcessString(., true())"/></xh:code>
                                            </xh:div>

                                            <!-- Live XML syntax preview (for debugging) -->
                                            <xh:div class="fb-process-preview fb-process-xml-preview xforms-hidden">
                                                <xh:div class="fb-process-preview-header">
                                                    XML Syntax Preview
                                                </xh:div>
                                                <xh:code class="fb-process-preview-code">
                                                    <xf:output value="xxf:serialize(., instance('xml-formatting-instance'))"/>
                                                </xh:code>
                                            </xh:div>
                                        </xh:div>
                                    </fr:c>
                                    <fr:c x="1" y="3" w="12">
                                        <xh:div class="fb-process-delete-container">
                                            <xf:trigger appearance="xxf:mini xxf:danger">
                                                <xf:label value="$resources/dialog-process-editor/delete-process"/>
                                                <xf:delete event="DOMActivate" ref="."/>
                                            </xf:trigger>
                                        </xh:div>
                                    </fr:c>
                                </fr:grid>
                            </xh:div>
                        </fr:tab>
                    </fr:tabbable>

                    <xf:action observer="fb-processes-tabbable" event="fr-tabbable-add">
                        <xf:insert
                            context="$i"
                            ref="process"
                            origin="instance('process-template')"/>
                        <xf:setfocus control="fb-process-name"/>
                    </xf:action>

                    <fr:error-summary id="error-summary" observer="dialog" valid-ref="instance('validity-instance')">
                        <fr:label><xf:output value="xxf:r('errors.label', '|fr-form-resources|')"/></fr:label>
                    </fr:error-summary>

                    <xh:div class="fr-dialog-buttons" xml:space="preserve">
                        <xf:trigger id="fb-save-trigger" appearance="xxf:primary">
                            <xf:label mediatype="text/html" value="$resources/apply/label"/>
                        </xf:trigger>
                        <xf:output value="$resources/or/label"/>
                        <xf:trigger appearance="minimal">
                            <xf:label mediatype="text/html" value="$resources/cancel/label"/>
                            <xxf:hide
                                event="DOMActivate"
                                dialog="dialog"/>
                        </xf:trigger>
                    </xh:div>

                </xxf:dialog>
            </xf:group>
        </xbl:template>

    </xbl:binding>
</xbl:xbl>
