                            <name-placeholder>staging</name-placeholder>
                            <url-label>URL del servidor</url-label>
                            <url-placeholder>https://staging.example.org/orbeon</url-placeholder>
                            <ui-access-label>Accés UI (Administració de formularis)</ui-access-label>
