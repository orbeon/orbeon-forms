                            <select-action>Aktion auswählen…</select-action>
                            <visual-editor>Visuell</visual-editor>
                            <text-editor>Text</text-editor>
                            <format>Formatieren</format>
                            <copy>Kopieren</copy>
                            <add-parameter>+ Parameter</add-parameter>
                            <custom-parameter>Benutzerdefinierter Parameter…</custom-parameter>
                            <remove-parameter>Parameter entfernen</remove-parameter>
                            <avt-toggle>Dynamische Wertvorlage umschalten ({…})</avt-toggle>
                            <categories>
                                <form-runner>Form-Runner-Aktionen</form-runner>
                                <sub-process>Integrierte Unterprozesse</sub-process>
                                <flow-control>Ablaufsteuerung</flow-control>
                                <xforms>XForms-Aktionen</xforms>
                                <form-processes>Benutzerdefinierte Prozesse</form-processes>
                            </categories>
                            <alerts>
                                <required>Wert ist erforderlich</required>
                                <action-required>Eine Aktion ist erforderlich</action-required>
                                <invalid-xpath>Ungültiger XPath-Ausdruck</invalid-xpath>
                                <invalid-avt>Ungültige XPath-Wertvorlage</invalid-avt>
                                <invalid-boolean>Muss „true“, „false“ oder ein AVT-Ausdruck sein</invalid-boolean>
                                <invalid-choice>Ungültiger Parameterwert</invalid-choice>
                                <invalid-token>Enthält einen nicht unterstützten Wert</invalid-token>
                                <invalid-duration>Muss eine gültige Dauer mit Einheit sein (z. B. 1000ms oder 5s)</invalid-duration>
                                <invalid-at>Muss „start“, „end“, „all“ oder eine positive Ganzzahl sein</invalid-at>
                                <invalid-mode>Nicht unterstützter Zielmodus</invalid-mode>
                                <invalid-ncname>Muss ein gültiger XML-Bezeichner sein</invalid-ncname>
                                <unknown-control>Unbekannter Steuerelementname</unknown-control>
                                <unknown-section>Unbekannter Abschnittsname</unknown-section>
                                <unknown-process>Unbekannter Unterprozessname</unknown-process>
                                <self-process>Ein Prozess kann sich nicht selbst aufrufen</self-process>
                                <unknown-param>Nicht unterstützter Parameter für diese Aktion</unknown-param>
                                <invalid-param-name>Ein eindeutiger, gültiger Parametername ist erforderlich</invalid-param-name>
                            </alerts>
                        </resource>
                        <resource xml:lang="es">
                            <label>Editor de procesos</label>
                            <apply>Aplicar</apply>
                            <cancel>Cancelar</cancel>
                            <or>o</or>
                            <process-name>
                                <label>Nombre del proceso</label>
                                <hint>Nombre único que identifica este proceso (p. ej. save-final)</hint>
                                <alert>Se requiere un nombre de proceso válido y único</alert>
