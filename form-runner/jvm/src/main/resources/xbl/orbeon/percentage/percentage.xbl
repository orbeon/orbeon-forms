<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:NumberSupport="java:org.orbeon.xbl.NumberSupportJava">

    <xbl:binding
        id="fr-number"
        element="
            fr|percentage,
            xf|input[appearance = 'xxf:percentage']:xxf-type('xs:decimal')"
        xxbl:mode="lhha binding value external-value focus javascript-lifecycle allow-minimal-label-hint"
        xxf:external-events="DOMActivate"
        xxbl:label-for="html-input"
        xxbl:format="
            string-join(
                (
                    fr:component-param-value('prefix'),
                    NumberSupport:getDisplayValueJava(
                        xxf:binding('fr-number'),
                        fr:component-param-value('decimal-separator'),
                        fr:component-param-value('grouping-separator'),
                        fr:component-param-value('prefix'),
                        fr:component-param-value('digits-after-decimal'),
                        string(fr:component-param-value('round-when-formatting')) = 'true',
                        string(fr:component-param-value('round-when-storing'))    = 'true',
                        2
                    ),
                    fr:component-param-value('suffix')
                ),
                ' '
            )"

        xxbl:serialize-external-value="
            NumberSupport:serializeExternalValueJava(
                xxf:binding('fr-number'),
                fr:component-param-value('decimal-separator'),
                fr:component-param-value('grouping-separator'),
                fr:component-param-value('prefix'),
                fr:component-param-value('digits-after-decimal'),
                string(fr:component-param-value('round-when-formatting')) = 'true',
                string(fr:component-param-value('round-when-storing'))    = 'true',
                2
            )"

        xxbl:deserialize-external-value="
            NumberSupport:deserializeExternalValueJava(
                .,
                xxf:binding('fr-number'),
                fr:component-param-value('decimal-separator'),
                fr:component-param-value('grouping-separator'),
                fr:component-param-value('prefix'),
                fr:component-param-value('digits-after-decimal'),
                string(fr:component-param-value('round-when-formatting')) = 'true',
                string(fr:component-param-value('round-when-storing'))    = 'true',
                2
            )"
    >

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Percentage</display-name>
            <display-name lang="fr">Pourcentage</display-name>
            <display-name lang="no">Prosent</display-name>
            <display-name lang="ru">Процент</display-name>
            <display-name lang="it">Percentuale</display-name>
            <display-name lang="de">Prozentsatz</display-name>
            <display-name lang="fi">Prosentti</display-name>
            <display-name lang="es">Porcentaje</display-name>
            <display-name lang="nl">Percentage</display-name>
            <display-name lang="pt">Percentagem</display-name>
            <display-name lang="sv">Procent</display-name>
            <display-name lang="ar">نسبة مئوية</display-name>
            <display-name lang="pl">Procent</display-name>
            <display-name lang="ja">パーセント</display-name>
            <icon>
                <icon-class>fa fa-fw fa-percent</icon-class>
            </icon>
            <templates>
                <bind type="xf:decimal"/>
                <view>
                    <fr:percentage>
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </fr:percentage>
                </view>
            </templates>
            <xi:include
                xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
                href="/xbl/orbeon/number/number.xbl"
                xpointer="xpath(/xbl:xbl/xbl:binding/fb:metadata/(fb:custom-settings, fb:control-details))"/>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/number/number.css"/>
        </xbl:resources>
        <!-- Delegate to `fr:number` -->
        <xi:include
            href="/xbl/orbeon/number/number.xbl"
            xpointer="xpath(/xbl:xbl/xbl:binding/xbl:handlers, /xbl:xbl/xbl:binding/xbl:template)"/>
    </xbl:binding>

    <xbl:binding
        id="fr-percentage-output"
        element="
            fr|percentage[fr|static-readonly = true],
            fr|percentage[fr|pdf-template = true]"
        xxbl:mode="lhha binding value allow-minimal-label-hint"
        xxbl:label-for="input"
        xxbl:format="
            string-join(
                (
                    fr:component-param-value('prefix'),
                    NumberSupport:getDisplayValueJava(
                        xxf:binding('fr-percentage-output'),
                        fr:component-param-value('decimal-separator'),
                        fr:component-param-value('grouping-separator'),
                        fr:component-param-value('prefix'),
                        fr:component-param-value('digits-after-decimal'),
                        string(fr:component-param-value('round-when-formatting')) = 'true',
                        string(fr:component-param-value('round-when-storing'))    = 'true',
                        2
                    ),
                    fr:component-param-value('suffix')
                ),
                ' '
            )"
    >
        <xbl:resources>
            <xbl:style src="/xbl/orbeon/number/number.css"/>
        </xbl:resources>
        <xbl:template>
            <xf:input
                id="input"
                class="{for $v in fr:component-param-value('field-align') return concat('fr-field-align-', $v)}"
                ref="xxf:binding('fr-percentage-output')"
                xxf:format="xxf:formatted-value('fr-percentage-output')"/>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>
