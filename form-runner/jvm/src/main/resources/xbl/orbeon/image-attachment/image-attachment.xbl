                                <view-mode>
                                    <label>Anzeigemodus</label>
                                    <item value="-1">Standard verwenden</item>
                                    <item value="grid">Raster</item>
                                    <item value="carousel">Karussell</item>
                                </view-mode>
                                <carousel-size>
                                    <label>Karussellgröße</label>
                                    <item value="-1">Standard verwenden</item>
                                    <item value="small">Klein</item>
                                    <item value="medium">Mittel</item>
                                    <item value="large">Groß</item>
                                </carousel-size>
                                <columns>
                                    <label>Anzahl der Spalten</label>
                                    <item value="-1">Standard verwenden</item>
                                    <item value="-2">Automatisch</item>
                                </columns>
                                <max-rows>
                                    <label>Maximale sichtbare Zeilen</label>
                                    <item value="-1">Standard verwenden</item>
                                    <item value="-2">Unbegrenzt</item>
                                </max-rows>
                                <max-width>
                                    <label>Maximale Breite anpassen auf</label>
                                    <item value="-1">Standard verwenden</item>
                                    <item value="-2">Keine Anpassung</item>
                                </max-width>
                                <max-height>
                                    <label>Maximale Höhe anpassen auf</label>
                                </max-height>
                                <quality>
                                    <label>Qualität des komprimierten Bildes</label>
                                    <item value="-1">Standard verwenden</item>
                                    <item value="90">Hoch (90%)</item>
                                    <item value="80">Mittel (80%)</item>
                                    <item value="70">Niedrig (70%)</item>
                                    <item value="50">Sehr niedrig (50%)</item>
                                </quality>
                                <format>
