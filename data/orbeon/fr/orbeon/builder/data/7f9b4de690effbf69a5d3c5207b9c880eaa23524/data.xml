            </xf:instance>

            <!-- All form resources -->
            <xf:instance xxf:readonly="true" id="fr-form-resources" xxf:exclude-result-prefixes="#all">
                <resources>
                    <resource xml:lang="en"><patient-details><label>Patient details</label></patient-details><contact-information-first-name><label>First Name</label><hint></hint>


                        </contact-information-first-name><contact-information-last-name><label>Last Name</label><hint></hint>


                        </contact-information-last-name><contact-information-phone><label>Phone number</label><hint></hint>


                        </contact-information-phone><contact-information-email><label>Email</label><hint></hint>


