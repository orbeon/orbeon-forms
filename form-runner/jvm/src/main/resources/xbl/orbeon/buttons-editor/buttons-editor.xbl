<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:exf="http://www.exforms.org/exf/1-0"
    xmlns:oxf="http://www.orbeon.com/oxf/processors"
    xmlns:fn="http://www.w3.org/2005/xpath-functions"
    xmlns:math="http://www.w3.org/2005/xpath-functions/math"
    xmlns:map="http://www.w3.org/2005/xpath-functions/map"
    xmlns:array="http://www.w3.org/2005/xpath-functions/array"
    xmlns:saxon="http://saxon.sf.net/"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:frf="java:org.orbeon.oxf.fr.FormRunner"
    xmlns:beu="java:org.orbeon.oxf.fr.ButtonsEditorUI"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <xbl:binding
        id="fr-buttons-editor"
        element="fr|buttons-editor"
        xxbl:mode="binding lhha">

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/buttons-editor/buttons-editor.css"/>
        </xbl:resources>

        <xbl:handlers>
            <!-- Allow host (e.g. Processes tab) to jump to a bar and/or open a specific button's configuration dialog -->
            <xbl:handler event="fr-select-bar" phase="target">
                <xf:var name="requested-bar" value="string(event('bar'))[. = ('edit', 'view', 'inner')]"/>
                <xf:setvalue if="exists($requested-bar)" ref="instance('state')/@active-bar" value="$requested-bar"/>
            </xbl:handler>

            <xbl:handler event="fr-configure-button" phase="target">
                <xf:var name="requested-bar"  value="string(event('bar'))[. = ('edit', 'view', 'inner')]"/>
                <xf:var name="requested-name" value="xxf:trim(string(event('name')))"/>
                <xf:setvalue if="exists($requested-bar)" ref="instance('state')/@active-bar" value="$requested-bar"/>
                <xf:rebuild/>
                <xf:recalculate/>
                <xf:refresh/>
                <xf:dispatch if="xxf:non-blank($requested-name)" name="fr-be-open-by-name" targetid="fr-be-root">
                    <xf:property name="name"       value="$requested-name"/>
                    <xf:property name="add-to-bar" value="string(event('add-to-bar'))"/>
                </xf:dispatch>
            </xbl:handler>
        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="buttons-editor-model">

                <!-- Mirrored <detail-buttons> subtree from host (keep XPath namespaces in scope for xxf:XPath2 validation) -->
                <xf:instance id="i" xxbl:mirror="true">
                    <detail-buttons/>
                </xf:instance>

                <!-- Standard detail buttons & curated Font Awesome icons catalog -->
                <xf:instance id="catalog" xxf:exclude-result-prefixes="#all">
                    <catalog/>
                </xf:instance>

                <!-- Parsed <item> list for the currently active bar (edit | view | inner) -->
                <xf:instance id="bar-items" xxf:exclude-result-prefixes="#all">
                    <items/>
                </xf:instance>

                <!-- Editor UI state -->
                <xf:instance id="state" xxf:exclude-result-prefixes="#all">
                    <state
                        initialized="false"
                        readonly="false"
                        syncing="false"
                        active-bar="edit"
                        last-bar-sig=""
                        add-standard-choice=""
                        announcement=""/>
                </xf:instance>

                <!-- Modal dialog state for configuring a single button or a split-dropdown button (keep XPath namespaces in scope for xxf:XPath2 validation) -->
                <xf:instance id="dialog">
                    <dialog
                        open="false"
                        mode="edit-bar-item"
                        bar-index="0"
                        active-part-index="1"
                        add-split-choice=""
                        show-errors="false">
                        <parts/>
                        <templates>
                            <part
                                original-name=""
                                name=""
                                is-standard="false"
                                label-mode="default"
                                icon=""
                                single-text=""
                                raw-html=""
                                visible-mode="default"
                                visible-xpath=""
                                enabled-mode="default"
                                enabled-xpath=""
                                loading-mode="default"
                                close-uri-override="false"
                                close-uri="">
                                <translations/>
                            </part>
                            <translation lang="en"/>
                        </templates>
                    </dialog>
                </xf:instance>

                <xf:instance id="orbeon-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <_>
                        <resource xml:lang="en">
                            <bar-edit>Edit / New</bar-edit>
                            <bar-view>View / Review</bar-view>
                            <bar-inner>Inner (Form / Wizard Body)</bar-inner>
                            <bar-edit-hint>Buttons shown in the bottom bar when creating or editing data</bar-edit-hint>
                            <bar-view-hint>Buttons shown in the bottom bar on read-only View and Review pages</bar-view-hint>
                            <bar-inner-hint>Buttons placed inside the form or wizard body instead of the sticky bottom bar</bar-inner-hint>
                            <override-list>Override button list</override-list>
                            <inherited-note>Showing inherited buttons. Add, remove, or drag buttons to override the list, or click Configure on any button to customize only its label, conditions, or process.</inherited-note>
                            <add-standard-placeholder>+ Add standard button…</add-standard-placeholder>
                            <add-custom>Add custom button…</add-custom>
                            <clear-bar>Clear all</clear-bar>
                            <reset-bar>Reset list</reset-bar>
                            <empty-bar>No buttons in this bar.</empty-bar>
                            <empty-bar-overridden>This bar is explicitly overridden to show no buttons.</empty-bar-overridden>
                            <cat-workflow>Save &amp; Workflow</cat-workflow>
                            <cat-navigation>Navigation &amp; Wizard</cat-navigation>
                            <cat-export>Export &amp; Utilities</cat-export>
                            <badge-primary>Primary</badge-primary>
                            <badge-primary-hint>The last visible button in the bar is automatically styled as the primary action</badge-primary-hint>
                            <badge-overridden>Overridden</badge-overridden>
