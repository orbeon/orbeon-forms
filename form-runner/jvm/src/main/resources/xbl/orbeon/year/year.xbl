<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <xbl:binding
        id="fr-year"
        element="fr|year, xf|input:xxf-type('xs:gYear')"
        xxbl:container="span"
        xxbl:mode="lhha binding value"
        xxbl:label-for="input"
    >

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Year</display-name>
            <display-name lang="fr">Année</display-name>
            <display-name lang="no">År</display-name>
            <display-name lang="ru">Год</display-name>
            <display-name lang="it">Anno</display-name>
            <display-name lang="de">Jahr</display-name>
            <display-name lang="fi">Vuosi</display-name>
            <display-name lang="es">Año</display-name>
            <display-name lang="nl">Jaar</display-name>
            <display-name lang="pt">Ano</display-name>
            <display-name lang="sv">År</display-name>
            <display-name lang="ar">سنة</display-name>
            <display-name lang="pl">Rok</display-name>
            <display-name lang="ja">年</display-name>
            <icon>
                <icon-class>fa fa-fw fa-calendar</icon-class>
            </icon>
            <templates>
                <bind type="xf:gYear"/>
                <view>
                    <fr:year id="" ref="" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint  ref=""/>
                        <xf:help  ref=""/>
                        <xf:alert ref=""/>
                    </fr:year>
                </view>
            </templates>
            <custom-settings>
                <setting name="field-width" type="xs:string" values="full natural"/>
            </custom-settings>
            <control-details>
                <xf:model xmlns="" id="fb-editor-year-model">

                    <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
                        <xf:var name="c" value="."/>
                        <xf:setvalue ref="$c" value="instance()/@*[name() = name($c)]"/>
                    </xf:action>

                    <xf:instance id="local" xxf:exclude-result-prefixes="#all">
                        <_>
                            <field-width/>
                        </_>
                    </xf:instance>
                </xf:model>
                <fr:grid xmlns="" id="fb-editor-year-grid">
                    <xh:tr>
                        <xh:td colspan="6">
                            <xf:select1 ref="instance('local')/field-width" appearance="full xxf:horizontal" id="field-width-control">
                                <xf:label ref="xxf:r('xbl-control-settings.field-width', '|fr-form-resources|')"/>
                                <xf:item>
                                    <xf:label ref="xxf:r('xbl-control-settings.default', '|fr-form-resources|')"/>
                                    <xf:value/>
                                </xf:item>
                                <xf:item>
                                    <xf:label ref="xxf:r('xbl-control-settings.full', '|fr-form-resources|')"/>
                                    <xf:value>full</xf:value>
                                </xf:item>
                                <xf:item>
                                    <xf:label ref="xxf:r('xbl-control-settings.natural', '|fr-form-resources|')"/>
                                    <xf:value>natural</xf:value>
                                </xf:item>
                            </xf:select1>
                        </xh:td>
                    </xh:tr>
                </fr:grid>
                <xf:action
                    id="fb-editor-year-action"
                    event="xforms-value-changed"
                    observer="field-width-control">

                    <xf:var name="name"      value="name(event('xxf:binding'))"/>
                    <xf:var name="new-value" value="string(event('xxf:binding'))"/>
                    <xf:insert
                        context="instance()"
                        if="xxf:non-blank($new-value)"
                        origin="xf:attribute($name, $new-value)"/>
                    <xf:delete
                        if="xxf:is-blank($new-value)"
                        ref="instance()/@*[name() = $name]"/>
                </xf:action>
            </control-details>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/year/year.css"/>
        </xbl:resources>

        <xbl:template>
            <xf:input
                id="input"
                class="fr-field-width-{fr:component-param-value('field-width')}"
                ref="xxf:binding('fr-year')"
                xxf:maxlength="4"
                xxf:pattern="[0-9]*"
                xbl:attr="navindex navindex=tabindex autocomplete"/>
        </xbl:template>
    </xbl:binding>

    <xbl:binding
        id="fr-year-output"
        element="
            fr|year[fr|static-readonly = true],
            fr|year[fr|pdf-template = true],
            fr|dropdown-year[fr|static-readonly = true]"
        xxbl:mode="lhha binding value"
        xxbl:label-for="input"
    >
        <xbl:resources>
            <xbl:style src="/xbl/orbeon/year/year.css"/>
        </xbl:resources>
        <xbl:template>
            <xf:input
                id="input"
                ref="xxf:binding('fr-year-output')"
                xbl:attr="xxf:readonly-appearance"/>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>
