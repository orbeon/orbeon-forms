<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <xbl:binding
        id="fr-segmented-select1"
        element="fr|segmented-select1, xf|select1[appearance ~= segmented]"
        xxbl:mode="lhha binding value selection"
        xxbl:container="span"
        xxbl:label-for="select-elem">

        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Segmented Buttons</display-name>
            <display-name lang="fr">Boutons segmentés</display-name>
            <display-name lang="no">Segmenterte knapper</display-name>
            <display-name lang="ru">Сегментированные кнопки</display-name>
            <display-name lang="it">Pulsanti segmentati</display-name>
            <display-name lang="de">Segmentierte Schaltflächen</display-name>
            <display-name lang="fi">Segmentoidut painikkeet</display-name>
            <display-name lang="es">Botones segmentados</display-name>
            <display-name lang="nl">Gesegmenteerde knoppen</display-name>
            <display-name lang="pt">Botões segmentados</display-name>
            <display-name lang="sv">Segmenterade knappar</display-name>
            <display-name lang="ar">أزرار مقسمة</display-name>
            <display-name lang="pl">Przyciski segmentowe</display-name>
            <display-name lang="ja">セグメントボタン</display-name>
            <toolbox show="false"/>
            <icon>
                <icon-class>fa fa-fw fa-columns</icon-class>
            </icon>
            <editors static-itemset="true" item-hint="true"/>
            <templates>
                <!-- Provide a view template for Form Builder so that CSS resources are loaded -->
                <view>
                    <xf:select1 id="" ref="" appearance="segmented" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                        <xf:itemset ref="">
                            <xf:label ref="label"/>
                            <xf:value ref="value"/>
                            <xf:hint ref="hint"/>
                        </xf:itemset>
                    </xf:select1>
                </view>
            </templates>
        </metadata>

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/segmented-select1/segmented-select1.css"/>
        </xbl:resources>

        <xbl:handlers>
            <!-- As done for XForms selection controls, consider the control visited on selection -->
            <xbl:handler event="xforms-select xforms-deselect" observer="select-elem">
                <xxf:setvisited control="fr-segmented-select1"/>
                <xf:dispatch name="{event('xxf:type')}" targetid="fr-segmented-select1">
                    <xf:property name="xxf:item-value" value="event('xxf:item-value')"/>
                </xf:dispatch>
            </xbl:handler>
        </xbl:handlers>

        <xbl:template>
            <xf:select1
                id="select-elem"
                appearance="full"
                ref="xxf:binding('fr-segmented-select1')"
                xbl:attr="xxf:encrypt-item-values">
                <xbl:content includes=":root > xf|itemset, :root > xf|item, :root > xf|choices"/>
            </xf:select1>
        </xbl:template>
    </xbl:binding>
</xbl:xbl>
