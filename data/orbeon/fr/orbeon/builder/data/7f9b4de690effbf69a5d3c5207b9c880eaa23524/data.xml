                        </contact-information-middle-initial><amendment-status><label>Amendment status</label><hint></hint><item>
            <label>Accepted</label>
            <hint></hint>
            <value>accepted</value>
          </item><item>
            <label>Denied</label>
            <hint></hint>
            <value>denied</value>
