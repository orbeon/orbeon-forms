<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:oxf="http://www.orbeon.com/oxf/processors"
    xmlns:frf="java:org.orbeon.oxf.fr.FormRunner"
    xmlns:array="http://www.w3.org/2005/xpath-functions/array"
    xmlns:map="http://www.w3.org/2005/xpath-functions/map"
    xmlns:p="http://www.orbeon.com/oxf/pipeline"
    xmlns:Wizard="java:org.orbeon.xbl.Wizard">

    <xbl:binding
        id="fr-wizard"
        element="fr|wizard"
        xxbl:mode="javascript-lifecycle"
        xxf:external-events="fr-wizard-focus">

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/wizard/wizard.css"/>
        </xbl:resources>
        <xbl:handlers>

            <xbl:handler event="xxforms-refresh-done" observer="#document" xxbl:scope="outer">
                <!--
                    - `fr:error-summary` listens to events during the capture phase so that it is up-to-date once the
                    wizard processes them.
                -->
                <xf:var name="fr-wizard-local">
                    <xxf:value value="$local" xxbl:scope="inner"/>
                </xf:var>
                <xf:dispatch
                    if="not($fr-wizard-local/@initialized/data(.))"
                    name="fr-update-initial-case"
                    targetid="fr-wizard-outer-group"/>
                <xf:dispatch
                    name="fr-update-section-status"
                    targetid="fr-wizard-outer-group"/>
            </xbl:handler>

            <xbl:handler event="fr-prev" phase="target">
                <!-- NOTE: The target shouldn't be in the outer scope ideally. -->
                <xf:dispatch
                    name="fr-prev-internal"
                    targetid="fr-wizard-outer-group"
                    xxbl:scope="outer"/>
            </xbl:handler>
            <xbl:handler event="fr-next" phase="target">
                <!-- NOTE: The target shouldn't be in the outer scope ideally. -->
                <xf:dispatch
                    name="fr-next-internal"
                    targetid="fr-wizard-outer-group"
                    xxbl:scope="outer"/>
            </xbl:handler>
            <xbl:handler event="fr-show-toc" phase="target">
                <xf:action if="$local/separate-toc/data(.)">
                    <xf:setvalue
                        ref="$local/show-toc"
                        value="true()"/>
                    <xf:setvalue
                        ref="$local/show-body"
                        value="false()"/>
                </xf:action>
            </xbl:handler>
            <xbl:handler event="fr-update-validity" phase="target">
                <!-- NOTE: The target shouldn't be in the outer scope ideally. -->
                <xf:dispatch
                    name="fr-wizard-update-validity"
                    targetid="fr-wizard-update-validity"
                    xxbl:scope="outer"/>
            </xbl:handler>
            <xbl:handler event="fr-visit-all fr-show-relevant-errors" phase="target">
                <!-- See https://github.com/orbeon/orbeon-forms/issues/3178 -->
                <xf:var
                    xxbl:scope="outer"
                    name="fr-wizard-target-name">
                    <xxf:value
                        xxbl:scope="inner"
                        value="
                            if ($local/validate/data(.) = 'free') then
                                'fr-wizard-visit-all'
                            else
                                'fr-wizard-visit-all-available'
                        "/>
                </xf:var>

                <!-- NOTE: The target shouldn't be in the outer scope ideally. -->
                <xf:dispatch
                    name="{$fr-wizard-target-name}"
                    targetid="{$fr-wizard-target-name}"
                    xxbl:scope="outer"/>

                <!-- So if the captcha is invalid, its error shows in the error summary. This is needed in addition -->
                <!-- to the event we dispatch above as the captcha isn't inside the switch, as we don't want to have -->
                <!-- one instance of the captcha per top-level section. -->
                <xxf:setvisited
                    control="fr-captcha"
                    visited="true"
                    recurse="true"/>


            </xbl:handler>
            <!-- For client-side API -->
            <xbl:handler event="fr-wizard-focus" phase="target">
                <xf:var
                    xxbl:scope="outer"
                    name="fr-wizard-control-id"
                    value="concat(event('fr-control-name'), '-control')">
                </xf:var>
                <xf:var
                    xxbl:scope="outer"
                    name="fr-wizard-repeat-indexes"
                    value="for $i in xxf:split(event('fr-repeat-indexes')) return xs:integer($i)">
                </xf:var>
                <xf:action if="$local/validate/data(.) = 'free'">
                    <!-- Start by focusing following repeat indexes -->
                    <xf:action xxbl:scope="outer">
                        <xf:action if="empty($fr-wizard-repeat-indexes)">
                            <!-- Case where caller does not specify repeat indexes and we just follow existing indexes -->
                            <xf:setfocus
                                control="{$fr-wizard-control-id}"/>
                        </xf:action>
                        <xf:action if="exists($fr-wizard-repeat-indexes)">

                            <!-- Adjust the index of all ancestor repeated containers -->
                            <xf:var name="fr-wizard-ancestor-repeated-containers-static-ids">
                                <xxf:value
                                    xxbl:scope="inner"
                                    value="reverse(Wizard:findAncestorRepeatedContainerStaticIds(concat(event('fr-control-name'), '-control')))"/>
                            </xf:var>
                            <xf:action
                                if="exists($fr-wizard-ancestor-repeated-containers-static-ids)"
                                iterate="$fr-wizard-ancestor-repeated-containers-static-ids">
                                <xf:var name="fr-wizard-p"                   value="position()"/>
                                <xf:var name="fr-wizard-container-static-id" value="."/>

                                <xf:dispatch
                                    name="fr-setindex"
                                    targetid="{$fr-wizard-container-static-id}">
                                    <xf:property name="index" value="$fr-wizard-repeat-indexes[$fr-wizard-p]"/>
                                </xf:dispatch>
                            </xf:action>

                            <!-- Set the focus following adjusted repeat indexes -->
                            <xf:setfocus
                                control="{$fr-wizard-control-id}"/>
                        </xf:action>
                    </xf:action>
                </xf:action>
                <xf:action if="not($local/validate/data(.) = 'free')">
                    <xf:dispatch
                        xxbl:scope="outer"
                        name="fr-toggle-section-validate"
                        targetid="fr-wizard-outer-group">
                        <xf:property name="requested-control-id-opt" value="$fr-wizard-control-id"/>
                        <xf:property name="requested-page-index-opt" value="$fr-wizard-repeat-indexes[1]"/>
                        <xf:property name="setfocus-control-id"      value="$fr-wizard-control-id"/>
                        <xf:property name="setfocus-repeat-indexes"  value="event('fr-repeat-indexes')"/>
                    </xf:dispatch>
                </xf:action>
            </xbl:handler>
            <!-- When a page/section is shown, create the associated `fr:section-status` attribute if needed -->
            <!-- NOTE: 2018-08-07: This is done only for *top-level* pages. -->
            <xbl:handler event="fr-section-shown" phase="target">

                <xf:var
                    name="section-binding"
                    value="event('section-binding')"/>

                <xf:insert
                    if="not(exists($section-binding/@fr:section-status))"
                    xxf:structural-dependencies="false"
                    context="$section-binding"
                    origin="xf:attribute('fr:section-status', '')"/>

                <!-- NOTE: No need to update the section status here, as the `xf:insert` will cause a subsequent refresh. -->

            </xbl:handler>
        </xbl:handlers>
        <xbl:implementation>
            <xf:model>
                <xf:instance id="local" xxf:expose-xpath-types="true" xxf:exclude-result-prefixes="#all">
                    <_ initialized="false">
                        <current-case-id/>
                        <current-top-level-case-id/>
                        <current-index/>
                        <show-toc/>
                        <show-body/>
                        <readwrite/>

                        <validate/>
                        <toc-position/>
                        <separate-toc/>
                        <section-status/>
                        <visit-on-page-change/>
                    </_>
                </xf:instance>

                <xf:var name="local" value="instance('local')"/>

                <xf:bind ref="@initialized"         type="xs:boolean" xxf:default="false()"/>

                <xf:bind ref="validate"                               xxf:default="Wizard:normalizeWizardMode(fr:component-param-value('validate'))"/>
                <xf:bind ref="toc-position"         type="xs:string"  xxf:default="Wizard:normalizeTocPosition(fr:component-param-value('toc-position'), fr:component-param-value('separate-toc'))"/>
                <xf:bind ref="separate-toc"         type="xs:boolean" xxf:default="../toc-position/data(.) = 'separate'"/>
                <xf:bind ref="section-status"       type="xs:boolean" xxf:default="../separate-toc/data(.) or fr:component-param-value('section-status') = 'true'"/>
                <xf:bind ref="visit-on-page-change" type="xs:string"  xxf:default="fr:component-param-value('visit-on-page-change')"/>

                <xf:bind ref="current-index"        type="xs:integer" xxf:default="1"/>
                <xf:bind ref="show-toc"             type="xs:boolean" xxf:default="../toc-position/data(.) != 'none'"/>
                <xf:bind ref="show-body"            type="xs:boolean" xxf:default="not(../separate-toc/data(.))"/>

                <xf:instance id="available-top-level-sections" xxf:expose-xpath-types="true" xxf:exclude-result-prefixes="#all">
                    <_/>
                </xf:instance>

                <xf:var name="available-top-level-sections" value="instance('available-top-level-sections')"/>

            </xf:model>
        </xbl:implementation>
        <xbl:template xxbl:transform="oxf:unsafe-xslt">
            <xsl:transform version="2.0">
                <xsl:import href="oxf:/oxf/xslt/utils/copy-modes.xsl"/>
                <xsl:import href="oxf:/apps/fr/components/toc.xsl"/>

                <!-- `app` and `form` must be passed as attributes (see view.xsl) -->
                <xsl:variable name="static-app"             select="/*/@app/string()"/>
                <xsl:variable name="static-form"            select="/*/@form/string()"/>
                <xsl:variable name="static-validate"        select="/*/@validate/string()"/>        <!-- This is the `free|lax|strict` Form Runner validation mode. -->
                <xsl:variable name="static-validation-mode" select="/*/@validation-mode/string()"/> <!-- This is the `incremental|explicit` Form Runner validation mode. -->

                <xsl:variable
                    xmlns:p="http://www.orbeon.com/oxf/pipeline"
                    name="static-subsections-nav"
                    select="
                        (
                            for $a in /*/@subsections-nav return $a = 'true', (: takes precedence if present :)
                            p:property(string-join(('oxf.xforms.xbl.fr.wizard.subsections-nav', $static-app, $static-form), '.')) = true(),
                            false()
                        )[1]
                    "
                    as="xs:boolean"/>

                <!-- `all | active | none` -->
                <xsl:variable
                    xmlns:p="http://www.orbeon.com/oxf/pipeline"
                    name="static-subsections-toc"
                    select="
                        (
                            /*/@subsections-toc, (: takes precedence if present :)
                            p:property(string-join(('oxf.xforms.xbl.fr.wizard.subsections-toc', $static-app, $static-form), '.'))[. = ('all', 'none')],
                            'active'
                        )[1]"
                    as="xs:string"/>

                <xsl:variable
                    xmlns:p="http://www.orbeon.com/oxf/pipeline"
                    name="static-initial-focus"
                    select="
                        (
                            for $a in /*/@initial-focus return $a = 'true', (: takes precedence if present :)
                            p:property(string-join(('oxf.fr.detail.initial-focus', $static-app, $static-form), '.')) = true(),
                            true()
                        )[1]
                    "
                    as="xs:boolean"/>

                <xsl:variable
                    name="static-nav-sections-or-grids"
                    select="
                        if ($static-subsections-nav) then
                            /*//(
                                fr:section[
                                    (
                                        (: Top-level section :)
                                        count(ancestor::fr:section) = 0 and (
                                            empty(fr:section)          or
                                            @subsections-nav = 'false' or
                                            frf:isRepeat(.)
                                        )
                                    ) or (
                                        (: First-level subsection :)
                                        count(ancestor::fr:section) = 1    and
                                        not(../@subsections-nav = 'false') and
                                        not(frf:isRepeat(..))
                                    )
                                ],
                                (: Grid within a top-level section which also contains subsections
                                   and top-level section doesn't have Subsection navigation explicitly
                                   disabled and is not repeated :)
                                fr:grid[
                                    count(ancestor::fr:section) = 1    and
                                    not(../@subsections-nav = 'false') and
                                    not(frf:isRepeat(..))              and
                                    exists((preceding-sibling::fr:section | following-sibling::fr:section))
                                ]
                            )
                        else
                            (: Top-level sections :)
                            /*/fr:section
                "/>

                <!-- Make sure that duplicates are kept, see https://github.com/orbeon/orbeon-forms/issues/3516 -->
                <xsl:variable
                    name="static-matching-top-level-section-ids"
                    select="
                        for $s in $static-nav-sections-or-grids
                        return $s/ancestor-or-self::fr:section[last()]/@id/string()
                "/>

                <xsl:variable
                    name="static-nav-section-or-grid-ids"
                    select="$static-nav-sections-or-grids/((@id/string(), concat(generate-id(), '-wizard-grid'))[1])"/>

                <xsl:variable
                    name="static-top-level-section-ids"
                    select="/*/fr:section/@id/string()"/>

                <xsl:variable
                    name="static-sections-with-paging-section-ids"
                    select="/*//fr:section[@fr-use-wizard-repeat-paging = 'true']/@id/string()"/>

                <xsl:variable
                    name="static-sections-with-paging-case-ids"
                    select="for $id in $static-sections-with-paging-section-ids return concat($id, '-case')"/>

                <xsl:variable
                    name="static-lazy-section-relevance"
                    select="
                        (: limited to `free` mode :)
                        $static-validate = 'free' and
                        (: enabled by property :)
                        p:property(
                            string-join(
                                ('oxf.xforms.xbl.fr.wizard.lazy-section-relevance', $static-app, $static-form),
                                '.'
                            )
                        ) = true()"/>

                <xsl:variable
                    name="captcha-location"
                    select="/*/@captcha-location"/>

                <xsl:variable
                    name="captcha-location-index"
                    select="
                        if ($captcha-location = ('inside-wizard-first-page'))
                        then '1'
                        else 'last()'"/>

                <xsl:template match="/*">
                    <xf:group appearance="xxf:internal" xxbl:scope="outer">

                        <xf:var name="fr-wizard-local">
                            <xxf:value value="$local" xxbl:scope="inner"/>
                        </xf:var>
                        <xf:var name="fr-wizard-available-top-level-sections">
                            <xxf:value value="$available-top-level-sections" xxbl:scope="inner"/>
                        </xf:var>

                        <xf:var name="fr-wizard-focus-includes">
                            <xxf:value xxbl:scope="inner" value="frf:xpathFormRunnerStringProperty('oxf.fr.detail.focus.includes')"/>
                        </xf:var>
                        <xf:var name="fr-wizard-focus-excludes">
                            <xxf:value xxbl:scope="inner" value="frf:xpathFormRunnerStringProperty('oxf.fr.detail.focus.excludes')"/>
                        </xf:var>

                        <!-- Statically-known section and grid ids -->
                        <xf:var
                            name="fr-wizard-nav-section-or-grid-ids"
                            value="({
                                string-join(
                                    for $id in $static-nav-section-or-grid-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>
                        <xf:var
                            name="inner-nav-section-or-grid-ids"
                            xxbl:scope="inner"
                            value="({
                                string-join(
                                    for $id in $static-nav-section-or-grid-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>

                        <xf:var
                            name="fr-wizard-nav-matching-top-level-section-ids"
                            value="({
                                string-join(
                                    for $id in $static-matching-top-level-section-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>
                        <xf:var
                            name="inner-nav-matching-top-level-section-ids"
                            xxbl:scope="inner"
                            value="({
                                string-join(
                                    for $id in $static-matching-top-level-section-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>

                        <xf:var
                            name="fr-wizard-top-level-section-ids"
                            value="({
                                string-join(
                                    for $id in $static-top-level-section-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>

                        <xf:var
                            name="fr-wizard-sections-with-paging-section-ids"
                            value="({
                                string-join(
                                    for $id in $static-sections-with-paging-section-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>
                        <xf:var
                            name="inner-sections-with-paging-section-ids"
                            xxbl:scope="inner"
                            value="({
                                string-join(
                                    for $id in $static-sections-with-paging-section-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>

                        <xf:var
                            name="fr-wizard-sections-with-paging-case-ids"
                            value="({
                                string-join(
                                    for $id in $static-sections-with-paging-case-ids
                                        return concat('''', $id, ''''),
                                    ','
                                )
                            })"/>

                        <xf:var name="fr-wizard-nav-section-or-grid-bind-ids">
                            <xxf:value
                                xxbl:scope="inner"
                                value="for $id in $inner-nav-section-or-grid-ids return frf:bindId(frf:controlNameFromId($id))"/>
                        </xf:var>

                        <xf:var name="fr-wizard-top-level-section-bind-ids">
                            <xxf:value
                                xxbl:scope="inner"
                                value="
                                    for $id in ({
                                        string-join(
                                            for $id in $static-top-level-section-ids
                                                return concat('''', $id, ''''),
                                            ','
                                        )
                                    })
                                    return frf:bindId(frf:controlNameFromId($id))"/>
                        </xf:var>

                        <xf:var name="fr-wizard-available-top-level-sections-ids">
                            <xxf:value
                                xxbl:scope="inner"
                                value="
                                    for $section-name in xxf:split($available-top-level-sections)
                                    return
                                        (: See https://github.com/orbeon/orbeon-forms/issues/4022 :)
                                        $inner-nav-section-or-grid-ids[frf:controlNameFromId(.) = $section-name]"/>
                        </xf:var>

                        <xf:var
                            name="fr-wizard-validated-mode"
                            value="$fr-wizard-local/validate/data(.) != 'free'"/>

                        <xf:var
                            name="fr-wizard-separate-toc-mode"
                            value="$fr-wizard-local/separate-toc/data(.)"/>

                        <xf:var
                            name="fr-wizard-relevant-nav-section-or-grid-ids"
                            value="
                                for $i in 1 to count($fr-wizard-nav-section-or-grid-ids)
                                return
                                    let $id                   := $fr-wizard-nav-section-or-grid-ids[$i],
                                        $section-or-grid-bind := bind($fr-wizard-nav-section-or-grid-bind-ids[$i])
                                    return
                                        $id[
                                            xxf:relevant($section-or-grid-bind) and (
                                                not(
                                                    $id = $fr-wizard-sections-with-paging-section-ids and
                                                    empty($section-or-grid-bind/*)
                                                )
                                            )
                                        ]"/>

                        <xf:var name="inner-relevant-nav-section-or-grid-ids" xxbl:scope="inner">
                            <xxf:value xxbl:scope="outer" value="$fr-wizard-relevant-nav-section-or-grid-ids"/>
                        </xf:var>

                        <xf:var
                            name="fr-wizard-relevant-top-level-section-ids"
                            value="
                                for $i in 1 to count($fr-wizard-top-level-section-ids)
                                return
                                    let $id                     := $fr-wizard-top-level-section-ids[$i],
                                        $top-level-section-bind := bind($fr-wizard-top-level-section-bind-ids[$i])
                                    return
                                        $id[xxf:relevant($top-level-section-bind)]"/>

                        <xf:var name="inner-relevant-top-level-section-ids" xxbl:scope="inner">
                            <xxf:value xxbl:scope="outer" value="$fr-wizard-relevant-top-level-section-ids"/>
                        </xf:var>

                        <xf:var
                            name="fr-wizard-relevant-nav-case-ids"
                            value="
                                for $section-id in $fr-wizard-relevant-nav-section-or-grid-ids
                                return concat($section-id, '-case')"/>

                        <xf:var
                            name="fr-wizard-relevant-top-level-case-ids"
                            value="
                                for $section-id in $fr-wizard-relevant-top-level-section-ids
                                return concat($section-id, '-case')"/>

                        <!-- HACK: Dependency bug, using `xf:random()` to force recalculation -->
                        <xf:var
                            name="fr-wizard-current-top-level-case-id"
                            value="($fr-wizard-local/current-top-level-case-id/string(), xf:random())[1]"/>

                        <xf:var name="fr-wizard-update-url-param">
                            <xxf:value xxbl:scope="inner" value="xs:string(fr:component-param-value('allow-url-param' )) = 'true' and
                                                                 xs:string(fr:component-param-value('update-url-param')) = 'true'"/>
                        </xf:var>

                        <!-- NOTE: Initially, current-case-id might be empty, so default to the first relevant case id. -->
                        <xf:var
                            name="fr-wizard-current-nav-case-id"
                            value="
                                (
                                    $fr-wizard-local/current-case-id[xxf:non-blank()]/string(),
                                    $fr-wizard-relevant-nav-case-ids
                                )[1]"/>

                        <xf:var
                            name="fr-wizard-nav-case-index"
                            value="index-of($fr-wizard-relevant-nav-case-ids, $fr-wizard-current-nav-case-id)"/>

                        <xf:var
                            name="fr-wizard-top-level-case-index"
                            value="index-of($fr-wizard-relevant-top-level-case-ids, $fr-wizard-current-top-level-case-id)"/>

                        <xf:var
                            name="fr-wizard-prev-nav-case-ids"
                            value="$fr-wizard-relevant-nav-case-ids[position() lt $fr-wizard-nav-case-index]"/>

                        <xf:var
                            name="fr-wizard-next-nav-case-ids"
                            value="$fr-wizard-relevant-nav-case-ids[position() gt $fr-wizard-nav-case-index]"/>

                        <xf:var
                            name="fr-wizard-next-top-level-case-ids"
                            value="$fr-wizard-relevant-top-level-case-ids[position() gt $fr-wizard-top-level-case-index]"/>

                        <xf:var
                            name="fr-wizard-current-section-uses-paging"
                            value="$fr-wizard-current-nav-case-id = $fr-wizard-sections-with-paging-case-ids"/>

                        <xf:var name="inner-current-nav-case-id" xxbl:scope="inner">
                            <xxf:value xxbl:scope="outer" value="$fr-wizard-current-nav-case-id"/>
                        </xf:var>
                        <xf:var name="inner-current-top-level-case-id" xxbl:scope="inner">
                            <xxf:value xxbl:scope="outer" value="$fr-wizard-current-top-level-case-id"/>
                        </xf:var>
                        <xf:var name="inner-prev-nav-case-ids" xxbl:scope="inner">
                            <xxf:value xxbl:scope="outer" value="$fr-wizard-prev-nav-case-ids"/>
                        </xf:var>
                        <xf:var name="inner-next-nav-case-ids" xxbl:scope="inner">
                            <xxf:value xxbl:scope="outer" value="$fr-wizard-next-nav-case-ids"/>
                        </xf:var>
                        <xf:var name="inner-next-top-level-case-ids" xxbl:scope="inner">
                            <xxf:value xxbl:scope="outer" value="$fr-wizard-next-top-level-case-ids"/>
                        </xf:var>

                        <xf:var name="fr-wizard-current-nav-section-id">
                            <xxf:value xxbl:scope="inner" value="Wizard:sectionIdFromCaseIdOpt($inner-current-nav-case-id)"/>
                        </xf:var>
                        <xf:var name="fr-wizard-current-nav-section-bind-id">
                            <xxf:value xxbl:scope="inner" value="for $s in Wizard:sectionIdFromCaseIdOpt($inner-current-nav-case-id) return frf:bindId(frf:controlNameFromId($s))"/>
                        </xf:var>
                        <xf:var name="fr-wizard-current-page-name">
                            <xxf:value xxbl:scope="inner" value="frf:controlNameFromIdOpt(Wizard:sectionIdFromCaseIdOpt($inner-current-nav-case-id))"/>
                        </xf:var>
                        <xf:var name="fr-wizard-current-top-level-section-id">
                            <xxf:value xxbl:scope="inner" value="Wizard:sectionIdFromCaseIdOpt($inner-current-top-level-case-id)"/>
                        </xf:var>
                        <xf:var name="current-top-level-section-name" xxbl:scope="inner" value="frf:controlNameFromIdOpt(Wizard:sectionIdFromCaseIdOpt($inner-current-top-level-case-id))"/>
                        <xf:var name="fr-wizard-prev-nav-section-ids">
                            <xxf:value xxbl:scope="inner" value="for $c in $inner-prev-nav-case-ids return Wizard:sectionIdFromCaseIdOpt($c)"/>
                        </xf:var>
                        <xf:var name="fr-wizard-next-nav-section-id">
                            <xxf:value xxbl:scope="inner" value="for $c in $inner-next-nav-case-ids[1] return Wizard:sectionIdFromCaseIdOpt($c)"/>
                        </xf:var>
                        <xf:var name="fr-wizard-next-top-level-section-name">
                            <xxf:value xxbl:scope="inner" value="for $c in $inner-next-top-level-case-ids[1] return frf:controlNameFromIdOpt(Wizard:sectionIdFromCaseIdOpt($c))"/>
                        </xf:var>

                        <!-- Communicate the name and index of the current page to the client if needed
                             https://github.com/orbeon/orbeon-forms/issues/2848 -->
                        <xf:var
                            name="fr-wizard-current-page-name-with-index"
                            value="
                                if ($fr-wizard-current-section-uses-paging) then
                                    concat(
                                        $fr-wizard-current-page-name,
                                        '/',
                                        $fr-wizard-local/current-index/string(.)
                                    )
                                else
                                    $fr-wizard-current-page-name">
                            <!-- Also set when the page appears so that the URL is up-to-date. This will also
                                 fix the URL if the requested URL is pointing to a non-existing section or
                                 index. -->
                            <xf:action
                                    type="javascript"
                                    event="xforms-enabled xforms-value-changed"
                                    if="$fr-wizard-current-page-name-with-index and $fr-wizard-update-url-param">
                                <xf:param name="pageNameWithIndex" value="$fr-wizard-current-page-name-with-index"/>
                                <xf:body>ORBEON.fr.private.API.updateWizardPageName(event.form, pageNameWithIndex)</xf:body>
                            </xf:action>
                        </xf:var>

                        <xf:var
                            name="fr-wizard-current-repeat-id-and-index-opt"
                            value="
                                if ($fr-wizard-current-section-uses-paging) then
                                    let $repeat-id     := concat($fr-wizard-current-nav-section-id, '-repeater-repeat'),
                                        $current-index := $fr-wizard-local/current-index/data(.)
                                    return
                                        ($repeat-id, $current-index)
                                else
                                    ()
                            "/>

                        <xf:var
                            name="fr-wizard-prev-repeat-id-and-index-opt"
                            value="
                                if ($fr-wizard-current-section-uses-paging) then
                                    let $repeat-id     := concat($fr-wizard-current-nav-section-id, '-repeater-repeat'),
                                        $current-index := $fr-wizard-local/current-index/data(.)
                                    return
                                        if ($current-index gt 1) then
                                            ($repeat-id, $current-index - 1)
                                        else
                                            ()
                                else
                                    ()
                            "/>

                        <xf:var
                            name="fr-wizard-next-repeat-id-and-index-opt"
                            value="
                                if ($fr-wizard-current-section-uses-paging) then
                                    let $repeat-id     := concat($fr-wizard-current-nav-section-id, '-repeater-repeat'),
                                        $current-index := $fr-wizard-local/current-index/data(.),
                                        $section-bind  := bind($fr-wizard-current-nav-section-bind-id),
                                        $last-index    := count($section-bind/*)
                                    return
                                        if ($current-index lt $last-index) then
                                            ($repeat-id, $current-index + 1)
                                        else
                                            ()
                                else
                                    ()
                            "/>

                        <xf:var
                            name="fr-wizard-next-nested-case-id-opt"
                            value="
                                let $next-nav-case-id := $fr-wizard-next-nav-case-ids[1]
                                return
                                    $next-nav-case-id[
                                        $fr-wizard-current-top-level-section-id =
                                            $fr-wizard-nav-matching-top-level-section-ids[
                                                index-of(
                                                    $fr-wizard-nav-section-or-grid-ids,
                                                    $fr-wizard-next-nav-section-id
                                                )
                                            ]
                                    ]
                            "/>

                        <xf:var
                            name="fr-wizard-next-top-level-case-id-opt"
                            value="
                                let $next-top-level-case-id := $fr-wizard-next-top-level-case-ids[1]
                                return
                                    (: Exists and is available :)
                                    $next-top-level-case-id[
                                        exists(
                                            index-of(
                                                xxf:split($fr-wizard-available-top-level-sections),
                                                $fr-wizard-next-top-level-section-name
                                            )
                                        )
                                    ]
                            "/>

                        <xf:var
                            id="fr-wizard-allow-prev"
                            name="fr-wizard-allow-prev"
                            value="
                                exists($fr-wizard-prev-repeat-id-and-index-opt) or
                                exists($fr-wizard-prev-nav-case-ids)
                            "/>

                        <xf:var
                            id="fr-wizard-allow-next"
                            name="fr-wizard-allow-next"
                            value="
                                (: We can go to the next top-level section :)
                                exists($fr-wizard-next-top-level-case-id-opt) or
                                (: We can go to the next repeated section iteration :)
                                exists($fr-wizard-next-repeat-id-and-index-opt) or
                                (: Next is in the same top-level section :)
                                exists($fr-wizard-next-nested-case-id-opt)
                            "/>

                        <!-- Wizard.scala uses this via the variable `id` -->
                        <xf:var
                            id="fr-wizard-is-first-nav"
                            name="fr-wizard-is-first-nav"
                            value="empty($fr-wizard-prev-nav-case-ids)"/>

                        <!-- Wizard.scala uses this via the variable `id` -->
                        <xf:var
                            id="fr-wizard-is-last-nav"
                            name="fr-wizard-is-last-nav"
                            value="empty($fr-wizard-next-nav-case-ids)"/>

                        <xf:var name="fr-wizard-prev-button-ref" value="if ($fr-wizard-allow-prev) then $fr-wizard-local/readwrite else ''"/>
                        <xf:var name="fr-wizard-next-button-ref" value="if ($fr-wizard-allow-next) then $fr-wizard-local/readwrite else ''"/>

                        <xf:group
                            xxbl:scope="inner"
                            class="fr-wizard-toc{{
                                ' xforms-hidden'         [not($local/show-toc/data(.))],
                                ' fr-wizard-separate-toc'[$local/toc-position/data(.) = 'separate'],
                                ' fr-wizard-toc-separate'[$local/toc-position/data(.) = 'separate'],
                                ' fr-wizard-toc-none'    [$local/toc-position/data(.) = 'none']
                            }}">

                            <!-- Dispatch fr-toc-shown event as needed -->
                            <xf:group appearance="xxf:internal" ref=".[$local/show-toc/data(.)]">
                                <xf:action
                                    event="xforms-enabled"
                                    target="#observer">

                                    <xf:dispatch
                                        name="fr-toc-shown"
                                        targetid="fr-wizard">
                                        <xf:property name="validate"     value="$local/validate/data(.)"/>
                                        <xf:property name="separate-toc" value="$local/separate-toc/data(.)"/>
                                    </xf:dispatch>
                                </xf:action>
                            </xf:group>

                            <xf:group
                                xxbl:scope="outer"
                                id="fr-wizard-outer-group"
                                class="fr-wizard-toc-inner"
                                xxf:element="div">

                                <xf:action event="fr-prev-internal">
                                    <xf:action if="$fr-wizard-allow-prev">
                                        <xf:action if="exists($fr-wizard-prev-repeat-id-and-index-opt)">
                                            <xf:var name="fr-wizard-new-index" value="$fr-wizard-prev-repeat-id-and-index-opt[2]"/>
                                            <xf:setvalue
                                                ref="$fr-wizard-local/current-index"
                                                value="$fr-wizard-new-index"/>
                                            <xf:setindex
                                                repeat="{{$fr-wizard-prev-repeat-id-and-index-opt[1]}}"
                                                index="$fr-wizard-new-index"/>
                                        </xf:action>
                                        <xf:action if="empty($fr-wizard-prev-repeat-id-and-index-opt)">
                                            <xf:var name="fr-wizard-prev-case-id" value="$fr-wizard-prev-nav-case-ids[last()]"/>
                                            <xf:toggle
                                                case="{{$fr-wizard-prev-case-id}}"/>
                                            <xf:action if="$fr-wizard-prev-case-id = $fr-wizard-sections-with-paging-case-ids">
                                                <xf:var name="fr-wizard-section-id" value="$fr-wizard-prev-nav-section-ids[last()]"/>
                                                <xf:var name="fr-wizard-new-index" value="count(xxf:binding($fr-wizard-section-id)/*)"/>
                                                <xf:setvalue
                                                    ref="$fr-wizard-local/current-index"
                                                    value="$fr-wizard-new-index"/>
                                                <xf:setindex
                                                    repeat="{{concat($fr-wizard-section-id, '-repeater-repeat')}}"
                                                    index="$fr-wizard-new-index"/>
                                            </xf:action>
                                            <xsl:if test="$static-initial-focus">
                                                <xf:setfocus
                                                    control="{{$fr-wizard-prev-case-id}}"
                                                    includes="{{$fr-wizard-focus-includes}}"
                                                    excludes="{{$fr-wizard-focus-excludes}}"/>
                                            </xsl:if>
                                        </xf:action>
                                    </xf:action>
                                </xf:action>

                                <xf:action event="fr-next-internal">
                                    <xf:dispatch
                                        name="fr-wizard-update-validity"
                                        targetid="fr-wizard-update-validity"/>
                                    <xf:dispatch
                                        name="fr-wizard-visit-all-to-current"
                                        targetid="fr-wizard-visit-all-to-current"/>
                                    <xf:action if="$fr-wizard-allow-next">
                                        <xf:action if="exists($fr-wizard-next-repeat-id-and-index-opt)">
                                            <xf:var name="fr-wizard-new-index" value="$fr-wizard-next-repeat-id-and-index-opt[2]"/>
                                            <xf:setvalue
                                                ref="$fr-wizard-local/current-index"
                                                value="$fr-wizard-new-index"/>
                                            <xf:setindex
                                                repeat="{{$fr-wizard-next-repeat-id-and-index-opt[1]}}"
                                                index="$fr-wizard-new-index"/>
                                        </xf:action>
                                        <xf:action if="empty($fr-wizard-next-repeat-id-and-index-opt)">
                                            <xf:var name="fr-wizard-next-case-id" value="$fr-wizard-next-nav-case-ids[1]"/>
                                            <xf:toggle
                                                case="{{$fr-wizard-next-case-id}}"/>
                                            <xf:action if="$fr-wizard-next-case-id = $fr-wizard-sections-with-paging-case-ids">
                                                <xf:var name="fr-wizard-section-id" value="$fr-wizard-next-nav-section-id"/>
                                                <xf:var name="fr-wizard-new-index" value="1"/>
                                                <xf:setvalue
                                                    ref="$fr-wizard-local/current-index"
                                                    value="$fr-wizard-new-index"/>
                                                <xf:setindex
                                                    repeat="{{concat($fr-wizard-section-id, '-repeater-repeat')}}"
                                                    index="$fr-wizard-new-index"/>
                                            </xf:action>
                                            <xsl:if test="$static-initial-focus">
                                                <xf:setfocus
                                                    control="{{$fr-wizard-next-case-id}}"
                                                    includes="{{$fr-wizard-focus-includes}}"
                                                    excludes="{{$fr-wizard-focus-excludes}}"/>
                                            </xsl:if>
                                        </xf:action>
                                    </xf:action>
                                    <xf:action if="not($fr-wizard-allow-next)">
                                        <xsl:if test="$static-initial-focus">
                                            <xf:setfocus
                                                control="{{$fr-wizard-current-nav-case-id}}"
                                                includes="{{$fr-wizard-focus-includes}}"
                                                excludes="{{$fr-wizard-focus-excludes}}"/>
                                        </xsl:if>
                                    </xf:action>
                                </xf:action>

                                <!-- We put this here because we need `$fr-wizard-relevant-top-level-section-ids` -->
                                <xf:action event="fr-update-section-status">

                                    <xf:var name="fr-wizard-maps">
                                        <xxf:value
                                            xxbl:scope="inner"
                                            value="Wizard:gatherTopLevelSectionStatusJava($inner-relevant-top-level-section-ids)"/>
                                    </xf:var>

                                    <!-- Update available sections instance -->
                                    <!-- We do this because we don't want to run `Wizard:gatherTopLevelSectionStatusJava` at each refresh, and we want to
                                         depend on instance values, although in practice it might not make much of a difference.
                                         2026-03-19: `fr-update-section-status` runs at each `xxforms-refresh-done` now.
                                     -->
                                    <xf:setvalue
                                        ref="$fr-wizard-available-top-level-sections"
                                        value="
                                            string-join(
                                                for $m in $fr-wizard-maps
                                                return
                                                    if (map:get($m, 'is-available')) then map:get($m, 'name') else (),
                                                ' '
                                            )"/>

                                    <!-- Update section statuses for all relevant sections -->
                                    <xf:action iterate="$fr-wizard-relevant-top-level-section-ids">

                                        <xf:var
                                            name="fr-wizard-section-binding"
                                            value="xxf:binding(.)"/>

                                        <xf:action if="exists($fr-wizard-section-binding/@fr:section-status)">

                                            <xf:var
                                                name="fr-wizard-map"
                                                value="
                                                    for $m in $fr-wizard-maps
                                                    return
                                                        if (map:get($m, 'name') = name($fr-wizard-section-binding)) then $m else ()"/>

                                            <xf:var
                                                name="fr-wizard-existing-tokens"
                                                value="
                                                    distinct-values(
                                                        xxf:split($fr-wizard-section-binding/@fr:section-status)
                                                    )"/>

                                            <xf:var
                                                name="fr-wizard-new-tokens"
                                                value="
                                                    distinct-values(
                                                        (
                                                            $fr-wizard-existing-tokens[
                                                                not(. = (
                                                                    'incomplete',
                                                                    'invalid',
                                                                    'visible-incomplete',
                                                                    'visible-invalid'
                                                                    )
                                                                )
                                                            ], (: these toggle so remove them first :)
                                                            'incomplete'        [exists($fr-wizard-map) and map:get($fr-wizard-map, 'has-incomplete-fields')],
                                                            'invalid'           [exists($fr-wizard-map) and map:get($fr-wizard-map, 'has-error-fields')],
                                                            'visible-incomplete'[exists($fr-wizard-map) and map:get($fr-wizard-map, 'has-visible-incomplete-fields')],
                                                            'visible-invalid'   [exists($fr-wizard-map) and map:get($fr-wizard-map, 'has-visible-error-fields')]
                                                        )
                                                    )"/>

                                            <xf:setvalue
                                                if="not(count($fr-wizard-existing-tokens) = count($fr-wizard-new-tokens) and empty($fr-wizard-existing-tokens[not(. = $fr-wizard-new-tokens)]))"
                                                ref="$fr-wizard-section-binding/@fr:section-status"
                                                value="string-join($fr-wizard-new-tokens, ' ')"/>

                                        </xf:action>
                                    </xf:action>
                                </xf:action>

                                <!-- Reusable action to toggle to a section and validate that this is allowed -->
                                <xf:action event="fr-toggle-section-validate">
                                    <xf:var
                                        name="last-available-and-visited-top-level-section-id-opt"
                                        xxbl:scope="inner"
                                        as="xs:string?"
                                        value="event('last-available-and-visited-top-level-section-id-opt')"/>
                                    <xf:var
                                        name="requested-control-id-opt"
                                        xxbl:scope="inner"
                                        as="xs:string?"
                                        value="event('requested-control-id-opt')"/>
                                    <xf:var
                                        name="requested-page-name-opt"
                                        xxbl:scope="inner"
                                        as="xs:string?"
                                        value="
                                            if (exists($requested-control-id-opt)) then
                                                Wizard:ancestorContainerNamesForControlId($requested-control-id-opt)[
                                                    . = (
                                                        for $i in $inner-relevant-nav-section-or-grid-ids
                                                        return frf:controlNameFromId($i)
                                                    )
                                                ]
                                            else
                                                event('requested-page-name-opt')"/>
                                    <xf:var
                                        name="requested-page-index-opt"
                                        xxbl:scope="inner"
                                        as="xs:integer?"
                                        value="event('requested-page-index-opt')"/>

                                    <xf:var
                                        name="fr-wizard-setfocus-control-id-opt"
                                        as="xs:string?"
                                        value="event('setfocus-control-id')"/>

                                    <xf:var
                                        name="fr-wizard-setfocus-repeat-indexes-opt"
                                        as="xs:string?"
                                        value="event('setfocus-repeat-indexes')"/>

                                    <xf:var
                                        name="inner-initial-case-id-with-index-opt"
                                        xxbl:scope="inner"
                                        value="
                                            (
                                                for $requested-page-name in $requested-page-name-opt
                                                return
                                                    let (: These include also subsection page names :)
                                                        $relevant-page-names :=
                                                            for $i in $inner-relevant-nav-section-or-grid-ids
                                                            return frf:controlNameFromId($i),
                                                        (: These are the computed available top-level section
                                                           names only, including taking the validated mode
                                                           into account. We call the function directly because
                                                           `$available-top-level-sections` is not
                                                            yet computed. :)
                                                        $available-top-level-sections-names :=
                                                            for $m in Wizard:gatherTopLevelSectionStatusJava($inner-relevant-top-level-section-ids)
                                                            return
                                                                if (map:get($m, 'is-available')) then map:get($m, 'name') else (),
                                                        $sections-with-paging-names :=
                                                            for $i in $inner-sections-with-paging-section-ids
                                                            return frf:controlNameFromId($i),
                                                        $has-paging :=
                                                            $requested-page-name = $sections-with-paging-names,
                                                        $new-validated-index-opt :=
                                                            if ($has-paging) then
                                                                $requested-page-index-opt
                                                            else
                                                                (),
                                                        $new-relevant-nav-section-or-grid-id-opt :=
                                                            $inner-relevant-nav-section-or-grid-ids[index-of($relevant-page-names, $requested-page-name)],
                                                        $new-top-level-section-id-opt :=
                                                            for $new-relevant-nav-section-or-grid-id in $new-relevant-nav-section-or-grid-id-opt
                                                            return
                                                                $inner-nav-matching-top-level-section-ids[
                                                                    index-of(
                                                                        $inner-nav-section-or-grid-ids,
                                                                        $new-relevant-nav-section-or-grid-id
                                                                    )
                                                                ][
                                                                    frf:controlNameFromIdOpt(.) = $available-top-level-sections-names
                                                                ]
                                                    return
                                                        if (exists($new-top-level-section-id-opt) and (not($has-paging) or exists($new-validated-index-opt))) then
                                                            array:append(
                                                                array:append(
                                                                    array:join(()),
                                                                    concat($new-relevant-nav-section-or-grid-id-opt, '-case')
                                                                ),
                                                                $new-validated-index-opt
                                                            )
                                                        else
                                                            (),
                                                (: Nested sections scenario :)
                                                for $i in Wizard:caseIdsForTopLevelSection($last-available-and-visited-top-level-section-id-opt)[1]
                                                return
                                                    array:append(
                                                        array:join(()),
                                                        $i
                                                    ),
                                                (: Regular top-level section scenario :)
                                                for $last-available-and-visited-top-level-section-id in $last-available-and-visited-top-level-section-id-opt
                                                return
                                                    array:append(
                                                        array:join(()),
                                                        concat($last-available-and-visited-top-level-section-id, '-case')
                                                    )
                                            )[1]"/>

                                    <xf:var name="fr-wizard-initial-case-id-with-index-opt">
                                        <xxf:value xxbl:scope="inner" value="$inner-initial-case-id-with-index-opt"/>
                                    </xf:var>

                                    <xf:action if="exists($fr-wizard-initial-case-id-with-index-opt)">
                                        <xf:var
                                            name="fr-wizard-new-case-id"
                                            value="array:get($fr-wizard-initial-case-id-with-index-opt, 1)"/>
                                        <xf:var name="fr-wizard-new-section-id">
                                            <xxf:value
                                                xxbl:scope="inner"
                                                value="Wizard:sectionIdFromCaseIdOpt(array:get($inner-initial-case-id-with-index-opt, 1))"/>
                                        </xf:var>

                                        <xf:setvalue
                                            ref="$fr-wizard-local/current-case-id"
                                            value="$fr-wizard-new-case-id"/>

                                        <xf:setvalue
                                            ref="$fr-wizard-local/current-top-level-case-id"
                                            value="
                                                concat(
                                                    $fr-wizard-nav-matching-top-level-section-ids[
                                                        index-of(
                                                            $fr-wizard-nav-section-or-grid-ids,
                                                            $fr-wizard-new-section-id
                                                        )
                                                    ],
                                                    '-case'
                                                )"/>

                                        <!-- See https://github.com/orbeon/orbeon-forms/issues/3433 -->
                                        <xf:toggle
                                            case="{{$fr-wizard-new-case-id}}"/>

                                        <!-- Set initial index if present -->
                                        <xf:action if="array:size($fr-wizard-initial-case-id-with-index-opt) ge 2">
                                            <xf:var name="fr-wizard-new-index" value="array:get($fr-wizard-initial-case-id-with-index-opt, 2)"/>
                                            <xf:setvalue
                                                ref="$fr-wizard-local/current-index"
                                                value="$fr-wizard-new-index"/>
                                            <xf:setindex
                                                repeat="{{concat($fr-wizard-new-section-id, '-repeater-repeat')}}"
                                                index="$fr-wizard-new-index"/>
                                        </xf:action>

                                        <xf:setfocus
                                            if="exists($fr-wizard-setfocus-control-id-opt)"
                                            control="{{$fr-wizard-setfocus-control-id-opt}}"
                                            xxf:repeat-indexes="{{$fr-wizard-setfocus-repeat-indexes-opt}}"/>

                                    </xf:action>

                                </xf:action>

                                <xf:action event="fr-update-initial-case" if="not($fr-wizard-local/@initialized/data(.))">

                                    <xf:setvalue ref="$fr-wizard-local/@initialized" value="true()"/>

                                    <!-- Make sure the first relevant case is shown initially -->
                                    <!-- NOTE: Ideally, we should also handle the case where the `fr:section` in the
                                         currently-selected case becomes non-relevant. However, this should not happen
                                         in a well-designed form (that would be very user unfriendly). If `xf:case` supported
                                         relevance, we might be able to let this behavior be handled by the XForms engine.
                                     -->
                                    <!-- Find the last available AND visited section -->
                                    <xf:var
                                        name="fr-wizard-last-available-and-visited-top-level-section-id-opt"
                                        value="
                                            (
                                                (: First relevant section by default :)
                                                $fr-wizard-relevant-top-level-section-ids[1],
                                                (: But also check subsequent sections for availability and visited :)
                                                (
                                                    for $id in $fr-wizard-relevant-top-level-section-ids[position() gt 1]
                                                    return
                                                        if (
                                                            $id = $fr-wizard-available-top-level-sections-ids and
                                                            exists(xxf:binding($id)/@fr:section-status)
                                                        ) then
                                                            $id
                                                        else
                                                            ()
                                                )
                                            )[last()]"/>

                                    <!-- Set initial current section -->
                                    <xf:action if="exists($fr-wizard-last-available-and-visited-top-level-section-id-opt)">

                                        <xf:var name="fr-wizard-allow-url-param">
                                            <xxf:value xxbl:scope="inner" value="xs:string(fr:component-param-value('allow-url-param')) = 'true'"/>
                                        </xf:var>

                                        <xf:var
                                            name="fr-wizard-page-name-with-index-opt"
                                            value="
                                                (: URL parameter, see https://github.com/orbeon/orbeon-forms/issues/2848
                                                   We validate the input page name and optional index and return
                                                   the empty sequence if the input is invalid. :)
                                                for $param in xxf:get-request-parameter('fr-wizard-page')[1][$fr-wizard-allow-url-param]
                                                return
                                                    xxf:trim($param[xxf:non-blank()])"/>

                                        <xf:var
                                            name="fr-wizard-requested-page-name-opt"
                                            value="
                                                for $page-name-with-index in $fr-wizard-page-name-with-index-opt
                                                return
                                                    if (contains($page-name-with-index, '/')) then
                                                        substring-before($page-name-with-index, '/')
                                                    else
                                                        $page-name-with-index"/>

                                        <xf:var
                                            name="fr-wizard-requested-page-index-opt"
                                            value="
                                                for $page-name-with-index in $fr-wizard-page-name-with-index-opt
                                                return
                                                    if (contains($page-name-with-index, '/')) then
                                                        xs:integer(substring-after($page-name-with-index, '/')[. castable as xs:integer])[
                                                            (: Range validation :)
                                                            . ge 1 and
                                                            . le count(bind(concat($fr-wizard-requested-page-name-opt, '-bind'))/*)
                                                        ]
                                                    else
                                                        ()"/>

                                        <xf:dispatch
                                            name="fr-toggle-section-validate"
                                            targetid="fr-wizard-outer-group">
                                            <xf:property name="last-available-and-visited-top-level-section-id-opt"  value="$fr-wizard-last-available-and-visited-top-level-section-id-opt"/>
                                            <xf:property name="requested-page-name-opt"                              value="$fr-wizard-requested-page-name-opt"/>
                                            <xf:property name="requested-page-index-opt"                             value="$fr-wizard-requested-page-index-opt"/>
                                        </xf:dispatch>

                                        <!-- Dispatch `fr-section-shown` the first time the body is shown if needed -->
                                        <xf:action if="$fr-wizard-local/show-body/data(.)">
                                            <xf:var name="inner-last-available-and-visited-top-level-section-id-opt" xxbl:scope="inner">
                                                <xxf:value xxbl:scope="outer" value="$fr-wizard-last-available-and-visited-top-level-section-id-opt"/>
                                            </xf:var>
                                            <xf:dispatch name="fr-section-shown" targetid="fr-wizard" xxbl:scope="inner">
                                                <xf:property name="section-binding" value="xxf:binding($fr-wizard-last-available-and-visited-top-level-section-id-opt)" xxbl:scope="outer"/>
                                                <xf:property name="section-name"    value="frf:controlNameFromIdOpt($inner-last-available-and-visited-top-level-section-id-opt)"/>
                                                <xf:property name="validate"        value="$local/validate/data(.)"/>
                                                <xf:property name="separate-toc"    value="$local/separate-toc/data(.)"/>
                                                <xf:property name="toc-position"    value="$local/toc-position/data(.)"/>
                                            </xf:dispatch>
                                        </xf:action>

                                    </xf:action>

                                </xf:action>

                                <!-- This id is used to expose visibility to buttons outside the wizard -->
                                <xf:group
                                    id="fr-wizard-submit-hide"
                                    ref="$fr-wizard-local/readwrite[not($fr-wizard-validated-mode) or empty($fr-wizard-next-top-level-case-ids)]"/>

                                <xh:div role="navigation">
                                    <xh:ul class="nav">
                                        <xsl:apply-templates mode="fr-toc-sections">
                                            <xsl:with-param name="is-wizard"              select="true()"                  tunnel="yes"/>
                                            <xsl:with-param name="static-app"             select="$static-app"             tunnel="yes"/>
                                            <xsl:with-param name="static-form"            select="$static-form"            tunnel="yes"/>
                                            <xsl:with-param name="static-subsections-nav" select="$static-subsections-nav" tunnel="yes"/>
                                            <xsl:with-param name="static-subsections-toc" select="$static-subsections-toc" tunnel="yes"/>
                                            <xsl:with-param name="static-initial-focus"   select="$static-initial-focus"   tunnel="yes"/>
                                        </xsl:apply-templates>
                                    </xh:ul>
                                </xh:div>

                                <xh:div class="fr-wizard-navigation{{if ($fr-wizard-local/separate-toc/data(.)) then ' xforms-hidden' else ''}}">
                                    <xh:div class="pagination pagination-centered">
                                        <xh:ul>
                                            <xh:li class="{{if ($fr-wizard-prev-button-ref instance of xs:string) then 'disabled' else ''}}">
                                                <xf:trigger id="fr-wizard-prev"  ref="$fr-wizard-prev-button-ref" appearance="minimal" class="fr-wizard-prev">
                                                    <xf:label><xh:i class="fa fa-fw fa-chevron-left"/></xf:label>
                                                    <xf:action event="DOMActivate" type="xpath">
                                                        fr:run-process-by-name('oxf.fr.detail.process', 'wizard-prev')
                                                    </xf:action>
                                                </xf:trigger>
                                            </xh:li>
                                            <xh:li>
                                                <xh:span class="fr-page-number">
                                                    <xf:output value="
                                                        sum(
                                                            (
                                                                if (exists($fr-wizard-prev-repeat-id-and-index-opt)) then
                                                                    $fr-wizard-prev-repeat-id-and-index-opt[2] + 1
                                                                else
                                                                    1,
                                                                for $i in 1 to count($fr-wizard-prev-nav-case-ids)
                                                                return
                                                                    if (
                                                                        $fr-wizard-prev-nav-case-ids[$i] = $fr-wizard-sections-with-paging-case-ids
                                                                    ) then
                                                                        count(xxf:binding($fr-wizard-prev-nav-section-ids[$i])/*)
                                                                    else
                                                                        1
                                                            )
                                                        )"/>

                                                    <xf:output value="concat(' ', $fr-resources/summary/paging/of, ' ')"/>
                                                    <xf:output value="
                                                        sum(
                                                            (
                                                                count(
                                                                    $fr-wizard-relevant-nav-case-ids[
                                                                        not(. = $fr-wizard-sections-with-paging-case-ids)
                                                                    ]
                                                                ),
                                                                for $section-id in $fr-wizard-sections-with-paging-section-ids
                                                                return
                                                                    count(xxf:binding($section-id)/*)
                                                            )
                                                        )"/>
                                                </xh:span>
                                            </xh:li>
                                            <xh:li class="{{if ($fr-wizard-next-button-ref instance of xs:string) then 'disabled' else ''}}">
                                                <xf:trigger id="fr-wizard-next" ref="$fr-wizard-next-button-ref" appearance="minimal" class="fr-wizard-next">
                                                    <xf:label><xh:i class="fa fa-fw fa-chevron-right"/></xf:label>
                                                    <xf:action event="DOMActivate" type="xpath">
                                                        fr:run-process-by-name('oxf.fr.detail.process', 'wizard-next')
                                                    </xf:action>
                                                </xf:trigger>
                                            </xh:li>
                                        </xh:ul>

                                        <!-- NOTE: This shouldn't be in the outer scope ideally. -->
                                        <xf:group id="fr-wizard-update-validity" appearance="xxf:internal">
                                            <xf:action event="fr-wizard-update-validity">
                                                <xsl:choose>
                                                    <xsl:when test="$static-validation-mode = 'explicit'">
                                                        <!-- Update validity, refresh, then try again -->
                                                        <xxf:update-validity
                                                            control="{{string-join(($fr-wizard-prev-nav-case-ids, $fr-wizard-current-nav-case-id), ' ')}}"
                                                            recurse="true"/>
                                                        <!-- This ensures that when `fr-do-next` runs, UI variables have been updated -->
                                                        <xf:refresh/>
                                                    </xsl:when>
                                                    <xsl:otherwise>
                                                        <!-- Do action immediately -->
                                                    </xsl:otherwise>
                                                </xsl:choose>
                                            </xf:action>
                                        </xf:group>
                                        <xf:group id="fr-wizard-visit-all" appearance="xxf:internal">
                                            <xf:action event="fr-wizard-visit-all">
                                                <xf:dispatch
                                                    iterate="$fr-wizard-top-level-section-ids"
                                                    name="fr-expand"
                                                    targetid="{{.}}"/>

                                                <!-- Create `fr:section-status` for all top-level sections so that the TOC status updates  -->
                                                <xf:action iterate="$fr-wizard-relevant-top-level-section-ids">
                                                    <xf:var name="fr-wizard-section-binding" value="xxf:binding(.)"/>
                                                    <xf:insert
                                                        if="not(exists($fr-wizard-section-binding/@fr:section-status))"
                                                        context="$fr-wizard-section-binding"
                                                        origin="xf:attribute('fr:section-status', '')"/>
                                                </xf:action>

                                                <!-- Avoid extra refreshes at this point: xxf:deferred-updates="false" -->
                                                <xxf:setvisited
                                                    xxf:deferred-updates="false"
                                                    control="switch"
                                                    visited="true"
                                                    recurse="true"/>
                                            </xf:action>
                                        </xf:group>
                                        <xf:group id="fr-wizard-visit-all-to-current" appearance="xxf:internal">
                                            <!-- NOTE: We visit the current page upon xforms-deselect too. -->
                                            <xf:action
                                                event="fr-wizard-visit-all-to-current"
                                                if="not($fr-wizard-local/visit-on-page-change = 'never')">

                                                <!-- This is called upon "next". -->
                                                <!-- The current section, since it is current, is obviously already
                                                     expanded. So we make sure we expand anything before it. -->
                                                <xf:dispatch
                                                    iterate="
                                                        distinct-values(
                                                            for $prev-nav-section-id in $fr-wizard-prev-nav-section-ids
                                                            return
                                                                $fr-wizard-nav-matching-top-level-section-ids[
                                                                    index-of(
                                                                        $fr-wizard-nav-section-or-grid-ids,
                                                                        $prev-nav-section-id
                                                                    )
                                                                ]
                                                        )"
                                                    name="fr-expand"
                                                    targetid="{{.}}"/>

                                                <xxf:setvisited
                                                    iterate="$fr-wizard-prev-nav-case-ids, if ($fr-wizard-current-section-uses-paging) then () else $fr-wizard-current-nav-case-id"
                                                    control="{{.}}"
                                                    visited="true"
                                                    recurse="true"/>
                                                <xxf:setvisited
                                                    if="$fr-wizard-current-section-uses-paging"
                                                    iterate="1 to $fr-wizard-current-repeat-id-and-index-opt[2]"
                                                    control="{{$fr-wizard-current-repeat-id-and-index-opt[1]}}~iteration"
                                                    xxf:repeat-indexes="{{.}}"
                                                    visited="true"
                                                    recurse="true"/>
                                            </xf:action>
                                        </xf:group>
                                        <xf:group id="fr-wizard-visit-all-available" appearance="xxf:internal">
                                            <xf:action event="fr-wizard-visit-all-available">
                                                <!-- Expand all as we want the errors recorded because this is called during `save` and
                                                     the save must be blocked if there are any errors in the entire form. -->
                                                <xf:dispatch
                                                    iterate="$fr-wizard-top-level-section-ids"
                                                    name="fr-expand"
                                                    targetid="{{.}}"/>

                                                <!-- Create `fr:section-status` for all top-level sections so that the TOC status updates -->
                                                <xf:action iterate="$fr-wizard-available-top-level-sections-ids">
                                                    <xf:var name="fr-wizard-section-binding" value="xxf:binding(.)"/>
                                                    <xf:insert
                                                        if="not(exists($fr-wizard-section-binding/@fr:section-status))"
                                                        context="$fr-wizard-section-binding"
                                                        origin="xf:attribute('fr:section-status', '')"/>
                                                </xf:action>

                                                <xxf:setvisited
                                                    iterate="
                                                        for $section-id in $fr-wizard-available-top-level-sections-ids
                                                        return concat($section-id, '-case')"
                                                    control="{{.}}"
                                                    visited="true"
                                                    recurse="true"/>
                                            </xf:action>
                                        </xf:group>
                                        <xf:group id="fr-wizard-unvisit-following" appearance="xxf:internal">
                                            <xxf:setvisited
                                                event="fr-wizard-unvisit-following"

                                                iterate="$fr-wizard-next-nav-case-ids"
                                                control="{{.}}"
                                                visited="false"
                                                recurse="true"/>
                                            <!-- Q: Should we remove `fr:section-status`? -->
                                            <!-- NOTE: We *could* collapse the corresponding top-level sections. -->
                                        </xf:group>
                                        <xf:group id="fr-wizard-section-deselected" appearance="xxf:internal">
                                            <xf:action event="fr-wizard-section-deselected">
                                                <!-- Avoid extra refreshes at this point: xxf:deferred-updates="false" -->
                                                <xxf:setvisited
                                                    if="not($fr-wizard-current-section-uses-paging)"

                                                    xxf:deferred-updates="false"
                                                    control="{{event('control')}}"
                                                    visited="true"
                                                    recurse="true"/>

                                                <xxf:setvisited
                                                    if="$fr-wizard-current-section-uses-paging"
                                                    iterate="1 to $fr-wizard-current-repeat-id-and-index-opt[2]"

                                                    xxf:deferred-updates="false"
                                                    control="{{$fr-wizard-current-repeat-id-and-index-opt[1]}}~iteration"
                                                    xxf:repeat-indexes="{{.}}"
                                                    visited="true"
                                                    recurse="true"/>
                                            </xf:action>
                                            <!-- NOTE: We *could* collapse the corresponding top-level sections. Should we? -->
                                        </xf:group>
                                    </xh:div>
                                </xh:div>

                                <!--
                                <xf:group id="fr-wizard-debugger" class="fr-wizard-debugger">
                                    <xf:label>Wizard Debugger</xf:label>
                                    <xh:ul>
                                        <xh:li>
                                            available-top-level-sections:
                                            <xh:ul>
                                                <xf:repeat ref="xxf:split($fr-wizard-available-top-level-sections)">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            nav-section-or-grid-ids (<xf:output value="count($fr-wizard-nav-section-or-grid-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-nav-section-or-grid-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            nav-matching-top-level-section-ids (<xf:output value="count($fr-wizard-nav-matching-top-level-section-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-nav-matching-top-level-section-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            top-level-section-ids (<xf:output value="count($fr-wizard-top-level-section-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-top-level-section-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            sections-with-paging-section-ids (<xf:output value="count($fr-wizard-sections-with-paging-section-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-sections-with-paging-section-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            sections-with-paging-case-ids (<xf:output value="count($fr-wizard-sections-with-paging-case-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-sections-with-paging-case-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>validated-mode: <xf:output value="$fr-wizard-validated-mode"/></xh:li>
                                        <xh:li>separate-toc-mode: <xf:output value="$fr-wizard-separate-toc-mode"/></xh:li>
                                        <xh:li>
                                            relevant-nav-section-or-grid-ids (<xf:output value="count($fr-wizard-relevant-nav-section-or-grid-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-relevant-nav-section-or-grid-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            relevant-top-level-section-ids (<xf:output value="count($fr-wizard-relevant-top-level-section-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-relevant-top-level-section-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            relevant-nav-case-ids (<xf:output value="count($fr-wizard-relevant-nav-case-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-relevant-nav-case-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            relevant-top-level-case-ids (<xf:output value="count($fr-wizard-relevant-top-level-case-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-relevant-top-level-case-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>current-top-level-case-id: <xf:output value="$fr-wizard-current-top-level-case-id"/></xh:li>
                                        <xh:li>current-nav-case-id: <xf:output value="$fr-wizard-current-nav-case-id"/></xh:li>
                                        <xh:li>nav-case-index: <xf:output value="$fr-wizard-nav-case-index"/></xh:li>
                                        <xh:li>top-level-case-index: <xf:output value="$fr-wizard-top-level-case-index"/></xh:li>
                                        <xh:li>
                                            prev-nav-case-ids (<xf:output value="count($fr-wizard-prev-nav-case-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-prev-nav-case-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            next-nav-case-ids (<xf:output value="count($fr-wizard-next-nav-case-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-next-nav-case-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>
                                            next-top-level-case-ids (<xf:output value="count($fr-wizard-next-top-level-case-ids)"/>):
                                            <xh:ul>
                                                <xf:repeat ref="$fr-wizard-next-top-level-case-ids">
                                                    <xh:li><xf:output value="."/></xh:li>
                                                </xf:repeat>
                                            </xh:ul>
                                        </xh:li>
                                        <xh:li>current-section-uses-paging: <xf:output value="$fr-wizard-current-section-uses-paging"/></xh:li>
                                        <xh:li>prev-repeat-id-and-index-opt: <xf:output value="string-join(for $ v in $fr-wizard-prev-repeat-id-and-index-opt return string($v), ', ')"/></xh:li>
                                        <xh:li>current-repeat-id-and-index-opt: <xf:output value="string-join(for $ v in $fr-wizard-current-repeat-id-and-index-opt return string($v), ', ')"/></xh:li>
                                        <xh:li>next-repeat-id-and-index-opt: <xf:output value="string-join(for $ v in $fr-wizard-next-repeat-id-and-index-opt return string($v), ', ')"/></xh:li>
                                        <xh:li>next-nested-case-id-opt: <xf:output value="$fr-wizard-next-nested-case-id-opt"/></xh:li>
                                        <xh:li>next-top-level-case-id-opt: <xf:output value="$fr-wizard-next-top-level-case-id-opt"/></xh:li>
                                        <xh:li>allow-prev: <xf:output value="$fr-wizard-allow-prev"/></xh:li>
                                        <xh:li>allow-next: <xf:output value="$fr-wizard-allow-next"/></xh:li>
                                        <xh:li>is-first-nav: <xf:output value="$fr-wizard-is-first-nav"/></xh:li>
                                        <xh:li>is-last-nav: <xf:output value="$fr-wizard-is-last-nav"/></xh:li>
                                    </xh:ul>
                                </xf:group>
                                -->
                            </xf:group>
                        </xf:group>

                        <xf:group appearance="xxf:internal" xxbl:scope="inner">
                            <xh:div class="fr-wizard-body{{if ($local/show-body/data(.)) then '' else ' xforms-hidden'}}">

                                <!-- FIXME: Don't like that this is a top-level `switch` id! -->
                                <xf:switch id="switch" xbl:attr="caseref=sectionref" xxf:element="div" xxbl:scope="outer">
                                    <xsl:if test="@full-update = 'true'">
                                        <xsl:attribute name="xxf:update">full</xsl:attribute>
                                    </xsl:if>

                                    <!-- We need a way to listen to each case, but we don't want to duplicate the script and
                                         anyway event.target doesn't work within case (which would be a bug) -->
                                    <!-- TODO: Move to Scala.js. -->
                                    <xf:action type="javascript" event="fr-section-scroll" target="#observer">
                                        <![CDATA[
                                        var $ = ORBEON.jQuery;
                                        var target = event.target;
                                        var sectionTitle = $(target).closest('.xbl-fr-wizard').find('.fr-wizard-body .xforms-case-selected .fr-section-title')[0];

                                        if (sectionTitle) {
                                            var r = sectionTitle.getBoundingClientRect();
                                            if (r.top < 0 || r.bottom > $(window).height()) {
                                                window.scrollTo($(window).scrollLeft(), $(sectionTitle).offset().top);
                                            }
                                        }
                                        ]]>
                                    </xf:action>
                                    <!-- Wrap each top-level fr:section within each own case -->
                                    <xsl:for-each select="fr:section">
                                        <xsl:variable name="static-section-id" select="@id"/>
                                        <xf:case id="{$static-section-id}-case">
                                            <xsl:if test="/*/@sectionref">
                                                <xsl:attribute
                                                    name="value"
                                                    select="concat('''', frf:controlNameFromId($static-section-id), '''')"
                                                    xmlns:frf="java:org.orbeon.oxf.fr.FormRunner"/>
                                            </xsl:if>

                                            <!-- Visit current section when leaving it -->
                                            <xf:dispatch
                                                event="xforms-deselect"
                                                target="#observer"
                                                if="not($fr-wizard-local/visit-on-page-change = ('never', 'only-forward'))"

                                                name="fr-wizard-section-deselected"
                                                targetid="fr-wizard-section-deselected">
                                                <xf:property name="control" value="event('xxf:targetid')"/>
                                            </xf:dispatch>

                                            <!-- Check that incoming `xforms-focus` is allowed -->
                                            <!-- TODO: See https://github.com/orbeon/orbeon-forms/issues/3323. -->

                                            <!-- Un-visit all subsequent sections upon error in current section in `strict` mode -->
                                            <!-- Use `delay="0"`, so we dispatch all the `fr-wizard-unvisit-following` after all the
                                                 `xforms-invalid`, avoiding a `StackOverflowError` on large forms -->
                                            <xf:dispatch
                                                event="xforms-invalid"
                                                if="$fr-wizard-local/validate/data(.) = 'strict'"

                                                name="fr-wizard-unvisit-following"
                                                targetid="fr-wizard-unvisit-following"
                                                delay="0"/>

                                            <!-- Subsection nav enabled AND the top-level section is not part of the nav, which
                                                 means we navigate it's subsections/grids. -->
                                            <xsl:variable
                                                name="has-subsections-nav"
                                                select="$static-subsections-nav and not($static-nav-section-or-grid-ids = @id)"/>

                                            <xf:action event="xforms-select" target="#observer">

                                                <!--
                                                    Keep `current-case-id` and `current-top-level-case-id` up to date.

                                                    NOTE: The `xforms-select` event is dispatched at the end of the `xf:toggle` but
                                                    before focus has been adjusted.
                                                -->
                                                <xsl:if test="not($has-subsections-nav)">
                                                    <!-- `current-case-id` is the same as `current-top-level-case-id` -->
                                                    <xf:setvalue
                                                        ref="$fr-wizard-local/current-case-id"
                                                        value="event('xxf:targetid')"/>
                                                </xsl:if>
                                                <xsl:if test="$has-subsections-nav">
                                                    <!-- Either the top-level case doesn't change, and then the nexted
                                                         switch's event handler sets this value; or the top-level case
                                                         changed, and there is a chance that the nested switch didn't
                                                         change its case, in which case we make sure we set it here. If
                                                         the nested switch changed its case, it already set the value,
                                                         but that's ok. -->
                                                    <xf:setvalue
                                                        ref="$fr-wizard-local/current-case-id"
                                                        value="case('{$static-section-id}-switch')"/>
                                                </xsl:if>

                                                <xf:setvalue
                                                    ref="$fr-wizard-local/current-top-level-case-id"
                                                    value="event('xxf:targetid')"/>

                                                <xf:dispatch name="fr-section-scroll" targetid="switch"/>

                                                <xf:var
                                                    name="inner-section-id"
                                                    value="Wizard:sectionIdFromCaseIdOpt(event('xxf:targetid'))"
                                                    xxbl:scope="inner"/>
                                                <xf:var name="fr-wizard-section-id">
                                                    <xxf:value value="$inner-section-id" xxbl:scope="inner"/>
                                                </xf:var>

                                                <xf:dispatch targetid="{{$fr-wizard-section-id}}" name="fr-expand"/>

                                                <!-- NOTE: 2020-01-23: This is dispatched only for *top-level* pages. -->
                                                <xf:dispatch name="fr-section-shown" targetid="fr-wizard" xxbl:scope="inner">
                                                    <xf:property name="section-binding" value="xxf:binding($fr-wizard-section-id)" xxbl:scope="outer"/>
                                                    <xf:property name="section-name"    value="frf:controlNameFromIdOpt($inner-section-id)"/>
                                                    <xf:property name="validate"        value="$local/validate/data(.)"/>
                                                    <xf:property name="separate-toc"    value="$local/separate-toc/data(.)"/>
                                                    <xf:property name="toc-position"    value="$local/toc-position/data(.)"/>
                                                </xf:dispatch>

                                            </xf:action>

                                            <xf:group appearance="xxf:internal"><!-- Q: Why this group? -->
                                                <!-- This is where the original section's attribute are being copied, including `id` and `bind` -->
                                                <xsl:copy><!-- `<fr:section>` -->
                                                    <xsl:attribute name="view-appearance">fr:wizard</xsl:attribute>
                                                    <xsl:attribute name="collapsible">false</xsl:attribute>
                                                    <xsl:apply-templates select="@* except (@collapse | @collapsible | @open)"/>
                                                    <!-- Tell the section whether it needs to be initially open or not (optimization).
                                                         We can't enable this yet in `lax|strict` mode, see:
                                                         https://github.com/orbeon/orbeon-forms/issues/4790#issuecomment-791652516 -->
                                                    <xsl:attribute
                                                        name="content-nonrelevant-if-collapsed"
                                                        select="$static-lazy-section-relevance"/>
                                                    <xsl:attribute
                                                        name="open"
                                                        select="concat('{case(''switch'') = ''', $static-section-id, '-case''}')"/>

                                                    <!-- Update the `changed` token -->
                                                    <xf:action event="xforms-value-changed">
                                                        <xf:setvalue
                                                            ref="@fr:section-status"
                                                            value="
                                                                let $tokens := distinct-values(xxf:split(.))
                                                                return
                                                                    if (empty(index-of($tokens, 'changed'))) then
                                                                        string-join(($tokens, 'changed'), ' ')
                                                                    else
                                                                        ."/>
                                                    </xf:action>

                                                    <xsl:choose>
                                                        <xsl:when test="$has-subsections-nav">

                                                            <!-- Don't forget the enclosing section lHHA -->
                                                            <xsl:apply-templates select="xf:label | xf:help | xf:hint | xf:alert"/>

                                                            <!-- Subsections -->
                                                            <xf:switch id="{$static-section-id}-switch" xxf:element="div" xxf:update="full">
                                                                <xsl:for-each select="fr:section | fr:grid">
                                                                    <!-- fr:grid might not have an id, and we need one to toggle -->
                                                                    <xsl:variable name="section-or-grid-id" select="(@id, concat(generate-id(), '-wizard-grid'))[1]"/>
                                                                    <xf:case id="{$section-or-grid-id}-case">
                                                                        <xxf:setvisited
                                                                            event="xforms-deselect"
                                                                            target="#observer"
                                                                            control="{{event('xxf:targetid')}}"
                                                                            visited="true"
                                                                            recurse="true"/>
                                                                        <xf:action event="xforms-select" target="#observer">
                                                                            <!-- Keep `current-case-id` up to date in case switch happened via toggling. -->
                                                                            <xf:setvalue
                                                                                ref="$fr-wizard-local/current-case-id"
                                                                                value="event('xxf:targetid')"/>

                                                                            <xf:dispatch name="fr-section-scroll" targetid="switch"/>

                                                                        </xf:action>
                                                                        <xf:group appearance="xxf:internal">
                                                                            <xsl:copy>
                                                                                <xsl:if test="self::fr:section">
                                                                                    <xsl:attribute name="view-appearance">fr:wizard</xsl:attribute>
                                                                                    <xsl:attribute name="collapsible">false</xsl:attribute>
                                                                                </xsl:if>
                                                                                <xsl:if test="not(@id)">
                                                                                    <xsl:attribute name="id" select="$section-or-grid-id"/>
                                                                                </xsl:if>
                                                                                <xsl:apply-templates select="(@* except (@collapse | @collapsible | @open)) | node()"/>
                                                                            </xsl:copy>
                                                                        </xf:group>
                                                                        <xsl:if test="$captcha-location = ('inside-wizard-first-page', 'inside-wizard-last-page')">
                                                                            <fr:captcha namespace-name="{/*/@captcha-namespace-name}">
                                                                                <xsl:attribute name="ref">
                                                                                    .[
                                                                                        '<xsl:value-of select="$section-or-grid-id"/>-case' =
                                                                                        $fr-wizard-relevant-nav-case-ids[<xsl:value-of select="$captcha-location-index"/>]
                                                                                    ]
                                                                                </xsl:attribute>
                                                                            </fr:captcha>
                                                                        </xsl:if>
                                                                    </xf:case>
                                                                </xsl:for-each>
                                                            </xf:switch>
                                                        </xsl:when>
                                                        <xsl:otherwise>
                                                            <!-- No subsection nav -->
                                                            <xsl:apply-templates select="node()"/>
                                                            <xsl:if test="$captcha-location = ('inside-wizard-first-page', 'inside-wizard-last-page')">
                                                                <fr:captcha namespace-name="{/*/@captcha-namespace-name}" captcha-visible="{/*/@captcha-visible}">
                                                                    <xsl:attribute name="ref">
                                                                        .[
                                                                            '<xsl:value-of select="$static-section-id"/>-case' =
                                                                            $fr-wizard-relevant-top-level-case-ids[<xsl:value-of select="$captcha-location-index"/>]
                                                                        ]
                                                                    </xsl:attribute>
                                                                </fr:captcha>
                                                            </xsl:if>
                                                        </xsl:otherwise>
                                                    </xsl:choose>
                                                </xsl:copy>
                                            </xf:group>
                                        </xf:case>
                                    </xsl:for-each>
                                </xf:switch>
                                <xsl:if test="$captcha-location = 'inside-wizard'">
                                    <fr:captcha
                                        id="fr-captcha"
                                        namespace-name="{/*/@captcha-namespace-name}"
                                        captcha-visible="{/*/@captcha-visible}"
                                        xxbl:scope="outer"/>
                                </xsl:if>
                            </xh:div>
                            <!-- In case the view contains elements other than sections (like dialogs) -->
                            <xsl:variable name="fr-wizard-other-content" as="node()*">
                                <xsl:apply-templates select="* except fr:section"/>
                            </xsl:variable>
                            <!-- Only place content if at least one element is present, so we avoid issues with table borders -->
                            <xsl:if test="exists($fr-wizard-other-content/self::*)">
                                <xh:div class="fr-wizard-other">
                                    <xf:group appearance="xxf:internal" xxbl:scope="outer">
                                        <xsl:copy-of select="$fr-wizard-other-content"/>
                                    </xf:group>
                                </xh:div>
                            </xsl:if>
                        </xf:group>
                    </xf:group>
                </xsl:template>

            </xsl:transform>
        </xbl:template>
    </xbl:binding>

</xbl:xbl>