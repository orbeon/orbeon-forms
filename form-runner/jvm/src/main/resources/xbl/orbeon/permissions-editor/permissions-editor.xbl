<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
    xmlns:pui="java:org.orbeon.oxf.fr.permission.PermissionsEditorUI">

    <xbl:binding
        id="fr-permissions-editor"
        element="fr|permissions-editor"
        xxbl:mode="lhha binding value">

        <xbl:resources>
            <xbl:style src="/xbl/orbeon/permissions-editor/permissions-editor.css"/>
        </xbl:resources>

        <xbl:handlers>
            <xbl:handler event="fr-permissions-reload" phase="target">
                <xf:setvalue ref="instance('state')/@initialized" value="'false'"/>
                <xf:setvalue ref="instance('state')/@reload-seq"  value="xs:integer(.) + 1"/>
                <xxf:setvisited control="fr-permissions-editor-root" visited="false" recurse="true"/>
            </xbl:handler>
        </xbl:handlers>

        <xbl:implementation>
            <xf:model id="permissions-editor-model">

                <xf:instance id="editor" xxf:exclude-result-prefixes="#all">
                    <editor>
                        <has-permissions/>
                        <always-show-roles/>
                        <permissions/>
                    </editor>
                </xf:instance>

                <xf:instance id="state" xxf:exclude-result-prefixes="#all">
                    <state
                        initialized="false"
                        readonly="true"
                        syncing="false"
                        mode="visual"
                        reload-seq="0"
                        last-json="">
                        <raw-json/>
                        <readonly-checked>create read update delete list</readonly-checked>
                        <readonly-unchecked/>
                    </state>
                </xf:instance>

                <xf:instance id="permission-with-role-template" xxf:exclude-result-prefixes="#all">
                    <permission>
                        <operations/>
                        <role/>
                    </permission>
                </xf:instance>

                <xf:instance id="orbeon-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                    <_>
                        <resource xml:lang="en">
                            <readonly-hint>Enable Override to configure permissions.</readonly-hint>
                            <enable-permissions>Enable permissions</enable-permissions>
                            <visual-mode>Visual</visual-mode>
                            <json-mode>JSON</json-mode>
                            <format-json>Format</format-json>
                            <copy-json>Copy</copy-json>
                            <role>Role</role>
                            <anyone>Anyone</anyone>
                            <anyone-with-token>Require token</anyone-with-token>
                            <any-authenticated-user>Any authenticated user</any-authenticated-user>
                            <owner>Owner</owner>
                            <group-member>Group members</group-member>
                            <create>Create</create>
                            <read>Read</read>
                            <update>Update</update>
                            <delete>Delete</delete>
                            <list>List</list>
                            <role-required>Role name is required</role-required>
                            <role-duplicate>Duplicate role name</role-duplicate>
                            <invalid-json>Invalid permissions JSON</invalid-json>
                        </resource>
                        <resource xml:lang="fr">
