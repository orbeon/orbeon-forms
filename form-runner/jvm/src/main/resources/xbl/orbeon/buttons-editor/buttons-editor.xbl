                            <label-text-placeholder>Enter button label…</label-text-placeholder>
                            <raw-html-label>HTML Markup</raw-html-label>
                            <section-conditions>Visibility &amp; Readonliness</section-conditions>
                            <visible-label>Visibility</visible-label>
