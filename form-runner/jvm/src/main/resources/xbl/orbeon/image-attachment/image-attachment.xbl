<xbl:xbl
    xmlns:xh="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
    xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
    xmlns:xbl="http://www.w3.org/ns/xbl"
    xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

    <xbl:binding
        id="fr-image-attachment"
        element="fr|image-attachment"
        xxbl:mode="binding lhha javascript-lifecycle"
        xxbl:container="span"
        xxbl:label-for="fr-image-attachment-elem">

        <!-- Orbeon Form Builder Component Metadata -->
        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Single Image Attachment</display-name>
            <display-name lang="fr">Image jointe unique</display-name>
            <display-name lang="no">Enkelt bildevedlegg</display-name>
            <display-name lang="ru">Загрузка одного изображения</display-name>
            <display-name lang="it">Immagine allegata singola</display-name>
            <display-name lang="de">Einzelner Bildanhang</display-name>
            <display-name lang="fi">Yhden kuvan liittäminen</display-name>
            <display-name lang="es">Adjuntar imagen única</display-name>
            <display-name lang="nl">Enkele afbeeldingsbijlage</display-name>
            <display-name lang="pt">Anexar imagem única</display-name>
            <display-name lang="sv">Enkel bild som bilaga</display-name>
            <display-name lang="ar">مرفق صورة واحدة</display-name>
            <display-name lang="pl">Załącznik pojedynczego obrazu</display-name>
            <display-name lang="ja">単一画像添付</display-name>
            <icon>
                <icon-class>fa fa-fw fa-file-image-o</icon-class>
            </icon>
            <templates>
                <bind type="xf:anyURI" constraint="xxf:upload-mediatypes('image/*')"/>
                <instance filename="" mediatype="" size=""/>
                <view>
                     <fr:image-attachment id="" ref="" class="fr-attachment">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                    </fr:image-attachment>
                </view>
            </templates>
            <custom-settings>
                <setting name="size" type="xs:string" values="auto small medium large"/>
                <setting name="view-mode" type="xs:string" values="grid carousel"/>
                <setting name="carousel-size" type="xs:string" values="small medium large"/>
                <setting name="columns" type="xs:integer" min="1"/>
                <setting name="max-rows" type="xs:integer" min="1"/>
                <setting name="transform-max-width" type="xs:integer" min="1"/>
                <setting name="transform-max-height" type="xs:integer" min="1"/>
                <setting name="transform-quality" type="xs:integer" min="1" max="100"/>
                <setting name="transform-format" type="xs:string" values="jpg png"/>
            </custom-settings>
            <conversions element="fr|attachment"/>
            <control-details>
                <xf:model xmlns="">

                    <xf:action event="xforms-model-construct-done">
                        <xf:action iterate="instance('local')/*">
                            <xf:var name="local-elem"  value="."/>
                            <xf:var name="param-name"  value="name($local-elem)"/>
                            <xf:var
                                name="att-name"
                                value="
                                    if ($param-name = ('size', 'view-mode', 'carousel-size', 'columns', 'max-rows')) then
                                        $param-name
                                    else
                                        concat('transform-', $param-name)"/>
                            <xf:var name="control-att" value="instance()/@*[name() = $att-name]"/>
                            <xf:setvalue
                                ref="$local-elem"
                                value="
                                    if (empty($control-att)) then
                                        -1
                                    else if (xxf:is-blank($control-att)) then
                                        $local-elem/@default
                                    else
                                        $control-att"/>
                        </xf:action>
                    </xf:action>

                    <xf:instance id="local" xxf:exclude-result-prefixes="#all">
                        <_>
                            <size          default="-2"/>
                            <view-mode     default="-2"/>
                            <carousel-size default="-2"/>
                            <columns       default="-2"/>
                            <max-rows      default="-2"/>
                            <max-width     default="-2"/>
                            <max-height    default="-2"/>
                            <quality       default="80"/>
                            <format        default="-2"/>
                        </_>
                    </xf:instance>

                    <xf:bind ref="instance('local')">
                        <xf:bind
                            ref="size"
                            relevant="empty(instance()/@id) or not(instance()/@multiple = 'true')"/>
                        <xf:bind
                            ref="view-mode"
                            relevant="empty(instance()/@id) or instance()/@multiple = 'true'"/>
                        <xf:bind
                            ref="carousel-size"
                            relevant="(empty(instance()/@id) or instance()/@multiple = 'true') and ../view-mode = 'carousel'"/>
                        <xf:bind
                            ref="columns | max-rows"
                            type="xf:integer"
                            xxf:whitespace="trim"
                            constraint=". = (-1, -2) or xxf:positive()"
                            relevant="(empty(instance()/@id) or instance()/@multiple = 'true') and ../view-mode != 'carousel'"/>
                        <xf:bind
                            ref="max-width | max-height"
                            type="xf:integer"
                            xxf:whitespace="trim"
                            constraint=". = (-1, -2) or xxf:positive()"/>
                        <xf:bind
                            ref="quality"
                            type="xf:integer"
                            xxf:whitespace="trim"
                            constraint=". = -1 or (xxf:positive() and . le 100)"/>
                    </xf:bind>

                    <xf:instance id="fr-form-resources" xxf:readonly="true" xxf:exclude-result-prefixes="#all">
                        <_>
                            <resource xml:lang="en">
                                <size>
                                    <label>Image size</label>
                                    <item value="-1">Use default</item>
                                    <item value="auto">Automatic</item>
                                    <item value="small">Small</item>
                                    <item value="medium">Medium</item>
                                    <item value="large">Large</item>
                                </size>
                                <view-mode>
                                    <label>Display mode</label>
                                    <item value="-1">Use default</item>
                                    <item value="grid">Grid</item>
                                    <item value="carousel">Carousel</item>
                                </view-mode>
                                <carousel-size>
                                    <label>Carousel size</label>
                                    <item value="-1">Use default</item>
                                    <item value="small">Small</item>
                                    <item value="medium">Medium</item>
                                    <item value="large">Large</item>
                                </carousel-size>
                                <columns>
                                    <label>Number of columns</label>
                                    <item value="-1">Use default</item>
                                    <item value="-2">Automatic</item>
                                </columns>
                                <max-rows>
                                    <label>Maximum visible rows</label>
                                    <item value="-1">Use default</item>
                                    <item value="-2">Unlimited</item>
                                </max-rows>
                                <max-width>
                                    <label>Adjust to maximum width to</label>
                                    <item value="-1">Use default</item>
                                    <item value="-2">No adjustment</item>
                                </max-width>
                                <max-height>
                                    <label>Adjust to maximum height to</label>
                                </max-height>
                                <quality>
                                    <label>Compressed image quality</label>
                                    <item value="-1">Use default</item>
                                    <item value="90">High (90%)</item>
                                    <item value="80">Medium (80%)</item>
                                    <item value="70">Low (70%)</item>
                                    <item value="50">Very low (50%)</item>
                                </quality>
                                <format>
                                    <label>Resulting image format</label>
                                    <item value="-1">Use default</item>
                                    <item value="-2">Preserve</item>
                                </format>
                            </resource>
                            <resource xml:lang="fr">
                                <size>
                                    <label>Taille de l'image</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="auto">Automatique</item>
                                    <item value="small">Petite</item>
                                    <item value="medium">Moyenne</item>
                                    <item value="large">Grande</item>
                                </size>
                                <view-mode>
                                    <label>Mode d'affichage</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="grid">Grille</item>
                                    <item value="carousel">Carrousel</item>
                                </view-mode>
                                <carousel-size>
                                    <label>Taille du carrousel</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="small">Petite</item>
                                    <item value="medium">Moyenne</item>
                                    <item value="large">Grande</item>
                                </carousel-size>
                                <columns>
                                    <label>Nombre de colonnes</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="-2">Automatique</item>
                                </columns>
                                <max-rows>
                                    <label>Nombre maximal de lignes visibles</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="-2">Illimité</item>
                                </max-rows>
                                <max-width>
                                    <label>Ajuster la largeur maximale à</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="-2">Ne pas ajuster</item>
                                </max-width>
                                <max-height>
                                    <label>Ajuster la hauteur maximale à</label>
                                </max-height>
                                <quality>
                                    <label>Qualité de l'image après compression</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="90">Haute (90%)</item>
                                    <item value="80">Moyenne (80%)</item>
                                    <item value="70">Basse (70%)</item>
                                    <item value="50">Très basse (50%)</item>
                                </quality>
                                <format>
                                    <label>Format d'image résultant</label>
                                    <item value="-1">Utiliser le défaut</item>
                                    <item value="-2">Préserver</item>
                                </format>
                            </resource>
                            <resource xml:lang="no">
                                <size>
                                    <label>Bildestørrelse</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="auto">Automatisk</item>
                                    <item value="small">Liten</item>
                                    <item value="medium">Middels</item>
                                    <item value="large">Stor</item>
                                </size>
                                <view-mode>
                                    <label>Visningsmodus</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="grid">Rutenett</item>
                                    <item value="carousel">Karusell</item>
                                </view-mode>
                                <carousel-size>
                                    <label>Karusellstørrelse</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="small">Liten</item>
                                    <item value="medium">Middels</item>
                                    <item value="large">Stor</item>
                                </carousel-size>
                                <columns>
                                    <label>Antall kolonner</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="-2">Automatisk</item>
                                </columns>
                                <max-rows>
                                    <label>Maksimalt antall synlige rader</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="-2">Ubegrenset</item>
                                </max-rows>
                                <max-width>
                                    <label>Juster maksimal bredde til</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="-2">Ingen justering</item>
                                </max-width>
                                <max-height>
                                    <label>Juster maksimal høyde til</label>
                                </max-height>
                                <quality>
                                    <label>Kvalitet etter komprimering</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="90">Høy (90%)</item>
                                    <item value="80">Middels (80%)</item>
                                    <item value="70">Lav (70%)</item>
                                    <item value="50">Svært lav (50%)</item>
                                </quality>
                                <format>
                                    <label>Resultatformat</label>
                                    <item value="-1">Bruk standard</item>
                                    <item value="-2">Behold</item>
                                </format>
                            </resource>
                            <resource xml:lang="ru">
                                <size>
                                    <label>Размер изображения</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="auto">Автоматически</item>
                                    <item value="small">Маленький</item>
                                    <item value="medium">Средний</item>
                                    <item value="large">Большой</item>
                                </size>
                                <view-mode>
                                    <label>Режим отображения</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="grid">Сетка</item>
                                    <item value="carousel">Карусель</item>
                                </view-mode>
                                <carousel-size>
                                    <label>Размер карусели</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="small">Маленький</item>
                                    <item value="medium">Средний</item>
                                    <item value="large">Большой</item>
                                </carousel-size>
                                <columns>
                                    <label>Количество столбцов</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="-2">Автоматически</item>
                                </columns>
                                <max-rows>
                                    <label>Максимальное число видимых строк</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="-2">Без ограничений</item>
                                </max-rows>
                                <max-width>
                                    <label>Установить макс. ширину</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="-2">Без изменения</item>
                                </max-width>
                                <max-height>
                                    <label>Установить макс. высоту</label>
                                </max-height>
                                <quality>
                                    <label>Качество сжатого изображения</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="90">Высокое (90%)</item>
                                    <item value="80">Среднее (80%)</item>
                                    <item value="70">Низкое (70%)</item>
                                    <item value="50">Очень низкое (50%)</item>
                                </quality>
                                <format>
                                    <label>Формат результирующего изображения</label>
                                    <item value="-1">Использовать по умолчанию</item>
                                    <item value="-2">Сохранить исходный</item>
                                </format>
                            </resource>
                            <resource xml:lang="it">
                                <size>
                                    <label>Dimensione dell'immagine</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="auto">Automatico</item>
                                    <item value="small">Piccola</item>
                                    <item value="medium">Media</item>
                                    <item value="large">Grande</item>
                                </size>
                                <view-mode>
                                    <label>Modalità di visualizzazione</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="grid">Griglia</item>
                                    <item value="carousel">Carosello</item>
                                </view-mode>
                                <carousel-size>
                                    <label>Dimensione del carosello</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="small">Piccola</item>
                                    <item value="medium">Media</item>
                                    <item value="large">Grande</item>
                                </carousel-size>
                                <columns>
                                    <label>Numero di colonne</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="-2">Automatico</item>
                                </columns>
                                <max-rows>
                                    <label>Numero massimo di righe visibili</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="-2">Illimitato</item>
                                </max-rows>
                                <max-width>
                                    <label>Adatta la larghezza massima a</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="-2">Nessun adattamento</item>
                                </max-width>
                                <max-height>
                                    <label>Adatta l'altezza massima a</label>
                                </max-height>
                                <quality>
                                    <label>Qualità dell'immagine dopo la compressione</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="90">Alta (90%)</item>
                                    <item value="80">Media (80%)</item>
                                    <item value="70">Bassa (70%)</item>
                                    <item value="50">Molto bassa (50%)</item>
                                </quality>
                                <format>
                                    <label>Formato immagine risultante</label>
                                    <item value="-1">Usa predefinito</item>
                                    <item value="-2">Conserva</item>
                                </format>
                            </resource>
                            <resource xml:lang="de">
                                <size>
                                    <label>Bildgröße</label>
                                    <item value="-1">Standard verwenden</item>
                                    <item value="auto">Automatisch</item>
                                    <item value="small">Klein</item>
                                    <item value="medium">Mittel</item>
                                    <item value="large">Groß</item>
