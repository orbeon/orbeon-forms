<xbl:xbl xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl">

    <xbl:binding id="fb-cards-select-horizontal" element="xf|select[appearance ~= cards][appearance ~= 'xxf:horizontal']">
        <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
            <display-name lang="en">Horizontal Choice Cards (Multiple Selection)</display-name>
            <display-name lang="fr">Cartes de choix horizontales (sélection multiple)</display-name>
            <display-name lang="no">Horisontale valgkort (flervalg)</display-name>
            <display-name lang="ru">Горизонтальные карточки выбора (множественный выбор)</display-name>
            <display-name lang="it">Schede di scelta orizzontali (scelta multipla)</display-name>
            <display-name lang="de">Horizontale Auswahlkarten (Mehrfachauswahl)</display-name>
            <display-name lang="fi">Vaakasuuntaiset valintakortit (monivalinta)</display-name>
            <display-name lang="es">Tarjetas de opción horizontales (selección múltiple)</display-name>
            <display-name lang="nl">Horizontale keuzekaarten (meervoudige selectie)</display-name>
            <display-name lang="pt">Cartões de opção horizontais (seleção múltipla)</display-name>
            <display-name lang="sv">Horisontella valkort (flerval)</display-name>
            <display-name lang="ar">بطاقات اختيار أفقية (تحديد متعدد)</display-name>
            <display-name lang="pl">Poziome karty wyboru (wybór wielokrotny)</display-name>
            <display-name lang="ja">水平選択カード（複数選択）</display-name>
            <appearance-display-name lang="en">Horizontal Choice Cards</appearance-display-name>
            <appearance-display-name lang="fr">Cartes de choix horizontales</appearance-display-name>
            <appearance-display-name lang="no">Horisontale valgkort</appearance-display-name>
            <appearance-display-name lang="ru">Горизонтальные карточки выбора</appearance-display-name>
            <appearance-display-name lang="it">Schede di scelta orizzontali</appearance-display-name>
            <appearance-display-name lang="de">Horizontale Auswahlkarten</appearance-display-name>
            <appearance-display-name lang="fi">Vaakasuuntaiset valintakortit</appearance-display-name>
            <appearance-display-name lang="es">Tarjetas de opción horizontales</appearance-display-name>
            <appearance-display-name lang="nl">Horizontale keuzekaarten</appearance-display-name>
            <appearance-display-name lang="pt">Cartões de opção horizontais</appearance-display-name>
            <appearance-display-name lang="sv">Horisontella valkort</appearance-display-name>
            <appearance-display-name lang="ar">بطاقات اختيار أفقية</appearance-display-name>
            <appearance-display-name lang="pl">Poziome karty wyboru</appearance-display-name>
            <appearance-display-name lang="ja">水平選択カード</appearance-display-name>
            <toolbox show="false"/>
            <icon>
                <icon-class>fa fa-fw fa-th-large</icon-class>
            </icon>
            <editors static-itemset="true" item-hint="true"/>
            <templates>
                <view>
                    <xf:select id="" ref="" appearance="cards xxf:horizontal" xmlns="">
                        <xf:label ref=""/>
                        <xf:hint ref=""/>
                        <xf:help ref=""/>
                        <xf:alert ref=""/>
                        <xf:itemset ref="">
                            <xf:label ref="label"/>
                            <xf:value ref="value"/>
                            <xf:hint ref="hint"/>
                        </xf:itemset>
                    </xf:select>
                </view>
            </templates>
        </metadata>
    </xbl:binding>

</xbl:xbl>
